<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst;net9.0-windows10.0.26100.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>CONATRADEC</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			Se desactivan globalmente los inicializadores automáticos que
			intentaban cargar componentes Main/Singleton del Windows App SDK
			antes de ejecutar App.xaml.cs y provocaban:
			0x80040154 (REGDB_E_CLASSNOTREG).
		-->
		<WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
		<WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>

		<PackageId>ConatraCafeSoil</PackageId>

		<ApplicationTitle>ConatraCafé Soil</ApplicationTitle>
		<ApplicationId>com.conatradec.conatradec</ApplicationId>

		<!-- Primera versión que incorpora el actualizador interno. -->
		<ApplicationDisplayVersion>1.0.8</ApplicationDisplayVersion>
		<ApplicationVersion>9</ApplicationVersion>

		<!-- Compatibilidad con teléfonos físicos y emuladores Android. -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
		Windows se distribuye como aplicación sin empaquetar y autocontenida.
		Este modo evita depender de una instalación externa del Windows App SDK
		y permite crear un instalador EXE tradicional con Inno Setup.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>true</SelfContained>

		<!--
			No se usan Main/Singleton, DeploymentManager ni el bootstrapper
			de un runtime instalado externamente.
		-->
		<WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
		<WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>

		<!--
			Las aplicaciones Windows desempaquetadas y autocontenidas necesitan
			activación WinRT sin registro.
		-->
		<WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<AndroidEnableLLVM>false</AndroidEnableLLVM>
		<RunAOTCompilation>false</RunAOTCompilation>
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<AndroidLinkMode>None</AndroidLinkMode>
	</PropertyGroup>

	<PropertyGroup>
		<RunAOTCompilation>false</RunAOTCompilation>
		<PublishTrimmed>false</PublishTrimmed>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>029760A486A8034C068CBDB82A3455463E877D7C</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icono principal de la aplicación. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="512,512" />

		<!-- Pantalla inicial nativa. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#3B655B" BaseSize="512,512" />

		<!--
			En Android, iOS y MacCatalyst las imágenes continúan siendo
			procesadas por .NET MAUI mediante MauiImage.
		-->
		<MauiImage Include="Resources\Images\**\*" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" />

		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!--
		En Windows se copian las imágenes directamente a la raíz del paquete.
		Así las referencias como Source="iconuser.png" y
		Source="mascota_cafe_conatradec.png" se resuelven sin depender
		del procesador de imágenes de MAUI.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Content Include="Resources\Images\**\*.png" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<Content Include="Resources\Images\**\*.jpg" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<Content Include="Resources\Images\**\*.jpeg" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<Content Include="Resources\Images\**\*.gif" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<!-- Los SVG siguen siendo procesados por MAUI y se consumen como .png. -->
		<MauiImage Include="Resources\Images\**\*.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.5" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="8.0.100" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<!--
		Plugin.Fingerprint se conserva para Android, iOS y MacCatalyst,
		pero no se incluye en Windows para evitar cargar su implementación
		WinRT/UWP durante el inicio de la aplicación.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
		<PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
	</ItemGroup>

