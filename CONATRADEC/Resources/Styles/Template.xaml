<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:services="clr-namespace:CONATRADEC.Services">

    <ControlTemplate x:Key="FooterTemplate">
        <Grid
            RowDefinitions="*,Auto"
            BackgroundColor="{StaticResource color_Blanco}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.Behaviors>
                <controls:ResponsiveNavigationLayoutBehavior />
            </Grid.Behaviors>

            <!-- NAVEGACIÓN LATERAL: WINDOWS AMPLIO -->
            <Border
                AutomationId="DesktopNavigation"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="False"
                Padding="14,18"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="3,0" Radius="12" Opacity="0.08" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto">
                    <VerticalStackLayout Grid.Row="0" Padding="10,8,10,20" Spacing="3">
                        <Label Text="ConatraCafé" FontSize="22" FontFamily="MontserratBold" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                        <Label Text="Soil" FontSize="13" FontFamily="MontserratMedium" TextColor="{StaticResource color_GrisOscuro}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                        <controls:AppNavigationMenuItem
                            Texto="Inicio"
                            Icono="iconhome.png"
                            Interfaz="MainPage"
                            Ruta="//MainPage"
                            Seccion="Inicio" />

                        <controls:AppNavigationMenuItem
                            Texto="Inspección fitosanitaria"
                            Icono="iconcultivo.png"
                            GrupoPermisos="InspeccionFitosanitaria"
                            Ruta="{x:Static services:DiagnosticoIARoutes.RutaModulo}"
                            Seccion="Inspeccion" />

                        <controls:AppNavigationMenuItem
                            Texto="Álbum de fotos"
                            Icono="iconalbum.png"
                            Interfaz="albumFotosPage"
                            Ruta="albumFotosPage"
                            Seccion="Album" />

                        <controls:AppNavigationMenuItem
                            Texto="Noticias"
                            Icono="iconnews.png"
                            Interfaz="noticiasPage"
                            Ruta="//noticiasPage"
                            Seccion="Noticias" />

                        <controls:AppNavigationMenuItem
                            Texto="Configuración"
                            Icono="iconsettings.png"
                            GrupoPermisos="Configuracion"
                            Ruta="//ConfiguracionPage"
                            Seccion="Configuracion" />

                        <controls:AppNavigationMenuItem
                            Texto="Sin conexión"
                            Icono="iconoffline.png"
                            Interfaz="datosSinConexionPage"
                            Ruta="//DatosSinConexionPage"
                            Seccion="DatosOffline" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,0,0,4" />
                        <Border
                            HeightRequest="50"
                            MinimumHeightRequest="50"
                            Padding="14,11"
                            BackgroundColor="#FEF2F2"
                            Stroke="Transparent"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="26,*" ColumnSpacing="12">
                                <Image Source="iconloginout.png" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Cerrar sesión" FontFamily="MontserratMedium" FontSize="15" TextColor="{StaticResource RedDelete}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <ContentPresenter
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="{StaticResource color_Blanco}" />

            <!-- NAVEGACIÓN INFERIOR: VENTANA ESTRECHA Y MÓVIL -->
            <Border
                AutomationId="CompactNavigation"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="True"
                Padding="3,6,3,10"
                BackgroundColor="{StaticResource color_Blanco}"
                Stroke="#E5E7EB"
                StrokeThickness="1">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-3" Radius="12" Opacity="0.10" />
                </Border.Shadow>

                <FlexLayout Direction="Row" AlignItems="Stretch" JustifyContent="SpaceBetween">
                    <FlexLayout.Behaviors>
                        <controls:MobileNavigationBarBehavior />
                    </FlexLayout.Behaviors>

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Inicio"
                        Icono="iconhome.png"
                        Interfaz="MainPage"
                        Ruta="//MainPage"
                        Seccion="Inicio"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Inspección"
                        Icono="iconcultivo.png"
                        GrupoPermisos="InspeccionFitosanitaria"
                        Ruta="{x:Static services:DiagnosticoIARoutes.RutaModulo}"
                        Seccion="Inspeccion"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Álbum"
                        Icono="iconalbum.png"
                        Interfaz="albumFotosPage"
                        Ruta="albumFotosPage"
                        Seccion="Album"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Noticias"
                        Icono="iconnews.png"
                        Interfaz="noticiasPage"
                        Ruta="//noticiasPage"
                        Seccion="Noticias"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Config."
                        Icono="iconsettings.png"
                        GrupoPermisos="Configuracion"
                        Ruta="//ConfiguracionPage"
                        Seccion="Configuracion"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Sin conexión"
                        Icono="iconoffline.png"
                        Interfaz="datosSinConexionPage"
                        Ruta="//DatosSinConexionPage"
                        Seccion="DatosOffline"
                        EsMovil="True" />

                    <VerticalStackLayout
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        HeightRequest="68"
                        MinimumHeightRequest="68"
                        Padding="2,6,2,5"
                        Spacing="2"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image Source="iconloginout.png" HeightRequest="24" WidthRequest="24" MinimumHeightRequest="24" MinimumWidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label
                            Text="Salir"
                            FontSize="11.5"
                            FontFamily="MontserratMedium"
                            TextColor="{StaticResource RedDelete}"
                            MaxLines="2"
                            LineBreakMode="WordWrap"
                            LineHeight="0.95"
                            MinimumHeightRequest="28"
                            VerticalTextAlignment="Center"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </FlexLayout>
            </Border>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
