<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:services="clr-namespace:CONATRADEC.Services">

    <ControlTemplate x:Key="FooterTemplate">
        <Grid
            RowDefinitions="*,Auto"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.Behaviors>
                <controls:ResponsiveNavigationLayoutBehavior />
            </Grid.Behaviors>

            <!-- =====================================================
                 NAVEGACIÓN LATERAL: WINDOWS AMPLIO
                 Se conserva exactamente la navegación y permisos.
                 ===================================================== -->
            <Border
                AutomationId="DesktopNavigation"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="False"
                Padding="16,18,16,16"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceNavigation}, Dark={StaticResource SurfaceNavigationDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1">

                <Border.Shadow>
                    <Shadow
                        Brush="#14231E"
                        Offset="3,0"
                        Radius="18"
                        Opacity="0.08" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

                    <!-- Marca -->
                    <Border
                        Grid.Row="0"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light=#F4F8F6, Dark={StaticResource SurfaceMutedDark}}"
                        Stroke="{AppThemeBinding Light=#DDE9E4, Dark={StaticResource BorderSoftDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">

                        <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="4"
                                BackgroundColor="White"
                                Stroke="#D9E5E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Center">
                                <Image
                                    Source="logocontradec.png"
                                    Aspect="AspectFit" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0"
                                VerticalOptions="Center">
                                <Label
                                    Text="ConatraCafé Soil"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    Text="Gestión técnica de suelos"
                                    Margin="0,2,0,0"
                                    FontFamily="MontserratMedium"
                                    FontSize="10.5"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Opciones principales -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="0,8,0,0"
                        Spacing="7">

                        <Label
                            Text="NAVEGACIÓN"
                            Margin="12,0,0,4"
                            FontFamily="MontserratBold"
                            FontSize="9.5"
                            CharacterSpacing="1.1"
                            TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />

                        <controls:AppNavigationMenuItem
                            Texto="Inicio"
                            Icono="iconhome.png"
                            Interfaz="MainPage"
                            Ruta="//MainPage"
                            Seccion="Inicio" />

                        <controls:AppNavigationMenuItem
                            Texto="Inspección fitosanitaria"
                            Icono="iconcultivo.png"
                            GrupoPermisos="InspeccionFitosanitaria"
                            Ruta="{x:Static services:DiagnosticoIARoutes.RutaModulo}"
                            Seccion="Inspeccion" />

                        <controls:AppNavigationMenuItem
                            Texto="Álbum de fotos"
                            Icono="iconalbum.png"
                            Interfaz="albumFotosPage"
                            Ruta="albumFotosPage"
                            Seccion="Album" />

                        <controls:AppNavigationMenuItem
                            Texto="Noticias"
                            Icono="iconnews.png"
                            Interfaz="noticiasPage"
                            Ruta="//noticiasPage"
                            Seccion="Noticias" />

                        <controls:AppNavigationMenuItem
                            Texto="Configuración"
                            Icono="iconsettings.png"
                            GrupoPermisos="Configuracion"
                            Ruta="//ConfiguracionPage"
                            Seccion="Configuracion" />

                        <controls:AppNavigationMenuItem
                            Texto="Sin conexión"
                            Icono="iconoffline.png"
                            Interfaz="datosSinConexionPage"
                            Ruta="//DatosSinConexionPage"
                            Seccion="DatosOffline" />
                    </VerticalStackLayout>

                    <!-- Cerrar sesión -->
                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <BoxView
                            HeightRequest="1"
                            Color="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                            Margin="0,0,0,2" />

                        <Border
                            HeightRequest="50"
                            MinimumHeightRequest="50"
                            Padding="13,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="28,*" ColumnSpacing="11">
                                <Image
                                    Source="iconloginout.png"
                                    HeightRequest="23"
                                    WidthRequest="23"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="Cerrar sesión"
                                    FontFamily="MontserratBold"
                                    FontSize="13"
                                    TextColor="{StaticResource RedDelete}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Contenido de la página -->
            <ContentPresenter
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}" />

            <!-- =====================================================
                 NAVEGACIÓN INFERIOR: MÓVIL, TABLET Y WINDOWS ESTRECHO
                 ===================================================== -->
            <Border
                AutomationId="CompactNavigation"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="True"
                Padding="3,3,3,5"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceNavigation}, Dark={StaticResource SurfaceNavigationDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1">

                <Border.Shadow>
                    <Shadow
                        Brush="#14231E"
                        Offset="0,-3"
                        Radius="14"
                        Opacity="0.09" />
                </Border.Shadow>

                <FlexLayout
                    Direction="Row"
                    AlignItems="Stretch"
                    JustifyContent="SpaceBetween">

                    <FlexLayout.Behaviors>
                        <controls:MobileNavigationBarBehavior />
                    </FlexLayout.Behaviors>

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Inicio"
                        Icono="iconhome.png"
                        Interfaz="MainPage"
                        Ruta="//MainPage"
                        Seccion="Inicio"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Inspección"
                        Icono="iconcultivo.png"
                        GrupoPermisos="InspeccionFitosanitaria"
                        Ruta="{x:Static services:DiagnosticoIARoutes.RutaModulo}"
                        Seccion="Inspeccion"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Álbum"
                        Icono="iconalbum.png"
                        Interfaz="albumFotosPage"
                        Ruta="albumFotosPage"
                        Seccion="Album"
                        EsMovil="True" />

                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Noticias"
                        Icono="iconnews.png"
                        Interfaz="noticiasPage"
                        Ruta="//noticiasPage"
                        Seccion="Noticias"
                        EsMovil="True" />

                    <!--
                        En móvil se concentran las herramientas secundarias y
                        el cierre de sesión dentro de Configuración. Con cinco
                        accesos principales la barra mantiene separación,
                        legibilidad y áreas táctiles cómodas.
                    -->
                    <controls:AppNavigationMenuItem
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="0"
                        Texto="Configuración"
                        Icono="iconsettings.png"
                        GrupoPermisos="ConfiguracionMovil"
                        Ruta="//ConfiguracionPage"
                        Seccion="Configuracion"
                        EsMovil="True" />
                </FlexLayout>
            </Border>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
