<?xml version="1.0" encoding="UTF-8" ?>

<Application
    x:Class="CONATRADEC.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CONATRADEC">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="Resources/Styles/Colors.xaml" />

                <ResourceDictionary
                    Source="Resources/Styles/Styles.xaml" />

                <!--
                    Estilos estandarizados para mensajes de validación,
                    campos inválidos y resúmenes dentro de las pantallas.
                -->
                <ResourceDictionary
                    Source="Resources/Styles/ValidationStyles.xaml" />

                <ResourceDictionary
                    Source="/Resources/Styles/Template.xaml" />

                <!--
                    Sistema visual moderno de CONATRADEC.
                    Se carga al final para que las páginas nuevas puedan reutilizar
                    los estilos sin alterar la lógica existente.
                -->
                <ResourceDictionary
                    Source="Resources/Styles/ModernTheme.xaml" />

                <!--
                    Compatibilidad visual para las pantallas históricas del
                    flujo de análisis y cálculos. Se carga al final para que
                    las claves antiguas adopten el sistema visual moderno.
                -->
                <ResourceDictionary
                    Source="Resources/Styles/AnalysisTheme.xaml" />

                <!--
                    Estilos específicos del flujo de inspección fitosanitaria.
                    No utiliza estilos implícitos para no afectar otros módulos.
                -->
                <ResourceDictionary
                    Source="Resources/Styles/InspectionTheme.xaml" />

                <!--
                    Normalización global de Picker.
                    Se carga al final para corregir el recorte vertical en WinUI
                    sin modificar bindings, eventos, validaciones ni lógica.
                -->
                <ResourceDictionary
                    Source="Resources/Styles/PickerTheme.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
