<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.ResultadoAnalisisSueloPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resultado del análisis"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ScrollView HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout
            Padding="{OnIdiom Phone='14,14,14,24', Tablet='22,18,22,28', Desktop='28,22,28,32'}"
            Spacing="14"
            MaximumWidthRequest="1120"
            HorizontalOptions="Center">

            <!-- Encabezado -->
            <Border Style="{StaticResource ModernHeroCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Border
                        WidthRequest="50"
                        HeightRequest="50"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        VerticalOptions="Start">
                        <Image
                            Source="iconrequerimentoanual.png"
                            WidthRequest="26"
                            HeightRequest="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label
                            Text="{Binding TituloResultado}"
                            Style="{StaticResource ModernPageTitle}" />

                        <Label
                            Text="Resultado preliminar del análisis de suelo y requerimientos utilizados por los cálculos complementarios."
                            Style="{StaticResource ModernPageSubtitle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Recomendación general -->
            <Border Style="{StaticResource AnalysisPanel}">
                <VerticalStackLayout Spacing="11">
                    <Label
                        Text="Recomendación general"
                        Style="{StaticResource ModernSectionTitle}" />

                    <Label
                        Text="{Binding RecomendacionGeneral}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        LineBreakMode="WordWrap" />

                    <Border Style="{StaticResource ModernInfoBanner}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="{StaticResource color_Verde}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 9">
                                <Label
                                    Text="i"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding SugerenciaSiguienteCalculo}"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        IsVisible="{Binding TieneObservaciones}"
                        Spacing="7">
                        <Label
                            Text="Observaciones"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            FontSize="14"
                            TextColor="{StaticResource color_Cafe}" />

                        <VerticalStackLayout
                            Spacing="7"
                            BindableLayout.ItemsSource="{Binding Observaciones}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernWarningBanner}">
                                        <Label
                                            Text="{Binding .}"
                                            TextColor="{AppThemeBinding Light=#7C4A24, Dark=#F1C7A8}"
                                            FontSize="12"
                                            LineBreakMode="WordWrap" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Datos base -->
            <Border Style="{StaticResource AnalysisPanel}">
                <VerticalStackLayout Spacing="13">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Datos base del cálculo" Style="{StaticResource ModernSectionTitle}" />
                        <Label Text="Resumen de los valores generales recibidos para este análisis." Style="{StaticResource ModernCaption}" />
                    </VerticalStackLayout>

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="9"
                        ColumnSpacing="9">

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tipo de cultivo" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding TipoCultivo}" FontFamily="MontserratBold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tipo de análisis" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding TipoAnalisisSuelo}" FontFamily="MontserratBold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="QQ oro" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding CantidadQuintalesOro, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Verde}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tamaño finca" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding TamanoFinca, StringFormat='{0:N2} mz'}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Verde}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="pH" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding Ph, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Acidez total" Style="{StaticResource ModernFieldLabel}" />
                                <Label Text="{Binding AcidezTotal, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Cafe}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Requerimientos por elemento -->
            <VerticalStackLayout
                IsVisible="{Binding TieneElementos}"
                Spacing="10">

                <VerticalStackLayout Spacing="3">
                    <Label Text="Requerimientos por elemento" Style="{StaticResource ModernSectionTitle}" />
                    <Label Text="Ordenados según la prioridad calculada para el suelo y la producción." Style="{StaticResource ModernCaption}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource ModernInfoBanner}">
                    <VerticalStackLayout Spacing="9">
                        <Label
                            Text="{Binding TextoElementosIncluidos}"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                            LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button
                                Grid.Column="0"
                                Text="Incluir todos"
                                Command="{Binding IncluirTodosElementosCommand}"
                                Style="{StaticResource ModernPrimaryButton}" />

                            <Button
                                Grid.Column="1"
                                Text="Excluir todos"
                                Command="{Binding ExcluirTodosElementosCommand}"
                                Style="{StaticResource ModernNeutralButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Son pocos elementos químicos; se conserva BindableLayout para evitar una lista anidada. -->
                <VerticalStackLayout
                    Spacing="10"
                    BindableLayout.ItemsSource="{Binding Elementos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCatalogCard}">
                                <VerticalStackLayout Spacing="11">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            BackgroundColor="{StaticResource color_Verde}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="{Binding SimboloElementoQuimico}"
                                                TextColor="White"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding NombreElementoQuimico}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding SimboloElementoQuimico}"
                                                Style="{StaticResource ModernCaption}" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding Clasificacion}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            Padding="8,4"
                                            TextColor="White"
                                            BackgroundColor="#6B7280"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Clasificacion}" Value="MUY_BAJO">
                                                    <Setter Property="BackgroundColor" Value="#DC2626" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Clasificacion}" Value="MEDIO_BAJO">
                                                    <Setter Property="BackgroundColor" Value="#F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Clasificacion}" Value="EXCESIVO">
                                                    <Setter Property="BackgroundColor" Value="#7C3AED" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Clasificacion}" Value="ADECUADO">
                                                    <Setter Property="BackgroundColor" Value="#16A34A" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="8"
                                        ColumnSpacing="8">

                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Cantidad en suelo" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding CantidadConvertidaLbMz, StringFormat='{0:N2} lb/Mz'}" FontFamily="MontserratBold" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Requerimiento" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding RequerimientoCalculado, StringFormat='{0:N2} lb/Mz'}" FontFamily="MontserratBold" FontSize="12" TextColor="{StaticResource color_Verde}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Rango mínimo" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding RangoMinimoLbMz, StringFormat='{0:N2} lb/Mz'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Rango máximo" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding RangoMaximoLbMz, StringFormat='{0:N2} lb/Mz'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Extracción / QQ" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding ExtraccionPorQQOro, StringFormat='{0:N2}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Extracción producción" Style="{StaticResource ModernFieldLabel}" />
                                                <Label Text="{Binding ExtraccionPorProduccion, StringFormat='{0:N2}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Label
                                        Text="{Binding Observacion}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        LineBreakMode="WordWrap" />

                                    <Border Style="{StaticResource AnalysisSoftPanel}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                            <CheckBox
                                                Grid.Column="0"
                                                Color="{StaticResource color_Verde}"
                                                IsChecked="{Binding IncluirEnCalculosComplementarios, Mode=TwoWay}"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label
                                                    Text="Incluir en cálculos complementarios"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    LineBreakMode="WordWrap" />
                                                <Label
                                                    Text="Afecta Balance y Fertilización mixta; el elemento permanece en el requerimiento anual."
                                                    Style="{StaticResource ModernCaption}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Selección de cálculos opcionales -->
            <Border Style="{StaticResource AnalysisPanel}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Cálculos opcionales" Style="{StaticResource ModernSectionTitle}" />
                        <Label
                            Text="Seleccione uno o varios cálculos. Si no selecciona ninguno, se guardará únicamente el requerimiento anual."
                            Style="{StaticResource ModernPageSubtitle}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource AnalysisSoftPanel}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <CheckBox Grid.Column="0" Color="{StaticResource color_Verde}" IsChecked="{Binding CalcularBalanceFormula}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Balance de fórmula" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Calcula la fórmula comercial según los requerimientos detectados." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AnalysisSoftPanel}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <CheckBox Grid.Column="0" Color="{StaticResource color_Cafe}" IsChecked="{Binding CalcularEnmiendaCalcarea}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Enmienda calcárea" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Permite evaluar y corregir la acidez del suelo cuando corresponda." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AnalysisSoftPanel}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <CheckBox Grid.Column="0" Color="{StaticResource color_Amarillo}" IsChecked="{Binding CalcularFertilizacionMixta}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Fertilización mixta" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Combina fuentes y criterios de fertilización según el análisis obtenido." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border
                        IsVisible="{Binding TieneMensajeSeleccionCalculo}"
                        Style="{StaticResource ModernDangerBanner}">
                        <Label
                            Text="{Binding MensajeSeleccionCalculo}"
                            TextColor="{StaticResource RedDelete}"
                            FontSize="12"
                            LineBreakMode="WordWrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            Grid.Column="0"
                            Text="Volver"
                            Command="{Binding VolverCommand}"
                            Style="{StaticResource ModernNeutralButton}" />

                        <Button
                            Grid.Column="1"
                            Text="{Binding TextoBotonContinuar}"
                            Command="{Binding ProcesarSeleccionCommand}"
                            Style="{StaticResource ModernPrimaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="8" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
