<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.TerrenoBusquedaIAPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!--
                CollectionView es la única superficie vertical desplazable.
                Evita el ScrollView + CollectionView anidado de la versión anterior
                y conserva la virtualización cuando existen muchos terrenos.
            -->
            <CollectionView
                x:Name="TerrenosCollection"
                ItemsSource="{Binding Resultados}"
                SelectionMode="None"
                IsVisible="True"
                Margin="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout
                        Spacing="14"
                        MaximumWidthRequest="1120"
                        HorizontalOptions="Center">

                        <controls:InspectionHeader
                            Title="Buscar terreno"
                            Subtitle="Localice el terreno por código, propietario, ubicación, dirección o extensión."
                            BackText="← Nueva inspección"
                            BackCommand="{Binding RegresarCommand}"
                            PrimaryText="Limpiar"
                            PrimaryCommand="{Binding LimpiarCommand}"
                            IsPrimaryVisible="True"
                            PrimaryBackgroundColor="#EEF2F0"
                            PrimaryTextColor="#263A35" />

                        <Border Style="{StaticResource InspectionCard}">
                            <VerticalStackLayout Spacing="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Búsqueda general" Style="{StaticResource InspectionTitle}" />
                                    <Label Text="Puede escribir una referencia general o combinar filtros avanzados." Style="{StaticResource InspectionSubtitle}" />
                                </VerticalStackLayout>

                                <Border Style="{StaticResource InspectionInputBorder}">
                                    <Entry
                                        Placeholder="Código, propietario, municipio, departamento o dirección"
                                        Text="{Binding Texto}"
                                        ReturnType="Search"
                                        ReturnCommand="{Binding BuscarCommand}"
                                        BackgroundColor="Transparent" />
                                </Border>

                                <Label Text="Filtros avanzados" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource color_Verde}" />

                                <Grid
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto,Auto,Auto', Default='Auto,Auto,Auto'}"
                                    ColumnSpacing="10"
                                    RowSpacing="10">

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InspectionInputBorder}">
                                        <Entry Placeholder="Código del terreno" Text="{Binding Codigo}" BackgroundColor="Transparent" />
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Style="{StaticResource InspectionInputBorder}">
                                        <Entry Placeholder="Nombre del propietario" Text="{Binding Propietario}" BackgroundColor="Transparent" />
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=2, Default=1}" Grid.Column="0" Style="{StaticResource InspectionInputBorder}">
                                        <Entry Placeholder="Identificación del propietario" Text="{Binding IdentificacionPropietario}" BackgroundColor="Transparent" />
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=3, Default=1}" Grid.Column="{OnIdiom Phone=0, Default=1}" Style="{StaticResource InspectionInputBorder}">
                                        <Entry Placeholder="País, departamento o municipio" Text="{Binding Ubicacion}" BackgroundColor="Transparent" />
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=4, Default=2}" Grid.Column="0" Style="{StaticResource InspectionInputBorder}">
                                        <Entry Placeholder="Dirección o referencia" Text="{Binding Direccion}" BackgroundColor="Transparent" />
                                    </Border>
                                    <Grid
                                        Grid.Row="{OnIdiom Phone=5, Default=2}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="8">
                                        <Border Grid.Column="0" Style="{StaticResource InspectionInputBorder}">
                                            <Entry Placeholder="Mz mín." Keyboard="Numeric" Text="{Binding ExtensionMinimaTexto}" BackgroundColor="Transparent" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource InspectionInputBorder}">
                                            <Entry Placeholder="Mz máx." Keyboard="Numeric" Text="{Binding ExtensionMaximaTexto}" BackgroundColor="Transparent" />
                                        </Border>
                                    </Grid>
                                </Grid>

                                <Button
                                    Text="Buscar terrenos"
                                    Command="{Binding BuscarCommand}"
                                    Style="{StaticResource InspectionPrimaryButton}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Style="{StaticResource InspectionWarningPanel}"
                            IsVisible="{Binding TieneMensajeEstado}">
                            <Label Text="{Binding MensajeEstado}" TextColor="#6B5710" LineBreakMode="WordWrap" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Resultados" Style="{StaticResource InspectionTitle}" />
                                <Label Text="Seleccione el terreno que corresponde a la inspección." Style="{StaticResource InspectionSubtitle}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource InspectionGreenPanel}" Padding="10,6" VerticalOptions="Center">
                                <Label Text="{Binding ResumenResultados}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                            </Border>
                        </Grid>

                        <Border
                            Style="{StaticResource InspectionSoftPanel}"
                            IsVisible="{Binding SinResultados}"
                            Margin="0,0,0,4">
                            <Label
                                Text="No se encontraron terrenos con los filtros indicados."
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource InspectionSubtitle}" />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TerrenoBusquedaIAItem">
                        <Border
                            Padding="14"
                            Margin="0,0,0,10"
                            MaximumWidthRequest="1120"
                            HorizontalOptions="Center"
                            Style="{StaticResource InspectionCard}">
                            <Grid
                                ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                ColumnSpacing="14"
                                RowSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding CodigoTerreno}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                                    <Label Text="{Binding PropietarioTexto}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding UbicacionTexto}" Style="{StaticResource InspectionSubtitle}" />
                                    <Label Text="{Binding DireccionTerreno}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding ExtensionTexto}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource color_Cafe}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Text="Seleccionar terreno"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource InspectionPrimaryButton}"
                                    HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                    MinimumWidthRequest="{OnIdiom Phone=0, Default=170}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Border
                        Margin="0,8,0,18"
                        Padding="12"
                        MaximumWidthRequest="700"
                        HorizontalOptions="Center"
                        Style="{StaticResource InspectionSoftPanel}"
                        IsVisible="{Binding MostrarPaginador}">
                        <!--
                            FlexLayout permite que el paginador se reorganice
                            también en ventanas Windows angostas, no solo según
                            el DeviceIdiom del dispositivo.
                        -->
                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Center"
                            JustifyContent="Center">
                            <Button
                                Text="← Anterior"
                                Command="{Binding PaginaAnteriorCommand}"
                                IsEnabled="{Binding PuedeIrAnterior}"
                                Style="{StaticResource InspectionNeutralButton}"
                                MinimumWidthRequest="120"
                                Margin="4" />
                            <Label
                                Text="{Binding TextoPaginacion}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                MinimumWidthRequest="130"
                                Margin="12,4" />
                            <Button
                                Text="Siguiente →"
                                Command="{Binding PaginaSiguienteCommand}"
                                IsEnabled="{Binding PuedeIrSiguiente}"
                                Style="{StaticResource InspectionNeutralButton}"
                                MinimumWidthRequest="120"
                                Margin="4" />
                        </FlexLayout>
                    </Border>
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                BackgroundColor="#66000000"
                IsVisible="{Binding IsBusy}"
                InputTransparent="False"
                ZIndex="60">
                <Border Style="{StaticResource InspectionOverlayCard}">
                    <VerticalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" WidthRequest="42" HeightRequest="42" />
                        <Label Text="Buscando terrenos..." HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Aplicando los filtros y preparando los resultados." HorizontalTextAlignment="Center" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
