<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rangoNutrientePage"
    x:Name="RangoPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">
                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image
                            Source="iconpermission.png"
                            WidthRequest="62"
                            HeightRequest="62"
                            Opacity="0.68" />
                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="20"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Su usuario no tiene permiso para consultar los rangos nutricionales."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="Regresar a configuración"
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding RegresarConfiguracionCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='12,12,12,18', Tablet='18,16,18,22', Desktop='24,20,24,26'}">
                <RefreshView
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">
                    <CollectionView
                        ItemsSource="{Binding List}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="CultivosGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.Header>
                            <VerticalStackLayout Padding="0,0,0,14" Spacing="12">
                                <controls:ResponsiveCatalogHeader
                                    Title="Rangos nutricionales"
                                    Subtitle="Seleccione un cultivo para administrar sus intervalos por elemento químico."
                                    BackText="← Configuración"
                                    BackCommand="{Binding RegresarConfiguracionCommand}"
                                    PrimaryText="+ Nuevo cultivo"
                                    PrimaryCommand="{Binding AddCategoryCommand}"
                                    IsPrimaryVisible="{Binding CanAdd}" />

                                <controls:ResponsiveSearchPanel
                                    Placeholder="Buscar por cultivo o descripción"
                                    SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                                    SummaryText="{Binding ResumenResultados}"
                                    SearchCommand="{Binding BuscarCommand}"
                                    ClearCommand="{Binding LimpiarFiltrosCommand}" />

                                <Border
                                    IsVisible="{Binding TieneMensaje}"
                                    Style="{StaticResource ModernWarningBanner}">
                                    <Label Text="{Binding Mensaje}" Style="{StaticResource ModernPageSubtitle}" />
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.EmptyView>
                            <Grid Padding="20,30">
                                <Border
                                    IsVisible="{Binding MostrarVacio}"
                                    Style="{StaticResource ModernEmptyStateCard}">
                                    <VerticalStackLayout Spacing="9" HorizontalOptions="Center">
                                        <Border Style="{StaticResource ModernIconTile}">
                                            <Label
                                                Text="RN"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            Text="No se encontraron cultivos"
                                            Style="{StaticResource ModernSectionTitle}"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Cambie la búsqueda o registre un nuevo tipo de cultivo."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RangoNutrienteCategoriaItem">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="204">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Border
                                                Style="{StaticResource ModernIconTile}"
                                                WidthRequest="52"
                                                HeightRequest="52">
                                                <Label
                                                    Text="TC"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding NombreCategoria}"
                                                    Style="{StaticResource ModernSectionTitle}"
                                                    FontSize="15"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding DescripcionMostrar}"
                                                    Style="{StaticResource ModernCaption}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border Grid.Row="1" Style="{StaticResource ModernMetricSurface}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="RANGOS CONFIGURADOS" Style="{StaticResource ModernCaption}" FontSize="9.5" />
                                                <Label
                                                    Text="{Binding AportesTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Grid Grid.Row="2" ColumnDefinitions="2*,*,*" ColumnSpacing="7">
                                            <Button
                                                Text="Abrir rangos"
                                                Style="{StaticResource ModernPrimaryButton}"
                                                HeightRequest="44"
                                                Command="{Binding Source={x:Reference RangoPageRoot}, Path=BindingContext.OpenCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                IsVisible="{Binding Source={x:Reference RangoPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference RangoPageRoot}, Path=BindingContext.EditCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                IsVisible="{Binding Source={x:Reference RangoPageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference RangoPageRoot}, Path=BindingContext.DeleteCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="10,16,10,24" Spacing="8" HorizontalOptions="Center">
                                <ActivityIndicator
                                    IsRunning="{Binding CargandoMas}"
                                    IsVisible="{Binding CargandoMas}"
                                    Color="{StaticResource color_Verde}" />
                                <Label
                                    IsVisible="{Binding MostrarFinLista}"
                                    Text="Fin del listado"
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    ZIndex="100"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#28000000">
                    <Border
                        Padding="18,14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource color_Verde}"
                                WidthRequest="24"
                                HeightRequest="24" />
                            <Label
                                Text="Cargando cultivos..."
                                VerticalOptions="Center"
                                FontFamily="MontserratBold"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
