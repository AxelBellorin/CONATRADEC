<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumRegistroFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                x:Name="FormularioStack"
                Padding="12,10,12,26"
                MaximumWidthRequest="1040"
                HorizontalOptions="Fill"
                Spacing="14">

                <Border Style="{StaticResource ModernHeroCard}" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="8">
                        <Button
                            Text="← Regresar"
                            Command="{Binding CancelarCommand}"
                            IsEnabled="{Binding NotIsBusy}"
                            Style="{StaticResource ModernLinkButton}"
                            HorizontalOptions="Start"
                            HeightRequest="36"
                            Padding="4,4" />
                        <Label Text="{Binding TituloPagina}" Style="{StaticResource ModernPageTitle}" />
                        <Label
                            Text="Defina la identificación y la información técnica. Las fotografías se administran después de guardar."
                            Style="{StaticResource ModernPageSubtitle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ModernFormCard}" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Identificación" Style="{StaticResource ModernSectionTitle}" TextColor="{StaticResource color_Verde}" />
                            <Label Text="Datos principales de la subcategoría del álbum." Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Categoría *" Style="{StaticResource ModernFieldLabel}" />
                            <Border Style="{StaticResource ModernInputBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TieneErrorCategoria}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Picker
                                    ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding CategoriaSeleccionada}"
                                    ItemDisplayBinding="{Binding NombreCategoria}"
                                    Title="Seleccione una categoría"
                                    Style="{StaticResource ModernPicker}" />
                            </Border>
                            <Label Text="{Binding ErrorCategoria}" IsVisible="{Binding TieneErrorCategoria}" Style="{StaticResource ValidationMessageStyle}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="IdentificacionCamposGrid"
                            HorizontalOptions="Fill"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <VerticalStackLayout x:Name="SubcategoriaCampo" Spacing="5">
                                <Label Text="Subcategoría específica *" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorTitulo}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Text="{Binding Titulo}"
                                        MaxLength="200"
                                        Placeholder="Ejemplo: Mancha de hierro"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                                <Label Text="{Binding ErrorTitulo}" IsVisible="{Binding TieneErrorTitulo}" Style="{StaticResource ValidationMessageStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="NombreCientificoCampo" Grid.Column="1" Spacing="5">
                                <Label Text="Nombre científico" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorNombreCientifico}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Text="{Binding NombreCientifico}"
                                        MaxLength="200"
                                        Placeholder="Ejemplo: Cercospora coffeicola"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                                <Label Text="{Binding ErrorNombreCientifico}" IsVisible="{Binding TieneErrorNombreCientifico}" Style="{StaticResource ValidationMessageStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Descripción general *" Style="{StaticResource ModernFieldLabel}" />
                            <Border Style="{StaticResource ModernInputBorder}" Padding="10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TieneErrorDescripcion}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Explique de forma general este diagnóstico o clasificación."
                                    MinimumHeightRequest="115"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>
                            <Label Text="{Binding ErrorDescripcion}" IsVisible="{Binding TieneErrorDescripcion}" Style="{StaticResource ValidationMessageStyle}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ModernFormCard}" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información técnica" Style="{StaticResource ModernSectionTitle}" TextColor="{StaticResource color_Cafe}" />
                            <Label Text="Estos campos se mostrarán en el detalle de la subcategoría." Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <Grid
                            HorizontalOptions="Fill"
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*"
                            RowSpacing="12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Características" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}" Padding="10">
                                    <Editor
                                        Text="{Binding Caracteristicas}"
                                        MinimumHeightRequest="95"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="5">
                                <Label Text="Síntomas" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}" Padding="10">
                                    <Editor
                                        Text="{Binding Sintomas}"
                                        MinimumHeightRequest="95"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid
                            HorizontalOptions="Fill"
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*"
                            RowSpacing="12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Causas" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}" Padding="10">
                                    <Editor
                                        Text="{Binding Causas}"
                                        MinimumHeightRequest="95"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="5">
                                <Label Text="Recomendaciones" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInfoBanner}" Padding="10">
                                    <Editor
                                        Text="{Binding Recomendaciones}"
                                        MinimumHeightRequest="95"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Observaciones" Style="{StaticResource ModernFieldLabel}" />
                            <Border Style="{StaticResource ModernWarningBanner}" Padding="10">
                                <Editor
                                    Text="{Binding Observaciones}"
                                    MinimumHeightRequest="90"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    x:Name="AccionesFormularioGrid"
                    HorizontalOptions="Fill"
                    ColumnDefinitions="*,*"
                    RowSpacing="8"
                    ColumnSpacing="10">
                    <Button
                        x:Name="CancelarFormularioButton"
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{StaticResource ModernNeutralButton}"
                        HeightRequest="50" />
                    <Button
                        x:Name="GuardarFormularioButton"
                        Grid.Column="1"
                        Text="Guardar subcategoría"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HeightRequest="50" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#520B1511">
            <Border
                Padding="22,18"
                MaximumWidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="38"
                        HeightRequest="38" />
                    <Label
                        Text="Procesando subcategoría..."
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Espere mientras se completa la operación." HorizontalTextAlignment="Center" Style="{StaticResource ModernCaption}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
