<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.ResultadosAnalisisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resultados del Análisis"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView
        x:Name="UserPage"
        ControlTemplate="{StaticResource FooterTemplate}">

        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout
                Padding="{OnIdiom Phone='14,14,14,24', Tablet='22,18,22,28', Desktop='28,22,28,32'}"
                Spacing="14"
                MaximumWidthRequest="1120"
                HorizontalOptions="Center">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                        <Border
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14">
                            <Image
                                Source="iconrequerimentoanual.png"
                                WidthRequest="25"
                                HeightRequest="25"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Requerimiento anual" Style="{StaticResource ModernPageTitle}" />
                            <Label Text="Resumen del análisis y cantidades requeridas por elemento." Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Navegación secundaria del cálculo. Se desplaza con el contenido. -->
                <Border Style="{StaticResource AnalysisPanel}">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Cálculos del análisis" Style="{StaticResource ModernSectionTitle}" />

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Button
                                    Text="Requerimiento anual"
                                    ImageSource="iconrequerimentoanual.png"
                                    ContentLayout="Left,7"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Clicked="OnMenuReqTapped" />

                                <Button
                                    Text="Balance"
                                    ImageSource="iconbalanceformula.png"
                                    ContentLayout="Left,7"
                                    Style="{StaticResource ModernNeutralButton}"
                                    Clicked="OnMenuBalanceTapped" />

                                <Button
                                    Text="Enmienda"
                                    ImageSource="iconenmiendacalcaeras.png"
                                    ContentLayout="Left,7"
                                    Style="{StaticResource ModernCoffeeButton}"
                                    Clicked="OnMenuEnmiendasTapped" />

                                <Button
                                    Text="Fertilización mixta"
                                    ImageSource="iconfertilizacionmixta.png"
                                    ContentLayout="Left,7"
                                    Style="{StaticResource ModernNeutralButton}"
                                    Clicked="OnMenuFertMixtaTapped" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AnalysisPanel}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Datos generales" Style="{StaticResource ModernSectionTitle}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="9"
                            ColumnSpacing="9">

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Fecha" Style="{StaticResource ModernFieldLabel}" />
                                    <Label
                                        x:Name="FechaLabel"
                                        Text="01/01/2025"
                                        FontFamily="MontserratBold"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Deficiencia del suelo" Style="{StaticResource ModernFieldLabel}" />
                                    <Label
                                        x:Name="DeficienciaLabel"
                                        Text="Nitrógeno"
                                        FontFamily="MontserratBold"
                                        FontSize="13"
                                        TextColor="{StaticResource color_Cafe}"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource AnalysisSoftPanel}">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Breve descripción" Style="{StaticResource ModernFieldLabel}" />
                                    <Label
                                        x:Name="DescripcionLabel"
                                        Text="Suelo con baja disponibilidad de N; considerar fertilización nitrogenada y enmiendas orgánicas."
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AnalysisPanel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Producción objetivo" Style="{StaticResource ModernSectionTitle}" />
                        <Label Text="Indique cuánto desea producir para actualizar la referencia del requerimiento." Style="{StaticResource ModernCaption}" />
                        <Border Style="{StaticResource ModernInputBorder}">
                            <Entry
                                x:Name="ProduccionEntry"
                                Placeholder="Cantidad (QQ)"
                                Keyboard="Numeric"
                                Style="{StaticResource ModernEntry}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AnalysisPanel}">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="Resultados" Style="{StaticResource ModernSectionTitle}" />
                        <Label Text="Deslice horizontalmente la tabla en pantallas pequeñas." Style="{StaticResource ModernCaption}" />

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                            <Grid
                                ColumnDefinitions="150,145,155,90"
                                RowDefinitions="40,42,42,42,42,42"
                                RowSpacing="1"
                                ColumnSpacing="1"
                                MinimumWidthRequest="540">

                                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource color_Verde}" Stroke="Transparent" Padding="9">
                                    <Label Text="Elemento" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="11" TextColor="White" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource color_Verde}" Stroke="Transparent" Padding="9">
                                    <Label Text="Cantidad actual" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BackgroundColor="{StaticResource color_Verde}" Stroke="Transparent" Padding="9">
                                    <Label Text="Cantidad necesaria" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" BackgroundColor="{StaticResource color_Verde}" Stroke="Transparent" Padding="9">
                                    <Label Text="Unidad" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="Nitrógeno" Padding="9" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="NitrogenoValueLabel" Text="95.7" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="2" x:Name="NitrogenoNeededLabel" Text="46.2" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="3" x:Name="NitrogenoUnitLabel" Text="lb/Mz" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Potasio" Padding="9" VerticalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="1" x:Name="PotasioValueLabel" Text="108.3" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="2" x:Name="PotasioNeededLabel" Text="108.8" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="3" x:Name="PotasioUnitLabel" Text="lb/Mz" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                                <Label Grid.Row="3" Grid.Column="0" Text="Fósforo" Padding="9" VerticalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="1" x:Name="FosforoValueLabel" Text="18.6" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="2" x:Name="FosforoNeededLabel" Text="3.5" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="3" x:Name="FosforoUnitLabel" Text="lb/Mz" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                                <Label Grid.Row="4" Grid.Column="0" Text="Calcio" Padding="9" VerticalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="1" x:Name="CalcioValueLabel" Text="13.5" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="2" x:Name="CalcioNeededLabel" Text="46.2" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="3" x:Name="CalcioUnitLabel" Text="lb/Mz" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />

                                <Label Grid.Row="5" Grid.Column="0" Text="Magnesio" Padding="9" VerticalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="1" x:Name="MagnesioValueLabel" Text="7.8" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="2" x:Name="MagnesioNeededLabel" Text="66.5" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="3" x:Name="MagnesioUnitLabel" Text="lb/Mz" Padding="9" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            </Grid>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="8" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentView>
</ContentPage>
