<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.FuenteNutrienteEliminadasPage"
    x:Name="PaginaEliminadas"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid Padding="{OnIdiom Phone='12,12,12,18', Tablet='18,16,18,22', Desktop='24,20,24,26'}">
        <Grid
            IsVisible="{Binding CanView}">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    ItemsSource="{Binding Fuentes}"
                    SelectionMode="None">

                    <!--
                        Encabezado, búsqueda y mensaje forman parte del contenido
                        desplazable. No se reparentan controles en ejecución.
                    -->
                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="12"
                            Padding="0,0,0,12">

                            <controls:ResponsiveCatalogHeader
                                Title="Fuentes eliminadas"
                                Subtitle="Reactive fuentes de nutrientes conservando sus datos, clasificación, precio y aportes anteriores."
                                BackText="← Cerrar"
                                BackCommand="{Binding CerrarCommand}"
                                IsPrimaryVisible="False" />

                            <Border Style="{StaticResource ModernFormCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <SearchBar
                                            Placeholder="Buscar una fuente eliminada"
                                            Text="{Binding TextoBusqueda}"
                                            SearchCommand="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernSearchBar}" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label
                                            Text="{Binding Resumen}"
                                            VerticalOptions="Center"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="11.5" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernPrimaryButton}" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarCommand}"
                                            Style="{StaticResource ModernNeutralButton}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="WordWrap" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="FuentesEliminadasGrid"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Grid Padding="12,24">
                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                MaximumWidthRequest="560">
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    Spacing="8">
                                    <Border
                                        Style="{StaticResource ModernIconTile}"
                                        WidthRequest="58"
                                        HeightRequest="58">
                                        <Label
                                            Text="✓"
                                            FontSize="27"
                                            TextColor="{StaticResource color_Verde}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Text="No hay fuentes eliminadas"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Todas las fuentes están activas o no coinciden con la búsqueda actual."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FuenteNutrienteResponse">
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                MinimumHeightRequest="205">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandCoffeeSoft}, Dark={StaticResource BrandCoffeeSoftDark}}"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="FN"
                                                FontSize="17"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding NombreNutriente}"
                                                FontSize="16"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding CategoriaFuenteMostrar}"
                                                FontFamily="MontserratBold"
                                                FontSize="10.5"
                                                TextColor="{StaticResource color_Cafe}" />
                                            <Label
                                                Text="{Binding DescripcionNutriente}"
                                                Style="{StaticResource ModernCaption}"
                                                FontSize="11.5"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource ModernDangerBanner}"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="Eliminada"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="9.5"
                                                TextColor="{StaticResource RedDelete}" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Spacing="7">
                                        <Border
                                            Style="{StaticResource ModernBadgeYellow}"
                                            Padding="9,6">
                                            <Label
                                                Text="{Binding PrecioMostrar}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalTextAlignment="Center" />
                                        </Border>
                                        <Label
                                            Text="{Binding AportesMostrar}"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="11"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="2"
                                        Text="Reactivar registro"
                                        IsVisible="{Binding Source={x:Reference PaginaEliminadas}, Path=BindingContext.CanEdit}"
                                        Command="{Binding Source={x:Reference PaginaEliminadas}, Path=BindingContext.ReactivarCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        HorizontalOptions="Fill" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="{OnIdiom Phone=18, Tablet=22, Desktop=26}" Opacity="0" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Grid
            IsVisible="{Binding MostrarAccesoDenegado}"
            Padding="{OnIdiom Phone=12, Tablet=20, Desktop=24}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">
                    <Image
                        Source="iconpermission.png"
                        WidthRequest="62"
                        HeightRequest="62"
                        Opacity="0.68" />
                    <Label
                        Text="Sin permiso de lectura"
                        Style="{StaticResource ModernSectionTitle}"
                        FontSize="20"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Su usuario no puede consultar las fuentes de nutrientes eliminadas."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Cerrar"
                        Command="{Binding CerrarCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#66000000">
            <Border
                Padding="20,16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Naranja}"
                        WidthRequest="24"
                        HeightRequest="24" />
                    <Label
                        Text="Cargando fuentes eliminadas..."
                        VerticalOptions="Center"
                        FontFamily="MontserratBold"
                        FontSize="11.5"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
