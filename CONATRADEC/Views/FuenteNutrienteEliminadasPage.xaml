<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.FuenteNutrienteEliminadasPage"
    x:Name="PaginaEliminadas"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F6F8F7">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{OnPlatform WinUI='26,22,26,26', Default='16,16,16,22'}" RowSpacing="14">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label
                    Text="Fuentes eliminadas"
                    FontSize="{OnPlatform WinUI=28, Default=24}"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    TextColor="{StaticResource color_Verde}" />
                <Label
                    Text="Reactive registros conservando sus datos y clasificación anteriores."
                    FontSize="13"
                    TextColor="{StaticResource color_GrisOscuro}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="Cerrar"
                Padding="16,10"
                BackgroundColor="#EEF2F0"
                TextColor="{StaticResource color_Verde}"
                CornerRadius="11"
                Command="{Binding CerrarCommand}" />
        </Grid>

        <Border
            Grid.Row="1"
            Padding="12"
            BackgroundColor="White"
            Stroke="#DDE7E3"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 15">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <SearchBar
                    Grid.Row="0"
                    Placeholder="Buscar una fuente eliminada"
                    Text="{Binding TextoBusqueda}"
                    SearchCommand="{Binding BuscarCommand}"
                    BackgroundColor="#F8FAF9"
                    CancelButtonColor="{StaticResource color_Verde}" />

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                    <Label
                        Text="{Binding Resumen}"
                        VerticalOptions="Center"
                        FontSize="12"
                        TextColor="{StaticResource color_GrisOscuro}" />
                    <Button
                        Grid.Column="1"
                        Text="Buscar"
                        Padding="14,8"
                        BackgroundColor="{StaticResource color_Verde}"
                        TextColor="White"
                        CornerRadius="10"
                        Command="{Binding BuscarCommand}" />
                    <Button
                        Grid.Column="2"
                        Text="Limpiar"
                        Padding="14,8"
                        BackgroundColor="#EEF2F0"
                        TextColor="{StaticResource color_Verde}"
                        CornerRadius="10"
                        Command="{Binding LimpiarCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid IsVisible="{Binding MostrarAccesoDenegado}" Padding="24">
                <Border
                    MaximumWidthRequest="620"
                    Padding="26"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label
                            Text="Sin permiso de lectura"
                            FontSize="20"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Negro}" />
                        <Label
                            Text="Su usuario no puede consultar las fuentes eliminadas."
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource color_GrisOscuro}" />
                        <Button
                            Text="Cerrar"
                            Command="{Binding CerrarCommand}"
                            BackgroundColor="{StaticResource color_Verde}"
                            TextColor="White"
                            CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <RefreshView
                IsVisible="{Binding CanView}"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    ItemsSource="{Binding Fuentes}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="FuentesEliminadasGrid"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Grid Padding="30">
                            <VerticalStackLayout
                                IsVisible="{Binding MostrarVacio}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="8">
                                <Border
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    BackgroundColor="#EAF7EF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                    <Label
                                        Text="✓"
                                        FontSize="28"
                                        TextColor="{StaticResource color_Verde}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Text="No hay fuentes eliminadas"
                                    FontSize="18"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="Todos los registros se encuentran activos o no coinciden con la búsqueda."
                                    FontSize="13"
                                    TextColor="{StaticResource color_GrisOscuro}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FuenteNutrienteResponse">
                            <Border
                                Padding="16"
                                MinimumHeightRequest="210"
                                BackgroundColor="White"
                                Stroke="#E5D8D0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16">

                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            BackgroundColor="#F7EEE9"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="FN"
                                                FontSize="17"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding NombreNutriente}"
                                                FontSize="17"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Negro}"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding CategoriaFuenteMostrar}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Cafe}" />
                                            <Label
                                                Text="{Binding DescripcionNutriente}"
                                                FontSize="12"
                                                TextColor="{StaticResource color_GrisOscuro}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="Eliminada"
                                            Padding="9,5"
                                            FontSize="11"
                                            TextColor="#B42318"
                                            BackgroundColor="#FEECEB"
                                            VerticalOptions="Start" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Spacing="7">
                                        <Border
                                            Padding="10,7"
                                            BackgroundColor="#FFF7E6"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9">
                                            <Label
                                                Text="{Binding PrecioMostrar}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalTextAlignment="Center" />
                                        </Border>
                                        <Label
                                            Text="{Binding AportesMostrar}"
                                            FontSize="11"
                                            TextColor="{StaticResource color_GrisOscuro}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="2"
                                        Text="Reactivar registro"
                                        Padding="12,10"
                                        BackgroundColor="{StaticResource color_Verde}"
                                        TextColor="White"
                                        CornerRadius="10"
                                        IsVisible="{Binding Source={x:Reference PaginaEliminadas}, Path=BindingContext.CanEdit}"
                                        Command="{Binding Source={x:Reference PaginaEliminadas}, Path=BindingContext.ReactivarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Border
                IsVisible="{Binding TieneMensaje}"
                Padding="14"
                Margin="16"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                BackgroundColor="#FFF7E6"
                Stroke="#F2C94C"
                StrokeShape="RoundRectangle 12">
                <Label
                    Text="{Binding Mensaje}"
                    FontSize="13"
                    TextColor="{StaticResource color_Negro}" />
            </Border>

            <Grid
                IsVisible="{Binding IsBusy}"
                InputTransparent="True"
                BackgroundColor="#40FFFFFF">
                <Border
                    Padding="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 14">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="True"
                            Color="{StaticResource color_Naranja}" />
                        <Label
                            Text="Cargando registros eliminados..."
                            VerticalOptions="Center"
                            TextColor="{StaticResource color_Negro}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
