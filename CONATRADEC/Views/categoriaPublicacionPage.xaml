<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.categoriaPublicacionPage"
    x:Name="CategoriaPublicacionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Tipos de publicación"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid x:Name="ContenidoPrincipal">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    x:Name="CategoriasCollectionView"
                    ItemsSource="{Binding Categorias}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="CategoriasGridLayout"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <!--
                        Encabezado, búsqueda, mensajes y estado vacío forman parte
                        del desplazamiento natural del catálogo. No se utiliza
                        CollectionView.EmptyView para evitar que WinUI capture la
                        interacción cuando una búsqueda devuelve cero resultados.
                    -->
                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="10"
                            Margin="0,0,0,14">

                            <controls:ResponsiveCatalogHeader
                                Title="Tipos de publicación"
                                Subtitle="Administre las categorías utilizadas para noticias, ofertas y eventos."
                                BackText="← Configuración"
                                BackCommand="{Binding RegresarCommand}"
                                PrimaryText="+ Nuevo tipo"
                                PrimaryCommand="{Binding NuevoCommand}"
                                IsPrimaryVisible="{Binding CanAdd}" />

                            <Border
                                Style="{StaticResource ModernCard}"
                                Padding="8">
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        Placeholder="Buscar por nombre o descripción"
                                        Text="{Binding TextoBusqueda}"
                                        ReturnType="Search"
                                        ReturnCommand="{Binding BuscarCommand}"
                                        ClearButtonVisibility="WhileEditing"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8">
                                    <Button
                                        Grid.Column="0"
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="Fill" />

                                    <Button
                                        Grid.Column="1"
                                        Text="Limpiar"
                                        Command="{Binding LimpiarCommand}"
                                        Style="{StaticResource ModernNeutralButton}"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="Fill" />
                                </Grid>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    Style="{StaticResource ModernPageSubtitle}"
                                    LineBreakMode="WordWrap" />
                            </Border>

                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                InputTransparent="True"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Fill">
                                <VerticalStackLayout
                                    Spacing="6"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="No hay tipos de publicación activos"
                                        Style="{StaticResource ModernSectionTitle}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Cambie la búsqueda o limpie el filtro para volver a consultar."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoriaPublicacionCatalogoResponse">
                            <Border Style="{StaticResource ModernCatalogCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                        <Border
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            Padding="7"
                                            Style="{StaticResource ModernSoftPanel}">
                                            <Border
                                                BackgroundColor="{Binding ColorMuestra}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label
                                                Text="{Binding NombreCategoriaPublicacion}"
                                                FontFamily="MontserratBold"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />

                                            <FlexLayout
                                                Direction="Row"
                                                Wrap="Wrap"
                                                AlignItems="Center">
                                                <Border
                                                    Margin="0,0,5,4"
                                                    Padding="7,3"
                                                    BackgroundColor="{Binding EstadoFondo}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        Text="{Binding EstadoTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="9"
                                                        TextColor="{Binding EstadoTextoColor}" />
                                                </Border>

                                                <Border
                                                    Margin="0,0,5,4"
                                                    Style="{StaticResource ModernBadgeCoffee}">
                                                    <Label
                                                        Text="{Binding Orden, StringFormat='Orden {0}'}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="9"
                                                        TextColor="{StaticResource color_Cafe}" />
                                                </Border>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label
                                        Text="{Binding DescripcionCategoriaPublicacion}"
                                        FontFamily="MontserratMedium"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding PublicacionesTexto}"
                                        Style="{StaticResource ModernCaption}" />

                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center">
                                        <Button
                                            Margin="0,0,6,6"
                                            Text="Editar"
                                            Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.EditarCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.CanEdit}"
                                            Style="{StaticResource ModernUpdateButton}"
                                            MinimumWidthRequest="96" />

                                        <Button
                                            Margin="0,0,6,6"
                                            Text="Desactivar"
                                            Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.DesactivarCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding PuedeDesactivar}"
                                            Style="{StaticResource ModernDangerSoftButton}"
                                            MinimumWidthRequest="105" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False"
                ZIndex="100">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Actualizando tipos de publicación..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">
                    <Label
                        Text="Sin permiso"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para consultar los tipos de publicación."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="← Regresar a Configuración"
                        Command="{Binding RegresarCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
