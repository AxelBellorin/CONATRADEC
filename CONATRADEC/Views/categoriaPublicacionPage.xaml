<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.categoriaPublicacionPage"
    x:Name="CategoriaPublicacionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Tipos de publicación"
    BackgroundColor="#FFF5FF"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid
            x:Name="ContenidoPrincipal"
            RowDefinitions="Auto,*"
            Padding="{OnPlatform WinUI='24,20', Default='14,12'}"
            RowSpacing="12">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button
                    Text="‹ Regresar"
                    Command="{Binding RegresarCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#3B655B"
                    FontFamily="MontserratBold" />

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        Text="Tipos de publicación"
                        FontFamily="MontserratBold"
                        FontSize="{OnPlatform WinUI=27, Default=21}"
                        TextColor="#3B655B" />
                    <Label
                        Text="Administre las categorías de noticias, ofertas y eventos."
                        FontFamily="MontserratMedium"
                        FontSize="11"
                        TextColor="#6B7280" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="Nuevo tipo"
                    Command="{Binding NuevoCommand}"
                    IsVisible="{Binding CanAdd}"
                    BackgroundColor="#3B655B"
                    TextColor="White"
                    FontFamily="MontserratBold"
                    CornerRadius="10"
                    Padding="13,9" />
            </Grid>

            <RefreshView
                Grid.Row="1"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    ItemsSource="{Binding Categorias}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
                            <Border
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 15">
                                <VerticalStackLayout Spacing="9">
                                    <SearchBar
                                        Placeholder="Buscar por nombre o descripción"
                                        Text="{Binding TextoBusqueda}"
                                        SearchCommand="{Binding BuscarCommand}"
                                        FontFamily="MontserratMedium"
                                        BackgroundColor="#F8FAF9" />

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Switch
                                                IsToggled="{Binding IncluirInactivas}"
                                                OnColor="#3B655B" />
                                            <Label
                                                Text="Mostrar inactivos"
                                                FontFamily="MontserratMedium"
                                                FontSize="11"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            BackgroundColor="#3B655B"
                                            TextColor="White"
                                            FontFamily="MontserratBold"
                                            CornerRadius="9" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="#9B552C"
                                            FontFamily="MontserratBold" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Padding="11"
                                BackgroundColor="#FFF7ED"
                                Stroke="#FDBA74"
                                StrokeShape="RoundRectangle 11">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="#9A3412" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoriaPublicacionCatalogoResponse">
                            <Border
                                Padding="13"
                                BackgroundColor="White"
                                Stroke="#E3EAE7"
                                StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                    <Border
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        Padding="7"
                                        BackgroundColor="#F8FAF9"
                                        Stroke="#DDE7E3"
                                        StrokeShape="RoundRectangle 12">
                                        <Border
                                            BackgroundColor="{Binding ColorMuestra}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 7" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <Label
                                                Text="{Binding NombreCategoriaPublicacion}"
                                                FontFamily="MontserratBold"
                                                FontSize="17"
                                                TextColor="#1F2937"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7,3"
                                                BackgroundColor="{Binding EstadoFondo}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 7">
                                                <Label
                                                    Text="{Binding EstadoTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="{Binding EstadoTextoColor}" />
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Padding="7,3"
                                                BackgroundColor="#F7F1EC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 7">
                                                <Label
                                                    Text="{Binding Orden, StringFormat='Orden {0}'}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="#9B552C" />
                                            </Border>
                                        </Grid>

                                        <Label
                                            Text="{Binding DescripcionCategoriaPublicacion}"
                                            FontFamily="MontserratMedium"
                                            FontSize="11"
                                            TextColor="#4B5563"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding PublicacionesTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            TextColor="#6B7280" />

                                        <HorizontalStackLayout Spacing="6">
                                            <Button
                                                Text="Editar"
                                                Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.CanEdit}"
                                                BackgroundColor="#3B655B"
                                                TextColor="White"
                                                FontFamily="MontserratBold"
                                                FontSize="9"
                                                CornerRadius="8"
                                                Padding="10,6" />
                                            <Button
                                                Text="Desactivar"
                                                Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.DesactivarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding PuedeDesactivar}"
                                                BackgroundColor="#B42318"
                                                TextColor="White"
                                                FontFamily="MontserratBold"
                                                FontSize="9"
                                                CornerRadius="8"
                                                Padding="10,6" />
                                            <Button
                                                Text="Reactivar"
                                                Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.ReactivarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding PuedeReactivar}"
                                                BackgroundColor="#F2C94C"
                                                TextColor="#4B3B00"
                                                FontFamily="MontserratBold"
                                                FontSize="9"
                                                CornerRadius="8"
                                                Padding="10,6" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="›"
                                        FontSize="25"
                                        TextColor="#3B655B"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            IsVisible="{Binding MostrarVacio}"
                            Padding="30"
                            HorizontalOptions="Center">
                            <Label
                                Text="No hay tipos de publicación"
                                FontFamily="MontserratBold"
                                FontSize="17"
                                TextColor="#3B655B" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator
                Grid.RowSpan="2"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#3B655B"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border
                MaximumWidthRequest="560"
                Padding="26"
                BackgroundColor="White"
                Stroke="#DDE7E3"
                StrokeShape="RoundRectangle 18"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Sin permiso"
                        FontFamily="MontserratBold"
                        FontSize="22"
                        TextColor="#3B655B"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para consultar los tipos de publicación."
                        FontFamily="MontserratMedium"
                        TextColor="#4B5563"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
