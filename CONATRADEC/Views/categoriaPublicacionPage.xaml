<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.categoriaPublicacionPage"
    x:Name="CategoriaPublicacionRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Tipos de publicación"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid
            x:Name="ContenidoPrincipal"
            RowDefinitions="Auto,*">

            <!--
                Encabezado y campo de búsqueda fuera del CollectionView para
                evitar el recálculo del SearchBar mientras WinUI procesa texto.
            -->
            <VerticalStackLayout
                Grid.Row="0"
                Margin="{OnIdiom Phone='12,12,12,10', Tablet='20,18,20,12', Desktop='28,22,28,14'}"
                Spacing="10">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                        RowSpacing="12"
                        ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Button
                                Text="← Publicaciones"
                                Command="{Binding RegresarCommand}"
                                Style="{StaticResource ModernLinkButton}"
                                HorizontalOptions="Start"
                                Margin="-8,-5,0,0" />
                            <Label
                                Text="Tipos de publicación"
                                Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="Administre las categorías utilizadas para noticias, ofertas y eventos."
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            Text="Nuevo tipo"
                            Command="{Binding NuevoCommand}"
                            IsVisible="{Binding CanAdd}"
                            Style="{StaticResource ModernPrimaryButton}"
                            HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                            VerticalOptions="End"
                            MinimumWidthRequest="{OnIdiom Phone=0, Default=150}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernCard}" Padding="8">
                    <Border Style="{StaticResource ModernInputBorder}">
                        <SearchBar
                            Placeholder="Buscar por nombre o descripción"
                            Text="{Binding TextoBusqueda}"
                            SearchCommand="{Binding BuscarCommand}"
                            Style="{StaticResource ModernSearchBar}" />
                    </Border>
                </Border>
            </VerticalStackLayout>

            <RefreshView
                Grid.Row="1"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    Margin="{OnIdiom Phone='12,0,12,20', Tablet='20,0,20,26', Desktop='28,0,28,30'}"
                    ItemsSource="{Binding Categorias}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="10" Margin="0,0,0,14">
                            <Border Style="{StaticResource ModernCard}">
                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,Auto,Auto'}"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <Border Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}" Style="{StaticResource ModernSoftPanel}" Padding="10,7">
                                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                            <Switch
                                                IsToggled="{Binding IncluirInactivas}"
                                                OnColor="{StaticResource color_Verde}" />
                                            <Label
                                                Text="Mostrar inactivos"
                                                Style="{StaticResource ModernCaption}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Button
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}" />
                                    <Button
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=1, Default=2}"
                                        Text="Limpiar"
                                        Command="{Binding LimpiarCommand}"
                                        Style="{StaticResource ModernNeutralButton}" />
                                </Grid>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoriaPublicacionCatalogoResponse">
                            <Border Style="{StaticResource ModernCatalogCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                        <Border
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            Padding="7"
                                            Style="{StaticResource ModernSoftPanel}">
                                            <Border
                                                BackgroundColor="{Binding ColorMuestra}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label
                                                Text="{Binding NombreCategoriaPublicacion}"
                                                FontFamily="MontserratBold"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />

                                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                                <Border
                                                    Margin="0,0,5,4"
                                                    Padding="7,3"
                                                    BackgroundColor="{Binding EstadoFondo}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        Text="{Binding EstadoTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="9"
                                                        TextColor="{Binding EstadoTextoColor}" />
                                                </Border>
                                                <Border
                                                    Margin="0,0,5,4"
                                                    Style="{StaticResource ModernBadgeCoffee}">
                                                    <Label
                                                        Text="{Binding Orden, StringFormat='Orden {0}'}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="9"
                                                        TextColor="{StaticResource color_Cafe}" />
                                                </Border>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label
                                        Text="{Binding DescripcionCategoriaPublicacion}"
                                        FontFamily="MontserratMedium"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        MaxLines="3"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding PublicacionesTexto}"
                                        Style="{StaticResource ModernCaption}" />

                                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                        <Button
                                            Margin="0,0,6,6"
                                            Text="Editar"
                                            Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.EditarCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.CanEdit}"
                                            Style="{StaticResource ModernUpdateButton}"
                                            MinimumWidthRequest="96" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Text="Desactivar"
                                            Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.DesactivarCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding PuedeDesactivar}"
                                            Style="{StaticResource ModernDangerSoftButton}"
                                            MinimumWidthRequest="105" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Text="Reactivar"
                                            Command="{Binding Source={x:Reference CategoriaPublicacionRoot}, Path=BindingContext.ReactivarCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding PuedeReactivar}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="105" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Grid Padding="12,24">
                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                MaximumWidthRequest="520">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label
                                        Text="No hay tipos de publicación"
                                        Style="{StaticResource ModernSectionTitle}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Cambie la búsqueda o los filtros para volver a consultar."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Grid
                Grid.RowSpan="2"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Actualizando categorías..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permiso"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para consultar los tipos de publicación."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
