<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAAnalizadorPage"
    x:Name="PaginaAnalizador"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F8F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TecnicoInspeccionTextoConverter
                x:Key="TecnicoInspeccionTextoConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!--
                Todo el encabezado pertenece al CollectionView para que en móvil
                desaparezca naturalmente al hacer scroll. La navegación inferior
                continúa fija mediante FooterTemplate.
            -->
            <CollectionView
                x:Name="AnalizadorListado"
                ItemsSource="{Binding Solicitudes}"
                SelectionMode="None"
                HorizontalOptions="Fill"
                Margin="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout
                        Spacing="10"
                        Padding="0,0,0,12"
                        WidthRequest="{Binding Source={x:Reference AnalizadorListado}, Path=Width}"
                        HorizontalOptions="Fill">
                        <controls:InspectionHeader
                            Title="Bandeja del analizador"
                            Subtitle="{Binding SubtituloVista}"
                            BackText="Volver"
                            BackCommand="{Binding RegresarCommand}"
                            IsPrimaryVisible="False" />

                        <Border
                            Padding="{OnIdiom Phone=10, Default=12}"
                            BackgroundColor="#F2F7F5"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 13">
                            <Grid
                                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                                RowSpacing="8"
                                ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="Vista de revisión"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="Pendientes contiene el trabajo activo. Revisadas conserva las inspecciones cuya etapa del analizador ya terminó."
                                        FontSize="11"
                                        TextColor="#5E6B67"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Grid
                                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8"
                                    HorizontalOptions="{OnIdiom Phone=Fill, Default=End}">
                                    <Button
                                        Grid.Column="0"
                                        Text="Pendientes"
                                        Command="{Binding VerPendientesCommand}"
                                        MinimumWidthRequest="{OnIdiom Phone=0, Default=145}"
                                        HeightRequest="42"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#315E52"
                                        CornerRadius="9">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoPendientes}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#9B552C" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Text="Revisadas"
                                        Command="{Binding VerRevisadasCommand}"
                                        MinimumWidthRequest="{OnIdiom Phone=0, Default=145}"
                                        HeightRequest="42"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#315E52"
                                        CornerRadius="9">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoRevisadas}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#9B552C" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="7"
                            ColumnSpacing="8">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding SubtituloVista}"
                                FontAttributes="Bold"
                                TextColor="#3B655B"
                                VerticalTextAlignment="Center"
                                LineBreakMode="WordWrap" />
                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="Actualizar"
                                Command="{Binding ActualizarCommand}"
                                HeightRequest="44"
                                Padding="14,7"
                                BackgroundColor="#E3EFEA"
                                TextColor="#3B655B"
                                HorizontalOptions="Fill" />
                        </Grid>

                        <Border
                            Padding="{OnIdiom Phone=10, Default=12}"
                            BackgroundColor="White"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 13">
                            <Grid
                                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                ColumnDefinitions="{OnIdiom Phone='*', Default='Auto,*'}"
                                RowSpacing="5"
                                ColumnSpacing="12">
                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="Técnico responsable"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="Filtra por el usuario que registró la inspección."
                                        FontSize="11"
                                        TextColor="#6B7773" />
                                </VerticalStackLayout>
                                <Button
                                    x:Name="TecnicoSelectorButton"
                                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Text="{Binding TecnicoFiltroTexto}"
                                    Clicked="OnSeleccionarTecnicoClicked"
                                    MinimumWidthRequest="{OnIdiom Phone=0, Default=360}"
                                    HeightRequest="44"
                                    Padding="14,8"
                                    HorizontalOptions="Fill"
                                    BackgroundColor="White"
                                    BorderColor="#C9D4D0"
                                    BorderWidth="1"
                                    TextColor="#263A35"
                                    CornerRadius="8" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="12"
                            BackgroundColor="#FFF9E8"
                            Stroke="#E2B93B"
                            StrokeShape="RoundRectangle 13"
                            IsVisible="{Binding TieneMensajeEstado}">
                            <Label
                                Text="{Binding MensajeEstado}"
                                TextColor="#6B5710"
                                LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InspeccionFitosanitariaBandejaItemV2">
                        <Border
                            Padding="{OnIdiom Phone=12, Default=15}"
                            BackgroundColor="White"
                            Stroke="#D7E2DE"
                            StrokeShape="RoundRectangle 15"
                            HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="12">
                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" JustifyContent="SpaceBetween">
                                    <Border
                                        Margin="0,0,12,8"
                                        WidthRequest="{OnIdiom Phone=92, Tablet=112, Desktop=122}"
                                        HeightRequest="{OnIdiom Phone=92, Tablet=112, Desktop=122}"
                                        BackgroundColor="#EEF3F1"
                                        Stroke="#C8DED6"
                                        StrokeShape="RoundRectangle 12">
                                        <Image Source="{Binding UrlMiniatura}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout
                                        Margin="0,0,12,8"
                                        Spacing="4"
                                        MinimumWidthRequest="{OnIdiom Phone=210, Default=330}"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="420">
                                        <Label Text="{Binding NombreInspeccionTexto}" FontSize="{OnIdiom Phone=17, Default=19}" FontAttributes="Bold" TextColor="#263A35" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding TerrenoTexto}" FontSize="13" TextColor="#3B655B" />
                                        <Label Text="{Binding InspeccionId, Converter={StaticResource TecnicoInspeccionTextoConverter}, StringFormat='Técnico: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#40544E" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding FechaTexto}" FontSize="12" TextColor="#7A8581" />
                                        <Label Text="{Binding AsignacionTexto}" FontSize="11" TextColor="#52665F" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Margin="0,0,0,8"
                                        Spacing="8"
                                        MinimumWidthRequest="{OnIdiom Phone=210, Default=230}"
                                        FlexLayout.Basis="250">
                                        <Border
                                            Padding="10,6"
                                            BackgroundColor="#FFF3D7"
                                            Stroke="#E5C66A"
                                            StrokeShape="RoundRectangle 11"
                                            IsVisible="True">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding EtapaTecnicaFinalizada}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="Recepción parcial" FontAttributes="Bold" TextColor="#705A19" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <Border
                                            Padding="10,6"
                                            BackgroundColor="#E8F3EE"
                                            Stroke="#BBD8CC"
                                            StrokeShape="RoundRectangle 11"
                                            IsVisible="False">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding EtapaTecnicaFinalizada}" Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="Envío técnico completo" FontAttributes="Bold" TextColor="#315E52" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <Button
                                            Text="{Binding Source={x:Reference PaginaAnalizador}, Path=BindingContext.TextoAbrir}"
                                            Command="{Binding Source={x:Reference PaginaAnalizador}, Path=BindingContext.AbrirCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="46"
                                            BackgroundColor="#9B552C"
                                            TextColor="White"
                                            CornerRadius="11" />
                                    </VerticalStackLayout>
                                </FlexLayout>

                                <Grid
                                    ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*,*'}"
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Default='Auto'}"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <Border Grid.Row="0" Grid.Column="0" Padding="10" BackgroundColor="#F7FAF9" Stroke="#DCE6E2" StrokeShape="RoundRectangle 11">
                                        <VerticalStackLayout Spacing="2"><Label Text="Total activas" FontSize="11" TextColor="#6B7773" /><Label Text="{Binding TotalFotografias}" FontSize="18" FontAttributes="Bold" TextColor="#263A35" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Padding="10" BackgroundColor="#EAF3EF" Stroke="#C8DED6" StrokeShape="RoundRectangle 11">
                                        <VerticalStackLayout Spacing="2"><Label Text="Recibidas" FontSize="11" TextColor="#527066" /><Label Text="{Binding EnviadasRevision}" FontSize="18" FontAttributes="Bold" TextColor="#315E52" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}" Padding="10" BackgroundColor="#EDF4FF" Stroke="#C8D9EE" StrokeShape="RoundRectangle 11">
                                        <VerticalStackLayout Spacing="2"><Label Text="Enviadas al aprobador" FontSize="11" TextColor="#315B86" /><Label Text="{Binding EnviadasAprobador}" FontSize="18" FontAttributes="Bold" TextColor="#315B86" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}" Padding="10" BackgroundColor="#FFF8E2" Stroke="#E4C765" StrokeShape="RoundRectangle 11">
                                        <VerticalStackLayout Spacing="2"><Label Text="Pendientes/correcciones" FontSize="11" TextColor="#705A19" /><Label Text="{Binding RequierenDecisionTecnico}" FontSize="18" FontAttributes="Bold" TextColor="#705A19" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="{OnIdiom Phone=2, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=4}" Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}" Padding="10" BackgroundColor="#FDECEC" Stroke="#F0C8C4" StrokeShape="RoundRectangle 11">
                                        <VerticalStackLayout Spacing="2"><Label Text="Error IA pendiente" FontSize="11" TextColor="#9A3028" /><Label Text="{Binding ConError}" FontSize="18" FontAttributes="Bold" TextColor="#B42318" /></VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Label
                                    FontSize="12"
                                    TextColor="#6B5710"
                                    LineBreakMode="WordWrap"
                                    Text="Puede revisar las fotografías recibidas. Todavía faltan evidencias o correcciones bajo responsabilidad del técnico."
                                    IsVisible="True">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EtapaTecnicaFinalizada}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    FontSize="12"
                                    TextColor="#315E52"
                                    LineBreakMode="WordWrap"
                                    Text="El técnico completó el envío. Cada fotografía revisada puede enviarse al aprobador de forma individual o mediante selección múltiple."
                                    IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EtapaTecnicaFinalizada}" Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,14,0,4" Spacing="8">
                        <Border
                            Padding="18"
                            BackgroundColor="#F2F6F4"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 14"
                            IsVisible="{Binding SinSolicitudes}">
                            <Label Text="{Binding TextoSinSolicitudes}" HorizontalTextAlignment="Center" TextColor="#5E6B67" />
                        </Border>
                        <ActivityIndicator
                            IsRunning="{Binding CargandoMas}"
                            IsVisible="{Binding CargandoMas}"
                            Color="#3B655B" />
                        <Button
                            Text="{Binding TextoCargarMas}"
                            Command="{Binding CargarMasCommand}"
                            IsVisible="{Binding HayMas}"
                            HeightRequest="46"
                            MaximumWidthRequest="360"
                            HorizontalOptions="Center"
                            BackgroundColor="#EAF3EF"
                            TextColor="#315E52"
                            CornerRadius="11" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

            <!-- Relay de carga principal; CargandoMas permanece no bloqueante. -->
            <Grid
                ZIndex="50"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#55000000"
                InputTransparent="False">
                <Border
                    Padding="22"
                    BackgroundColor="White"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="320">
                    <VerticalStackLayout Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#9B552C" WidthRequest="40" HeightRequest="40" />
                        <Label Text="Actualizando bandeja..." FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#263A35" />
                        <Label Text="{Binding MensajeEstado}" FontSize="12" HorizontalTextAlignment="Center" TextColor="#5E6B67" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
