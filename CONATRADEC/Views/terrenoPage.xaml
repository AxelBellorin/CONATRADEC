<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.terrenoPage"
    x:Name="TerrenosRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid
            x:Name="ContenidoPrincipal"
            Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    x:Name="TerrenosCollectionView"
                    ItemsSource="{Binding List}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <!--
                        Encabezado, búsqueda y filtros forman parte del contenido
                        desplazable. La distribución se ajusta por ancho real en
                        terrenoPage.xaml.cs para funcionar también en WinUI estrecho.
                    -->
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">

                            <controls:ResponsiveCatalogHeader
                                Title="Terrenos"
                                Subtitle="{Binding TotalTexto}"
                                BackText="← Configuración"
                                BackCommand="{Binding Source={x:Reference TerrenosRoot}, Path=RegresarConfiguracionCommand}"
                                PrimaryText="+ Nuevo terreno"
                                PrimaryCommand="{Binding AddCommand}"
                                IsPrimaryVisible="{Binding CanAdd}" />

                            <!-- Búsqueda principal -->
                            <Border Style="{StaticResource ModernCard}" Padding="12">
                                <VerticalStackLayout Spacing="10">
                                    <Border Style="{StaticResource ModernInputBorder}" Padding="6,0">
                                        <SearchBar
                                            Placeholder="Código, propietario, identificación o dirección"
                                            Text="{Binding TextoBusqueda}"
                                            SearchCommand="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernSearchBar}" />
                                    </Border>

                                    <Grid
                                        x:Name="BusquedaAccionesGrid"
                                        ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="8"
                                        RowSpacing="8">

                                        <Button
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />

                                        <Button
                                            Grid.Column="1"
                                            Text="{Binding TextoBotonFiltros}"
                                            Command="{Binding AlternarFiltrosCommand}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            HeightRequest="48"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />

                                        <Button
                                            Grid.Column="2"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarFiltrosCommand}"
                                            Style="{StaticResource ModernNeutralButton}"
                                            HeightRequest="48"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Filtros avanzados -->
                            <Border
                                IsVisible="{Binding MostrarFiltrosAvanzados}"
                                Style="{StaticResource ModernCard}">
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Búsqueda avanzada" Style="{StaticResource ModernSectionTitle}" />
                                            <Label
                                                Text="Combine uno o varios criterios para reducir el listado."
                                                Style="{StaticResource ModernPageSubtitle}"
                                                FontSize="11" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource ModernBadgeGreen}"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="Filtros"
                                                FontFamily="MontserratBold"
                                                FontSize="9.5"
                                                TextColor="{StaticResource color_Verde}" />
                                        </Border>
                                    </Grid>

                                    <Grid
                                        x:Name="FiltrosTextoGrid"
                                        ColumnDefinitions="*,*"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="10">
                                        <VerticalStackLayout
                                            x:Name="FiltroCodigoSection"
                                            Spacing="5">
                                            <Label Text="Código" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Placeholder="Ej: TRR-0025-000127"
                                                    Text="{Binding CodigoFiltro}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            x:Name="FiltroPropietarioSection"
                                            Grid.Column="1"
                                            Spacing="5">
                                            <Label Text="Propietario" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Placeholder="Nombre del propietario"
                                                    Text="{Binding PropietarioFiltro}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            x:Name="FiltroIdentificacionSection"
                                            Grid.Row="1"
                                            Spacing="5">
                                            <Label Text="Identificación" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Placeholder="001-080701-1050R"
                                                    Text="{Binding IdentificacionFiltro}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            x:Name="FiltroDireccionSection"
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Spacing="5">
                                            <Label Text="Dirección" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Placeholder="Sector, comunidad o referencia"
                                                    Text="{Binding DireccionFiltro}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />

                                    <Label
                                        Text="Ubicación administrativa"
                                        Style="{StaticResource ModernFieldLabel}"
                                        FontSize="12" />

                                    <Grid
                                        x:Name="FiltrosUbicacionGrid"
                                        ColumnDefinitions="*,*,*"
                                        RowDefinitions="Auto"
                                        ColumnSpacing="10"
                                        RowSpacing="8">
                                        <Border
                                            x:Name="FiltroPaisBorder"
                                            Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                Title="Todos los países"
                                                ItemsSource="{Binding Paises}"
                                                ItemDisplayBinding="{Binding NombrePais}"
                                                SelectedItem="{Binding PaisSeleccionado}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>

                                        <Border
                                            x:Name="FiltroDepartamentoBorder"
                                            Grid.Column="1"
                                            Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                Title="Todos los departamentos"
                                                ItemsSource="{Binding Departamentos}"
                                                ItemDisplayBinding="{Binding NombreDepartamento}"
                                                SelectedItem="{Binding DepartamentoSeleccionado}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>

                                        <Border
                                            x:Name="FiltroMunicipioBorder"
                                            Grid.Column="2"
                                            Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                Title="Todos los municipios"
                                                ItemsSource="{Binding Municipios}"
                                                ItemDisplayBinding="{Binding NombreMunicipio}"
                                                SelectedItem="{Binding MunicipioSeleccionado}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>
                                    </Grid>

                                    <HorizontalStackLayout
                                        IsVisible="{Binding UbicacionCargando}"
                                        Spacing="8">
                                        <ActivityIndicator
                                            IsRunning="{Binding UbicacionCargando}"
                                            Color="{StaticResource color_Verde}"
                                            WidthRequest="20"
                                            HeightRequest="20" />
                                        <Label
                                            Text="Actualizando ubicación..."
                                            Style="{StaticResource ModernCaption}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />

                                    <Grid
                                        x:Name="FiltrosFechaGrid"
                                        ColumnDefinitions="Auto,*,*,*"
                                        RowDefinitions="Auto"
                                        ColumnSpacing="10"
                                        RowSpacing="8">
                                        <Switch
                                            x:Name="FiltroFechaSwitch"
                                            IsToggled="{Binding FiltrarPorFecha}"
                                            OnColor="{StaticResource color_Verde}" />
                                        <Label
                                            x:Name="FiltroFechaLabel"
                                            Grid.Column="1"
                                            Text="Filtrar fecha de ingreso"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratBold"
                                            FontSize="11.5"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                                        <Border
                                            x:Name="FiltroFechaDesdeBorder"
                                            Grid.Column="2"
                                            IsVisible="{Binding FiltrarPorFecha}"
                                            Style="{StaticResource ModernInputBorder}">
                                            <DatePicker
                                                Date="{Binding FechaDesde}"
                                                Style="{StaticResource ModernDatePicker}" />
                                        </Border>

                                        <Border
                                            x:Name="FiltroFechaHastaBorder"
                                            Grid.Column="3"
                                            IsVisible="{Binding FiltrarPorFecha}"
                                            Style="{StaticResource ModernInputBorder}">
                                            <DatePicker
                                                Date="{Binding FechaHasta}"
                                                Style="{StaticResource ModernDatePicker}" />
                                        </Border>
                                    </Grid>

                                    <Grid
                                        x:Name="FiltrosExtensionGrid"
                                        ColumnDefinitions="*,*,*"
                                        RowDefinitions="Auto"
                                        ColumnSpacing="10"
                                        RowSpacing="8">
                                        <VerticalStackLayout
                                            x:Name="FiltroExtensionMinimaSection"
                                            Spacing="5">
                                            <Label Text="Extensión mínima (mz)" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Keyboard="Numeric"
                                                    Placeholder="0.00"
                                                    Text="{Binding ExtensionMinimaTexto}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            x:Name="FiltroExtensionMaximaSection"
                                            Grid.Column="1"
                                            Spacing="5">
                                            <Label Text="Extensión máxima (mz)" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Entry
                                                    Keyboard="Numeric"
                                                    Placeholder="100.00"
                                                    Text="{Binding ExtensionMaximaTexto}"
                                                    Style="{StaticResource ModernEntry}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            x:Name="FiltroOrdenSection"
                                            Grid.Column="2"
                                            Spacing="5">
                                            <Label Text="Ordenar por" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Picker
                                                    ItemsSource="{Binding Ordenamientos}"
                                                    SelectedItem="{Binding OrdenarSeleccionado}"
                                                    Style="{StaticResource ModernPicker}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Button
                                        x:Name="AplicarFiltrosButton"
                                        Text="Aplicar filtros"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="11.5"
                                    TextColor="{AppThemeBinding Light=#8B541E, Dark=#E6C28D}" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TerrenoResponse">
                            <Border Style="{StaticResource ModernCatalogCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.ViewCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout
                                            Spacing="3"
                                            MinimumWidthRequest="0">
                                            <Label
                                                Text="{Binding CodigoTerreno}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding Propietario.NombreCompleto, TargetNullValue='Sin propietario'}"
                                                FontFamily="MontserratMedium"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource ModernBadgeGreen}">
                                            <Label
                                                Text="{Binding ExtensionManzanaTerreno, StringFormat='{0:F2} mz'}"
                                                FontFamily="MontserratBold"
                                                FontSize="10.5"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation"
                                                TextColor="{StaticResource color_Verde}" />
                                        </Border>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        ColumnDefinitions="*,*,*"
                                        RowDefinitions="Auto"
                                        ColumnSpacing="8"
                                        RowSpacing="6"
                                        SizeChanged="TerrenoMetricasGrid_SizeChanged">
                                        <Border Style="{StaticResource ModernMetricSurface}">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="MUNICIPIO" Style="{StaticResource ModernCaption}" FontSize="8.5" />
                                                <Label
                                                    Text="{Binding Ubicacion.NombreMunicipio}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10.5"
                                                    TextColor="{StaticResource color_Verde}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource ModernMetricSurface}">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="DEPARTAMENTO" Style="{StaticResource ModernCaption}" FontSize="8.5" />
                                                <Label
                                                    Text="{Binding Ubicacion.NombreDepartamento}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource ModernMetricSurface}">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="INGRESO" Style="{StaticResource ModernCaption}" FontSize="8.5" />
                                                <Label
                                                    Text="{Binding FechaIngresoTerreno, StringFormat='{0:dd/MM/yyyy}'}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid
                                        Grid.Row="2"
                                        ColumnDefinitions="*,*,*"
                                        RowDefinitions="Auto"
                                        ColumnSpacing="8"
                                        RowSpacing="8"
                                        SizeChanged="TerrenoAccionesGrid_SizeChanged">
                                        <Button
                                            Text="Ver"
                                            Command="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.ViewCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Editar"
                                            Command="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.CanEdit}"
                                            Style="{StaticResource ModernUpdateButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Eliminar"
                                            Command="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={x:Reference TerrenosRoot}, Path=BindingContext.CanDelete}"
                                            Style="{StaticResource ModernDangerButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Grid Padding="12,24">
                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                Style="{StaticResource ModernEmptyStateCard}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border
                                        Style="{StaticResource ModernIconTile}"
                                        WidthRequest="54"
                                        HeightRequest="54"
                                        Padding="11">
                                        <Image Source="iconland.png" Aspect="AspectFit" Opacity="0.62" />
                                    </Border>
                                    <Label
                                        Text="No hay terrenos para mostrar"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="17"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Cambie los filtros o actualice la lista."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <VerticalStackLayout
                            Padding="0,14,0,28"
                            Spacing="8"
                            HorizontalOptions="Center">
                            <ActivityIndicator
                                IsVisible="{Binding CargandoMas}"
                                IsRunning="{Binding CargandoMas}"
                                Color="{StaticResource color_Verde}" />
                            <Label
                                IsVisible="{Binding MostrarFinLista}"
                                Text="No hay más terrenos."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <Grid
                IsVisible="{Binding IsBusy}"
                InputTransparent="False"
                BackgroundColor="#36000000">
                <Border
                    Padding="18,14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeShape="RoundRectangle 15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" />
                        <Label
                            Text="Cargando terrenos..."
                            FontFamily="MontserratBold"
                            FontSize="12"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="{OnIdiom Phone=16, Tablet=24, Desktop=28}">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border
                        Style="{StaticResource ModernIconTile}"
                        WidthRequest="70"
                        HeightRequest="70"
                        Padding="14">
                        <Image Source="iconpermission.png" Aspect="AspectFit" Opacity="0.72" />
                    </Border>
                    <Label
                        Text="Sin permiso para consultar terrenos"
                        Style="{StaticResource ModernSectionTitle}"
                        FontSize="21"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Su usuario está activo, pero su rol no tiene permiso de lectura para este apartado."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
