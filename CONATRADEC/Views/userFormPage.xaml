<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.userFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <Grid Padding="{OnIdiom Phone='14,16,14,22', Tablet='22,20,22,26', Desktop='28,24,28,30'}">

        <ScrollView HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Spacing="18">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding Title}"
                            FontSize="{OnIdiom Phone=25, Tablet=28, Desktop=30}"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Label
                            Text="Administre los datos de acceso, ubicación, rol e imagen del usuario."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource color_Naranja}" />
                </Grid>

                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="Acceso e identificación"
                            FontSize="19"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Grid
                            x:Name="AccesoGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="14">

                            <VerticalStackLayout x:Name="UsuarioSection" Spacing="6">
                                <Label Text="Usuario" FontAttributes="Bold" />
                                <Entry
                                    Placeholder="Nombre de usuario"
                                    Text="{Binding NombreUsuario}"
                                    IsReadOnly="{Binding IsUserNameReadOnly}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ClaveSection"
                                Grid.Row="1"
                                IsVisible="{Binding ShowPasswordField}"
                                Spacing="6">

                                <Label Text="Contraseña" FontAttributes="Bold" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <!--
                                        No se fuerza el teclado de contraseña porque Android
                                        mantenía el texto oculto aun después de tocar
                                        el botón del ojo. IsPassword controla por sí
                                        solo la visibilidad.
                                    -->
                                    <Entry
                                        Text="{Binding ClaveUsuario}"
                                        Placeholder="{Binding PasswordPlaceholder}"
                                        IsPassword="{Binding IsPasswordHidden}"
                                        BackgroundColor="#FAFBFA" />

                                    <ImageButton
                                        Grid.Column="1"
                                        Source="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordCommand}"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="Transparent" />
                                </Grid>

                                <Label
                                    Text="{Binding PasswordHelpText}"
                                    FontSize="11"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="NombreSection"
                                Grid.Row="2"
                                Spacing="6">

                                <Label Text="Nombre completo" FontAttributes="Bold" />
                                <Entry
                                    Text="{Binding NombreCompletoUsuario}"
                                    Placeholder="Nombre completo"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="IdentificacionSection"
                                Grid.Row="3"
                                Spacing="6">

                                <Label Text="Identificación" FontAttributes="Bold" />
                                <Entry
                                    Text="{Binding IdentificacionUsuario}"
                                    Placeholder="001-080701-1050R"
                                    MaxLength="18"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="Contacto y asignación"
                            FontSize="19"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Grid
                            x:Name="ContactoGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="14">

                            <VerticalStackLayout x:Name="CorreoSection" Spacing="6">
                                <Label Text="Correo electrónico" FontAttributes="Bold" />
                                <Entry
                                    Text="{Binding CorreoUsuario}"
                                    Placeholder="usuario@dominio.com"
                                    Keyboard="Email"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="TelefonoSection"
                                Grid.Row="1"
                                Spacing="6">
                                <Label Text="Teléfono" FontAttributes="Bold" />
                                <Entry
                                    Text="{Binding TelefonoUsuario}"
                                    Placeholder="8 dígitos"
                                    Keyboard="Telephone"
                                    MaxLength="8"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="FechaSection"
                                Grid.Row="2"
                                Spacing="6">

                                <Label
                                    Text="Fecha de nacimiento"
                                    FontAttributes="Bold" />

                                <!--
                                    La parte visible se dibuja debajo.
                                    El DatePicker transparente se coloca al final,
                                    por lo que queda encima y recibe la interacción.
                                    Su Format siempre es una fecha válida.
                                -->
                                <Grid
                                    x:Name="FechaNacimientoField"
                                    HeightRequest="48"
                                    HorizontalOptions="Fill"
                                    SizeChanged="FechaNacimientoField_SizeChanged">

                                    <Border
                                        BackgroundColor="#FAFBFA"
                                        Stroke="#D9D9D9"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4"
                                        InputTransparent="True">

                                        <Grid
                                            Padding="12,0"
                                            ColumnDefinitions="*,Auto"
                                            InputTransparent="True">

                                            <Label
                                                x:Name="FechaNacimientoTexto"
                                                Text="Seleccione una fecha"
                                                VerticalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}"
                                                InputTransparent="True" />

                                            <Label
                                                Grid.Column="1"
                                                Text="▾"
                                                Margin="10,0,2,0"
                                                VerticalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}"
                                                InputTransparent="True" />
                                        </Grid>
                                    </Border>

                                    <DatePicker
                                        x:Name="FechaNacimientoPicker"
                                        Date="{Binding FechaNacimientoDate}"
                                        MinimumDate="1900-01-01"
                                        MaximumDate="{x:Static sys:DateTime.Now}"
                                        Format="dd/MM/yyyy"
                                        DateSelected="FechaNacimientoPicker_DateSelected"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        MinimumHeightRequest="48"
                                        IsEnabled="{Binding IsEnabled}"
                                        Opacity="0.01"
                                        BackgroundColor="Transparent" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="RolSection"
                                Grid.Row="3"
                                Spacing="6">
                                <Label Text="Rol" FontAttributes="Bold" />
                                <Picker
                                    Title="Seleccione un rol"
                                    ItemsSource="{Binding Roles}"
                                    ItemDisplayBinding="{Binding NombreRol}"
                                    SelectedItem="{Binding RolSeleccionado}"
                                    IsEnabled="{Binding IsEnabled}"
                                    BackgroundColor="#FAFBFA" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="16">
                        <Label
                            Text="Ubicación"
                            FontSize="19"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Grid
                            x:Name="UbicacionGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="14">

                            <VerticalStackLayout x:Name="PaisSection" Spacing="6">
                                <Label Text="País" FontAttributes="Bold" />
                                <Picker
                                    Title="Seleccione un país"
                                    ItemsSource="{Binding Paises}"
                                    ItemDisplayBinding="{Binding NombrePais}"
                                    SelectedItem="{Binding PaisSeleccionado}"
                                    IsEnabled="{Binding IsEnabled}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="DepartamentoSection"
                                Grid.Row="1"
                                Spacing="6">
                                <Label Text="Departamento" FontAttributes="Bold" />
                                <Picker
                                    Title="Seleccione un departamento"
                                    ItemsSource="{Binding Departamentos}"
                                    ItemDisplayBinding="{Binding NombreDepartamento}"
                                    SelectedItem="{Binding DepartamentoSeleccionado}"
                                    IsEnabled="{Binding CanPickDepartamento}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="MunicipioSection"
                                Grid.Row="2"
                                Spacing="6">
                                <Label Text="Municipio" FontAttributes="Bold" />
                                <Picker
                                    Title="Seleccione un municipio"
                                    ItemsSource="{Binding Municipios}"
                                    ItemDisplayBinding="{Binding NombreMunicipio}"
                                    SelectedItem="{Binding MunicipioSeleccionado}"
                                    IsEnabled="{Binding CanPickMunicipio}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 18">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="Imagen de perfil"
                                FontSize="18"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Button
                                Text="Seleccionar imagen"
                                Command="{Binding SeleccionarImagenCommand}"
                                IsEnabled="{Binding EnabledImagenField}"
                                Style="{StaticResource AddButton}"
                                HorizontalOptions="Start" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="120"
                            HeightRequest="120"
                            BackgroundColor="#EEF5F2"
                            Stroke="#DDE7E3"
                            StrokeShape="RoundRectangle 18">
                            <Image
                                Source="{Binding ImagenPreview}"
                                Aspect="AspectFill" />
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,2,0,16">

                    <Button
                        Text="Guardar"
                        Style="{StaticResource UpdateButton}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding SaveCommand}" />

                    <Button
                        Grid.Column="1"
                        Text="Cancelar"
                        Style="{StaticResource CancelButton}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}" />

                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Regresar"
                        Style="{StaticResource CancelButton}"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
