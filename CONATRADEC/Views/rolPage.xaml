<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rolPage"
    x:Name="RolPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="{OnIdiom Phone=16, Tablet=24, Desktop=28}">

                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="70"
                            HeightRequest="70"
                            Padding="14">
                            <Image Source="iconpermission.png" Aspect="AspectFit" Opacity="0.72" />
                        </Border>

                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="21"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar roles."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarConfiguracionCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido -->
            <Grid
                x:Name="ContenidoRoles"
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}">

                <RefreshView
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">

                    <CollectionView
                        x:Name="RolesCollectionView"
                        ItemsSource="{Binding List}"
                        SelectionMode="None">

                        <!--
                            Encabezado y búsqueda pertenecen al flujo normal del
                            CollectionView y desaparecen con el scroll natural.
                        -->
                        <CollectionView.Header>
                            <VerticalStackLayout
                                Spacing="12"
                                Padding="0,0,0,12">

                                <controls:ResponsiveCatalogHeader
                                    Title="Roles"
                                    Subtitle="Administre los perfiles utilizados para asignar usuarios y permisos."
                                    BackText="← Configuración"
                                    BackCommand="{Binding RegresarConfiguracionCommand}"
                                    PrimaryText="+ Nuevo rol"
                                    PrimaryCommand="{Binding AddCommand}"
                                    IsPrimaryVisible="{Binding CanAdd}" />

                                <controls:ResponsiveSearchPanel
                                    Placeholder="Buscar por nombre o descripción"
                                    SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                                    SummaryText="{Binding ResumenResultados}"
                                    SearchCommand="{Binding BuscarCommand}"
                                    ClearCommand="{Binding LimpiarFiltrosCommand}" />

                                <Border
                                    IsVisible="{Binding TieneMensaje}"
                                    Style="{StaticResource ModernWarningBanner}">
                                    <Label
                                        Text="{Binding Mensaje}"
                                        FontFamily="MontserratMedium"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                                <!--
                                    Estado vacío dentro del Header para evitar que EmptyView
                                    capture la interacción de búsqueda en WinUI.
                                -->
                                <Grid Padding="12,24"
                                    IsVisible="{Binding MostrarVacio}"
                                    InputTransparent="True">
                                    <Border
                                        IsVisible="{Binding MostrarVacio}"
                                        InputTransparent="True"
                                        Style="{StaticResource ModernEmptyStateCard}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Start"
                                        MaximumWidthRequest="560">
                                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <Border
                                                Style="{StaticResource ModernIconTile}"
                                                WidthRequest="54"
                                                HeightRequest="54"
                                                Padding="11">
                                                <Image Source="iconrol.png" Aspect="AspectFit" Opacity="0.62" />
                                            </Border>
                                            <Label
                                                Text="No se encontraron roles"
                                                Style="{StaticResource ModernSectionTitle}"
                                                FontSize="17"
                                                HorizontalTextAlignment="Center" />
                                            <Label
                                                Text="Cambie la búsqueda o registre un nuevo rol."
                                                Style="{StaticResource ModernPageSubtitle}"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="RolesGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RolResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="218">

                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="13">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Style="{StaticResource ModernIconTile}">
                                                <Label
                                                    Text="RL"
                                                    FontSize="18"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding NombreMostrar}"
                                                    FontSize="16"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding DescripcionMostrar}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="11.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8">
                                            <Border Style="{StaticResource ModernBadgeBlue}" Padding="9,7">
                                                <Label
                                                    Text="{Binding UsuariosTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ModernBadgeYellow}" Padding="9,7">
                                                <Label
                                                    Text="{Binding InterfacesTexto}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="2"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">
                                            <Button
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.ViewCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                IsVisible="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.CanEdit}"
                                                IsEnabled="{Binding EsEditable}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                IsVisible="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.CanDelete}"
                                                IsEnabled="{Binding EsEditable}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Border
                                x:Name="PaginacionRoles"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="{OnIdiom Phone='12,12', Tablet='14,13', Desktop='16,14'}"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Pressed="PaginacionRoles_Pressed"
                                            Clicked="PaginacionRoles_Clicked"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Pressed="PaginacionRoles_Pressed"
                                            Clicked="PaginacionRoles_Clicked"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    IsVisible="{Binding MostrandoRelay}"
                    InputTransparent="False"
                    BackgroundColor="#50000000"
                    ZIndex="100">
                    <Border
                        Padding="20,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeShape="RoundRectangle 15"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding MostrandoRelay}"
                                Color="{StaticResource color_Naranja}" />
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label
                                    Text="{Binding TituloRelay}"
                                    FontFamily="MontserratBold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label
                                    Text="{Binding DetalleRelay}"
                                    FontFamily="MontserratMedium"
                                    FontSize="10"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
