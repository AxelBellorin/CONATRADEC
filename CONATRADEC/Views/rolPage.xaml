<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rolPage"
    x:Name="RolPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="{OnIdiom Phone=16, Tablet=24, Desktop=28}">

                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="70"
                            HeightRequest="70"
                            Padding="14">
                            <Image Source="iconpermission.png" Aspect="AspectFit" Opacity="0.72" />
                        </Border>

                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="21"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar roles."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarConfiguracionCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido -->
            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
                RowDefinitions="Auto,*"
                RowSpacing="12">

                <!-- Buscador estable fuera del CollectionView virtualizado. -->
                <VerticalStackLayout Grid.Row="0" Spacing="12">
                    <controls:ResponsiveCatalogHeader
                        Title="Roles"
                        Subtitle="Administre los perfiles utilizados para asignar usuarios y permisos."
                        BackText="← Configuración"
                        BackCommand="{Binding RegresarConfiguracionCommand}"
                        PrimaryText="+ Nuevo rol"
                        PrimaryCommand="{Binding AddCommand}"
                        IsPrimaryVisible="{Binding CanAdd}" />

                    <controls:ResponsiveSearchPanel
                        Placeholder="Buscar por nombre o descripción"
                        SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                        SummaryText="{Binding ResumenResultados}"
                        SearchCommand="{Binding BuscarCommand}"
                        ClearCommand="{Binding LimpiarFiltrosCommand}" />
                </VerticalStackLayout>

                <RefreshView
                    Grid.Row="1"
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">

                    <CollectionView
                        ItemsSource="{Binding List}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                        <CollectionView.Header>
                            <Border
                                Margin="0,0,0,12"
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            </Border>
                        </CollectionView.Header>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="RolesGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Grid Padding="12,24">
                                <Border
                                    IsVisible="{Binding MostrarVacio}"
                                    Style="{StaticResource ModernEmptyStateCard}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start"
                                    MaximumWidthRequest="560">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Border
                                            Style="{StaticResource ModernIconTile}"
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            Padding="11">
                                            <Image Source="iconrol.png" Aspect="AspectFit" Opacity="0.62" />
                                        </Border>
                                        <Label
                                            Text="No se encontraron roles"
                                            Style="{StaticResource ModernSectionTitle}"
                                            FontSize="17"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Cambie la búsqueda o registre un nuevo rol."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RolResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="218">

                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="13">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Style="{StaticResource ModernIconTile}">
                                                <Label
                                                    Text="RL"
                                                    FontSize="18"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding NombreMostrar}"
                                                    FontSize="16"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding DescripcionMostrar}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="11.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8">
                                            <Border Style="{StaticResource ModernBadgeBlue}" Padding="9,7">
                                                <Label
                                                    Text="{Binding UsuariosTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ModernBadgeYellow}" Padding="9,7">
                                                <Label
                                                    Text="{Binding InterfacesTexto}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="2"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">
                                            <Button
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.ViewCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                IsVisible="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                IsVisible="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference RolPageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout
                                Padding="10,16,10,24"
                                Spacing="8"
                                HorizontalOptions="Center">
                                <ActivityIndicator
                                    IsRunning="{Binding CargandoMas}"
                                    IsVisible="{Binding CargandoMas}"
                                    Color="{StaticResource color_Verde}" />
                                <Label
                                    IsVisible="{Binding MostrarFinLista}"
                                    Text="Fin del listado"
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    Grid.RowSpan="2"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#36000000">
                    <Border
                        Padding="18,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeShape="RoundRectangle 15"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" />
                            <Label Text="Cargando..." FontFamily="MontserratBold" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
