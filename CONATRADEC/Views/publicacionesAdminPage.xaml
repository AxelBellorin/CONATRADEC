<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.publicacionesAdminPage"
    x:Name="PublicacionesAdminRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Administrar publicaciones"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid
            x:Name="ContenidoPrincipal"
            RowDefinitions="Auto,*">

            <!-- SearchBar estable fuera del CollectionView virtualizado. -->
            <VerticalStackLayout
                x:Name="EncabezadoAdminStack"
                Grid.Row="0"
                Margin="{OnIdiom Phone='12,12,12,10', Tablet='20,18,20,12', Desktop='28,22,28,14'}"
                Spacing="10">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid
                        x:Name="HeroAdminGrid"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="14"
                        RowSpacing="12">
                        <VerticalStackLayout
                            x:Name="HeroAdminTexto"
                            Spacing="4">
                            <Button
                                Text="← Noticias"
                                Command="{Binding RegresarCommand}"
                                Style="{StaticResource ModernLinkButton}"
                                HorizontalOptions="Start"
                                Margin="-8,-5,0,0" />
                            <Label
                                Text="Administrar publicaciones"
                                Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="Gestione noticias, eventos, vigencia y publicaciones destacadas."
                                Style="{StaticResource ModernPageSubtitle}" />
                            <Label
                                Text="{Binding TotalTexto}"
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="HeroAdminAcciones"
                            Grid.Column="1"
                            ColumnDefinitions="Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8"
                            HorizontalOptions="End"
                            VerticalOptions="End">
                            <Button
                                x:Name="EliminadasButton"
                                Text="Eliminadas"
                                Clicked="AbrirEliminadas_Clicked"
                                IsVisible="{Binding CanAdministrar}"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalOptions="Fill"
                                MinimumWidthRequest="0" />
                            <Button
                                x:Name="NuevaPublicacionButton"
                                Grid.Column="1"
                                Text="Nueva publicación"
                                Command="{Binding NuevaCommand}"
                                IsVisible="{Binding CanAdd}"
                                Style="{StaticResource ModernPrimaryButton}"
                                HorizontalOptions="Fill"
                                MinimumWidthRequest="0" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernCard}" Padding="8">
                    <Border Style="{StaticResource ModernInputBorder}">
                        <SearchBar
                            Placeholder="Buscar por título o contenido"
                            Text="{Binding TextoBusqueda, Mode=TwoWay}"
                            SearchCommand="{Binding BuscarCommand}"
                            Style="{StaticResource ModernSearchBar}" />
                    </Border>
                </Border>
            </VerticalStackLayout>

            <RefreshView
                Grid.Row="1"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    x:Name="PublicacionesCollection"
                    Margin="{OnIdiom Phone='12,0,12,20', Tablet='20,0,20,26', Desktop='28,0,28,30'}"
                    ItemsSource="{Binding Publicaciones}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="PublicacionesGrid"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="10"
                            Margin="0,0,0,14">

                            <Border Style="{StaticResource ModernCard}">
                                <Grid
                                    x:Name="FiltrosAdminGrid"
                                    ColumnDefinitions="*,*,Auto,Auto"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <Border
                                        x:Name="CategoriaFiltroBorder"
                                        Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            Title="Categoría"
                                            ItemsSource="{Binding Categorias}"
                                            ItemDisplayBinding="{Binding Nombre}"
                                            SelectedItem="{Binding CategoriaSeleccionada}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                    <Border
                                        x:Name="EstadoFiltroBorder"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            Title="Estado"
                                            ItemsSource="{Binding Estados}"
                                            SelectedItem="{Binding EstadoSeleccionado}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                    <Button
                                        x:Name="BuscarFiltroButton"
                                        Grid.Column="2"
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        MinimumWidthRequest="0" />
                                    <Button
                                        x:Name="LimpiarFiltroButton"
                                        Grid.Column="3"
                                        Text="Limpiar"
                                        Command="{Binding LimpiarFiltrosCommand}"
                                        Style="{StaticResource ModernNeutralButton}"
                                        MinimumWidthRequest="0" />
                                </Grid>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </Border>

                            <!--
                                Estado vacío independiente del EmptyView de
                                CollectionView para evitar capturas de interacción
                                en WinUI cuando una búsqueda no devuelve registros.
                            -->
                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                InputTransparent="True"
                                Style="{StaticResource ModernEmptyStateCard}"
                                Margin="0,8,0,12"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="560">
                                <VerticalStackLayout
                                    Spacing="8"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="No hay publicaciones administrativas"
                                        Style="{StaticResource ModernSectionTitle}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Cree una publicación o cambie los filtros."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PublicacionListadoResponse">
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                Padding="0"
                                MinimumHeightRequest="420">
                                <Grid RowDefinitions="142,Auto">
                                    <Grid
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}">
                                        <Label
                                            Text="CONATRADEC"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}" />
                                        <Image
                                            Source="{Binding ImagenPortadaUrl}"
                                            IsVisible="{Binding TieneImagen}"
                                            Aspect="AspectFill" />
                                    </Grid>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Padding="14"
                                        Spacing="7">
                                        <FlexLayout
                                            Direction="Row"
                                            Wrap="Wrap"
                                            AlignItems="Center">
                                            <Border
                                                Margin="0,0,5,5"
                                                Padding="7,3"
                                                BackgroundColor="{Binding CategoriaColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                                <Label
                                                    Text="{Binding Categoria}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="White" />
                                            </Border>
                                            <Border
                                                Margin="0,0,5,5"
                                                Style="{StaticResource ModernBadgeGreen}">
                                                <Label
                                                    Text="{Binding EstadoVisualTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                            <Border
                                                Margin="0,0,5,5"
                                                IsVisible="{Binding Destacada}"
                                                Style="{StaticResource ModernBadgeYellow}">
                                                <Label
                                                    Text="Destacada"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </Border>
                                        </FlexLayout>

                                        <Label
                                            Text="{Binding Titulo}"
                                            FontFamily="MontserratBold"
                                            FontSize="16.5"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Resumen}"
                                            FontFamily="MontserratMedium"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Autor, StringFormat='Creada por: {0}'}"
                                            Style="{StaticResource ModernCaption}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Grid
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="7"
                                            RowSpacing="7"
                                            Margin="0,4,0,0">
                                            <Button
                                                Text="Editar"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernUpdateButton}"
                                                MinimumWidthRequest="0" />
                                            <Button
                                                Grid.Column="1"
                                                Text="{Binding AccionEstadoTexto}"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CambiarEstadoCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernCoffeeButton}"
                                                MinimumWidthRequest="0" />
                                            <Button
                                                Grid.Row="1"
                                                Text="{Binding AccionDestacadaTexto}"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CambiarDestacadaCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                FontSize="10"
                                                MinimumWidthRequest="0" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="Eliminar"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanDelete}"
                                                Style="{StaticResource ModernDangerSoftButton}"
                                                MinimumWidthRequest="0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                x:Name="PaginacionAdmin"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="{OnIdiom Phone='12,12', Tablet='14,13', Desktop='16,14'}"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Pressed="PaginacionAdmin_Pressed"
                                            Clicked="PaginacionAdmin_Clicked"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Pressed="PaginacionAdmin_Pressed"
                                            Clicked="PaginacionAdmin_Clicked"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <BoxView
                                HeightRequest="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                Opacity="0" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <Grid
                Grid.RowSpan="2"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Actualizando publicaciones..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permisos de administración"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Necesita permiso de lectura y al menos permiso para agregar, actualizar o eliminar publicaciones."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
