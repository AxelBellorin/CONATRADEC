<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.publicacionesAdminPage"
    x:Name="PublicacionesAdminRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Administrar publicaciones"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid x:Name="ContenidoPrincipal">
            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    Margin="{OnIdiom Phone='12,12,12,20', Tablet='20,18,20,26', Desktop='28,22,28,30'}"
                    ItemsSource="{Binding Publicaciones}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem"
                    RemainingItemsThreshold="2"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="14" Margin="0,0,0,14">
                            <Border Style="{StaticResource ModernHeroCard}">
                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                                    RowSpacing="12"
                                    ColumnSpacing="14">
                                    <VerticalStackLayout Spacing="4">
                                        <Button
                                            Text="← Noticias"
                                            Command="{Binding RegresarCommand}"
                                            Style="{StaticResource ModernLinkButton}"
                                            HorizontalOptions="Start"
                                            Margin="-8,-5,0,0" />
                                        <Label
                                            Text="Administrar publicaciones"
                                            Style="{StaticResource ModernPageTitle}" />
                                        <Label
                                            Text="Gestione noticias, eventos, vigencia y publicaciones destacadas."
                                            Style="{StaticResource ModernPageSubtitle}" />
                                        <Label
                                            Text="{Binding TotalTexto}"
                                            Style="{StaticResource ModernCaption}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Text="Nueva publicación"
                                        Command="{Binding NuevaCommand}"
                                        IsVisible="{Binding CanAdd}"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                        VerticalOptions="End"
                                        MinimumWidthRequest="{OnIdiom Phone=0, Default=170}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ModernCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <SearchBar
                                            Placeholder="Buscar por título o contenido"
                                            Text="{Binding TextoBusqueda}"
                                            SearchCommand="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernSearchBar}" />
                                    </Border>

                                    <Grid
                                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                        ColumnDefinitions="{OnIdiom Phone='*,*', Default='1*,1*,Auto,Auto'}"
                                        ColumnSpacing="8"
                                        RowSpacing="8">
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                Title="Categoría"
                                                ItemsSource="{Binding Categorias}"
                                                ItemDisplayBinding="{Binding Nombre}"
                                                SelectedItem="{Binding CategoriaSeleccionada}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                Title="Estado"
                                                ItemsSource="{Binding Estados}"
                                                SelectedItem="{Binding EstadoSeleccionado}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>
                                        <Button
                                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                                            Grid.Column="{OnIdiom Phone=0, Default=2}"
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernPrimaryButton}" />
                                        <Button
                                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                                            Grid.Column="{OnIdiom Phone=1, Default=3}"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarFiltrosCommand}"
                                            Style="{StaticResource ModernNeutralButton}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PublicacionListadoResponse">
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                Padding="0"
                                MinimumHeightRequest="420">
                                <Grid RowDefinitions="142,Auto">
                                    <Grid
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}">
                                        <Label
                                            Text="CONATRADEC"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}" />
                                        <Image
                                            Source="{Binding ImagenPortadaUrl}"
                                            IsVisible="{Binding TieneImagen}"
                                            Aspect="AspectFill" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="7">
                                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                            <Border
                                                Margin="0,0,5,5"
                                                Padding="7,3"
                                                BackgroundColor="{Binding CategoriaColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                                <Label
                                                    Text="{Binding Categoria}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="White" />
                                            </Border>
                                            <Border
                                                Margin="0,0,5,5"
                                                Style="{StaticResource ModernBadgeGreen}">
                                                <Label
                                                    Text="{Binding EstadoVisualTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                            <Border
                                                Margin="0,0,5,5"
                                                IsVisible="{Binding Destacada}"
                                                Style="{StaticResource ModernBadgeYellow}">
                                                <Label
                                                    Text="Destacada"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </Border>
                                        </FlexLayout>

                                        <Label
                                            Text="{Binding Titulo}"
                                            FontFamily="MontserratBold"
                                            FontSize="16.5"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Resumen}"
                                            FontFamily="MontserratMedium"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Autor, StringFormat='Creada por: {0}'}"
                                            Style="{StaticResource ModernCaption}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Grid
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="7"
                                            RowSpacing="7"
                                            Margin="0,4,0,0">
                                            <Button
                                                Text="Editar"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernUpdateButton}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="{Binding AccionEstadoTexto}"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CambiarEstadoCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernCoffeeButton}" />
                                            <Button
                                                Grid.Row="1"
                                                Text="{Binding AccionDestacadaTexto}"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CambiarDestacadaCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                FontSize="10" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="Eliminar"
                                                Command="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PublicacionesAdminRoot}, Path=BindingContext.CanDelete}"
                                                Style="{StaticResource ModernDangerSoftButton}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Border
                            IsVisible="{Binding MostrarVacio}"
                            Style="{StaticResource ModernEmptyStateCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="No hay publicaciones administrativas"
                                    Style="{StaticResource ModernSectionTitle}"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="Cree una publicación o cambie los filtros."
                                    Style="{StaticResource ModernPageSubtitle}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,16,0,28" Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator
                                IsVisible="{Binding CargandoMas}"
                                IsRunning="{Binding CargandoMas}"
                                Color="{StaticResource color_Verde}" />
                            <Label
                                IsVisible="{Binding MostrarFinLista}"
                                Text="No hay más publicaciones."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Actualizando publicaciones..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permisos de administración"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Necesita permiso para agregar, actualizar o eliminar publicaciones."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
