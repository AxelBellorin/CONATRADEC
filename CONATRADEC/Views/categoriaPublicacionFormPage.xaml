<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.categoriaPublicacionFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Tipo de publicación"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid x:Name="ContenidoPrincipal">
            <ScrollView>
                <VerticalStackLayout
                    MaximumWidthRequest="860"
                    HorizontalOptions="Center"
                    Padding="{OnIdiom Phone='12,12,12,28', Tablet='20,18,20,32', Desktop='28,22,28,36'}"
                    Spacing="14">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="12"
                            ColumnSpacing="14">
                            <VerticalStackLayout Spacing="4">
                                <Button
                                    Text="← Cancelar"
                                    Command="{Binding CancelarCommand}"
                                    Style="{StaticResource ModernLinkButton}"
                                    HorizontalOptions="Start"
                                    Margin="-8,-5,0,0" />
                                <Label
                                    Text="{Binding TituloPagina}"
                                    Style="{StaticResource ModernPageTitle}" />
                                <Label
                                    Text="Defina el nombre, descripción, color y orden de presentación."
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="{Binding TextoBoton}"
                                Command="{Binding GuardarCommand}"
                                IsVisible="{Binding PuedeGuardar}"
                                Style="{StaticResource ModernPrimaryButton}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                VerticalOptions="End"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=150}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="16">
                            <Label
                                Text="Información del tipo"
                                Style="{StaticResource ModernSectionTitle}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nombre *" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        Text="{Binding Nombre}"
                                        Placeholder="Ejemplo: Capacitación"
                                        MaxLength="80"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Descripción" Style="{StaticResource ModernFieldLabel}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CaracteresDescripcion}"
                                        Style="{StaticResource ModernCaption}" />
                                </Grid>
                                <Border
                                    Style="{StaticResource ModernInputBorder}"
                                    Padding="10,8"
                                    MinimumHeightRequest="125">
                                    <Editor
                                        Text="{Binding Descripcion}"
                                        Placeholder="Explique qué clase de publicaciones utilizarán este tipo."
                                        MaxLength="250"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="105"
                                        FontFamily="MontserratMedium"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
                                </Border>
                            </VerticalStackLayout>

                            <Grid
                                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                ColumnSpacing="14"
                                RowSpacing="14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Color sugerido" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            Title="Seleccione un color"
                                            ItemsSource="{Binding Colores}"
                                            ItemDisplayBinding="{Binding Texto}"
                                            SelectedItem="{Binding ColorSeleccionado}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Spacing="6">
                                    <Label Text="Código hexadecimal *" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding ColorHex}"
                                            Placeholder="#3B655B"
                                            MaxLength="7"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Border Style="{StaticResource ModernSoftPanel}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border
                                        WidthRequest="68"
                                        HeightRequest="68"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                        StrokeShape="RoundRectangle 15">
                                        <Border
                                            BackgroundColor="{Binding ColorVistaPrevia}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="Vista previa" Style="{StaticResource ModernSectionTitle}" />
                                        <Label
                                            Text="Este color identificará el tipo en las tarjetas y filtros de Noticias."
                                            Style="{StaticResource ModernPageSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Orden *" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        Text="{Binding OrdenTexto}"
                                        Placeholder="1"
                                        Keyboard="Numeric"
                                        MaxLength="4"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                                <Label
                                    Text="Los números menores aparecen primero en los selectores."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Padding="0,2,0,0">
                        <Button
                            Text="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource ModernNeutralButton}" />
                        <Button
                            Grid.Column="1"
                            Text="{Binding TextoBoton}"
                            Command="{Binding GuardarCommand}"
                            IsVisible="{Binding PuedeGuardar}"
                            Style="{StaticResource ModernPrimaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Procesando categoría..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permiso"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para crear o editar tipos de publicación."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
