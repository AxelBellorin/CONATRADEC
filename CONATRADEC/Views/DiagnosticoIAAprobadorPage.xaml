<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAAprobadorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="Bandeja del aprobador"
                Subtitle="Apruebe, devuelva, rechace o declare inconclusa cada fotografía de manera independiente."
                BackText="Inspección fitosanitaria"
                BackCommand="{Binding RegresarCommand}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="12"
                    MaximumWidthRequest="1100"
                    HorizontalOptions="Center">

                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#263A35" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <Button
                        Text="Actualizar bandeja"
                        Command="{Binding ActualizarCommand}"
                        HorizontalOptions="End"
                        BackgroundColor="#EEF2F0"
                        TextColor="#263A35" />

                    <CollectionView
                        ItemsSource="{Binding Solicitudes}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFitosanitariaListaItemV2">
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        ColumnDefinitions="86,*,Auto"
                                        RowDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="5">
                                        <Image
                                            Grid.RowSpan="3"
                                            Source="{Binding UrlMiniatura}"
                                            HeightRequest="80"
                                            WidthRequest="80"
                                            Aspect="AspectFill" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding TerrenoTexto}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#263A35" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Resumen}"
                                            TextColor="#5E6B67" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding FechaTexto}"
                                            FontSize="12"
                                            TextColor="#7A8581" />
                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Grid.RowSpan="3"
                                            Spacing="7"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Estado}"
                                                FontAttributes="Bold"
                                                TextColor="#263A35"
                                                HorizontalTextAlignment="Center" />
                                            <Button
                                                Text="Tomar decisión"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#263A35"
                                                TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border
                        Padding="18"
                        BackgroundColor="#F2F6F4"
                        Stroke="#D9E3DF"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding SinSolicitudes}">
                        <Label
                            Text="No hay fotografías pendientes de aprobación."
                            HorizontalTextAlignment="Center"
                            TextColor="#5E6B67" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
