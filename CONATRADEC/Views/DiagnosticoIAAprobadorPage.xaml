<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAAprobadorPage"
    x:Name="PaginaAprobador"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="Bandeja del aprobador"
                Subtitle="{Binding SubtituloVista}"
                BackText="Inspección fitosanitaria"
                BackCommand="{Binding RegresarCommand}"
                IsPrimaryVisible="False" />

            <Grid
                Grid.Row="1"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="12"
                MaximumWidthRequest="1100"
                HorizontalOptions="Fill">

                <Border
                    Grid.Row="0"
                    Padding="{OnIdiom Phone=10, Default=12}"
                    BackgroundColor="#F2F7F5"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 13">
                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                        RowSpacing="8"
                        ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Vista de revisión"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Pendientes muestra el trabajo activo. Revisadas conserva el acceso posterior para administrar autorización y publicación en el Álbum Botánico."
                                FontSize="11"
                                TextColor="#5E6B67"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Grid
                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8"
                            HorizontalOptions="{OnIdiom Phone=Fill, Default=End}">
                            <Button
                                Grid.Column="0"
                                Text="Pendientes"
                                Command="{Binding VerPendientesCommand}"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=145}"
                                HeightRequest="42"
                                BackgroundColor="#E3EFEA"
                                TextColor="#315E52"
                                CornerRadius="9">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding MostrandoPendientes}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#263A35" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Text="Revisadas"
                                Command="{Binding VerRevisadasCommand}"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=145}"
                                HeightRequest="42"
                                BackgroundColor="#E3EFEA"
                                TextColor="#315E52"
                                CornerRadius="9">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding MostrandoRevisadas}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#263A35" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="{OnIdiom Phone=10, Default=12}"
                    BackgroundColor="White"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 13">
                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Default='Auto'}"
                        ColumnDefinitions="{OnIdiom Phone='*', Default='Auto,*,Auto'}"
                        RowSpacing="6"
                        ColumnSpacing="12">
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="1"
                            IsVisible="{Binding MostrarFiltroTecnico}"
                            VerticalOptions="Center">
                            <Label
                                Text="Técnico responsable"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="El filtro utiliza el identificador del técnico."
                                FontSize="11"
                                TextColor="#6B7773" />
                        </VerticalStackLayout>

                        <Button
                            x:Name="TecnicoSelectorButton"
                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            Text="{Binding TecnicoFiltroTexto}"
                            Clicked="OnSeleccionarTecnicoClicked"
                            IsVisible="{Binding MostrarFiltroTecnico}"
                            MinimumWidthRequest="{OnIdiom Phone=260, Default=360}"
                            HeightRequest="44"
                            Padding="14,8"
                            HorizontalOptions="Fill"
                            BackgroundColor="White"
                            BorderColor="#C9D4D0"
                            BorderWidth="1"
                            TextColor="#263A35"
                            CornerRadius="8" />

                        <Button
                            Grid.Row="{OnIdiom Phone=2, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=2}"
                            Text="Actualizar"
                            Command="{Binding ActualizarCommand}"
                            HeightRequest="44"
                            BackgroundColor="#EEF2F0"
                            TextColor="#263A35" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <CollectionView
                        ItemsSource="{Binding Solicitudes}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFitosanitariaBandejaItemV2">
                                <Border
                                    Padding="{OnIdiom Phone=12, Default=14}"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="{OnIdiom Phone='82,*', Default='86,*,Auto'}"
                                        ColumnSpacing="12"
                                        RowSpacing="10">
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            WidthRequest="{OnIdiom Phone=76, Default=80}"
                                            HeightRequest="{OnIdiom Phone=76, Default=80}"
                                            BackgroundColor="#EEF3F1"
                                            Stroke="#D4E1DC"
                                            StrokeShape="RoundRectangle 11">
                                            <Image
                                                Source="{Binding UrlMiniatura}"
                                                Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding NombreInspeccionTexto}"
                                                FontSize="{OnIdiom Phone=16, Default=18}"
                                                FontAttributes="Bold"
                                                TextColor="#263A35"
                                                LineBreakMode="WordWrap" />
                                            <Label
                                                Text="{Binding TerrenoTexto}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#3B655B" />
                                            <Label
                                                Text="{Binding TecnicoTexto, StringFormat='Técnico: {0}'}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#40544E"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding Resumen}"
                                                FontSize="12"
                                                TextColor="#5E6B67"
                                                LineBreakMode="WordWrap" />
                                            <Label
                                                Text="{Binding FechaTexto, StringFormat='Registrada: {0}'}"
                                                FontSize="12"
                                                TextColor="#7A8581" />
                                            <Label
                                                Text="{Binding AsignacionTexto}"
                                                FontSize="11"
                                                TextColor="#52665F"
                                                LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                                            Grid.Column="{OnIdiom Phone=0, Default=2}"
                                            Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}"
                                            Spacing="7"
                                            VerticalOptions="Center"
                                            HorizontalOptions="{OnIdiom Phone=Fill, Default=End}">
                                            <Label
                                                Text="{Binding EstadoTexto}"
                                                FontAttributes="Bold"
                                                TextColor="#263A35"
                                                HorizontalTextAlignment="Center" />
                                            <Button
                                                Text="Abrir revisión"
                                                Command="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.AbrirCommand}"
                                                CommandParameter="{Binding .}"
                                                HeightRequest="46"
                                                MinimumWidthRequest="{OnIdiom Phone=220, Default=170}"
                                                BackgroundColor="#263A35"
                                                TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout
                                Padding="0,14,0,4"
                                Spacing="8">
                                <ActivityIndicator
                                    IsRunning="{Binding CargandoMas}"
                                    IsVisible="{Binding CargandoMas}"
                                    Color="#3B655B" />
                                <Button
                                    Text="{Binding TextoCargarMas}"
                                    Command="{Binding CargarMasCommand}"
                                    IsVisible="{Binding HayMas}"
                                    HeightRequest="46"
                                    MaximumWidthRequest="360"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#EAF3EF"
                                    TextColor="#315E52"
                                    CornerRadius="11" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>

                    <Border
                        Padding="18"
                        VerticalOptions="Start"
                        BackgroundColor="#F2F6F4"
                        Stroke="#D9E3DF"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding SinSolicitudes}">
                        <Label
                            Text="{Binding TextoSinSolicitudes}"
                            HorizontalTextAlignment="Center"
                            TextColor="#5E6B67" />
                    </Border>

                    <Border
                        Padding="14"
                        Margin="0,4"
                        VerticalOptions="Start"
                        ZIndex="5"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#263A35" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
