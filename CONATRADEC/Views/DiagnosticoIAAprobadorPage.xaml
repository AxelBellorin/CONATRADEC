<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAAprobadorPage"
    x:Name="PaginaAprobador"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!--
                Encabezado, vistas, filtros y paginación pertenecen al mismo
                CollectionView para mantener un scroll natural en móvil.
            -->
            <CollectionView
                x:Name="AprobadorListado"
                ItemsSource="{Binding Solicitudes}"
                SelectionMode="None"
                HorizontalOptions="Fill"
                Margin="26,22,26,28">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout
                        Spacing="10"
                        Padding="0,0,0,12"
                        WidthRequest="{Binding Source={x:Reference AprobadorListado}, Path=Width}"
                        HorizontalOptions="Fill">

                        <controls:InspectionHeader
                            Title="Bandeja del aprobador"
                            Subtitle="{Binding SubtituloVista}"
                            BackText="Volver"
                            BackCommand="{Binding RegresarCommand}"
                            IsPrimaryVisible="False" />

                        <Border
                            Padding="12"
                            BackgroundColor="#F2F7F5"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 13">
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="Asignación de expedientes"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="Mis expedientes contiene únicamente los asignados a usted. Disponibles muestra los que todavía no tienen aprobador. Revisados conserva las decisiones técnicas ya emitidas y permite administrar posteriormente la clasificación, autorización y publicación del Álbum Botánico."
                                        FontSize="11"
                                        TextColor="#5E6B67"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <!-- Responde al ancho real, incluido WinUI angosto. -->
                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Stretch"
                                    JustifyContent="Start">
                                    <Button
                                        Text="Mis expedientes"
                                        Command="{Binding VerMisCommand}"
                                        MinimumWidthRequest="135"
                                        HeightRequest="42"
                                        Margin="0,0,6,6"
                                        Padding="8,5"
                                        FontSize="12"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="150"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#315E52"
                                        CornerRadius="9">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoMis}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#263A35" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Text="Disponibles"
                                        Command="{Binding VerDisponiblesCommand}"
                                        MinimumWidthRequest="125"
                                        HeightRequest="42"
                                        Margin="0,0,6,6"
                                        Padding="8,5"
                                        FontSize="12"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="140"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#315E52"
                                        CornerRadius="9">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoDisponibles}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#263A35" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Text="Revisados"
                                        Command="{Binding VerRevisadasCommand}"
                                        MinimumWidthRequest="125"
                                        HeightRequest="42"
                                        Margin="0,0,0,6"
                                        Padding="8,5"
                                        FontSize="12"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="140"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#315E52"
                                        CornerRadius="9">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoRevisadas}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#263A35" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Center"
                            JustifyContent="Start">
                            <VerticalStackLayout
                                MinimumWidthRequest="220"
                                Margin="0,0,8,8"
                                Spacing="0"
                                FlexLayout.Grow="1"
                                FlexLayout.Basis="420">
                                <Label
                                    Text="{Binding SubtituloVista}"
                                    FontAttributes="Bold"
                                    TextColor="#3B655B"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding ResumenFiltrosActivos}"
                                    FontSize="11"
                                    TextColor="#6B7773"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button
                                Text="{Binding TextoBotonFiltros}"
                                Command="{Binding AlternarFiltrosCommand}"
                                MinimumWidthRequest="150"
                                HeightRequest="44"
                                Margin="0,0,8,8"
                                FlexLayout.Basis="180"
                                BackgroundColor="#E3EFEA"
                                TextColor="#3B655B" />
                            <Button
                                Text="Actualizar"
                                Command="{Binding ActualizarCommand}"
                                MinimumWidthRequest="110"
                                HeightRequest="44"
                                Margin="0,0,0,8"
                                FlexLayout.Basis="125"
                                BackgroundColor="#EEF2F0"
                                TextColor="#263A35" />
                        </FlexLayout>

                        <Border
                            Padding="12"
                            IsVisible="{Binding FiltrosExpandidos}"
                            BackgroundColor="White"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 13">
                            <VerticalStackLayout Spacing="10">
                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Stretch"
                                    JustifyContent="Start">
                                    <Entry
                                        Text="{Binding BuscarInspeccion}"
                                        Placeholder="Nombre, terreno, propietario, técnico, ubicación o archivo"
                                        ReturnType="Search"
                                        ReturnCommand="{Binding BuscarCommand}"
                                        ClearButtonVisibility="WhileEditing"
                                        MinimumWidthRequest="220"
                                        HeightRequest="44"
                                        Margin="0,0,8,8"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="430" />
                                    <Button
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        MinimumWidthRequest="110"
                                        HeightRequest="44"
                                        Margin="0,0,0,8"
                                        FlexLayout.Basis="130"
                                        BackgroundColor="#263A35"
                                        TextColor="White" />
                                </FlexLayout>

                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="End" JustifyContent="Start">
                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="220" FlexLayout.Grow="1" FlexLayout.Basis="260">
                                        <Label Text="Técnico responsable" FontSize="12" FontAttributes="Bold" TextColor="#263A35" />
                                        <Button
                                            x:Name="TecnicoSelectorButton"
                                            Text="{Binding TecnicoFiltroTexto}"
                                            Clicked="OnSeleccionarTecnicoClicked"
                                            HeightRequest="42"
                                            Padding="12,6"
                                            HorizontalOptions="Fill"
                                            BackgroundColor="White"
                                            BorderColor="#C9D4D0"
                                            BorderWidth="1"
                                            TextColor="#263A35"
                                            CornerRadius="8" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="210" FlexLayout.Grow="1" FlexLayout.Basis="235">
                                        <Label Text="Propietario" FontSize="12" FontAttributes="Bold" TextColor="#263A35" />
                                        <Entry Text="{Binding PropietarioFiltro}" Placeholder="Nombre o identificación" ReturnType="Search" ReturnCommand="{Binding BuscarCommand}" HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="190" FlexLayout.Grow="1" FlexLayout.Basis="215">
                                        <Label Text="Departamento" FontSize="12" FontAttributes="Bold" TextColor="#263A35" />
                                        <Entry Text="{Binding DepartamentoFiltro}" Placeholder="Ej. Matagalpa" ReturnType="Search" ReturnCommand="{Binding BuscarCommand}" HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="200" FlexLayout.Grow="1" FlexLayout.Basis="225">
                                        <Label Text="Tipo de fotografía" FontSize="12" FontAttributes="Bold" TextColor="#263A35" />
                                        <Picker ItemsSource="{Binding TiposFotografiaFiltro}" ItemDisplayBinding="{Binding Nombre}" SelectedItem="{Binding TipoFotografiaFiltroSeleccionado}" HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="205" FlexLayout.Grow="1" FlexLayout.Basis="235">
                                        <Label Text="Estado" FontSize="12" FontAttributes="Bold" TextColor="#263A35" />
                                        <Picker ItemsSource="{Binding EstadosFiltro}" ItemDisplayBinding="{Binding Nombre}" SelectedItem="{Binding EstadoFiltroSeleccionado}" HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,8,8" Spacing="3" MinimumWidthRequest="200" FlexLayout.Grow="1" FlexLayout.Basis="220">
                                        <HorizontalStackLayout Spacing="4">
                                            <CheckBox IsChecked="{Binding UsarFechaDesde}" Color="#3B655B" VerticalOptions="Center" />
                                            <Label Text="Registro desde" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="#263A35" />
                                        </HorizontalStackLayout>
                                        <DatePicker Date="{Binding FechaDesde}" IsVisible="{Binding UsarFechaDesde}" MinimumDate="{Binding FechaMinimaFiltro}" MaximumDate="{Binding FechaMaximaFiltro}" Format="dd/MM/yyyy" HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Margin="0,0,0,8" Spacing="3" MinimumWidthRequest="200" FlexLayout.Grow="1" FlexLayout.Basis="220">
                                        <HorizontalStackLayout Spacing="4">
                                            <CheckBox IsChecked="{Binding UsarFechaHasta}" Color="#3B655B" VerticalOptions="Center" />
                                            <Label Text="Registro hasta" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="#263A35" />
                                        </HorizontalStackLayout>
                                        <DatePicker Date="{Binding FechaHasta}" IsVisible="{Binding UsarFechaHasta}" MinimumDate="{Binding FechaMinimaFiltro}" MaximumDate="{Binding FechaMaximaFiltro}" Format="dd/MM/yyyy" HeightRequest="42" />
                                    </VerticalStackLayout>
                                </FlexLayout>

                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                                    <Label
                                        Text="Escribir o seleccionar filtros no consulta el servidor. Pulse Buscar para aplicarlos. Las fechas usan la zona horaria del dispositivo."
                                        MinimumWidthRequest="220"
                                        Margin="0,0,8,8"
                                        FontSize="11"
                                        TextColor="#6B7773"
                                        LineBreakMode="WordWrap"
                                        FlexLayout.Grow="1"
                                        FlexLayout.Basis="420" />
                                    <Button
                                        Text="Limpiar filtros"
                                        Command="{Binding LimpiarFiltrosCommand}"
                                        MinimumWidthRequest="135"
                                        HeightRequest="40"
                                        Margin="0,0,0,8"
                                        Padding="10,5"
                                        FlexLayout.Basis="155"
                                        BackgroundColor="#F5F7F6"
                                        TextColor="#5E6B67" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Padding="12"
                            BackgroundColor="#FFF9E8"
                            Stroke="#E2B93B"
                            StrokeShape="RoundRectangle 13"
                            IsVisible="{Binding TieneMensajeEstado}">
                            <Label Text="{Binding MensajeEstado}" TextColor="#6B5710" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InspeccionFitosanitariaBandejaItemV2">
                        <Border
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 14"
                            HorizontalOptions="Fill">
                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" JustifyContent="SpaceBetween">
                                <Border
                                    Margin="0,0,12,8"
                                    WidthRequest="86"
                                    HeightRequest="86"
                                    BackgroundColor="#EEF3F1"
                                    Stroke="#D4E1DC"
                                    StrokeShape="RoundRectangle 11">
                                    <Image Source="{Binding UrlMiniatura}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout
                                    Margin="0,0,12,8"
                                    Spacing="3"
                                    MinimumWidthRequest="220"
                                    FlexLayout.Grow="1"
                                    FlexLayout.Basis="430">
                                    <Label Text="{Binding NombreInspeccionTexto}" FontSize="18" FontAttributes="Bold" TextColor="#263A35" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding TerrenoTexto}" FontSize="13" FontAttributes="Bold" TextColor="#3B655B" />
                                    <Label Text="{Binding TecnicoTexto, StringFormat='Técnico: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#40544E" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PropietarioTexto, StringFormat='Propietario: {0}'}" FontSize="12" TextColor="#5E6B67" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding UbicacionTexto}" FontSize="11" TextColor="#6B7773" />
                                    <Label Text="{Binding Resumen}" FontSize="12" TextColor="#5E6B67" LineBreakMode="WordWrap" />
                                    <Label
                                        Text="{Binding AyudaAlbumAprobador}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#7A5A13"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding TieneGestionPosteriorAlbum}" />
                                    <Label Text="{Binding FechaTexto, StringFormat='Registrada: {0}'}" FontSize="12" TextColor="#7A8581" />
                                    <Label Text="{Binding AsignacionTexto}" FontSize="11" TextColor="#52665F" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Margin="0,0,0,8"
                                    Spacing="7"
                                    MinimumWidthRequest="180"
                                    FlexLayout.Grow="1"
                                    FlexLayout.Basis="210">
                                    <Border Padding="10,6" BackgroundColor="{Binding EstadoFondo}" Stroke="#D9E3DF" StrokeShape="RoundRectangle 10">
                                        <Label Text="{Binding EstadoTexto}" FontAttributes="Bold" TextColor="{Binding EstadoColor}" HorizontalTextAlignment="Center" />
                                    </Border>

                                    <Button
                                        Text="{Binding TextoAbrirAprobador}"
                                        Command="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.AbrirCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="46"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="#263A35"
                                        TextColor="White"
                                        IsVisible="True">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.MostrandoDisponibles}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button
                                        Text="Tomar expediente"
                                        Command="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.TomarCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="46"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="#3B655B"
                                        TextColor="White"
                                        IsVisible="False"
                                        IsEnabled="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.PuedeTomarExpediente}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference PaginaAprobador}, Path=BindingContext.MostrandoDisponibles}" Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </VerticalStackLayout>
                            </FlexLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,14,0,4" Spacing="10">
                        <Border
                            Padding="18"
                            BackgroundColor="#F2F6F4"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 14"
                            IsVisible="{Binding SinSolicitudes}">
                            <Label Text="{Binding TextoSinSolicitudes}" HorizontalTextAlignment="Center" TextColor="#5E6B67" />
                        </Border>

                        <Border
                            Padding="12"
                            BackgroundColor="#F7FAF9"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 13"
                            IsVisible="{Binding TieneResultados}">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding ResumenResultados}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#52665F" />
                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Center"
                                    JustifyContent="Center">
                                    <Button
                                        Text="← Anterior"
                                        Command="{Binding PaginaAnteriorCommand}"
                                        MinimumWidthRequest="120"
                                        HeightRequest="44"
                                        Margin="0,0,8,8"
                                        Padding="12,7"
                                        FlexLayout.Basis="145"
                                        BackgroundColor="#EAF3EF"
                                        TextColor="#315E52"
                                        CornerRadius="10" />
                                    <Label
                                        Text="{Binding TextoPagina}"
                                        MinimumWidthRequest="120"
                                        Margin="0,0,8,8"
                                        Padding="10,7"
                                        FlexLayout.Basis="150"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="#263A35" />
                                    <Button
                                        Text="Siguiente →"
                                        Command="{Binding PaginaSiguienteCommand}"
                                        MinimumWidthRequest="120"
                                        HeightRequest="44"
                                        Margin="0,0,0,8"
                                        Padding="12,7"
                                        FlexLayout.Basis="145"
                                        BackgroundColor="#EAF3EF"
                                        TextColor="#315E52"
                                        CornerRadius="10" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                ZIndex="50"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#55000000"
                InputTransparent="False">
                <Border
                    Padding="22"
                    BackgroundColor="White"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="320">
                    <VerticalStackLayout Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#263A35" WidthRequest="40" HeightRequest="40" />
                        <Label Text="Actualizando aprobaciones..." FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#263A35" />
                        <Label Text="{Binding MensajeEstado}" FontSize="12" HorizontalTextAlignment="Center" TextColor="#5E6B67" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
