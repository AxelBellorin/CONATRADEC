<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietariosPage"
    x:Name="PropietariosPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>

            <!-- Acceso denegado únicamente para administración.
                 El modo selector de Terrenos conserva su acceso especializado. -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="{OnIdiom Phone=16, Tablet=24, Desktop=28}">

                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="70"
                            HeightRequest="70">
                            <Label
                                Text="PR"
                                FontFamily="MontserratBold"
                                FontSize="20"
                                TextColor="{StaticResource color_Verde}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="21"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar propietarios."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido principal -->
            <Grid
                x:Name="ContenidoPropietarios"
                IsVisible="{Binding PuedeMostrarContenido}"
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}">

                <RefreshView
                    Command="{Binding ActualizarCommand}"
                    IsRefreshing="{Binding IsRefreshing}">

                    <CollectionView
                        x:Name="PropietariosCollectionView"
                        ItemsSource="{Binding Propietarios}"
                        SelectionMode="None">

                        <CollectionView.Header>
                            <VerticalStackLayout
                                Padding="0,0,0,12"
                                Spacing="12">

                                <controls:ResponsiveCatalogHeader
                                    Title="{Binding Titulo}"
                                    Subtitle="Una persona se registra una sola vez y puede tener varios terrenos."
                                    BackText="{Binding TextoRegresar, StringFormat='← {0}'}"
                                    BackCommand="{Binding RegresarCommand}"
                                    PrimaryText="+ Nuevo propietario"
                                    PrimaryCommand="{Binding NuevoCommand}"
                                    IsPrimaryVisible="{Binding CanAdd}" />

                                <controls:ResponsiveSearchPanel
                                    Placeholder="Nombre, identificación o correo"
                                    SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                                    SummaryText="{Binding ResumenResultados}"
                                    SearchCommand="{Binding BuscarCommand}"
                                    ClearCommand="{Binding LimpiarFiltrosCommand}" />

                                <Border
                                    IsVisible="{Binding EsModoSeleccion}"
                                    Style="{StaticResource ModernInfoBanner}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            BackgroundColor="{StaticResource color_Verde}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                            <Label
                                                Text="✓"
                                                FontFamily="MontserratBold"
                                                FontSize="15"
                                                TextColor="White"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <Label
                                            Grid.Column="1"
                                            Text="Seleccione una tarjeta para asignar ese propietario al terreno."
                                            FontFamily="MontserratBold"
                                            FontSize="11.5"
                                            TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                            LineBreakMode="WordWrap"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Estado vacío dentro del encabezado para evitar
                                     que EmptyView capture la superficie en WinUI. -->
                                <Border
                                    IsVisible="{Binding MostrarListaVacia}"
                                    InputTransparent="True"
                                    Style="{StaticResource ModernEmptyStateCard}"
                                    Margin="0,8,0,12"
                                    MaximumWidthRequest="560"
                                    HorizontalOptions="Center">

                                    <VerticalStackLayout
                                        Spacing="8"
                                        HorizontalOptions="Center">

                                        <Border
                                            Style="{StaticResource ModernIconTile}"
                                            WidthRequest="54"
                                            HeightRequest="54">
                                            <Label
                                                Text="PR"
                                                FontFamily="MontserratBold"
                                                FontSize="16"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <Label
                                            Text="No hay propietarios para mostrar"
                                            Style="{StaticResource ModernSectionTitle}"
                                            FontSize="17"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Text="Cambie la búsqueda o registre un nuevo propietario."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="PropietariosGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropietarioResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="230"
                                    HorizontalOptions="Fill">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.AbrirCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="13"
                                        HorizontalOptions="Fill">

                                        <!-- Identidad -->
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12"
                                            HorizontalOptions="Fill">

                                            <Border
                                                WidthRequest="60"
                                                HeightRequest="60"
                                                Style="{StaticResource ModernIconTile}">
                                                <Label
                                                    Text="PR"
                                                    FontFamily="MontserratBold"
                                                    FontSize="18"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding TextoPrincipal}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="16"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TextoContacto}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                VerticalOptions="Start"
                                                HorizontalOptions="End">
                                                <Label
                                                    Text="Activo"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9.5"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                        </Grid>

                                        <!-- Resumen -->
                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8"
                                            HorizontalOptions="Fill">

                                            <Border
                                                Grid.Column="0"
                                                Style="{StaticResource ModernBadgeYellow}"
                                                Padding="9,7"
                                                HorizontalOptions="Fill">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label
                                                        Text="IDENTIFICACIÓN"
                                                        FontFamily="MontserratBold"
                                                        FontSize="8.5"
                                                        HorizontalTextAlignment="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Text="{Binding TextoIdentificacion}"
                                                        FontFamily="MontserratMedium"
                                                        FontSize="10.5"
                                                        HorizontalTextAlignment="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource ModernBadgeBlue}"
                                                Padding="9,7"
                                                HorizontalOptions="Fill">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label
                                                        Text="TERRENOS"
                                                        FontFamily="MontserratBold"
                                                        FontSize="8.5"
                                                        HorizontalTextAlignment="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
                                                    <Label
                                                        Text="{Binding TextoTerrenos}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="10.5"
                                                        HorizontalTextAlignment="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <!-- Acciones administrativas.
                                             MinimumWidthRequest=0 evita desborde nativo de WinUI. -->
                                        <Grid
                                            Grid.Row="2"
                                            IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.MostrarAccionesAdministracion}"
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,*,*"
                                            RowSpacing="8"
                                            ColumnSpacing="6"
                                            HorizontalOptions="Fill">

                                            <Button
                                                Grid.Column="0"
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="6,8"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="6,8"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="6,8"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanDelete}" />

                                            <Button
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Text="{Binding TextoBotonTerrenos}"
                                                Style="{StaticResource ModernCoffeeButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerTerrenosCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding TieneTerrenos}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Paginación explícita: solo la página visible permanece
                             en memoria y Anterior/Siguiente consultan al servidor. -->
                        <CollectionView.Footer>
                            <Border
                                x:Name="PaginacionPropietarios"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="{OnIdiom Phone='12,12', Tablet='14,13', Desktop='16,14'}"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="8">

                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Pressed="PaginacionPropietarios_Pressed"
                                            Clicked="PaginacionPropietarios_Clicked"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Pressed="PaginacionPropietarios_Pressed"
                                            Clicked="PaginacionPropietarios_Clicked"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <!-- Relay consistente con Usuarios/Terrenos -->
            <Grid
                IsVisible="{Binding MostrandoRelay}"
                InputTransparent="False"
                BackgroundColor="#66000000"
                ZIndex="100">

                <Border
                    Padding="22,18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding MostrandoRelay}"
                            Color="{StaticResource color_Naranja}"
                            WidthRequest="26"
                            HeightRequest="26" />

                        <VerticalStackLayout
                            Spacing="1"
                            VerticalOptions="Center">
                            <Label
                                Text="{Binding TituloRelay}"
                                FontFamily="MontserratBold"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label
                                Text="{Binding DetalleRelay}"
                                FontFamily="MontserratMedium"
                                FontSize="10"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
