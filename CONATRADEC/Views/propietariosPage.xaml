<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietariosPage"
    x:Name="PropietariosPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <Grid
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
                RowDefinitions="*"
                RowSpacing="12">

                <RefreshView
                    Grid.Row="0"
                    Command="{Binding ActualizarCommand}"
                    IsRefreshing="{Binding IsRefreshing}">

                    <CollectionView
                        ItemsSource="{Binding Propietarios}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                        <CollectionView.Header>
                            <VerticalStackLayout
                                Padding="0,0,0,12"
                                Spacing="12">
                                <controls:ResponsiveCatalogHeader
                                                    Title="{Binding Titulo}"
                                                    Subtitle="Una persona se registra una sola vez y puede tener varios terrenos."
                                                    BackText="{Binding TextoRegresar, StringFormat='← {0}'}"
                                                    BackCommand="{Binding RegresarCommand}"
                                                    PrimaryText="+ Nuevo propietario"
                                                    PrimaryCommand="{Binding NuevoCommand}"
                                                    IsPrimaryVisible="{Binding CanAdd}" />
                                
                                                <!-- Búsqueda -->
                                                <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="12">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Border Style="{StaticResource ModernInputBorder}" Padding="6,0">
                                                            <SearchBar
                                                                Placeholder="Buscar por nombre, identificación o correo"
                                                                Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                                                SearchCommand="{Binding BuscarCommand}"
                                                                Style="{StaticResource ModernSearchBar}" />
                                                        </Border>
                                
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="Buscar"
                                                            Command="{Binding BuscarCommand}"
                                                            Style="{StaticResource ModernPrimaryButton}"
                                                            HeightRequest="48"
                                                            Padding="14,9" />
                                                    </Grid>
                                                </Border>
                                
                                                <!-- Modo selección -->
                                                <Border
                                                    IsVisible="{Binding EsModoSeleccion}"
                                                    Style="{StaticResource ModernInfoBanner}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            BackgroundColor="{StaticResource color_Verde}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Label
                                                                Text="✓"
                                                                FontFamily="MontserratBold"
                                                                FontSize="15"
                                                                TextColor="White"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center" />
                                                        </Border>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="Seleccione una tarjeta para asignar ese propietario al terreno."
                                                            FontFamily="MontserratBold"
                                                            FontSize="11.5"
                                                            TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                                            VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                
                                                <!-- Recuperación de eliminados -->
                                                <Border
                                                    IsVisible="{Binding MostrarFiltroEliminados}"
                                                    Style="{StaticResource ModernWarningBanner}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                            <Label
                                                                Text="Mostrar propietarios eliminados"
                                                                Style="{StaticResource ModernSectionTitle}"
                                                                FontSize="13" />
                                                            <Label
                                                                Text="Permite recuperar registros eliminados sin perder su historial."
                                                                Style="{StaticResource ModernPageSubtitle}"
                                                                FontSize="10.5" />
                                                        </VerticalStackLayout>
                                                        <Switch
                                                            Grid.Column="1"
                                                            IsToggled="{Binding MostrarEliminados, Mode=TwoWay}"
                                                            OnColor="{StaticResource color_Verde}"
                                                            VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.Behaviors>
                            <controls:ResponsiveGridItemsLayoutBehavior />
                        </CollectionView.Behaviors>

                        <CollectionView.EmptyView>
                            <Grid Padding="12,24">
                                <Border Style="{StaticResource ModernEmptyStateCard}">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Border
                                            Style="{StaticResource ModernIconTile}"
                                            WidthRequest="54"
                                            HeightRequest="54">
                                            <Label
                                                Text="PR"
                                                FontFamily="MontserratBold"
                                                FontSize="16"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            Text="No hay propietarios para mostrar"
                                            Style="{StaticResource ModernSectionTitle}"
                                            FontSize="17"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Cambie el texto de búsqueda o actualice el listado."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropietarioResponse">
                                <Border Style="{StaticResource ModernCatalogCard}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Activo}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF9F3, Dark=#30271F}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#EBC9AA, Dark=#664A35}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.AbrirCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Style="{StaticResource ModernIconTile}">
                                                <Label
                                                    Text="PR"
                                                    FontSize="18"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding TextoPrincipal}"
                                                    FontSize="16"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding TextoIdentificacion}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_Verde}" />
                                                <Label
                                                    Text="{Binding TextoContacto}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding TextoTerrenos}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10.5"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                VerticalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FDE8D5, Dark=#493123}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label
                                                    Text="{Binding TextoEstado}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9.5"
                                                    TextColor="#276749">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="TextColor" Value="#B25B2B" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.MostrarAccionesAdministracion}">

                                            <Grid
                                                IsVisible="{Binding Activo}"
                                                RowDefinitions="Auto,Auto"
                                                ColumnDefinitions="*,*,*"
                                                RowSpacing="8"
                                                ColumnSpacing="8">
                                                <Button
                                                    Text="Ver"
                                                    Style="{StaticResource ModernSecondaryButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Editar"
                                                    Style="{StaticResource ModernUpdateButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EditarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Text="Eliminar"
                                                    Style="{StaticResource ModernDangerButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EliminarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanDelete}" />
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="3"
                                                    Text="{Binding TextoBotonTerrenos}"
                                                    Style="{StaticResource ModernCoffeeButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerTerrenosCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding TieneTerrenos}" />
                                            </Grid>

                                            <Grid
                                                IsVisible="{Binding EstaInactivo}"
                                                RowDefinitions="Auto,Auto"
                                                ColumnDefinitions="*,*"
                                                RowSpacing="8"
                                                ColumnSpacing="8">
                                                <Button
                                                    Text="Ver"
                                                    Style="{StaticResource ModernCoffeeButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Recuperar"
                                                    Style="{StaticResource ModernPrimaryButton}"
                                                    HeightRequest="44"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.RecuperarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding TextoBotonTerrenos}"
                                                    Style="{StaticResource ModernCoffeeButton}"
                                                    Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerTerrenosCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding TieneTerrenos}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout
                                Padding="8,16,8,28"
                                Spacing="7"
                                HorizontalOptions="Center">
                                <ActivityIndicator
                                    IsVisible="{Binding CargandoMas}"
                                    IsRunning="{Binding CargandoMas}"
                                    Color="{StaticResource color_Verde}" />
                                <Label
                                    Text="{Binding ResumenResultados}"
                                    FontFamily="MontserratBold"
                                    FontSize="10.5"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    IsVisible="{Binding MostrarFinLista}"
                                    Text="Fin de la lista"
                                    Style="{StaticResource ModernCaption}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    Grid.RowSpan="1"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#36000000">
                    <Border
                        Padding="18,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeShape="RoundRectangle 15"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" />
                            <Label Text="Cargando..." FontFamily="MontserratBold" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
