<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietariosPage"
    x:Name="PropietariosPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <Grid
                Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="14">

                <controls:ResponsiveCatalogHeader
                    Grid.Row="0"
                    Title="{Binding Titulo}"
                    Subtitle="Una persona se registra una sola vez y puede tener varios terrenos."
                    BackText="{Binding TextoRegresar, StringFormat='← {0}'}"
                    BackCommand="{Binding RegresarCommand}"
                    PrimaryText="+ Nuevo propietario"
                    PrimaryCommand="{Binding NuevoCommand}"
                    IsPrimaryVisible="{Binding CanAdd}" />

                <SearchBar
                    Grid.Row="1"
                    Placeholder="Buscar por nombre, identificación o correo"
                    Text="{Binding TextoBusqueda, Mode=TwoWay}"
                    SearchCommand="{Binding BuscarCommand}"
                    BackgroundColor="#F8FAF9"
                    TextColor="{StaticResource color_Negro}"
                    PlaceholderColor="{StaticResource color_Gris}" />

                <Border
                    Grid.Row="2"
                    IsVisible="{Binding EsModoSeleccion}"
                    Padding="11"
                    BackgroundColor="#EEF5F2"
                    Stroke="#C9DDD6"
                    StrokeShape="RoundRectangle 11">

                    <Label
                        Text="Seleccione una tarjeta para asignar ese propietario al terreno."
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource color_Verde}" />
                </Border>

                <Border
                    Grid.Row="2"
                    IsVisible="{Binding MostrarFiltroEliminados}"
                    Padding="12"
                    BackgroundColor="#FFFDF8"
                    Stroke="#E7DDC8"
                    StrokeShape="RoundRectangle 12">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="14">

                        <VerticalStackLayout
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                Text="Mostrar propietarios eliminados"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />

                            <Label
                                Text="Permite recuperar registros eliminados sin perder su historial."
                                FontSize="11"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>

                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding MostrarEliminados, Mode=TwoWay}"
                            OnColor="{StaticResource color_Verde}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <RefreshView
                    Grid.Row="3"
                    Command="{Binding ActualizarCommand}"
                    IsRefreshing="{Binding IsBusy}">

                    <CollectionView
                        ItemsSource="{Binding Propietarios}"
                        SelectionMode="None"
                        EmptyView="No hay propietarios para mostrar.">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropietarioResponse">
                                <Border
                                    Padding="16"
                                    BackgroundColor="White"
                                    Stroke="#DDE7E3"
                                    StrokeShape="RoundRectangle 16">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Activo}"
                                            Value="False">

                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#FFF8F1" />

                                            <Setter
                                                Property="Stroke"
                                                Value="#F4C999" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.AbrirCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="12">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">

                                            <Border
                                                WidthRequest="58"
                                                HeightRequest="58"
                                                BackgroundColor="#EEF5F2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 15">

                                                <Label
                                                    Text="PR"
                                                    FontSize="18"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding TextoPrincipal}"
                                                    FontSize="17"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TextoIdentificacion}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}" />

                                                <Label
                                                    Text="{Binding TextoContacto}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_GrisOscuro}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TextoTerrenos}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Padding="10,5"
                                                BackgroundColor="#E7F4EC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Start">

                                                <Border.Triggers>
                                                    <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding Activo}"
                                                        Value="False">

                                                        <Setter
                                                            Property="BackgroundColor"
                                                            Value="#FDE7D3" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Label
                                                    Text="{Binding TextoEstado}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#276749">

                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Activo}"
                                                            Value="False">

                                                            <Setter
                                                                Property="TextColor"
                                                                Value="#9C4221" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.MostrarAccionesAdministracion}">

                                            <!-- Acciones de propietarios activos. -->
                                            <Grid
                                                IsVisible="{Binding Activo}"
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,*,*"
                                            RowSpacing="8"
                                            ColumnSpacing="8">

                                            <Button
                                                Text="Ver"
                                                Padding="8,9"
                                                BackgroundColor="#EEF5F2"
                                                TextColor="{StaticResource color_Verde}"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource BlueUpdate}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource RedDelete}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanDelete}" />

                                            <Button
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Text="{Binding TextoBotonTerrenos}"
                                                Padding="10,10"
                                                BackgroundColor="#F4EDE7"
                                                TextColor="{StaticResource color_Cafe}"
                                                BorderColor="#D9C5B5"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerTerrenosCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding TieneTerrenos}" />
                                        </Grid>

                                            <!-- Acciones de propietarios eliminados. -->
                                            <Grid
                                                IsVisible="{Binding EstaInactivo}"
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,*"
                                            RowSpacing="8"
                                            ColumnSpacing="8">

                                            <Button
                                                Text="Ver"
                                                Padding="8,9"
                                                BackgroundColor="#F4EDE7"
                                                TextColor="{StaticResource color_Cafe}"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Recuperar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource color_Verde}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.RecuperarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />

                                            <Button
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding TextoBotonTerrenos}"
                                                Padding="10,10"
                                                BackgroundColor="#FDE7D3"
                                                TextColor="#9C4221"
                                                BorderColor="#F4C999"
                                                BorderWidth="1"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerTerrenosCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding TieneTerrenos}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <Grid
                    Grid.RowSpan="4"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#40FFFFFF">

                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource color_Naranja}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
