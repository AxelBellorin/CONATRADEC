<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietariosPage"
    x:Name="PropietariosPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <!--
        Propietarios es una ruta secundaria porque también se abre desde el
        formulario de Terreno. Se oculta expresamente la flecha nativa de Shell
        para conservar un solo botón de regreso dentro del catálogo.
    -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <Grid
                Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="14">

                <controls:ResponsiveCatalogHeader
                    Grid.Row="0"
                    Title="{Binding Titulo}"
                    Subtitle="Una persona se registra una sola vez y puede tener varios terrenos."
                    BackText="{Binding TextoRegresar, StringFormat='← {0}'}"
                    BackCommand="{Binding RegresarCommand}"
                    PrimaryText="+ Nuevo propietario"
                    PrimaryCommand="{Binding NuevoCommand}"
                    IsPrimaryVisible="{Binding CanAdd}" />

                <SearchBar
                    Grid.Row="1"
                    Placeholder="Buscar por nombre, identificación o correo"
                    Text="{Binding TextoBusqueda, Mode=TwoWay}"
                    SearchCommand="{Binding BuscarCommand}"
                    BackgroundColor="#F8FAF9"
                    TextColor="{StaticResource color_Negro}"
                    PlaceholderColor="{StaticResource color_Gris}" />

                <Border
                    Grid.Row="2"
                    IsVisible="{Binding EsModoSeleccion}"
                    Padding="11"
                    BackgroundColor="#EEF5F2"
                    Stroke="#C9DDD6"
                    StrokeShape="RoundRectangle 11">

                    <Label
                        Text="Seleccione una tarjeta para asignar ese propietario al terreno."
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource color_Verde}" />
                </Border>

                <RefreshView
                    Grid.Row="3"
                    Command="{Binding ActualizarCommand}"
                    IsRefreshing="{Binding IsBusy}">

                    <CollectionView
                        ItemsSource="{Binding Propietarios}"
                        SelectionMode="None"
                        EmptyView="No hay propietarios para mostrar.">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropietarioResponse">
                                <Border
                                    Padding="16"
                                    BackgroundColor="White"
                                    Stroke="#DDE7E3"
                                    StrokeShape="RoundRectangle 16">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.AbrirCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="12">

                                        <Grid
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="12">

                                            <Border
                                                WidthRequest="58"
                                                HeightRequest="58"
                                                BackgroundColor="#EEF5F2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 15">

                                                <Label
                                                    Text="PR"
                                                    FontSize="18"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding TextoPrincipal}"
                                                    FontSize="17"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TextoIdentificacion}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}" />

                                                <Label
                                                    Text="{Binding TextoContacto}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_GrisOscuro}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TextoTerrenos}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.MostrarAccionesAdministracion}"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">

                                            <Button
                                                Text="Ver"
                                                Padding="8,9"
                                                BackgroundColor="#EEF5F2"
                                                TextColor="{StaticResource color_Verde}"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.VerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanView}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource BlueUpdate}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanEdit}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource RedDelete}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference PropietariosPageRoot}, Path=BindingContext.CanDelete}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <Grid
                    Grid.RowSpan="4"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#40FFFFFF">

                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource color_Naranja}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
