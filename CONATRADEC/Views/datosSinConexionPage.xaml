<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.datosSinConexionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Datos sin conexión"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="1120"
            HorizontalOptions="Center"
            Padding="{OnIdiom Phone='12,12,12,30', Tablet='20,18,20,34', Desktop='28,22,28,38'}"
            Spacing="14">

            <Border Style="{StaticResource ModernHeroCard}">
                <Grid
                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                    RowSpacing="12"
                    ColumnSpacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Button
                            Text="← Volver"
                            Clicked="VolverButton_Clicked"
                            Style="{StaticResource ModernLinkButton}"
                            HorizontalOptions="Start"
                            Margin="-8,-5,0,0"
                            SemanticProperties.Description="Volver a la interfaz principal" />
                        <Label
                            Text="Preparar datos sin conexión"
                            Style="{StaticResource ModernPageTitle}" />
                        <Label
                            Text="Descargue una copia completa del contenido autorizado antes de salir a campo."
                            Style="{StaticResource ModernPageSubtitle}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                        Style="{StaticResource ModernBadgeGreen}"
                        HorizontalOptions="{OnIdiom Phone=Start, Default=End}"
                        VerticalOptions="End">
                        <Label
                            x:Name="ModoSesionLabel"
                            Text="Sesión en línea"
                            FontFamily="MontserratBold"
                            FontSize="10.5"
                            TextColor="{StaticResource color_Verde}" />
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="EstadoPrincipalBorder"
                Padding="{OnIdiom Phone=15, Tablet=18, Desktop=20}"
                BackgroundColor="#F3F7FF"
                Stroke="#C9D7F2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12">
                            <Grid>
                                <Label
                                    Text="↻"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Verde}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <ActivityIndicator
                                    x:Name="ComprobacionActivityIndicator"
                                    IsVisible="False"
                                    IsRunning="False"
                                    WidthRequest="25"
                                    HeightRequest="25"
                                    Color="{StaticResource color_Verde}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label
                                x:Name="EstadoTituloLabel"
                                Text="Los datos todavía no están preparados"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="{OnIdiom Phone=15, Tablet=16, Desktop=17}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                LineBreakMode="WordWrap" />
                            <Label
                                x:Name="EstadoDetalleLabel"
                                Text="Use Descargar todo durante una sesión en línea."
                                FontFamily="MontserratMedium"
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <ProgressBar
                        x:Name="ProgresoGlobal"
                        IsVisible="False"
                        Progress="0"
                        HeightRequest="7"
                        ProgressColor="{StaticResource color_Verde}" />

                    <Button
                        x:Name="ComprobarActualizacionesButton"
                        Text="Comprobar nuevamente"
                        Clicked="ComprobarActualizacionesButton_Clicked"
                        IsVisible="False"
                        HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}"
                        Style="{StaticResource ModernSecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ModernInfoBanner}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label
                        Text="ⓘ"
                        FontSize="21"
                        TextColor="{StaticResource color_Verde}"
                        VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label
                            Text="Comprobación automática, descarga manual"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="Al entrar en línea se comprueba si existen cambios. La copia del dispositivo solo se reemplaza cuando una descarga nueva finaliza correctamente; en modo sin conexión no se consulta la API."
                            Style="{StaticResource ModernCaption}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="5" Margin="0,2,0,0">
                <Label Text="Contenido disponible para campo" Style="{StaticResource ModernSectionTitle}" />
                <Label
                    Text="Cada tarjeta muestra el estado real del paquete que utilizará la aplicación sin Internet."
                    Style="{StaticResource ModernPageSubtitle}" />
            </VerticalStackLayout>

            <Grid
                x:Name="ModulosGrid"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Border
                    x:Name="MotorCalculoBorder"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource ModernCatalogCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Motor de cálculo" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                x:Name="MotorCalculoEstadoLabel"
                                Text="Pendiente"
                                FontFamily="MontserratBold"
                                FontSize="11"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                x:Name="MotorCalculoDetalleLabel"
                                Text="Reglas, precios y parámetros."
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            Style="{StaticResource ModernBadgeGreen}"
                            Padding="0"
                            VerticalOptions="Start">
                            <Label
                                Text="∑"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="CatalogosBorder"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ModernCatalogCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Interfaces y terrenos" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                x:Name="CatalogosEstadoLabel"
                                Text="Pendiente"
                                FontFamily="MontserratBold"
                                FontSize="11"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                x:Name="CatalogosDetalleLabel"
                                Text="Se indicarán las interfaces específicas que tengan cambios."
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            Style="{StaticResource ModernBadgeCoffee}"
                            Padding="0"
                            VerticalOptions="Start">
                            <Label
                                Text="⌂"
                                FontSize="19"
                                TextColor="{StaticResource color_Cafe}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="AnalisisBorder"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource ModernCatalogCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Historial completo de análisis" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                x:Name="AnalisisEstadoLabel"
                                Text="Pendiente"
                                FontFamily="MontserratBold"
                                FontSize="11"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                x:Name="AnalisisDetalleLabel"
                                Text="Encabezados, detalles, edición y datos para PDF/Excel."
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            Style="{StaticResource ModernBadgeCoffee}"
                            Padding="0"
                            VerticalOptions="Start">
                            <Label
                                Text="▤"
                                FontSize="21"
                                TextColor="{StaticResource color_Cafe}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="NoticiasBorder"
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource ModernCatalogCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Noticias" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                x:Name="NoticiasEstadoLabel"
                                Text="Pendiente"
                                FontFamily="MontserratBold"
                                FontSize="11"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                x:Name="NoticiasDetalleLabel"
                                Text="Publicaciones, categorías e imágenes."
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            Style="{StaticResource ModernBadgeGreen}"
                            Padding="0"
                            VerticalOptions="Start">
                            <Label
                                Text="N"
                                FontFamily="MontserratBold"
                                FontSize="16"
                                TextColor="{StaticResource color_Verde}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="AlbumBorder"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource ModernCatalogCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Álbum botánico" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                x:Name="AlbumEstadoLabel"
                                Text="Pendiente"
                                FontFamily="MontserratBold"
                                FontSize="11"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                x:Name="AlbumDetalleLabel"
                                Text="Galerías, detalles y fotografías."
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            Style="{StaticResource ModernBadgeGreen}"
                            Padding="0"
                            VerticalOptions="Start">
                            <Label
                                Text="▧"
                                FontSize="20"
                                TextColor="{StaticResource color_Verde}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="FitosanitariaOfflineBorder"
                Style="{StaticResource ModernCatalogCard}"
                Loaded="FitosanitariaOfflineBorder_Loaded"
                Unloaded="FitosanitariaOfflineBorder_Unloaded">
                <Grid
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    RowSpacing="10">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                        <Label Text="Inspección fitosanitaria" Style="{StaticResource ModernSectionTitle}" />
                        <Label
                            x:Name="FitosanitariaOfflineEstadoLabel"
                            Text="Comprobando..."
                            FontFamily="MontserratBold"
                            FontSize="11"
                            TextColor="{StaticResource color_Cafe}" />
                        <Label
                            x:Name="FitosanitariaOfflineDetalleLabel"
                            Text="Captura de campo, fotografías y cola de sincronización."
                            Style="{StaticResource ModernCaption}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        Style="{StaticResource ModernBadgeGreen}"
                        Padding="0"
                        VerticalOptions="Start">
                        <Label
                            Text="🌿"
                            FontSize="23"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Button
                        x:Name="FitosanitariaOfflineActualizarButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Preparar / sincronizar fitosanitaria"
                        Clicked="FitosanitariaOfflineActualizarButton_Clicked"
                        Style="{StaticResource ModernSecondaryButton}" />
                </Grid>
            </Border>

            <Grid
                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                ColumnSpacing="12"
                RowSpacing="10">
                <Border Style="{StaticResource ModernMetricSurface}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Última descarga completa" Style="{StaticResource ModernCaption}" />
                        <Label
                            x:Name="FechaSincronizacionLabel"
                            Text="Todavía no disponible"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                    Style="{StaticResource ModernMetricSurface}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Espacio utilizado" Style="{StaticResource ModernCaption}" />
                        <Label
                            x:Name="TamanoTotalLabel"
                            Text="0 MB"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border
                x:Name="ResumenPendientesBorder"
                Style="{StaticResource ModernSoftPanel}">
                <Grid
                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                    ColumnSpacing="12"
                    RowSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Análisis pendientes de enviar" Style="{StaticResource ModernCaption}" />
                        <Label
                            x:Name="PendientesAnalisisLabel"
                            Text="0"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            FontSize="20"
                            TextColor="{StaticResource color_Verde}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                        Spacing="3">
                        <Label Text="Requieren revisión" Style="{StaticResource ModernCaption}" />
                        <Label
                            x:Name="RevisionAnalisisLabel"
                            Text="0"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            FontSize="20"
                            TextColor="{StaticResource color_Cafe}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource ModernFormCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Preparar dispositivo"
                        Style="{StaticResource ModernSectionTitle}" />
                    <Label
                        Text="Mantenga la aplicación abierta hasta finalizar. El botón se deshabilita durante la descarga para impedir ejecuciones duplicadas."
                        Style="{StaticResource ModernPageSubtitle}" />
                    <Button
                        x:Name="DescargarTodoButton"
                        Text="Descargar todo"
                        Clicked="DescargarTodoButton_Clicked"
                        Style="{StaticResource ModernPrimaryButton}"
                        HeightRequest="54"
                        FontSize="14" />
                    <Label
                        Text="La copia anterior solo se reemplaza cuando la nueva descarga finaliza correctamente."
                        Style="{StaticResource ModernCaption}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
