<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.datosSinConexionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Datos sin conexión"
    BackgroundColor="#FFF7FF">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="20,16"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12"
            BackgroundColor="White">

            <Button
                Grid.Column="0"
                Text="←"
                Clicked="VolverButton_Clicked"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                CornerRadius="14"
                FontSize="22"
                BackgroundColor="#F3F5F4"
                TextColor="#263238"
                SemanticProperties.Description="Volver a la interfaz principal" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">
                <Label
                    Text="Preparar datos sin conexión"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    FontSize="25"
                    TextColor="#3B655B" />
                <Label
                    Text="Descarga manual y completa del contenido autorizado"
                    FontSize="12"
                    TextColor="#5F6368" />
            </VerticalStackLayout>

            <Border
                Grid.Column="2"
                Padding="10,6"
                BackgroundColor="#EEF5F2"
                Stroke="#B7D3C8"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
                <Label
                    x:Name="ModoSesionLabel"
                    Text="Sesión en línea"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    FontSize="11"
                    TextColor="#3B655B" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="20"
                Spacing="14"
                MaximumWidthRequest="1050">

                <Border
                    x:Name="EstadoPrincipalBorder"
                    Padding="16"
                    BackgroundColor="#F3F7FF"
                    Stroke="#C9D7F2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <ActivityIndicator
                                x:Name="ComprobacionActivityIndicator"
                                IsVisible="False"
                                IsRunning="False"
                                WidthRequest="24"
                                HeightRequest="24"
                                Color="#3B655B"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="EstadoTituloLabel"
                                Grid.Column="1"
                                Text="Los datos todavía no están preparados"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#263238"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            x:Name="EstadoDetalleLabel"
                            Text="Use Descargar todo durante una sesión en línea."
                            FontSize="11"
                            LineBreakMode="WordWrap"
                            TextColor="#546E7A" />

                        <Button
                            x:Name="ComprobarActualizacionesButton"
                            Text="Comprobar nuevamente"
                            Clicked="ComprobarActualizacionesButton_Clicked"
                            IsVisible="False"
                            HorizontalOptions="Start"
                            HeightRequest="38"
                            Padding="14,0"
                            CornerRadius="10"
                            FontSize="11"
                            BackgroundColor="#EEF5F2"
                            TextColor="#3B655B" />

                        <ProgressBar
                            x:Name="ProgresoGlobal"
                            IsVisible="False"
                            Progress="0"
                            ProgressColor="#3B655B" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="14"
                    BackgroundColor="#FFF8E8"
                    Stroke="#EBCB78"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="ⓘ" FontSize="22" TextColor="#9B552C" />
                        <Label
                            Grid.Column="1"
                            Text="Al visitar esta página durante una sesión en línea, se comprueba si existen actualizaciones disponibles. La descarga continúa siendo manual y durante una sesión sin conexión no se consulta la API."
                            FontSize="11"
                            LineBreakMode="WordWrap"
                            TextColor="#6B4D32" />
                    </Grid>
                </Border>

                <Grid
                    x:Name="ModulosGrid"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="12">

                    <Border
                        x:Name="MotorCalculoBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Motor de cálculo" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="14" TextColor="#3B655B" />
                            <Label x:Name="MotorCalculoEstadoLabel" Text="Pendiente" FontAttributes="Bold" FontSize="11" />
                            <Label x:Name="MotorCalculoDetalleLabel" Text="Reglas, precios y parámetros." FontSize="10" TextColor="#60736B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="CatalogosBorder"
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Interfaces y terrenos" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="14" TextColor="#3B655B" />
                            <Label x:Name="CatalogosEstadoLabel" Text="Pendiente" FontAttributes="Bold" FontSize="11" />
                            <Label x:Name="CatalogosDetalleLabel" Text="Se indicarán las interfaces específicas que tengan cambios." FontSize="10" TextColor="#60736B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="AnalisisBorder"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Historial completo de análisis" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="14" TextColor="#3B655B" />
                                <Label x:Name="AnalisisEstadoLabel" Text="Pendiente" FontAttributes="Bold" FontSize="11" />
                                <Label x:Name="AnalisisDetalleLabel" Text="Encabezados, detalles, edición y datos para PDF/Excel." FontSize="10" TextColor="#60736B" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="▤" FontSize="30" TextColor="#9B552C" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="NoticiasBorder"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Noticias" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="14" TextColor="#3B655B" />
                            <Label x:Name="NoticiasEstadoLabel" Text="Pendiente" FontAttributes="Bold" FontSize="11" />
                            <Label x:Name="NoticiasDetalleLabel" Text="Publicaciones, categorías e imágenes." FontSize="10" TextColor="#60736B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="AlbumBorder"
                        Grid.Row="2"
                        Grid.Column="1"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 13">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Álbum de fotos" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="14" TextColor="#3B655B" />
                            <Label x:Name="AlbumEstadoLabel" Text="Pendiente" FontAttributes="Bold" FontSize="11" />
                            <Label x:Name="AlbumDetalleLabel" Text="Galerías, detalles y fotografías." FontSize="10" TextColor="#60736B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--
                    La captura fitosanitaria reutiliza los terrenos descargados
                    por el paquete global. Este panel prepara su cola local y
                    conserva las fotografías hasta poder enviarlas al servidor.
                -->
                <Border
                    x:Name="FitosanitariaOfflineBorder"
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 13"
                    Loaded="FitosanitariaOfflineBorder_Loaded"
                    Unloaded="FitosanitariaOfflineBorder_Unloaded">
                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label
                                Text="Inspección fitosanitaria"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="14"
                                TextColor="#3B655B" />
                            <Label
                                x:Name="FitosanitariaOfflineEstadoLabel"
                                Text="Comprobando..."
                                FontAttributes="Bold"
                                FontSize="11" />
                            <Label
                                x:Name="FitosanitariaOfflineDetalleLabel"
                                Text="Captura de campo, fotografías y cola de sincronización."
                                FontSize="10"
                                TextColor="#60736B"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="🌿"
                            FontSize="28"
                            VerticalOptions="Center" />
                        <Button
                            x:Name="FitosanitariaOfflineActualizarButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Preparar / sincronizar fitosanitaria"
                            Clicked="FitosanitariaOfflineActualizarButton_Clicked"
                            HeightRequest="42"
                            BackgroundColor="#EEF5F2"
                            TextColor="#3B655B"
                            CornerRadius="10" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Padding="12" BackgroundColor="White" Stroke="#E2E8E5" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Última descarga completa" FontSize="9" TextColor="#60736B" />
                            <Label x:Name="FechaSincronizacionLabel" Text="Todavía no disponible" FontAttributes="Bold" FontSize="11" TextColor="#263238" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12" BackgroundColor="White" Stroke="#E2E8E5" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Espacio utilizado" FontSize="9" TextColor="#60736B" />
                            <Label x:Name="TamanoTotalLabel" Text="0 MB" FontAttributes="Bold" FontSize="11" TextColor="#263238" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border
                    x:Name="ResumenPendientesBorder"
                    Padding="14"
                    BackgroundColor="#F7F9F8"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 13">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Análisis pendientes de enviar" FontSize="10" TextColor="#60736B" />
                            <Label x:Name="PendientesAnalisisLabel" Text="0" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="18" TextColor="#3B655B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Requieren revisión" FontSize="10" TextColor="#60736B" />
                            <Label x:Name="RevisionAnalisisLabel" Text="0" FontFamily="MontserratBold" FontAttributes="Bold" FontSize="18" TextColor="#9B552C" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Button
                    x:Name="DescargarTodoButton"
                    Text="Descargar todo"
                    Clicked="DescargarTodoButton_Clicked"
                    HeightRequest="52"
                    CornerRadius="14"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    BackgroundColor="#3B655B"
                    TextColor="White" />

                <Label
                    Text="La copia anterior solo se reemplaza cuando la nueva descarga finaliza correctamente."
                    HorizontalTextAlignment="Center"
                    FontSize="9"
                    TextColor="#78908A" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
