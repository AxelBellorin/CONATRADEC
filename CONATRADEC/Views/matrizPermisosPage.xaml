<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.matrizPermisosPage"
    x:Name="MatrizPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>

            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">

                <Border
                    MaximumWidthRequest="620"
                    Padding="28"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Image
                            Source="iconpermission.png"
                            WidthRequest="64"
                            HeightRequest="64"
                            Opacity="0.65" />

                        <Label
                            Text="Sin permiso de lectura"
                            FontSize="21"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Negro}" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar la matriz de permisos."
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource color_GrisOscuro}" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarConfiguracionCommand}"
                            BackgroundColor="{StaticResource color_Verde}"
                            TextColor="White"
                            CornerRadius="11" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!--
                El encabezado, selector, filtros y estado forman parte del
                Header del CollectionView. Todo se desplaza de forma natural
                como una sola superficie, sin un ScrollView vertical anidado.
            -->
            <Grid
                x:Name="ContenidoPrincipal"
                IsVisible="{Binding CanView}"
                Padding="18"
                RowDefinitions="*,Auto"
                RowSpacing="10">

                <CollectionView
                    Grid.Row="0"
                    x:Name="PermisosList"
                    ItemsSource="{Binding PermisosVisibles}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout
                            Padding="0,0,0,12"
                            Spacing="12">

                            <controls:ResponsiveCatalogHeader
                                Title="Matriz de permisos"
                                Subtitle="Seleccione un rol y configure sus acciones por interfaz."
                                BackText="← Configuración"
                                BackCommand="{Binding RegresarConfiguracionCommand}"
                                PrimaryText="Refrescar"
                                PrimaryCommand="{Binding RefrescarCommand}"
                                IsPrimaryVisible="True"
                                PrimaryBackgroundColor="#EEF5F2"
                                PrimaryTextColor="{StaticResource color_Verde}" />

                            <!-- Selector y búsqueda -->
                            <Border
                                Padding="14"
                                BackgroundColor="White"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 16">

                                <VerticalStackLayout Spacing="10">

                                    <Label
                                        Text="Rol"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}" />

                                    <Picker
                                        x:Name="RolPicker"
                                        Title="Seleccione un rol"
                                        ItemsSource="{Binding Roles}"
                                        ItemDisplayBinding="{Binding NombreRol}"
                                        SelectedItem="{Binding RolSeleccionado, Mode=OneWay}"
                                        SelectedIndexChanged="RolPicker_SelectedIndexChanged"
                                        IsEnabled="{Binding NotIsBusy}"
                                        BackgroundColor="#F8FAF9"
                                        TextColor="{StaticResource color_Negro}" />

                                    <SearchBar
                                        Placeholder="Buscar interfaz"
                                        Text="{Binding Filtro}"
                                        IsEnabled="{Binding NotIsBusy}"
                                        BackgroundColor="#F8FAF9" />

                                    <Label
                                        Text="Las acciones masivas se aplican únicamente a las interfaces visibles."
                                        FontSize="11"
                                        TextColor="{StaticResource color_GrisOscuro}" />

                                    <!--
                                        FlexLayout permite que los botones bajen de fila
                                        en móvil, tablet o una ventana Windows angosta.
                                        No existe desplazamiento horizontal oculto.
                                    -->
                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Start">

                                        <Button
                                            Text="Marcar lectura"
                                            Margin="0,0,8,8"
                                            Padding="12,8"
                                            Command="{Binding MarcarColumnaCommand}"
                                            CommandParameter="leer"
                                            IsEnabled="{Binding PuedeEditar}"
                                            BackgroundColor="#EEF5F2"
                                            TextColor="{StaticResource color_Verde}"
                                            CornerRadius="9" />

                                        <Button
                                            Text="Marcar agregar"
                                            Margin="0,0,8,8"
                                            Padding="12,8"
                                            Command="{Binding MarcarColumnaCommand}"
                                            CommandParameter="agregar"
                                            IsEnabled="{Binding PuedeEditar}"
                                            BackgroundColor="#EAF7EF"
                                            TextColor="{StaticResource color_Verde}"
                                            CornerRadius="9" />

                                        <Button
                                            Text="Marcar actualizar"
                                            Margin="0,0,8,8"
                                            Padding="12,8"
                                            Command="{Binding MarcarColumnaCommand}"
                                            CommandParameter="actualizar"
                                            IsEnabled="{Binding PuedeEditar}"
                                            BackgroundColor="#EEF4FF"
                                            TextColor="{StaticResource BlueUpdate}"
                                            CornerRadius="9" />

                                        <Button
                                            Text="Marcar eliminar"
                                            Margin="0,0,8,8"
                                            Padding="12,8"
                                            Command="{Binding MarcarColumnaCommand}"
                                            CommandParameter="eliminar"
                                            IsEnabled="{Binding PuedeEditar}"
                                            BackgroundColor="#FDECEC"
                                            TextColor="{StaticResource RedDelete}"
                                            CornerRadius="9" />

                                        <Button
                                            Text="Limpiar visibles"
                                            Margin="0,0,8,8"
                                            Padding="12,8"
                                            Command="{Binding LimpiarTodoCommand}"
                                            IsEnabled="{Binding PuedeEditar}"
                                            BackgroundColor="#F3F4F6"
                                            TextColor="{StaticResource color_Negro}"
                                            CornerRadius="9" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Estado actual -->
                            <Border
                                Padding="11"
                                BackgroundColor="#FFF7E6"
                                Stroke="#F2C94C"
                                StrokeShape="RoundRectangle 11">

                                <Label
                                    Text="{Binding Estado}"
                                    FontSize="12"
                                    TextColor="{StaticResource color_Negro}" />
                            </Border>

                            <!--
                                Estado vacío dentro del flujo normal del Header.
                                Evita que un EmptyView independiente capture la
                                superficie de interacción en Windows.
                            -->
                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                Padding="24"
                                BackgroundColor="#F8FAF9"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 14">

                                <VerticalStackLayout
                                    Spacing="6"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="No hay interfaces para mostrar"
                                        FontSize="17"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{StaticResource color_Negro}" />

                                    <Label
                                        Text="Cambie el texto de búsqueda o seleccione otro rol."
                                        HorizontalTextAlignment="Center"
                                        TextColor="{StaticResource color_GrisOscuro}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:InterfazResponse">

                            <Border
                                Padding="13"
                                BackgroundColor="White"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 14">

                                <VerticalStackLayout Spacing="10">

                                    <Label
                                        Text="{Binding NombreMostrar}"
                                        FontSize="15"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}"
                                        LineBreakMode="WordWrap" />

                                    <HorizontalStackLayout
                                        Spacing="8"
                                        HorizontalOptions="Start">

                                        <Button
                                            Text="Todo"
                                            Padding="10,6"
                                            FontSize="11"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference MatrizPageRoot}, Path=BindingContext.MarcarFilaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EAF7EF"
                                            TextColor="{StaticResource color_Verde}"
                                            CornerRadius="8" />

                                        <Button
                                            Text="Ninguno"
                                            Padding="10,6"
                                            FontSize="11"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference MatrizPageRoot}, Path=BindingContext.LimpiarFilaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F3F4F6"
                                            TextColor="{StaticResource color_Negro}"
                                            CornerRadius="8" />
                                    </HorizontalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*,*,*"
                                        ColumnSpacing="6">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Leer"
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Leer}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource color_Verde}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Agregar"
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Agregar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource color_Verde}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Actualizar"
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Actualizar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource BlueUpdate}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="3"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Eliminar"
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Eliminar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource RedDelete}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Acciones inferiores: siempre responsivas -->
                <Grid
                    x:Name="AccionesInferioresGrid"
                    Grid.Row="1"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,*"
                    RowSpacing="6"
                    ColumnSpacing="10"
                    Padding="0,3">

                    <Label
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Estado}"
                        FontSize="11"
                        TextColor="{StaticResource color_GrisOscuro}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation" />

                    <Button
                        x:Name="BotonRevertir"
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Revertir"
                        Padding="14,9"
                        Style="{StaticResource CancelButton}"
                        IsEnabled="{Binding PuedeRevertir}"
                        Command="{Binding RevertirCambiosCommand}" />

                    <Button
                        x:Name="BotonGuardar"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Guardar cambios"
                        Padding="16,9"
                        Style="{StaticResource AddButton}"
                        IsEnabled="{Binding PuedeGuardar}"
                        Command="{Binding GuardarCommand}" />
                </Grid>

                <!-- Relay de carga -->
                <Grid
                    Grid.RowSpan="2"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#50FFFFFF">

                    <Border
                        Padding="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource color_Naranja}" />

                            <Label
                                Text="Procesando permisos..."
                                VerticalOptions="Center"
                                TextColor="{StaticResource color_Negro}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
