<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.matrizPermisosPage"
    x:Name="MatrizPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>

            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">

                <Border
                    MaximumWidthRequest="620"
                    Padding="28"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Image
                            Source="iconpermission.png"
                            WidthRequest="64"
                            HeightRequest="64"
                            Opacity="0.65" />

                        <Label
                            Text="Sin permiso de lectura"
                            FontSize="21"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Negro}" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar la matriz de permisos."
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource color_GrisOscuro}" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarConfiguracionCommand}"
                            BackgroundColor="{StaticResource color_Verde}"
                            TextColor="White"
                            CornerRadius="11" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido principal sin ScrollView exterior -->
            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnPlatform WinUI='26,22,26,28', Default='16,16,16,24'}"
                RowDefinitions="Auto,*,Auto"
                RowSpacing="12">

                <!--
                    Panel superior desplazable y de altura limitada.
                    Al reducir la ventana, este bloque cede espacio al
                    listado de permisos, que es la sección prioritaria.
                -->
                <ScrollView
                    x:Name="PanelSuperiorScroll"
                    Grid.Row="0"
                    VerticalScrollBarVisibility="Always"
                    HorizontalScrollBarVisibility="Never">

                    <VerticalStackLayout Spacing="12">
                <!-- Encabezado -->
                <Grid
                    x:Name="EncabezadoGrid"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">

                    <Button
                        x:Name="BotonConfiguracion"
                        Grid.Column="0"
                        Text="← Configuración"
                        Padding="16,10"
                        BackgroundColor="#EEF2F0"
                        TextColor="{StaticResource color_Verde}"
                        CornerRadius="11"
                        Command="{Binding RegresarConfiguracionCommand}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            x:Name="TituloMatrizLabel"
                            Text="Matriz de permisos"
                            FontSize="{OnPlatform WinUI=30, Default=25}"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Label
                            x:Name="SubtituloMatrizLabel"
                            Text="Seleccione un rol y configure sus acciones por interfaz."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="BotonRefrescar"
                        Grid.Column="2"
                        Text="Refrescar"
                        Padding="16,10"
                        BackgroundColor="#EEF5F2"
                        TextColor="{StaticResource color_Verde}"
                        CornerRadius="10"
                        Command="{Binding RefrescarCommand}" />
                </Grid>

                <!-- Selector y búsqueda -->
                <Border
                    Padding="{OnPlatform WinUI='16,14', Default='12'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeShape="RoundRectangle 16">

                    <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Text="Rol"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                TextColor="{StaticResource color_Negro}" />

                            <Picker
                                Grid.Column="1"
                                Title="Seleccione un rol"
                                ItemsSource="{Binding Roles}"
                                ItemDisplayBinding="{Binding NombreRol}"
                                SelectedItem="{Binding RolSeleccionado}"
                                BackgroundColor="#F8FAF9"
                                TextColor="{StaticResource color_Negro}" />
                        </Grid>

                        <SearchBar
                            Grid.Row="1"
                            Placeholder="Buscar interfaz"
                            Text="{Binding Filtro}"
                            IsEnabled="{Binding NotIsBusy}"
                            BackgroundColor="#F8FAF9" />

                        <!-- Acciones masivas: desplazamiento solo horizontal -->
                        <ScrollView
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Default"
                            VerticalScrollBarVisibility="Never">

                            <HorizontalStackLayout Spacing="8">

                                <Button
                                    Text="Marcar lectura"
                                    Padding="12,8"
                                    Command="{Binding MarcarColumnaCommand}"
                                    CommandParameter="leer"
                                    IsEnabled="{Binding PuedeEditar}"
                                    BackgroundColor="#EEF5F2"
                                    TextColor="{StaticResource color_Verde}"
                                    CornerRadius="9" />

                                <Button
                                    Text="Marcar agregar"
                                    Padding="12,8"
                                    Command="{Binding MarcarColumnaCommand}"
                                    CommandParameter="agregar"
                                    IsEnabled="{Binding PuedeEditar}"
                                    BackgroundColor="#EAF7EF"
                                    TextColor="{StaticResource color_Verde}"
                                    CornerRadius="9" />

                                <Button
                                    Text="Marcar actualizar"
                                    Padding="12,8"
                                    Command="{Binding MarcarColumnaCommand}"
                                    CommandParameter="actualizar"
                                    IsEnabled="{Binding PuedeEditar}"
                                    BackgroundColor="#EEF4FF"
                                    TextColor="{StaticResource BlueUpdate}"
                                    CornerRadius="9" />

                                <Button
                                    Text="Marcar eliminar"
                                    Padding="12,8"
                                    Command="{Binding MarcarColumnaCommand}"
                                    CommandParameter="eliminar"
                                    IsEnabled="{Binding PuedeEditar}"
                                    BackgroundColor="#FDECEC"
                                    TextColor="{StaticResource RedDelete}"
                                    CornerRadius="9" />

                                <Button
                                    Text="Limpiar todo"
                                    Padding="12,8"
                                    Command="{Binding LimpiarTodoCommand}"
                                    IsEnabled="{Binding PuedeEditar}"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="{StaticResource color_Negro}"
                                    CornerRadius="9" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Estado -->
                <Border
                    Grid.Row="2"
                    Padding="11"
                    BackgroundColor="#FFF7E6"
                    Stroke="#F2C94C"
                    StrokeShape="RoundRectangle 11">

                    <Label
                        Text="{Binding Estado}"
                        FontSize="12"
                        TextColor="{StaticResource color_Negro}" />
                </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Lista virtualizada -->
                <CollectionView
                    Grid.Row="1"
                    x:Name="PermisosList"
                    ItemsSource="{Binding PermisosVisibles}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            IsVisible="{Binding MostrarVacio}"
                            Padding="30"
                            Spacing="8"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                Text="No hay interfaces para mostrar"
                                FontSize="18"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />

                            <Label
                                Text="Seleccione otro rol o cambie el texto de búsqueda."
                                TextColor="{StaticResource color_GrisOscuro}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:InterfazResponse">

                            <Border
                                Padding="{OnPlatform WinUI='15,12', Default='12'}"
                                BackgroundColor="White"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 14">

                                <Grid
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="10">

                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="8">

                                        <Label
                                            Text="{Binding NombreInterfaz}"
                                            FontSize="15"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource color_Negro}"
                                            LineBreakMode="TailTruncation"
                                            VerticalOptions="Center" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Todo"
                                            Padding="10,6"
                                            FontSize="11"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference MatrizPageRoot}, Path=BindingContext.MarcarFilaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EAF7EF"
                                            TextColor="{StaticResource color_Verde}"
                                            CornerRadius="8" />

                                        <Button
                                            Grid.Column="2"
                                            Text="Ninguno"
                                            Padding="10,6"
                                            FontSize="11"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference MatrizPageRoot}, Path=BindingContext.LimpiarFilaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F3F4F6"
                                            TextColor="{StaticResource color_Negro}"
                                            CornerRadius="8" />
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        ColumnDefinitions="*,*,*,*"
                                        ColumnSpacing="8">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Leer"
                                                FontSize="11"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Leer}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource color_Verde}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Agregar"
                                                FontSize="11"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Agregar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource color_Verde}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Actualizar"
                                                FontSize="11"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Actualizar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource BlueUpdate}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="3"
                                            Spacing="2"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Eliminar"
                                                FontSize="11"
                                                TextColor="{StaticResource color_GrisOscuro}" />

                                            <CheckBox
                                                IsChecked="{Binding Eliminar}"
                                                IsEnabled="{Binding CanEdit}"
                                                Color="{StaticResource RedDelete}"
                                                HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Acciones fijas -->
                <Grid
                    x:Name="AccionesInferioresGrid"
                    Grid.Row="2"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    Padding="0,4">

                    <Button
                        x:Name="BotonRevertir"
                        Text="Revertir"
                        Padding="16,10"
                        Style="{StaticResource CancelButton}"
                        IsEnabled="{Binding PuedeRevertir}"
                        Command="{Binding RevertirCambiosCommand}" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding Estado}"
                        FontSize="11"
                        TextColor="{StaticResource color_GrisOscuro}"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation" />

                    <Button
                        x:Name="BotonGuardar"
                        Grid.Column="2"
                        Text="Guardar cambios"
                        Padding="18,10"
                        Style="{StaticResource AddButton}"
                        IsEnabled="{Binding PuedeGuardar}"
                        Command="{Binding GuardarCommand}" />
                </Grid>

                <!-- Carga -->
                <Grid
                    Grid.RowSpan="3"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#50FFFFFF">

                    <Border
                        Padding="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource color_Naranja}" />

                            <Label
                                Text="Procesando permisos..."
                                VerticalOptions="Center"
                                TextColor="{StaticResource color_Negro}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
