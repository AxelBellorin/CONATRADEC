<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.TipoFotografiaIAPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}">

            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">

                <!--
                    Encabezado estático: no cambia filas ni columnas en tiempo
                    de ejecución. Esto evita superposición dentro del Header
                    del CollectionView en Android.
                -->
                <CollectionView.Header>
                    <VerticalStackLayout
                        Spacing="14"
                        Padding="0,0,0,14">

                        <Border
                            Style="{StaticResource ModernHeroCard}"
                            Padding="{OnIdiom Phone='12,12', Tablet='18,16', Desktop='22,20'}">
                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*,Auto"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="0"
                                    Text="← Configuración de IA"
                                    Command="{Binding RegresarCommand}"
                                    Style="{StaticResource ModernNeutralButton}"
                                    FontSize="{OnIdiom Phone=10, Tablet=12, Desktop=12.5}"
                                    HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=44}"
                                    MinimumWidthRequest="0"
                                    Padding="{OnIdiom Phone='8,7', Tablet='12,8', Desktop='12,8'}"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.ColumnSpan="{OnIdiom Phone=3, Tablet=1, Desktop=1}"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Tipos de fotografía para IA"
                                        Style="{StaticResource ModernPageTitle}"
                                        FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=30}"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Text="Administre el nombre, orden y la instrucción que orienta el análisis visual de cada evidencia."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        MaxLines="{OnIdiom Phone=3, Tablet=2, Desktop=2}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="2"
                                    Text="Nuevo tipo"
                                    Command="{Binding NuevoCommand}"
                                    IsVisible="{Binding CanAdd}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    FontSize="{OnIdiom Phone=10, Tablet=12, Desktop=12.5}"
                                    HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=44}"
                                    MinimumWidthRequest="0"
                                    Padding="{OnIdiom Phone='10,7', Tablet='14,8', Desktop='14,8'}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="12"
                            BackgroundColor="White"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 13">
                            <Grid
                                RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                                ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,Auto,Auto', Desktop='*,Auto,Auto'}"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <SearchBar
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Placeholder="Buscar por código, nombre o instrucción"
                                    Text="{Binding TextoBusqueda}"
                                    SearchCommand="{Binding BuscarCommand}"
                                    BackgroundColor="Transparent" />

                                <HorizontalStackLayout
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Spacing="5"
                                    VerticalOptions="Center">
                                    <CheckBox
                                        IsChecked="{Binding MostrarInactivos}"
                                        Color="#3B655B" />
                                    <Label
                                        Text="Mostrar inactivos"
                                        VerticalTextAlignment="Center"
                                        TextColor="#263A35" />
                                </HorizontalStackLayout>

                                <Button
                                    Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                                    Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                                    Text="Actualizar"
                                    Command="{Binding ActualizarCommand}"
                                    WidthRequest="{OnIdiom Phone=-1, Tablet=150, Desktop=150}"
                                    HorizontalOptions="{OnIdiom Phone=Fill, Tablet=End, Desktop=End}"
                                    HeightRequest="46"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B" />
                            </Grid>
                        </Border>

                        <Border
                            IsVisible="{Binding TieneMensajeEstado}"
                            Padding="14"
                            HorizontalOptions="Center"
                            BackgroundColor="#FFF9E8"
                            Stroke="#E2B93B"
                            StrokeShape="RoundRectangle 12">
                            <HorizontalStackLayout Spacing="10">
                                <ActivityIndicator
                                    IsRunning="{Binding IsBusy}"
                                    Color="#9B552C" />
                                <Label
                                    Text="{Binding MensajeEstado}"
                                    VerticalTextAlignment="Center"
                                    TextColor="#6B5710" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Border
                        Padding="24"
                        Margin="0,20"
                        BackgroundColor="White"
                        Stroke="#D9E3DF"
                        StrokeShape="RoundRectangle 14">
                        <Label
                            Text="No se encontraron tipos de fotografía."
                            HorizontalTextAlignment="Center"
                            TextColor="#7A8581" />
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TipoFotografiaIAItem">
                        <Border
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="#D9E3DF"
                            StrokeShape="RoundRectangle 14">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnSpacing="14"
                                RowSpacing="5">
                                <HorizontalStackLayout Spacing="10">
                                    <Label
                                        Text="{Binding NombreMostrar}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="{Binding EstadoTexto}"
                                        FontAttributes="Bold"
                                        TextColor="{Binding EstadoColor}"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding CodigoTexto}"
                                    FontSize="12"
                                    TextColor="#7A8581" />

                                <Label
                                    Grid.Row="2"
                                    Text="{Binding Descripcion}"
                                    TextColor="#5E6B67"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Grid.Row="3"
                                    Text="{Binding InstruccionVisible}"
                                    TextColor="#3B655B"
                                    LineBreakMode="WordWrap"
                                    MaxLines="4" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Grid.RowSpan="4"
                                    Spacing="7"
                                    WidthRequest="150">
                                    <Label
                                        Text="{Binding OrdenTexto}"
                                        HorizontalTextAlignment="Center"
                                        TextColor="#7A8581" />
                                    <Button
                                        Text="Ver"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.VerCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="42"
                                        BackgroundColor="#EEF2F0"
                                        TextColor="#263A35" />
                                    <Button
                                        Text="Editar"
                                        IsVisible="{Binding Activo}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditarCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="42"
                                        BackgroundColor="#3B655B"
                                        TextColor="White" />
                                    <Button
                                        Text="Desactivar"
                                        IsVisible="{Binding PuedeDesactivarse}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EliminarCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="42"
                                        BackgroundColor="#FDECEC"
                                        TextColor="#B42318" />
                                    <Button
                                        Text="Recuperar"
                                        IsVisible="{Binding Inactivo}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RecuperarCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="42"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#3B655B" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentView>
</ContentPage>
