<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.publicacionFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Publicación"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid x:Name="ContenidoPrincipal">
            <ScrollView>
                <VerticalStackLayout
                    MaximumWidthRequest="1180"
                    HorizontalOptions="Center"
                    Padding="{OnIdiom Phone='12,12,12,28', Tablet='20,18,20,32', Desktop='28,22,28,36'}"
                    Spacing="14">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="12"
                            ColumnSpacing="14">
                            <VerticalStackLayout Spacing="4">
                                <Button
                                    Text="← Cancelar"
                                    Command="{Binding CancelarCommand}"
                                    Style="{StaticResource ModernLinkButton}"
                                    HorizontalOptions="Start"
                                    Margin="-8,-5,0,0" />
                                <Label
                                    Text="{Binding TituloPagina}"
                                    Style="{StaticResource ModernPageTitle}" />
                                <Label
                                    Text="Prepare el contenido, vigencia, portada y datos opcionales del evento."
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="{Binding TextoBotonGuardar}"
                                Command="{Binding GuardarCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                VerticalOptions="End"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=170}" />
                        </Grid>
                    </Border>

                    <Border
                        IsVisible="{Binding TieneMensaje}"
                        Style="{StaticResource ModernWarningBanner}">
                        <Label
                            Text="{Binding Mensaje}"
                            Style="{StaticResource ModernPageSubtitle}" />
                    </Border>

                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto', Default='Auto,Auto'}"
                        ColumnDefinitions="{OnIdiom Desktop='1.25*,0.75*', Default='*'}"
                        ColumnSpacing="14"
                        RowSpacing="14">

                        <Border Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Información principal" Style="{StaticResource ModernSectionTitle}" />

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Categoría *" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            Title="Seleccione una categoría"
                                            ItemsSource="{Binding Categorias}"
                                            ItemDisplayBinding="{Binding Nombre}"
                                            SelectedItem="{Binding CategoriaSeleccionada}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Título *" Style="{StaticResource ModernFieldLabel}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CaracteresTitulo}"
                                            Style="{StaticResource ModernCaption}" />
                                    </Grid>
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Titulo}"
                                            Placeholder="Título de la publicación"
                                            MaxLength="180"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Resumen *" Style="{StaticResource ModernFieldLabel}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding CaracteresResumen}"
                                            Style="{StaticResource ModernCaption}" />
                                    </Grid>
                                    <Border
                                        Style="{StaticResource ModernInputBorder}"
                                        Padding="10,8"
                                        MinimumHeightRequest="112">
                                        <Editor
                                            Text="{Binding Resumen}"
                                            Placeholder="Texto breve que aparecerá en la tarjeta"
                                            MaxLength="500"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="92"
                                            FontFamily="MontserratMedium"
                                            FontSize="13"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Contenido completo *" Style="{StaticResource ModernFieldLabel}" />
                                    <Border
                                        Style="{StaticResource ModernInputBorder}"
                                        Padding="10,8"
                                        MinimumHeightRequest="235">
                                        <Editor
                                            Text="{Binding Contenido}"
                                            Placeholder="Desarrolle aquí toda la información de la publicación"
                                            AutoSize="TextChanges"
                                            MinimumHeightRequest="215"
                                            FontFamily="MontserratMedium"
                                            FontSize="13"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{OnIdiom Desktop=0, Default=1}"
                            Grid.Column="{OnIdiom Desktop=1, Default=0}"
                            Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="13">
                                <Label Text="Imagen de portada" Style="{StaticResource ModernSectionTitle}" />
                                <Label
                                    Text="La vista previa utiliza la imagen seleccionada sin cambiar la lógica de almacenamiento."
                                    Style="{StaticResource ModernPageSubtitle}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                    StrokeShape="RoundRectangle 15"
                                    HeightRequest="{OnIdiom Phone=220, Tablet=260, Desktop=310}">
                                    <Grid>
                                        <VerticalStackLayout
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Spacing="6"
                                            Margin="20">
                                            <Label
                                                Text="PORTADA"
                                                FontFamily="MontserratBold"
                                                FontSize="17"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalTextAlignment="Center" />
                                            <Label
                                                Text="Seleccione una imagen para la publicación"
                                                Style="{StaticResource ModernCaption}"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                        <Image
                                            Source="{Binding PortadaPreview}"
                                            IsVisible="{Binding TienePortada}"
                                            Aspect="AspectFill" />
                                    </Grid>
                                </Border>

                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <Button
                                        Text="Seleccionar imagen"
                                        Clicked="OnSeleccionarPortadaClicked"
                                        Style="{StaticResource ModernSecondaryButton}" />
                                    <Button
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Text="Quitar portada"
                                        Command="{Binding EliminarPortadaCommand}"
                                        IsVisible="{Binding TienePortada}"
                                        Style="{StaticResource ModernDangerSoftButton}" />
                                </Grid>

                                <Label
                                    Text="JPG, JPEG, PNG o WEBP · máximo 8 MB"
                                    Style="{StaticResource ModernCaption}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Desktop='Auto', Default='Auto,Auto'}"
                        ColumnDefinitions="{OnIdiom Desktop='*,*', Default='*'}"
                        ColumnSpacing="14"
                        RowSpacing="14">

                        <Border Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Publicación y vigencia" Style="{StaticResource ModernSectionTitle}" />

                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    ColumnSpacing="10"
                                    RowSpacing="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Fecha de inicio *" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <DatePicker
                                                Date="{Binding FechaInicioPublicacion}"
                                                Style="{StaticResource ModernDatePicker}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Spacing="6">
                                        <Label Text="Hora de inicio *" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <TimePicker
                                                Time="{Binding HoraInicioPublicacion}"
                                                FontFamily="MontserratMedium"
                                                FontSize="13"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border Style="{StaticResource ModernSoftPanel}">
                                    <HorizontalStackLayout Spacing="9">
                                        <Switch
                                            IsToggled="{Binding TieneFechaFinPublicacion}"
                                            OnColor="{StaticResource color_Verde}" />
                                        <Label
                                            Text="La publicación tiene fecha de vencimiento"
                                            Style="{StaticResource ModernPageSubtitle}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Grid
                                    IsVisible="{Binding TieneFechaFinPublicacion}"
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    ColumnSpacing="10"
                                    RowSpacing="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Fecha final" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <DatePicker
                                                Date="{Binding FechaFinPublicacion}"
                                                Style="{StaticResource ModernDatePicker}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Spacing="6">
                                        <Label Text="Hora final" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <TimePicker
                                                Time="{Binding HoraFinPublicacion}"
                                                FontFamily="MontserratMedium"
                                                FontSize="13"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    ColumnSpacing="10"
                                    RowSpacing="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Estado" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                ItemsSource="{Binding Estados}"
                                                SelectedItem="{Binding EstadoSeleccionado}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Style="{StaticResource ModernSoftPanel}"
                                        VerticalOptions="End">
                                        <HorizontalStackLayout Spacing="9">
                                            <Switch
                                                IsToggled="{Binding Destacada}"
                                                OnColor="{StaticResource color_Amarillo}" />
                                            <Label
                                                Text="Publicación destacada"
                                                Style="{StaticResource ModernPageSubtitle}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{OnIdiom Desktop=0, Default=1}"
                            Grid.Column="{OnIdiom Desktop=1, Default=0}"
                            Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="14">
                                <Border Style="{StaticResource ModernSoftPanel}">
                                    <HorizontalStackLayout Spacing="9">
                                        <Switch
                                            IsToggled="{Binding TieneEvento}"
                                            OnColor="{StaticResource color_Verde}" />
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label
                                                Text="Evento"
                                                Style="{StaticResource ModernSectionTitle}" />
                                            <Label
                                                Text="Active esta opción cuando la publicación corresponda a una actividad con fecha y lugar."
                                                Style="{StaticResource ModernCaption}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <VerticalStackLayout IsVisible="{Binding TieneEvento}" Spacing="12">
                                    <Grid
                                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                        ColumnSpacing="10"
                                        RowSpacing="10">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="Fecha de inicio del evento" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <DatePicker Date="{Binding FechaEventoInicio}" Style="{StaticResource ModernDatePicker}" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                                            Spacing="6">
                                            <Label Text="Hora de inicio" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <TimePicker
                                                    Time="{Binding HoraEventoInicio}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="13"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border Style="{StaticResource ModernSoftPanel}">
                                        <HorizontalStackLayout Spacing="9">
                                            <Switch
                                                IsToggled="{Binding TieneFechaFinEvento}"
                                                OnColor="{StaticResource color_Verde}" />
                                            <Label
                                                Text="El evento tiene fecha y hora final"
                                                Style="{StaticResource ModernPageSubtitle}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Grid
                                        IsVisible="{Binding TieneFechaFinEvento}"
                                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                        ColumnSpacing="10"
                                        RowSpacing="10">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="Fecha final del evento" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <DatePicker Date="{Binding FechaEventoFin}" Style="{StaticResource ModernDatePicker}" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                                            Spacing="6">
                                            <Label Text="Hora final" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <TimePicker
                                                    Time="{Binding HoraEventoFin}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="13"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Ubicación" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <Entry
                                                Text="{Binding Ubicacion}"
                                                Placeholder="Lugar donde se realizará el evento"
                                                MaxLength="300"
                                                Style="{StaticResource ModernEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="13">
                            <Label Text="Enlace externo opcional" Style="{StaticResource ModernSectionTitle}" />

                            <Grid
                                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                ColumnDefinitions="{OnIdiom Phone='*', Default='1.4*,0.6*'}"
                                ColumnSpacing="10"
                                RowSpacing="10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Dirección web" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding EnlaceExterno}"
                                            Placeholder="https://..."
                                            Keyboard="Url"
                                            MaxLength="1000"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout
                                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Spacing="6">
                                    <Label Text="Texto del botón" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding TextoEnlace}"
                                            Placeholder="Ejemplo: Más información"
                                            MaxLength="120"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Padding="0,2,0,0">
                        <Button
                            Text="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource ModernNeutralButton}" />
                        <Button
                            Grid.Column="1"
                            Text="{Binding TextoBotonGuardar}"
                            Command="{Binding GuardarCommand}"
                            Style="{StaticResource ModernPrimaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Procesando publicación..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permiso"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para crear o editar publicaciones."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
