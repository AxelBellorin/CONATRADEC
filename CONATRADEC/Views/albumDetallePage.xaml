<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumDetallePage"
    x:Name="DetallePageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentPage.Resources>
        <converters:AlbumImageSourceConverter x:Key="AlbumImageSourceConverter" />
    </ContentPage.Resources>

    <Grid>
        <!--
            Un solo CollectionView vertical mantiene virtualizadas las fotografías.
            El encabezado y la información técnica forman parte del mismo scroll.
        -->
        <CollectionView
            ItemsSource="{Binding Detalle.Fotos}"
            SelectionMode="None"
            ItemSizingStrategy="MeasureFirstItem"
            Margin="{OnIdiom Phone='12,10,12,22', Tablet='20,16,20,28', Desktop='28,20,28,34'}"
            MaximumWidthRequest="1450"
            HorizontalOptions="Fill">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="{OnIdiom Phone=2, Tablet=3, Desktop=4}"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout
                    Spacing="14"
                    Margin="0,0,0,14">

                    <!-- Encabezado compacto y desplazable. -->
                    <Border Style="{StaticResource ModernHeroCard}">
                        <VerticalStackLayout Spacing="10">
                            <Button
                                Text="Regresar"
                                Command="{Binding RegresarCommand}"
                                Style="{StaticResource ModernLinkButton}"
                                HorizontalOptions="Start"
                                Padding="4,4"
                                HeightRequest="36" />

                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Detalle del álbum"
                                        Style="{StaticResource ModernPageTitle}" />
                                    <Label
                                        Text="Información técnica y evidencia fotográfica aprobada."
                                        Style="{StaticResource ModernPageSubtitle}" />
                                </VerticalStackLayout>

                                <!--
                                    Barra de acciones estable para WinUI. Los botones
                                    comienzan desde el lado izquierdo y utilizan el ancho
                                    real disponible sin depender de una medición Auto.
                                    En móvil pueden envolver de forma natural.
                                -->
                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Center"
                                    JustifyContent="Start"
                                    HorizontalOptions="Fill">
                                    <Button
                                        Margin="0,0,8,8"
                                        Text="Editar"
                                        Command="{Binding EditarCommand}"
                                        IsVisible="{Binding CanEdit}"
                                        Style="{StaticResource ModernUpdateButton}"
                                        MinimumWidthRequest="110" />
                                    <Button
                                        Margin="0,0,8,8"
                                        Text="Fotografías"
                                        Command="{Binding AdministrarFotosCommand}"
                                        IsVisible="{Binding PuedeAdministrarFotos}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        MinimumWidthRequest="128" />
                                    <Button
                                        Margin="0,0,0,8"
                                        Text="{Binding Detalle.AccionEstadoTexto}"
                                        Command="{Binding CambiarEstadoCommand}"
                                        IsVisible="{Binding CanDelete}"
                                        Style="{StaticResource ModernCoffeeButton}"
                                        MinimumWidthRequest="128" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Información principal. -->
                    <Border
                        IsVisible="{Binding TieneDetalle}"
                        Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="12">
                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center">
                                <Border
                                    Margin="0,0,7,7"
                                    Style="{StaticResource ModernBadgeGreen}">
                                    <Label
                                        Text="{Binding Detalle.Categoria}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Verde}" />
                                </Border>
                                <Border
                                    Margin="0,0,7,7"
                                    Padding="8,4"
                                    BackgroundColor="{Binding Detalle.EstadoColor}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 9">
                                    <Label
                                        Text="{Binding Detalle.EstadoTexto}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="White" />
                                </Border>
                            </FlexLayout>

                            <Label
                                Text="{Binding Detalle.Titulo}"
                                FontFamily="MontserratBold"
                                FontSize="{OnIdiom Phone=25, Tablet=29, Desktop=32}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="{Binding Detalle.NombreCientifico}"
                                IsVisible="{Binding Detalle.TieneNombreCientifico}"
                                FontSize="17"
                                FontAttributes="Italic"
                                TextColor="{StaticResource color_Cafe}"
                                LineBreakMode="WordWrap" />

                            <BoxView
                                WidthRequest="64"
                                HeightRequest="3"
                                HorizontalOptions="Start"
                                Color="{StaticResource color_Naranja}" />

                            <Label
                                Text="{Binding Detalle.Descripcion}"
                                FontSize="13"
                                LineHeight="1.25"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Galería fotográfica"
                                Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Toque una imagen para verla a pantalla completa."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Style="{StaticResource ModernBadgeGreen}">
                            <Label
                                Text="{Binding Detalle.Fotos.Count, StringFormat='{}{0} fotos'}"
                                FontSize="10.5"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />
                        </Border>
                    </Grid>

                    <Border
                        IsVisible="{Binding SinFotos}"
                        Style="{StaticResource ModernEmptyStateCard}">
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="9">
                            <Image
                                Source="iconalbum.png"
                                WidthRequest="58"
                                HeightRequest="58" />
                            <Label
                                Text="Este registro todavía no tiene fotografías."
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Fotografías virtualizadas; evita crear toda la galería a la vez. -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="0"
                        Style="{StaticResource ModernCatalogCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.AbrirFotoCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid HeightRequest="{OnIdiom Phone=158, Tablet=190, Desktop=215}">
                            <Image
                                Source="{Binding FotoUrl, Converter={StaticResource AlbumImageSourceConverter}}"
                                Aspect="AspectFill" />

                            <BoxView
                                VerticalOptions="End"
                                HeightRequest="{OnIdiom Phone=48, Default=58}"
                                Color="#88000000" />

                            <Label
                                Margin="10,0,10,8"
                                Text="{Binding DescripcionMostrar}"
                                VerticalOptions="End"
                                TextColor="White"
                                FontSize="{OnIdiom Phone=9.5, Default=11}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />

                            <Border
                                Margin="9"
                                Padding="7,4"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                IsVisible="{Binding EsPortada}"
                                BackgroundColor="{StaticResource color_Verde}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 9">
                                <Label
                                    Text="Portada"
                                    FontSize="9.5"
                                    FontAttributes="Bold"
                                    TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- La información técnica aparece después de la galería y también se desplaza. -->
            <CollectionView.Footer>
                <VerticalStackLayout
                    Spacing="12"
                    Padding="0,18,0,8">
                    <Label
                        Text="Información técnica"
                        Style="{StaticResource ModernSectionTitle}" />

                    <Border
                        IsVisible="{Binding Detalle.TieneCaracteristicas}"
                        Style="{StaticResource ModernCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Características"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource color_Verde}" />
                            <Label
                                Text="{Binding Detalle.Caracteristicas}"
                                FontSize="13"
                                LineHeight="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding Detalle.TieneSintomas}"
                        Style="{StaticResource ModernCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Síntomas"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                Text="{Binding Detalle.Sintomas}"
                                FontSize="13"
                                LineHeight="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding Detalle.TieneCausas}"
                        Style="{StaticResource ModernCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Causas"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource color_Naranja}" />
                            <Label
                                Text="{Binding Detalle.Causas}"
                                FontSize="13"
                                LineHeight="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding Detalle.TieneRecomendaciones}"
                        Style="{StaticResource ModernInfoBanner}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Recomendaciones"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource color_Verde}" />
                            <Label
                                Text="{Binding Detalle.Recomendaciones}"
                                FontSize="13"
                                LineHeight="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding Detalle.TieneObservaciones}"
                        Style="{StaticResource ModernWarningBanner}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Observaciones"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource color_Cafe}" />
                            <Label
                                Text="{Binding Detalle.Observaciones}"
                                FontSize="13"
                                LineHeight="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- Relay de carga y operaciones administrativas. -->
        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#520B1511">
            <Border
                Padding="22,18"
                MaximumWidthRequest="340"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="38"
                        HeightRequest="38" />
                    <Label
                        Text="Cargando detalle del álbum..."
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="Preparando información y fotografías."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource ModernCaption}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
