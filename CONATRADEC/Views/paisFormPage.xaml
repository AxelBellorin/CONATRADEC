<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.paisFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid x:Name="ContenidoPaisFormulario" Padding="12,12,12,20">
        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="920" HorizontalOptions="Center" Spacing="14">
                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource ModernPageTitle}" TextColor="{StaticResource color_Verde}" />
                            <Label Text="{Binding Subtitulo}" Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource color_Naranja}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información general" Style="{StaticResource ModernSectionTitle}" />
                            <Label Text="El código ISO se utiliza en búsquedas, filtros y relaciones geográficas." Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="CamposPaisGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nombre del país" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorNombrePais}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry Placeholder="Ejemplo: Nicaragua" Text="{Binding NombrePais}" MaxLength="80" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource ModernEntry}" />
                                </Border>
                                <Label Text="{Binding ErrorNombrePais}" IsVisible="{Binding TieneErrorNombrePais}" FontSize="11" TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="CampoCodigoIso" Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="Código ISO" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorCodigoISOPais}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry Placeholder="NIC" Text="{Binding CodigoISOPais}" MaxLength="3" IsReadOnly="{Binding IsReadOnly}" CharacterSpacing="2" FontFamily="MontserratBold" Style="{StaticResource ModernEntry}" />
                                </Border>
                                <Label Text="{Binding ErrorCodigoISOPais}" IsVisible="{Binding TieneErrorCodigoISOPais}" FontSize="11" TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,16">
                    <Button Grid.Column="0" Text="Guardar" IsVisible="{Binding ShowSaveButton}" IsEnabled="{Binding NotIsBusy}" Command="{Binding SaveCommand}" Style="{StaticResource ModernPrimaryButton}" />
                    <Button Grid.Column="1" Text="Cancelar" IsEnabled="{Binding NotIsBusy}" Command="{Binding CancelCommand}" Style="{StaticResource ModernNeutralButton}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#4A0B1511">
            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Procesando país..." VerticalOptions="Center" FontFamily="MontserratBold" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
