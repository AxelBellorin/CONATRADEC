<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumFotosAdminPage"
    x:Name="FotosAdminRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <!--
            Un único CollectionView vertical conserva la virtualización de la galería.
            El encabezado y el formulario también se desplazan para dejar más espacio
            a las fotografías en pantallas pequeñas.
        -->
        <CollectionView
            x:Name="FotosCollectionView"
            ItemsSource="{Binding Detalle.Fotos}"
            SelectionMode="None"
            ItemSizingStrategy="MeasureFirstItem"
            MaximumWidthRequest="1450"
            HorizontalOptions="Fill"
            Margin="{OnIdiom Phone='12,10,12,24', Tablet='20,16,20,30', Desktop='28,20,28,36'}">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                    HorizontalItemSpacing="14"
                    VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout
                    Spacing="14"
                    Margin="0,0,0,14">

                    <!-- Encabezado desplazable. x:Name se conserva para el code-behind de Windows. -->
                    <Border Style="{StaticResource ModernHeroCard}">
                        <VerticalStackLayout Spacing="9">
                            <Button
                                x:Name="RegresarButton"
                                Text="← Regresar"
                                Clicked="OnRegresarClicked"
                                IsEnabled="{Binding NotIsBusy}"
                                Style="{StaticResource ModernLinkButton}"
                                HorizontalOptions="Start"
                                Padding="4,4"
                                HeightRequest="36" />
                            <Label
                                Text="Administrar fotografías"
                                Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="{Binding Detalle.Titulo}"
                                Style="{StaticResource ModernPageSubtitle}"
                                MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding Detalle.Inactivo}"
                        Style="{StaticResource ModernWarningBanner}">
                        <Label
                            Text="El registro está inactivo. Debe activarlo antes de agregar nuevas fotografías."
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Cafe}"
                            LineBreakMode="WordWrap" />
                    </Border>

                    <!-- Formulario para subir fotografía. -->
                    <Border
                        IsVisible="{Binding PuedeSubir}"
                        Style="{StaticResource ModernFormCard}">
                        <Grid
                            ColumnDefinitions="{OnIdiom Phone='*', Tablet='0.85*,1.15*', Desktop='0.82*,1.18*'}"
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnSpacing="22"
                            RowSpacing="14">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                StrokeShape="RoundRectangle 16">
                                <Grid
                                    RowDefinitions="*,Auto,Auto"
                                    RowSpacing="9"
                                    MinimumHeightRequest="{OnIdiom Phone=270, Tablet=315, Desktop=330}">
                                    <Grid Grid.Row="0">
                                        <Image
                                            Source="iconalbum.png"
                                            WidthRequest="76"
                                            HeightRequest="76"
                                            Aspect="AspectFit"
                                            IsVisible="{Binding SinArchivoSeleccionado}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                        <Border
                                            IsVisible="{Binding TieneArchivoSeleccionado}"
                                            BackgroundColor="#E5EFEB"
                                            Stroke="{StaticResource BorderSoft}"
                                            StrokeShape="RoundRectangle 12">
                                            <Image
                                                Source="{Binding ImagenSeleccionadaPreview}"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill" />
                                        </Border>
                                    </Grid>

                                    <Button
                                        Grid.Row="1"
                                        Text="Seleccionar fotografía"
                                        Command="{Binding SeleccionarArchivoCommand}"
                                        IsEnabled="{Binding NotIsBusy}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        HorizontalOptions="Fill" />

                                    <Grid
                                        Grid.Row="2"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">
                                        <Label
                                            Text="{Binding ArchivoSeleccionadoTexto}"
                                            MaxLines="1"
                                            LineBreakMode="MiddleTruncation"
                                            Style="{StaticResource ModernCaption}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="JPG · PNG · WEBP · 8 MB"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="9"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <VerticalStackLayout
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Spacing="13">
                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Nueva fotografía"
                                        Style="{StaticResource ModernSectionTitle}"
                                        TextColor="{StaticResource color_Verde}" />
                                    <Label
                                        Text="Agregue una descripción y defina su posición dentro de la galería."
                                        Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        Text="Descripción"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}" Padding="10">
                                        <Editor
                                            Text="{Binding DescripcionNueva}"
                                            MaxLength="500"
                                            MinimumHeightRequest="100"
                                            AutoSize="TextChanges"
                                            Placeholder="Describa lo que se observa en la fotografía."
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>
                                </VerticalStackLayout>

                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='0.7*,1.3*'}"
                                    RowSpacing="10"
                                    ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="5">
                                        <Label
                                            Text="Orden"
                                            Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <Entry
                                                Text="{Binding OrdenNuevo}"
                                                Keyboard="Numeric"
                                                Style="{StaticResource ModernEntry}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        Style="{StaticResource ModernSoftPanel}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="Usar como portada"
                                                    Style="{StaticResource ModernFieldLabel}" />
                                                <Label
                                                    Text="Será la imagen principal de la ficha."
                                                    Style="{StaticResource ModernCaption}" />
                                            </VerticalStackLayout>
                                            <Switch
                                                Grid.Column="1"
                                                IsToggled="{Binding EsPortadaNueva}"
                                                Style="{StaticResource SwitchStyle}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Button
                                    Text="Subir fotografía"
                                    Command="{Binding SubirFotoCommand}"
                                    IsEnabled="{Binding TieneArchivoSeleccionado}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    HorizontalOptions="Fill" />
                                <Label
                                    Text="Seleccione una imagen para habilitar la carga."
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Fotografías guardadas"
                                Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Toque una imagen para verla completa."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Style="{StaticResource ModernBadgeGreen}">
                            <Label
                                Text="{Binding Detalle.Fotos.Count, StringFormat='{}{0} fotos'}"
                                FontSize="10.5"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />
                        </Border>
                    </Grid>

                    <Border
                        IsVisible="{Binding SinFotos}"
                        Style="{StaticResource ModernEmptyStateCard}">
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="9">
                            <Image
                                Source="iconalbum.png"
                                WidthRequest="54"
                                HeightRequest="54" />
                            <Label
                                Text="Este registro todavía no tiene fotografías."
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Tarjeta virtualizada; sin sombras por elemento para mejorar el scroll. -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        HorizontalOptions="Fill"
                        Padding="0"
                        Style="{StaticResource ModernCatalogCard}">
                        <Grid RowDefinitions="{OnIdiom Phone='225,Auto', Tablet='210,Auto', Desktop='205,Auto'}">
                            <Grid
                                Grid.Row="0"
                                BackgroundColor="#EEF5F2">
                                <Image
                                    Source="{Binding FotoUrl}"
                                    Aspect="AspectFill" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.AbrirFotoCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border
                                    Margin="10"
                                    Padding="8,4"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding EsPortada}"
                                    BackgroundColor="{StaticResource color_Verde}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 9">
                                    <Label
                                        Text="Portada"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="White" />
                                </Border>

                                <Border
                                    Margin="10"
                                    Padding="8,4"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    BackgroundColor="#DDF7F3EF"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 9">
                                    <Label
                                        Text="Ver completa"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Verde}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout
                                Grid.Row="1"
                                Padding="14"
                                Spacing="9">
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Descripción"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding DescripcionFoto, Mode=TwoWay}"
                                            MaxLength="500"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Orden"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding OrdenTexto, Mode=TwoWay}"
                                            Keyboard="Numeric"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <Button
                                    Text="Guardar cambios"
                                    Command="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.GuardarFotoCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.CanEdit}"
                                    IsEnabled="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.NotIsBusy}"
                                    Style="{StaticResource ModernUpdateButton}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                    <Button
                                        Grid.Column="0"
                                        Text="Portada"
                                        Command="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.EstablecerPortadaCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.CanEdit}"
                                        IsEnabled="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.NotIsBusy}"
                                        Style="{StaticResource ModernSecondaryButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Eliminar"
                                        Command="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.EliminarFotoCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.CanDelete}"
                                        IsEnabled="{Binding Source={x:Reference FotosAdminRoot}, Path=BindingContext.NotIsBusy}"
                                        Style="{StaticResource ModernDangerSoftButton}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="18" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Relay para carga, subida, edición, portada y eliminación. -->
        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#520B1511">
            <Border
                Padding="22,18"
                MaximumWidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="38"
                        HeightRequest="38" />
                    <Label
                        Text="Procesando fotografías..."
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="Espere mientras se completa la operación."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource ModernCaption}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
