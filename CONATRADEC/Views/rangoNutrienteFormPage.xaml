<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rangoNutrienteFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <ScrollView
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Padding="{OnIdiom Phone='14,14,14,24', Tablet='22,18,22,28', Desktop='28,22,28,32'}"
                Spacing="14">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="52"
                            HeightRequest="52"
                            VerticalOptions="Start">
                            <Image
                                Source="iconrangonutriente.png"
                                WidthRequest="28"
                                HeightRequest="28"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Rango nutricional" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource ModernPageTitle}" />
                            <Label Text="{Binding Subtitulo}" Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información del rango" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Cada cultivo puede tener un único rango activo por elemento químico."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="DatosReferenciaGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="13">

                            <VerticalStackLayout x:Name="CultivoSection" Grid.Row="0" Spacing="6">
                                <Label Text="Tipo de cultivo" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInfoBanner}">
                                    <Label
                                        Text="{Binding TipoCultivoNombre}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                                </Border>
                                <Label
                                    Text="{Binding ErrorTipoCultivo}"
                                    IsVisible="{Binding TieneErrorTipoCultivo}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ElementoSection" Grid.Row="1" Spacing="6">
                                <Label Text="Elemento químico" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorElemento}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Picker
                                        Style="{StaticResource ModernPicker}"
                                        ItemsSource="{Binding Elementos}"
                                        SelectedItem="{Binding ElementoSeleccionado}"
                                        ItemDisplayBinding="{Binding Texto}"
                                        Title="Seleccione un elemento"
                                        IsEnabled="{Binding IsEditable}"
                                        SemanticProperties.Description="Elemento químico del rango nutricional" />
                                </Border>
                                <Label
                                    Text="{Binding ErrorElemento}"
                                    IsVisible="{Binding TieneErrorElemento}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid
                            x:Name="ValoresGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="13">

                            <VerticalStackLayout x:Name="MinimoSection" Grid.Row="0" Spacing="6">
                                <Label Text="Valor mínimo" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorMinimo}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Style="{StaticResource ModernEntry}"
                                        Text="{Binding MinimoTexto}"
                                        Placeholder="Ejemplo: 10.50"
                                        Keyboard="Numeric"
                                        MaxLength="12"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        SemanticProperties.Description="Valor mínimo del rango en libras por manzana" />
                                </Border>
                                <Label
                                    Text="{Binding ErrorMinimo}"
                                    IsVisible="{Binding TieneErrorMinimo}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="MaximoSection" Grid.Row="1" Spacing="6">
                                <Label Text="Valor máximo" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorMaximo}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Style="{StaticResource ModernEntry}"
                                        Text="{Binding MaximoTexto}"
                                        Placeholder="Ejemplo: 25.00"
                                        Keyboard="Numeric"
                                        MaxLength="12"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        SemanticProperties.Description="Valor máximo del rango en libras por manzana" />
                                </Border>
                                <Label
                                    Text="{Binding ErrorMaximo}"
                                    IsVisible="{Binding TieneErrorMaximo}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border Style="{StaticResource ModernWarningBanner}">
                            <Label
                                Text="Los valores admiten un máximo de dos decimales y el máximo debe ser mayor que el mínimo."
                                Style="{StaticResource ModernCaption}" />
                        </Border>

                        <Grid
                            ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="13">

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Unidad base" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInfoBanner}">
                                    <Label
                                        Text="{Binding UnidadBaseDescripcion}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                                </Border>
                                <Label
                                    Text="La interfaz trabaja en lb/Mz. La compatibilidad histórica de la base de datos se conserva internamente."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                Spacing="6">
                                <Label Text="Descripción" Style="{StaticResource ModernFieldLabel}" />
                                <Border
                                    Style="{StaticResource ModernInputBorder}"
                                    MinimumHeightRequest="118"
                                    Padding="10,7">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorDescripcion}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Editor
                                        Text="{Binding Descripcion}"
                                        Placeholder="Descripción del rango nutricional"
                                        MaxLength="150"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="100"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                        FontFamily="MontserratMedium"
                                        FontSize="13"
                                        SemanticProperties.Description="Descripción del rango nutricional" />
                                </Border>
                                <Label Text="Máximo 150 caracteres." Style="{StaticResource ModernCaption}" />
                                <Label
                                    Text="{Binding ErrorDescripcion}"
                                    IsVisible="{Binding TieneErrorDescripcion}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="9"
                    Margin="0,2,0,12">
                    <Button
                        Text="Guardar"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        SemanticProperties.Description="Guardar el rango nutricional" />
                    <Button
                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Text="Cancelar"
                        Style="{StaticResource ModernNeutralButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsEditable}"
                        IsEnabled="{Binding NotIsBusy}"
                        SemanticProperties.Description="Cancelar y regresar a los rangos del cultivo" />
                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                        Text="Regresar"
                        Style="{StaticResource ModernNeutralButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}"
                        SemanticProperties.Description="Regresar a los rangos del cultivo" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Relay de carga: bloquea acciones duplicadas mientras el ViewModel trabaja. -->
        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#28000000">
            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="24"
                        HeightRequest="24"
                        SemanticProperties.Description="Procesando rango nutricional" />
                    <Label
                        Text="Procesando rango nutricional..."
                        VerticalOptions="Center"
                        FontFamily="MontserratBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
