<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.ActualizacionAplicacionPage"
    x:Name="ActualizacionPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <!--
            Contenido autorizado. La página registrada desde Configuración exige
            permiso de lectura; el acceso automático por actualización del
            sistema puede habilitarse mediante parámetro interno de navegación.
        -->
        <Grid
            x:Name="ContenidoAutorizado"
            RowDefinitions="*,Auto">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout
                    x:Name="ContenidoPrincipal"
                    Padding="24,20,24,28"
                    Spacing="16"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Centro de actualizaciones"
                                    Style="{StaticResource ModernPageTitle}" />

                                <Label
                                    Text="Busque, descargue e instale nuevas versiones de ConatraCafé Soil."
                                    Style="{StaticResource ModernPageSubtitle}"
                                    MaxLines="3" />
                            </VerticalStackLayout>

                            <Grid
                                x:Name="HeaderActionsGrid"
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto"
                                ColumnSpacing="10"
                                RowSpacing="10">

                                <Button
                                    x:Name="BuscarHeaderButton"
                                    Text="Buscar actualizaciones"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    IsEnabled="{Binding PuedeBuscar}"
                                    Clicked="BuscarActualizaciones_Clicked" />

                                <Button
                                    x:Name="CerrarHeaderButton"
                                    Grid.Column="1"
                                    Text="Cerrar"
                                    Style="{StaticResource ModernNeutralButton}"
                                    IsVisible="{Binding PuedeCerrar}"
                                    Clicked="Volver_Clicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Estado general: sin comprobar, buscando o actualizado. -->
                    <Border
                        IsVisible="{Binding NoTieneActualizacion}"
                        Style="{StaticResource ModernFormCard}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border
                                WidthRequest="58"
                                HeightRequest="58"
                                Padding="12"
                                BackgroundColor="#EEF5F2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">

                                <Label
                                    Text="✓"
                                    FontSize="28"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{StaticResource color_Verde}" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="{Binding TituloEstadoGeneral}"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="19" />

                                    <ActivityIndicator
                                        Grid.Column="1"
                                        IsRunning="{Binding Consultando}"
                                        IsVisible="{Binding Consultando}"
                                        Color="{StaticResource color_Naranja}" />
                                </Grid>

                                <Label
                                    Text="{Binding DescripcionEstadoGeneral}"
                                    Style="{StaticResource ModernPageSubtitle}" />

                                <Label
                                    Text="{Binding UltimaComprobacionTexto}"
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Versión actualmente instalada. -->
                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="Aplicación instalada"
                                Style="{StaticResource ModernSectionTitle}" />

                            <Grid
                                x:Name="VersionInfoGrid"
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto"
                                ColumnSpacing="10"
                                RowSpacing="10">

                                <Border
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="Versión instalada"
                                            Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding VersionInstalada}"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    x:Name="PlataformaInstaladaCard"
                                    Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="Plataforma"
                                            Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PlataformaVisible}"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Label
                                Text="{Binding UltimaComprobacionTexto}"
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Información de la nueva versión. -->
                    <Border
                        IsVisible="{Binding TieneActualizacion}"
                        Style="{StaticResource ModernFormCard}">

                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    Padding="13"
                                    BackgroundColor="#EEF5F2"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 17">
                                    <Label
                                        Text="↻"
                                        FontSize="31"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="{StaticResource color_Verde}" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding NuevaVersionTitulo}"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="21" />
                                    <Label
                                        Text="{Binding ResumenVersion}"
                                        Style="{StaticResource ModernPageSubtitle}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Border
                                IsVisible="{Binding EsObligatoria}"
                                Padding="12"
                                BackgroundColor="#FFF4E5"
                                Stroke="#FFB74D"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                                <Label
                                    Text="Esta actualización es obligatoria. El bloqueo solo se aplica mientras el servidor confirme que la versión continúa vigente."
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    TextColor="#8A4B00" />
                            </Border>

                            <Grid
                                x:Name="NuevaVersionDatosGrid"
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="10">

                                <Border
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Versión instalada" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding VersionInstalada}"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    x:Name="NuevaVersionCard"
                                    Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Nueva versión" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding VersionNueva}"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource color_Verde}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    x:Name="NuevaPlataformaCard"
                                    Grid.Row="1"
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Plataforma" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PlataformaVisible}"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    x:Name="TamanoVersionCard"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="#F7F9F8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tamaño" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding TamanoVisible}"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <VerticalStackLayout Spacing="7">
                                <Label
                                    Text="Novedades"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="16" />
                                <Label
                                    Text="{Binding NotasVersion}"
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Border
                                IsVisible="{Binding TieneArchivoDescargado}"
                                Padding="13"
                                BackgroundColor="#ECFDF3"
                                Stroke="#A6D7B8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label
                                        Text="✓"
                                        FontAttributes="Bold"
                                        FontSize="20"
                                        TextColor="#16794B" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            Text="Archivo listo para instalar"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            TextColor="#16643B" />
                                        <Label
                                            Text="El archivo ya fue validado por tamaño y SHA-256."
                                            FontSize="11"
                                            LineBreakMode="WordWrap"
                                            TextColor="#356B50" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Progreso global y recuperable. -->
                    <Border
                        IsVisible="{Binding MostrandoProgreso}"
                        Padding="15"
                        BackgroundColor="#F1F7F4"
                        Stroke="#BFD8D0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding EstadoDescarga}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{StaticResource color_Verde}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding PorcentajeTexto}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{StaticResource color_Verde}" />
                            </Grid>

                            <ProgressBar
                                Progress="{Binding ProgresoDescarga}"
                                ProgressColor="{StaticResource color_Verde}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label
                                    Text="{Binding DetalleDescarga}"
                                    Style="{StaticResource ModernCaption}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding VelocidadTexto}"
                                    Style="{StaticResource ModernCaption}" />
                            </Grid>

                            <Label
                                Text="{Binding TiempoRestanteTexto}"
                                Style="{StaticResource ModernCaption}" />

                            <Label
                                Text="{Binding DescripcionPersistenciaDescarga}"
                                Style="{StaticResource ModernCaption}"
                                LineBreakMode="WordWrap" />

                            <Button
                                Text="Cancelar descarga"
                                Clicked="CancelarDescarga_Clicked"
                                IsVisible="{Binding PuedeCancelarDescarga}"
                                HorizontalOptions="Start"
                                Padding="12,8"
                                BackgroundColor="#FFF1F2"
                                TextColor="#B42318" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding TieneMensajeEstado}"
                        Padding="13"
                        BackgroundColor="#F8FAF9"
                        Stroke="#E1E8E5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                        <Label
                            Text="{Binding MensajeEstado}"
                            Style="{StaticResource ModernPageSubtitle}" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Border
                x:Name="BarraAccion"
                Grid.Row="1"
                Padding="16,12,16,18"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="#DDE7E3"
                StrokeThickness="1">

                <Button
                    Text="{Binding TextoBotonPrincipal}"
                    Clicked="AccionPrincipal_Clicked"
                    IsEnabled="{Binding PuedeEjecutarPrincipal}"
                    Style="{StaticResource ModernPrimaryButton}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="720"
                    HeightRequest="52" />
            </Border>

            <!-- Relay bloqueante para consultas HTTP e inicio del instalador. -->
            <Grid
                Grid.RowSpan="2"
                IsVisible="{Binding BloqueoInterfaz}"
                BackgroundColor="#66000000"
                InputTransparent="False"
                ZIndex="20">
                <Border
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24,20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator
                            IsRunning="True"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="38"
                            HeightRequest="38" />
                        <Label
                            Text="Procesando actualización..."
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- Estado explícito para una navegación administrativa sin permiso. -->
        <Grid
            x:Name="SinPermisoPanel"
            IsVisible="False"
            Padding="24">
            <Border
                MaximumWidthRequest="620"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Style="{StaticResource ModernEmptyStateCard}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Acceso no autorizado"
                        Style="{StaticResource ModernSectionTitle}"
                        FontSize="20"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para abrir el centro de actualizaciones desde Configuración. Las actualizaciones obligatorias del sistema se gestionan automáticamente cuando corresponda."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Volver a Configuración"
                        Style="{StaticResource ModernPrimaryButton}"
                        Clicked="VolverSinPermiso_Clicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
