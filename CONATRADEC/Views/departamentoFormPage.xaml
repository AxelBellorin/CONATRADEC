<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.departamentoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid x:Name="ContenidoDepartamentoFormulario" Padding="12,12,12,20">
        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="920" HorizontalOptions="Center" Spacing="14">
                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource ModernPageTitle}" TextColor="{StaticResource color_Verde}" />
                            <Label Text="{Binding Subtitulo}" Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource color_Naranja}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernSoftPanel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border WidthRequest="46" HeightRequest="46" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <Image Source="iconcountry.png" Aspect="AspectFit" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="País asociado" Style="{StaticResource ModernCaption}" />
                            <Label Text="{Binding NombrePais}" FontSize="15" FontFamily="MontserratBold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" IsVisible="{Binding MostrarCodigoPais}" Padding="9,5" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                            <Label Text="{Binding CodigoPais}" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource color_Verde}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información general" Style="{StaticResource ModernSectionTitle}" />
                            <Label Text="El departamento permanecerá asociado al país mostrado arriba." Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre del departamento" Style="{StaticResource ModernFieldLabel}" />
                            <Border Style="{StaticResource ModernInputBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TieneErrorNombreDepartamento}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Placeholder="Ejemplo: Managua" Text="{Binding NombreDepartamento}" MaxLength="80" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource ModernEntry}" />
                            </Border>
                            <Label Text="{Binding ErrorNombreDepartamento}" IsVisible="{Binding TieneErrorNombreDepartamento}" FontSize="11" TextColor="{StaticResource RedDelete}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,16">
                    <Button Grid.Column="0" Text="Guardar" IsVisible="{Binding ShowSaveButton}" IsEnabled="{Binding NotIsBusy}" Command="{Binding SaveCommand}" Style="{StaticResource ModernPrimaryButton}" />
                    <Button Grid.Column="1" Text="Cancelar" IsEnabled="{Binding NotIsBusy}" Command="{Binding CancelCommand}" Style="{StaticResource ModernNeutralButton}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#4A0B1511">
            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" WidthRequest="24" HeightRequest="24" />
                    <Label Text="Procesando departamento..." VerticalOptions="Center" FontFamily="MontserratBold" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
