<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.userPage"
    x:Name="UserPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="{OnIdiom Phone=16, Tablet=24, Desktop=28}">

                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="70"
                            HeightRequest="70"
                            Padding="14">
                            <Image
                                Source="iconpermission.png"
                                Aspect="AspectFit"
                                Opacity="0.72" />
                        </Border>

                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="21"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar usuarios."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a configuración"
                            Command="{Binding RegresarConfiguracionCommand}"
                            Style="{StaticResource ModernPrimaryButton}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido -->
            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}">

                <RefreshView
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">

                    <CollectionView
                        ItemsSource="{Binding UsersList}"
                        SelectionMode="None">

                        <!--
                            Encabezado, búsqueda y mensajes forman parte del
                            contenido desplazable. No se mueven controles en
                            tiempo de ejecución ni se modifica su padre visual.
                        -->
                        <CollectionView.Header>
                            <VerticalStackLayout
                                Spacing="12"
                                Padding="0,0,0,12">

                                <controls:ResponsiveCatalogHeader
                                    Title="Usuarios"
                                    Subtitle="Administre cuentas internas, externas, roles y procedencia."
                                    BackText="← Configuración"
                                    BackCommand="{Binding RegresarConfiguracionCommand}"
                                    PrimaryText="+ Nuevo usuario"
                                    PrimaryCommand="{Binding AddUserCommand}"
                                    IsPrimaryVisible="{Binding CanAdd}" />

                                <controls:ResponsiveSearchPanel
                                    Placeholder="Nombre, usuario, correo, identificación o teléfono"
                                    SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                                    SummaryText="{Binding ResumenResultados}"
                                    SearchCommand="{Binding BuscarCommand}"
                                    ClearCommand="{Binding LimpiarFiltrosCommand}" />

                                <Border
                                    IsVisible="{Binding TieneMensaje}"
                                    Style="{StaticResource ModernWarningBanner}">
                                    <Label
                                        Text="{Binding Mensaje}"
                                        FontFamily="MontserratMedium"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>

                                <!--
                                    El estado vacío forma parte del Header y no usa
                                    CollectionView.EmptyView. En WinUI el EmptyView
                                    puede ocupar la superficie completa del control y
                                    capturar interacción sobre contenido visible.
                                -->
                                <Border
                                    IsVisible="{Binding MostrarVacio}"
                                    InputTransparent="True"
                                    Style="{StaticResource ModernEmptyStateCard}"
                                    Margin="0,8,0,12"
                                    MaximumWidthRequest="560"
                                    HorizontalOptions="Center">
                                    <VerticalStackLayout
                                        Spacing="8"
                                        HorizontalOptions="Center">
                                        <Border
                                            Style="{StaticResource ModernIconTile}"
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            Padding="11">
                                            <Image
                                                Source="iconuser.png"
                                                Aspect="AspectFit"
                                                Opacity="0.62" />
                                        </Border>
                                        <Label
                                            Text="No se encontraron usuarios"
                                            Style="{StaticResource ModernSectionTitle}"
                                            FontSize="17"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Cambie la búsqueda o registre una nueva cuenta."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="UsuariosGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>


                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:UserResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="230">

                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="13">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">

                                            <Border
                                                WidthRequest="62"
                                                HeightRequest="62"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 17">
                                                <Grid>
                                                    <Label
                                                        Text="{Binding Iniciales}"
                                                        FontSize="18"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource color_Verde}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Image
                                                        Source="{Binding UrlImagenUsuario}"
                                                        IsVisible="{Binding TieneImagen}"
                                                        Aspect="AspectFill" />
                                                </Grid>
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding NombreMostrar}"
                                                    FontSize="16"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding NombreUsuario, StringFormat='@{0}'}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="11.5"
                                                    TextColor="{StaticResource color_Verde}" />
                                                <Label
                                                    Text="{Binding CorreoMostrar}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="11.5"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                VerticalOptions="Start">
                                                <Label
                                                    Text="{Binding ProcedenciaMostrar}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="9.5"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8">
                                            <Border Style="{StaticResource ModernBadgeBlue}" Padding="9,7">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="ROL" FontFamily="MontserratBold" FontSize="8.5" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding RolMostrar}" FontFamily="MontserratBold" FontSize="10.5" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ModernBadgeYellow}" Padding="9,7">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="IDENTIFICACIÓN" FontFamily="MontserratBold" FontSize="8.5" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding IdentificacionMostrar}" FontFamily="MontserratMedium" FontSize="10.5" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="2"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">
                                            <Button
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Command="{Binding Source={x:Reference UserPageRoot}, Path=BindingContext.ViewUserCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                IsVisible="{Binding Source={x:Reference UserPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference UserPageRoot}, Path=BindingContext.EditUserCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                IsVisible="{Binding Source={x:Reference UserPageRoot}, Path=BindingContext.CanDelete}"
                                                IsEnabled="{Binding PuedeDesactivar}"
                                                Command="{Binding Source={x:Reference UserPageRoot}, Path=BindingContext.DeleteUserCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!--
                            Paginación explícita: la colección contiene únicamente
                            la página actual. Anterior/Siguiente consultan al servidor
                            y reemplazan los elementos en memoria.
                        -->
                        <CollectionView.Footer>
                            <Border
                                x:Name="PaginacionUsuarios"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="{OnIdiom Phone='12,12', Tablet='14,13', Desktop='16,14'}"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <!--
                                    Composición única y estable para Windows, tablet
                                    y móvil. La información ocupa una fila propia y
                                    los botones comparten exactamente el ancho disponible.
                                -->
                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            HorizontalOptions="Fill" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </Grid>

        <!--
            Relay único para toda operación asíncrona del módulo Usuarios.
            Se muestra en carga, búsqueda, paginación, navegación y acciones
            de escritura, y siempre se libera al finalizar la operación.
        -->
        <Grid
            IsVisible="{Binding MostrandoRelay}"
            InputTransparent="False"
            BackgroundColor="#66000000"
            ZIndex="100">

            <Border
                Padding="22,18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding MostrandoRelay}"
                        Color="{StaticResource color_Naranja}"
                        WidthRequest="26"
                        HeightRequest="26" />
                    <VerticalStackLayout
                        Spacing="1"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding TituloRelay}"
                            FontFamily="MontserratBold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="{Binding DetalleRelay}"
                            FontFamily="MontserratMedium"
                            FontSize="10"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>
        </Grid>
    </ContentView>
</ContentPage>
