<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MotivoDevolucionTecnicoEliminadosPage"
    x:Name="PaginaRaiz"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid Padding="{OnIdiom Phone='12,12,12,22', Tablet='18,16,18,26', Desktop='24,20,24,30'}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="14" Padding="0,0,0,14">
                        <controls:ResponsiveCatalogHeader
                            Title="Motivos de devolución eliminados"
                            Subtitle="Registros inactivos conservados históricamente. Recuperar vuelve a activarlos sin crear un identificador nuevo."
                            BackText="← Motivos activos"
                            BackCommand="{Binding RegresarCommand}"
                            IsPrimaryVisible="False" />

                        <Border
                            IsVisible="{Binding SinPermisoLectura}"
                            Style="{StaticResource ModernWarningBanner}">
                            <Label
                                Text="No tiene permiso para consultar los motivos eliminados."
                                HorizontalTextAlignment="Center"
                                FontFamily="MontserratMedium"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>

                        <Border
                            IsVisible="{Binding CanView}"
                            Style="{StaticResource ModernFormCard}">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                                <Border Grid.Row="0" Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        Text="{Binding TextoBusqueda}"
                                        Placeholder="Buscar eliminados"
                                        ReturnType="Search"
                                        ReturnCommand="{Binding BuscarCommand}"
                                        ClearButtonVisibility="WhileEditing"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>

                                <Grid
                                    x:Name="AccionesEliminadosGrid"
                                    Grid.Row="1"
                                    ColumnDefinitions="*,*,*"
                                    RowDefinitions="Auto"
                                    ColumnSpacing="7"
                                    RowSpacing="7">
                                    <Button
                                        x:Name="BuscarButton"
                                        Grid.Column="0"
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        MinimumWidthRequest="0"
                                        HeightRequest="44"
                                        Padding="5,7" />
                                    <Button
                                        x:Name="LimpiarButton"
                                        Grid.Column="1"
                                        Text="Limpiar"
                                        Command="{Binding LimpiarCommand}"
                                        Style="{StaticResource ModernNeutralButton}"
                                        MinimumWidthRequest="0"
                                        HeightRequest="44"
                                        Padding="5,7" />
                                    <Button
                                        x:Name="ActualizarButton"
                                        Grid.Column="2"
                                        Text="Actualizar"
                                        Command="{Binding ActualizarCommand}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        MinimumWidthRequest="0"
                                        HeightRequest="44"
                                        Padding="5,7" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label
                                        Text="{Binding BusquedaAplicadaTexto}"
                                        Style="{StaticResource ModernCaption}"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Resumen}"
                                        FontFamily="MontserratBold"
                                        FontSize="11"
                                        TextColor="{StaticResource color_Cafe}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            IsVisible="{Binding SinRegistros}"
                            InputTransparent="True"
                            Style="{StaticResource ModernEmptyStateCard}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label
                                    Text="No se encontraron motivos eliminados"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="17"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="Use Limpiar para consultar todos los registros inactivos."
                                    Style="{StaticResource ModernPageSubtitle}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MotivoDevolucionTecnicoItem">
                        <Border Style="{StaticResource ModernCatalogCard}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="{Binding NombreMostrar}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding CodigoTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="10.5"
                                            TextColor="{StaticResource color_Cafe}" />
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandCoffeeSoft}, Dark={StaticResource BrandCoffeeSoftDark}}"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 9"
                                        VerticalOptions="Start">
                                        <Label
                                            Text="Inactivo"
                                            FontFamily="MontserratBold"
                                            FontSize="10"
                                            TextColor="{StaticResource color_Cafe}" />
                                    </Border>
                                </Grid>

                                <Label
                                    Text="{Binding Descripcion}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12.5"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    LineBreakMode="WordWrap" />

                                <Border Style="{StaticResource ModernSoftPanel}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="{Binding InstruccionSugerida}"
                                            Style="{StaticResource ModernCaption}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding TipoCorreccionTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="11"
                                            TextColor="{StaticResource color_Cafe}"
                                            LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <Button
                                    Text="Recuperar"
                                    Command="{Binding Source={x:Reference PaginaRaiz}, Path=BindingContext.RecuperarCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Source={x:Reference PaginaRaiz}, Path=BindingContext.CanEdit}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    HeightRequest="44"
                                    HorizontalOptions="Fill" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="{OnIdiom Phone=24, Tablet=28, Desktop=32}" Opacity="0" />
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#66000000"
                InputTransparent="False">
                <Border
                    Padding="20,16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Naranja}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="{Binding MensajeEstado}"
                            HorizontalTextAlignment="Center"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
