<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.noticiasPage"
    x:Name="NoticiasRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Title="Noticias"
    BackgroundColor="#FFF5FF"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid
            x:Name="ContenidoPrincipal"
            RowDefinitions="Auto,*"
            Padding="{OnPlatform WinUI='24,20', Default='14,12'}"
            RowSpacing="12">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="Noticias e intereses"
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        FontSize="{OnPlatform WinUI=28, Default=23}"
                        TextColor="#3B655B" />
                    <Label
                        Text="{Binding TotalTexto}"
                        FontFamily="MontserratMedium"
                        FontSize="12"
                        TextColor="#6B7280" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="Administrar"
                    Command="{Binding AbrirAdministracionCommand}"
                    IsVisible="{Binding CanAdministrar}"
                    BackgroundColor="#9B552C"
                    TextColor="White"
                    FontFamily="MontserratBold"
                    CornerRadius="11"
                    Padding="14,9" />
            </Grid>

            <RefreshView
                Grid.Row="1"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    x:Name="NoticiasCollectionView"
                    ItemsSource="{Binding Publicaciones}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem"
                    RemainingItemsThreshold="2"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
                            <Border
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#DDE7E3"
                                StrokeShape="RoundRectangle 15">
                                <VerticalStackLayout Spacing="9">
                                    <SearchBar
                                        Placeholder="Buscar noticias, eventos u ofertas"
                                        Text="{Binding TextoBusqueda}"
                                        SearchCommand="{Binding BuscarCommand}"
                                        FontFamily="MontserratMedium"
                                        BackgroundColor="#F8FAF9" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Picker
                                            Title="Categoría"
                                            ItemsSource="{Binding Categorias}"
                                            ItemDisplayBinding="{Binding Nombre}"
                                            SelectedItem="{Binding CategoriaSeleccionada}"
                                            FontFamily="MontserratMedium" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            BackgroundColor="#3B655B"
                                            TextColor="White"
                                            FontFamily="MontserratBold"
                                            CornerRadius="10" />
                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto,*,Auto"
                                        ColumnSpacing="6">
                                        <Switch
                                            IsToggled="{Binding SoloDestacadas}"
                                            OnColor="#3B655B" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Destacadas"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratMedium"
                                            FontSize="11" />
                                        <Switch
                                            Grid.Column="2"
                                            IsToggled="{Binding SoloEventos}"
                                            OnColor="#3B655B" />
                                        <Label
                                            Grid.Column="3"
                                            Text="Eventos"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratMedium"
                                            FontSize="11" />
                                        <Button
                                            Grid.Column="4"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarFiltrosCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="#9B552C"
                                            FontFamily="MontserratBold"
                                            Padding="8,4" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Padding="11"
                                BackgroundColor="#FFF7ED"
                                Stroke="#FDBA74"
                                StrokeShape="RoundRectangle 11">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="#9A3412" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PublicacionListadoResponse">
                            <Border
                                BackgroundColor="White"
                                Stroke="#E3EAE7"
                                StrokeShape="RoundRectangle 16"
                                Padding="0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference NoticiasRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid
                                    ColumnDefinitions="{OnPlatform WinUI='230,*', Default='*'}"
                                    RowDefinitions="{OnPlatform WinUI='210', Default='180,Auto'}">

                                    <Grid
                                        BackgroundColor="#EEF5F2"
                                        HeightRequest="{OnPlatform WinUI=210, Default=180}">
                                        <Label
                                            Text="CONATRADEC"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontFamily="MontserratBold"
                                            TextColor="#3B655B" />
                                        <Image
                                            Source="{Binding ImagenPortadaUrl}"
                                            Aspect="AspectFill"
                                            IsVisible="{Binding TieneImagen}" />
                                    </Grid>

                                    <VerticalStackLayout
                                        Grid.Column="{OnPlatform WinUI=1, Default=0}"
                                        Grid.Row="{OnPlatform WinUI=0, Default=1}"
                                        Padding="14"
                                        Spacing="7">

                                        <HorizontalStackLayout Spacing="7">
                                            <Border
                                                Padding="8,3"
                                                BackgroundColor="{Binding CategoriaColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                                <Label
                                                    Text="{Binding Categoria}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10"
                                                    TextColor="White" />
                                            </Border>
                                            <Border
                                                IsVisible="{Binding Destacada}"
                                                Padding="8,3"
                                                BackgroundColor="#FFF3CD"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                                <Label
                                                    Text="Destacada"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10"
                                                    TextColor="#8A5A00" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label
                                            Text="{Binding Titulo}"
                                            FontFamily="MontserratBold"
                                            FontSize="18"
                                            TextColor="#1F2937"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Resumen}"
                                            FontFamily="MontserratMedium"
                                            FontSize="12"
                                            TextColor="#4B5563"
                                            MaxLines="3"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding FechaEventoTexto}"
                                            HeightRequest="16"
                                            FontFamily="MontserratBold"
                                            FontSize="11"
                                            TextColor="#9B552C"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding FechaPublicacionTexto}"
                                                FontFamily="MontserratMedium"
                                                FontSize="10"
                                                TextColor="#6B7280" />
                                            <Label
                                                Grid.Column="1"
                                                Text="Leer más ›"
                                                FontFamily="MontserratBold"
                                                FontSize="12"
                                                TextColor="#3B655B" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            IsVisible="{Binding MostrarVacio}"
                            Padding="30"
                            Spacing="8"
                            HorizontalOptions="Center">
                            <Label
                                Text="No hay publicaciones para mostrar"
                                FontFamily="MontserratBold"
                                FontSize="17"
                                TextColor="#3B655B"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Cambie los filtros o actualice la lista."
                                FontFamily="MontserratMedium"
                                FontSize="12"
                                TextColor="#6B7280"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <VerticalStackLayout
                            Padding="0,14,0,28"
                            Spacing="8"
                            HorizontalOptions="Center">
                            <ActivityIndicator
                                IsVisible="{Binding CargandoMas}"
                                IsRunning="{Binding CargandoMas}"
                                Color="#3B655B" />
                            <Label
                                IsVisible="{Binding MostrarFinLista}"
                                Text="No hay más publicaciones."
                                FontSize="11"
                                TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator
                Grid.RowSpan="2"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#3B655B"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border
                MaximumWidthRequest="540"
                Padding="26"
                BackgroundColor="White"
                Stroke="#DDE7E3"
                StrokeShape="RoundRectangle 18"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Sin permiso para consultar noticias"
                        FontFamily="MontserratBold"
                        FontSize="22"
                        TextColor="#3B655B"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Su usuario está activo, pero su rol no tiene permiso de lectura para este apartado."
                        FontFamily="MontserratMedium"
                        TextColor="#4B5563"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
