<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAResultadoPage"
    x:Name="PaginaResultado"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CodigoLegibleConverter
                x:Key="CodigoLegibleConverter" />
            <converters:JerarquiaPropuestaPresentacionConverter
                x:Key="JerarquiaPropuestaPresentacionConverter" />
            <converters:FlujoInspeccionPresentacionConverter
                x:Key="FlujoInspeccionPresentacionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <!--
                Encabezado específico del expediente. No utiliza la detección
                automática de catálogos eliminados porque esta pantalla no
                administra terrenos ni otro catálogo configurable.
            -->
            <Grid
                Grid.Row="0"
                RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                ColumnDefinitions="{OnIdiom Phone='*,*', Tablet='Auto,*,Auto', Desktop='Auto,*,Auto'}"
                RowSpacing="10"
                ColumnSpacing="12"
                MaximumWidthRequest="1250"
                HorizontalOptions="Fill">

                <Button
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="0"
                    Text="{Binding TextoRegresar}"
                    Command="{Binding RegresarResultadoCommand}"
                    WidthRequest="{OnIdiom Phone=150, Tablet=220, Desktop=220}"
                    HeightRequest="48"
                    Padding="12,10"
                    BackgroundColor="#EEF2F0"
                    TextColor="{StaticResource color_Verde}"
                    CornerRadius="11"
                    FontFamily="MontserratMedium"
                    FontSize="{OnIdiom Phone=12, Tablet=12, Desktop=13}"
                    VerticalOptions="Center"
                    HorizontalOptions="{OnIdiom Phone=Start, Tablet=Start, Desktop=Start}" />

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Label
                        Text="{Binding TituloResultado}"
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=25, Tablet=27, Desktop=30}"
                        TextColor="{StaticResource color_Verde}"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="{Binding SubtituloResultado}"
                        FontSize="13"
                        TextColor="{StaticResource color_GrisOscuro}"
                        LineBreakMode="WordWrap"
                        MaxLines="3" />
                </VerticalStackLayout>

                <Button
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                    Text="Agregar fotografías"
                    Command="{Binding AgregarFotografiasCommand}"
                    IsVisible="{Binding PuedeAgregarFotografias}"
                    WidthRequest="{OnIdiom Phone=150, Tablet=220, Desktop=220}"
                    HeightRequest="48"
                    Padding="12,10"
                    BackgroundColor="{StaticResource color_Verde}"
                    TextColor="White"
                    CornerRadius="11"
                    FontFamily="MontserratBold"
                    FontSize="{OnIdiom Phone=12, Tablet=12, Desktop=13}"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="12"
                    MaximumWidthRequest="1250"
                    HorizontalOptions="Center">

                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#9B552C" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14">
                        <Border.IsVisible>
                            <MultiBinding
                                Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                ConverterParameter="PanelAcciones">
                                <Binding Path="TextoRegresar" />
                                <Binding Path="Detalle.CerradaTecnico" />
                            </MultiBinding>
                        </Border.IsVisible>

                        <VerticalStackLayout Spacing="12">
                            <!--
                                El encabezado separa la información de selección
                                de las acciones disponibles. FlexLayout permite
                                que los controles se adapten sin desordenarse en
                                Windows, tabletas y teléfonos.
                            -->
                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="SpaceBetween">
                                <VerticalStackLayout
                                    Spacing="2"
                                    MinimumWidthRequest="230"
                                    Margin="0,0,12,8"
                                    FlexLayout.Grow="1">
                                    <Label
                                        Text="Acciones por fotografía"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="{Binding TextoSeleccion}"
                                        FontSize="14"
                                        TextColor="#5E6B67" />
                                </VerticalStackLayout>

                                <Border
                                    Padding="8"
                                    Margin="0,0,0,8"
                                    BackgroundColor="#F5F8F7"
                                    Stroke="#DFE8E4"
                                    StrokeShape="RoundRectangle 12">
                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="End">
                                        <Button
                                            Text="Seleccionar todo"
                                            Clicked="OnSeleccionarTodoTecnicoClicked"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=165, Desktop=170}"
                                            HeightRequest="44"
                                            CornerRadius="10"
                                            FontSize="13"
                                            BackgroundColor="#E3EFEA"
                                            TextColor="#3B655B"
                                            Margin="0,0,6,0"
                                            IsVisible="{Binding TextoRegresar, Converter={StaticResource FlujoInspeccionPresentacionConverter}, ConverterParameter=VistaTecnico}" />
                                        <Button
                                            Text="Quitar selección"
                                            Command="{Binding QuitarSeleccionCommand}"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=165, Desktop=170}"
                                            HeightRequest="44"
                                            CornerRadius="10"
                                            FontSize="13"
                                            BackgroundColor="#EEF2F0"
                                            TextColor="#263A35" />
                                    </FlexLayout>
                                </Border>
                            </FlexLayout>

                            <BoxView
                                HeightRequest="1"
                                Color="#E5ECE9"
                                HorizontalOptions="Fill" />

                            <Border
                                Padding="12"
                                BackgroundColor="#FAFCFB"
                                Stroke="#E5ECE9"
                                StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="9">
                                    <Label
                                        Text="Acciones disponibles"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#5E6B67" />

                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="Start">
                                        <Button
                                            Text="Analizar con IA"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding ProcesarSeleccionCommand}"
                                            BackgroundColor="#3B655B"
                                            TextColor="White"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionTecnico">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeProcesarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Enviar a revisión"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding EnviarAnalizadorCommand}"
                                            BackgroundColor="#F2C94C"
                                            TextColor="#263A35"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionTecnico">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeEnviarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Nueva evaluación IA"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding SolicitarRevisionCommand}"
                                            BackgroundColor="#E3EFEA"
                                            TextColor="#3B655B"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionTecnico">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeSolicitarRevision" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Clasificación humana"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding AnalisisHumanoCommand}"
                                            BackgroundColor="#9B552C"
                                            TextColor="White"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionAnalizador">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeAnalizarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Registrar aprobación"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding AprobarCommand}"
                                            BackgroundColor="#263A35"
                                            TextColor="White"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionAprobador">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeAprobarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Publicar en álbum"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding PublicarAlbumCommand}"
                                            BackgroundColor="#3B82F6"
                                            TextColor="White"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionAprobador">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedePublicarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Descartar evidencia"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding DescartarCommand}"
                                            BackgroundColor="#FDECEC"
                                            TextColor="#B42318"
                                            Margin="0,0,8,8">
                                            <Button.IsVisible>
                                                <MultiBinding
                                                    Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                    ConverterParameter="AccionTecnico">
                                                    <Binding Path="TextoRegresar" />
                                                    <Binding Path="PuedeDescartarSeleccion" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>

                                        <Button
                                            Text="Actualizar"
                                            WidthRequest="{OnIdiom Phone=148, Tablet=170, Desktop=180}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="13"
                                            Command="{Binding ActualizarCommand}"
                                            BackgroundColor="#EEF2F0"
                                            TextColor="#263A35"
                                            Margin="0,0,8,8" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EEF2F0"
                        Stroke="#B8C7C1"
                        StrokeShape="RoundRectangle 14">
                        <Border.IsVisible>
                            <MultiBinding
                                Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                ConverterParameter="EtapaTecnicaFinalizadaTecnico">
                                <Binding Path="TextoRegresar" />
                                <Binding Path="Detalle.CerradaTecnico" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Etapa técnica finalizada · Enviada al analizador"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Las fotografías enviadas quedaron bloqueadas para el técnico. La inspección continuará su flujo en las bandejas del analizador y del aprobador."
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EAF3EF"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding MostrarCierreTecnico}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="Envío de la inspección al analizador"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#263A35" />
                                <Label
                                    Text="{Binding MotivoNoPuedeCerrar}"
                                    TextColor="#4D625C" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Finalizar y enviar inspección"
                                Clicked="OnFinalizarEtapaTecnicaClicked"
                                WidthRequest="220"
                                HeightRequest="46"
                                CornerRadius="11"
                                BackgroundColor="#9B552C"
                                TextColor="White" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding Fotografias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFotoV2">
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="12">

                                        <!-- Encabezado: identifica la evidencia sin confundir el tipo de foto con la jerarquía. -->
                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">
                                            <CheckBox
                                                Grid.Column="0"
                                                IsChecked="{Binding Seleccionada}"
                                                VerticalOptions="Start"
                                                Color="#3B655B">
                                                <CheckBox.IsVisible>
                                                    <MultiBinding
                                                        Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                        ConverterParameter="PuedeSeleccionarFotografia">
                                                        <Binding Source="{x:Reference PaginaResultado}" Path="BindingContext.TextoRegresar" />
                                                        <Binding Source="{x:Reference PaginaResultado}" Path="BindingContext.Detalle.CerradaTecnico" />
                                                        <Binding Path="Estado" />
                                                    </MultiBinding>
                                                </CheckBox.IsVisible>
                                                <CheckBox.IsEnabled>
                                                    <MultiBinding
                                                        Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                                        ConverterParameter="PuedeSeleccionarFotografia">
                                                        <Binding Source="{x:Reference PaginaResultado}" Path="BindingContext.TextoRegresar" />
                                                        <Binding Source="{x:Reference PaginaResultado}" Path="BindingContext.Detalle.CerradaTecnico" />
                                                        <Binding Path="Estado" />
                                                    </MultiBinding>
                                                </CheckBox.IsEnabled>
                                            </CheckBox>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="5">
                                                <Label
                                                    Text="{Binding Orden, StringFormat='Fotografía {0}'}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Border
                                                    Padding="9,4"
                                                    HorizontalOptions="Start"
                                                    BackgroundColor="#EEF5F2"
                                                    Stroke="#C8DED6"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Label
                                                        Text="{Binding TipoFotografia, Converter={StaticResource CodigoLegibleConverter}, ConverterParameter='Tipo de fotografía: '}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#3B655B" />
                                                </Border>
                                                <Label
                                                    Text="{Binding FechaCampoTexto}"
                                                    FontSize="13"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding EstadoTexto}"
                                                FontAttributes="Bold"
                                                TextColor="#9B552C"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <!-- La fotografía vuelve a ser la evidencia principal de la tarjeta. -->
                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="16">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="{OnIdiom Phone=120, Tablet=190, Desktop=230}"
                                                HeightRequest="{OnIdiom Phone=120, Tablet=190, Desktop=230}"
                                                BackgroundColor="#F4F7F5"
                                                Stroke="#C8DED6"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12">
                                                <Image
                                                    Source="{Binding UrlImagen}"
                                                    Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="8">
                                                <Label
                                                    Text="{Binding DisponibilidadTexto}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="#7A5A13"
                                                    IsVisible="{Binding TieneMensajeDisponibilidad}" />
                                                <Label
                                                    Text="{Binding DiagnosticoTexto}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#3B655B" />
                                                <Label
                                                    Text="{Binding ResultadoIA.ResumenImagen}"
                                                    TextColor="#4F5D59" />
                                                <Label
                                                    Text="{Binding ErrorProcesamiento}"
                                                    TextColor="#B42318"
                                                    IsVisible="{Binding TieneError}" />

                                                <Grid
                                                    ColumnDefinitions="*,*"
                                                    ColumnSpacing="18">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                        <Label
                                                            Text="Clasificación IA"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ResultadoIA.CategoriaPrincipal}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.CategoriaPrincipal}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="Estado fitosanitario: Aparentemente sana" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="Resultado: Sin indicios visibles de plagas o enfermedades"
                                                            TextColor="#5E6B67"
                                                            IsVisible="False">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.CategoriaPrincipal}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="IsVisible"
                                                                        Value="True" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="{Binding ResultadoIA.SeveridadVisual, StringFormat='Severidad: {0}'}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.SeveridadVisual}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="IsVisible"
                                                                        Value="False" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="{Binding ResultadoIA.NivelCerteza, StringFormat='Certeza: {0}'}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="ALTO">
                                                                    <Setter Property="Text" Value="Certeza: Alta" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="MEDIO">
                                                                    <Setter Property="Text" Value="Certeza: Media" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="BAJO">
                                                                    <Setter Property="Text" Value="Certeza: Baja" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="NO_APLICA">
                                                                    <Setter Property="IsVisible" Value="False" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                        <Label
                                                            Text="Trazabilidad"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ModeloIAUtilizado, StringFormat='Modelo: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding IntentosIA, StringFormat='Intentos IA: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimoAnalisisHumano.UsuarioAnalizador, StringFormat='Analizador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimaAprobacion.UsuarioAprobador, StringFormat='Aprobador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <VerticalStackLayout
                                            Grid.Row="2"
                                            Spacing="10">

                                            <!-- Jerarquía ya cargada: siempre conserva visible la categoría que encajó. -->
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#F7FAF8"
                                                Stroke="#C8DED6"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TieneJerarquiaAlbum}">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                            <Label
                                                                Text="Clasificación asignada al Álbum Botánico"
                                                                FontSize="15"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                            <Label
                                                                Text="Categoría, subcategoría y diagnóstico que encajaron con esta fotografía."
                                                                FontSize="11"
                                                                TextColor="#5E6B67" />
                                                        </VerticalStackLayout>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="8,4"
                                                            VerticalOptions="Center"
                                                            BackgroundColor="#E5F2ED"
                                                            Stroke="#C4DED4"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Label
                                                                Text="Jerarquía cargada"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                        </Border>
                                                    </Grid>

                                                    <FlexLayout
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Stretch"
                                                        JustifyContent="SpaceBetween">
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFFFF"
                                                            Stroke="#D4E5DE"
