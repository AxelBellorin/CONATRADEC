<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAResultadoPage"
    x:Name="PaginaResultado"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CodigoLegibleConverter
                x:Key="CodigoLegibleConverter" />
            <converters:JerarquiaPropuestaPresentacionConverter
                x:Key="JerarquiaPropuestaPresentacionConverter" />
            <converters:FlujoInspeccionPresentacionConverter
                x:Key="FlujoInspeccionPresentacionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <Grid
                Grid.Row="0"
                RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                ColumnDefinitions="{OnIdiom Phone='*,*', Default='Auto,*,Auto'}"
                RowSpacing="10"
                ColumnSpacing="12"
                MaximumWidthRequest="1250"
                HorizontalOptions="Fill">

                <Button
                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                    Grid.Column="0"
                    Text="{Binding TextoRegresar}"
                    Command="{Binding RegresarResultadoCommand}"
                    WidthRequest="{OnIdiom Phone=150, Default=220}"
                    HeightRequest="48"
                    Padding="12,10"
                    BackgroundColor="#EEF2F0"
                    TextColor="#3B655B"
                    CornerRadius="11"
                    FontFamily="MontserratMedium"
                    FontSize="{OnIdiom Phone=12, Default=13}">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding TextoRegresar}"
                            Value="Decisiones pendientes">
                            <Setter Property="Text" Value="← Mis inspecciones" />
                        </DataTrigger>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding TextoRegresar}"
                            Value="← Decisiones pendientes">
                            <Setter Property="Text" Value="← Mis inspecciones" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                    Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}"
                    Spacing="3"
                    VerticalOptions="Center">
                    <Label
                        Text="{Binding TituloResultado}"
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=25, Default=30}"
                        TextColor="#3B655B"
                        LineBreakMode="WordWrap" />
                    <Label
                        Text="{Binding SubtituloResultado}"
                        FontSize="13"
                        TextColor="#5E6B67"
                        LineBreakMode="WordWrap"
                        MaxLines="3" />
                </VerticalStackLayout>

                <Button
                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                    Grid.Column="{OnIdiom Phone=1, Default=2}"
                    Text="Agregar fotografías"
                    Command="{Binding AgregarFotografiasCommand}"
                    IsVisible="{Binding PuedeAgregarFotografias}"
                    WidthRequest="{OnIdiom Phone=150, Default=220}"
                    HeightRequest="48"
                    Padding="12,10"
                    BackgroundColor="#3B655B"
                    TextColor="White"
                    CornerRadius="11"
                    FontFamily="MontserratBold"
                    FontSize="{OnIdiom Phone=12, Default=13}" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="12"
                    MaximumWidthRequest="1250"
                    HorizontalOptions="Center">

                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#9B552C" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <!--
                        Este panel pertenece al usuario que registró la inspección.
                        En la bandeja del analizador se oculta y las acciones se
                        incorporan dentro de cada tarjeta fotográfica.
                    -->
                    <Border
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14">
                        <Border.IsVisible>
                            <MultiBinding
                                Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                ConverterParameter="PanelAcciones">
                                <Binding Path="TextoRegresar" />
                                <Binding Path="Detalle.EtapaTecnicaFinalizada" />
                            </MultiBinding>
                        </Border.IsVisible>

                        <VerticalStackLayout Spacing="12">
                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="SpaceBetween">
                                <VerticalStackLayout
                                    Spacing="2"
                                    MinimumWidthRequest="230"
                                    Margin="0,0,12,8"
                                    FlexLayout.Grow="1">
                                    <Label
                                        Text="Acciones por fotografía"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="{Binding TextoSeleccion}"
                                        FontSize="14"
                                        TextColor="#5E6B67" />
                                </VerticalStackLayout>

                                <Border
                                    Padding="8"
                                    Margin="0,0,0,8"
                                    BackgroundColor="#F5F8F7"
                                    Stroke="#DFE8E4"
                                    StrokeShape="RoundRectangle 12">
                                    <FlexLayout
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        JustifyContent="End">
                                        <Button
                                            Text="Seleccionar todo"
                                            Clicked="OnSeleccionarTodoTecnicoClicked"
                                            IsVisible="{Binding TextoRegresar, Converter={StaticResource FlujoInspeccionPresentacionConverter}, ConverterParameter=VistaTecnico}"
                                            WidthRequest="{OnIdiom Phone=148, Default=170}"
                                            HeightRequest="44"
                                            CornerRadius="10"
                                            FontSize="13"
                                            BackgroundColor="#E3EFEA"
                                            TextColor="#3B655B"
                                            Margin="0,0,6,0" />
                                        <Button
                                            Text="Quitar selección"
                                            Command="{Binding QuitarSeleccionCommand}"
                                            WidthRequest="{OnIdiom Phone=148, Default=170}"
                                            HeightRequest="44"
                                            CornerRadius="10"
                                            FontSize="13"
                                            BackgroundColor="#EEF2F0"
                                            TextColor="#263A35" />
                                    </FlexLayout>
                                </Border>
                            </FlexLayout>

                            <BoxView HeightRequest="1" Color="#E5ECE9" />

                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                                <Button
                                    Text="Analizar con IA"
                                    WidthRequest="{OnIdiom Phone=160, Default=205}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding ProcesarSeleccionCommand}"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    Margin="0,0,8,8">
                                    <Button.IsVisible>
                                        <MultiBinding
                                            Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                            ConverterParameter="AccionTecnico">
                                            <Binding Path="TextoRegresar" />
                                            <Binding Path="PuedeProcesarSeleccion" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>

                                <Button
                                    Text="Enviar al analizador"
                                    WidthRequest="{OnIdiom Phone=160, Default=205}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding EnviarAnalizadorCommand}"
                                    BackgroundColor="#F2C94C"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8">
                                    <Button.IsVisible>
                                        <MultiBinding
                                            Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                            ConverterParameter="AccionTecnico">
                                            <Binding Path="TextoRegresar" />
                                            <Binding Path="PuedeEnviarSeleccion" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>

                                <Button
                                    Text="Solicitar nueva evaluación IA"
                                    WidthRequest="{OnIdiom Phone=210, Default=235}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding SolicitarRevisionCommand}"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B"
                                    Margin="0,0,8,8">
                                    <Button.IsVisible>
                                        <MultiBinding
                                            Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                            ConverterParameter="AccionTecnico">
                                            <Binding Path="TextoRegresar" />
                                            <Binding Path="PuedeSolicitarRevision" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>

                                <Button
                                    Text="Descartar fotografías"
                                    WidthRequest="{OnIdiom Phone=175, Default=210}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding DescartarCommand}"
                                    BackgroundColor="#FDECEC"
                                    TextColor="#B42318"
                                    Margin="0,0,8,8">
                                    <Button.IsVisible>
                                        <MultiBinding
                                            Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                            ConverterParameter="AccionTecnico">
                                            <Binding Path="TextoRegresar" />
                                            <Binding Path="PuedeDescartarSeleccion" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>

                                <Button
                                    Text="Registrar decisión"
                                    WidthRequest="{OnIdiom Phone=175, Default=210}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding AprobarCommand}"
                                    IsVisible="{Binding PuedeAprobarSeleccion}"
                                    BackgroundColor="#263A35"
                                    TextColor="White"
                                    Margin="0,0,8,8" />

                                <Button
                                    Text="Cerrar definitivamente"
                                    WidthRequest="{OnIdiom Phone=190, Default=225}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding CerrarDefinitivoCommand}"
                                    IsVisible="{Binding PuedeCerrarDefinitivamente}"
                                    BackgroundColor="#9B552C"
                                    TextColor="White"
                                    Margin="0,0,8,8" />

                                <Button
                                    Text="Actualizar"
                                    WidthRequest="{OnIdiom Phone=148, Default=180}"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    FontSize="13"
                                    Command="{Binding ActualizarCommand}"
                                    BackgroundColor="#EEF2F0"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EEF6F2"
                        Stroke="#B9D7CB"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding PuedePublicarSeleccion}">
                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="8"
                            ColumnSpacing="12">
                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="3">
                                <Label
                                    Text="Publicación autorizada"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#294A42" />
                                <Label
                                    Text="La fotografía seleccionada puede copiarse al Álbum Botánico aun cuando el expediente ya esté cerrado. La evidencia original permanecerá inalterada."
                                    FontSize="12"
                                    TextColor="#4D625C"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="Copiar al Álbum Botánico"
                                Command="{Binding PublicarAlbumCommand}"
                                HeightRequest="46"
                                MinimumWidthRequest="{OnIdiom Phone=230, Default=220}"
                                BackgroundColor="#3B655B"
                                TextColor="White"
                                CornerRadius="11"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EEF2F0"
                        Stroke="#B8C7C1"
                        StrokeShape="RoundRectangle 14">
                        <Border.IsVisible>
                            <MultiBinding
                                Converter="{StaticResource FlujoInspeccionPresentacionConverter}"
                                ConverterParameter="EtapaTecnicaFinalizada">
                                <Binding Path="TextoRegresar" />
                                <Binding Path="Detalle.EtapaTecnicaFinalizada" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Etapa técnica finalizada · Enviada al analizador"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Las fotografías enviadas quedaron bloqueadas para el usuario creador. La inspección continuará en las bandejas del analizador y del aprobador."
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EAF3EF"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding MostrarCierreTecnico}">
                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="10"
                            ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="Finalización de la etapa técnica"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#263A35" />
                                <Label
                                    Text="{Binding MotivoNoPuedeCerrar}"
                                    TextColor="#4D625C" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="Finalizar etapa técnica"
                                Clicked="OnFinalizarEtapaTecnicaClicked"
                                IsEnabled="{Binding PuedeCerrarInspeccion}"
                                WidthRequest="{OnIdiom Phone=0, Default=220}"
                                HeightRequest="46"
                                CornerRadius="11"
                                BackgroundColor="#9B552C"
                                TextColor="White"
                                HorizontalOptions="Fill" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding Fotografias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFotoV2">
                                <Border
                                    Padding="{OnIdiom Phone=12, Default=16}"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <!--
                                        El Grid de la tarjeta conserva cuatro filas para
                                        que el flujo de revisión pueda insertar acciones
                                        independientes del analizador dentro de esta misma
                                        evidencia.
                                    -->
                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto,Auto"
                                        RowSpacing="14">
                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="10">
                                            <CheckBox
                                                Grid.Column="0"
                                                IsChecked="{Binding Seleccionada}"
                                                IsEnabled="{Binding PuedeSeleccionarse}"
                                                Color="#3B655B"
                                                VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label
                                                    Text="{Binding Titulo}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Border
                                                    Padding="8,4"
                                                    HorizontalOptions="Start"
                                                    BackgroundColor="#EAF3EF"
                                                    Stroke="#C8DED6"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Label
                                                        Text="{Binding TipoFotografia, StringFormat='Tipo de fotografía: {0}'}"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="#3B655B" />
                                                </Border>
                                                <Label
                                                    Text="{Binding FechaCampoTexto}"
                                                    FontSize="12"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding EstadoTexto}"
                                                FontAttributes="Bold"
                                                TextColor="#9B552C"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="{OnIdiom Phone='*', Default='Auto,*'}"
                                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                            ColumnSpacing="16"
                                            RowSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="{OnIdiom Phone=0, Default=230}"
                                                HeightRequest="{OnIdiom Phone=245, Default=230}"
                                                BackgroundColor="#F4F7F5"
                                                Stroke="#C8DED6"
                                                StrokeShape="RoundRectangle 12">
                                                <Image
                                                    Source="{Binding UrlImagen}"
                                                    Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                                Spacing="8">
                                                <Label
                                                    Text="{Binding DisponibilidadTexto}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="#7A5A13"
                                                    IsVisible="{Binding TieneMensajeDisponibilidad}" />
                                                <Label
                                                    Text="{Binding DiagnosticoTexto}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#3B655B" />
                                                <Label
                                                    Text="{Binding ResultadoIA.ResumenImagen}"
                                                    TextColor="#4F5D59"
                                                    LineBreakMode="WordWrap" />
                                                <Label
                                                    Text="{Binding ErrorProcesamiento}"
                                                    TextColor="#B42318"
                                                    IsVisible="{Binding TieneError}" />

                                                <FlexLayout
                                                    Direction="Row"
                                                    Wrap="Wrap"
                                                    AlignItems="Start">
                                                    <VerticalStackLayout
                                                        WidthRequest="260"
                                                        Margin="0,0,20,8"
                                                        Spacing="3">
                                                        <Label
                                                            Text="Clasificación IA"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ResultadoIA.CategoriaPrincipal}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding ResultadoIA.SeveridadVisual, StringFormat='Severidad: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding ResultadoIA.NivelCerteza, StringFormat='Certeza: {0}'}"
                                                            TextColor="#5E6B67" />
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout
                                                        WidthRequest="260"
                                                        Margin="0,0,0,8"
                                                        Spacing="3">
                                                        <Label
                                                            Text="Trazabilidad"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ModeloIAUtilizado, StringFormat='Modelo: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding IntentosIA, StringFormat='Intentos IA: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimoAnalisisHumano.UsuarioAnalizador, StringFormat='Analizador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimaAprobacion.UsuarioAprobador, StringFormat='Aprobador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                    </VerticalStackLayout>
                                                </FlexLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Álbum simplificado: Categoría -> Subcategoría -> Fotografías. -->
                                        <VerticalStackLayout Grid.Row="2" Spacing="10">
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#F7FAF8"
                                                Stroke="#C8DED6"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TieneJerarquiaAlbum}">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                            <Label
                                                                Text="Clasificación asignada al Álbum Botánico"
                                                                FontSize="15"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                            <Label
                                                                Text="Categoría y subcategoría específica asociadas con esta fotografía."
                                                                FontSize="11"
                                                                TextColor="#5E6B67" />
                                                        </VerticalStackLayout>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="8,4"
                                                            BackgroundColor="#E5F2ED"
                                                            Stroke="#C4DED4"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Label
                                                                Text="Clasificación cargada"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                        </Border>
                                                    </Grid>

                                                    <FlexLayout
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Stretch"
                                                        JustifyContent="SpaceBetween">
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="360"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="White"
                                                            Stroke="#D4E5DE"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#3B655B"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="1"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="CATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6A7D76" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.Categoria}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.EstadoCategoria}"
                                                                        FontSize="10"
                                                                        TextColor="#527066" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="360"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="White"
                                                            Stroke="#D4E5DE"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#3B655B"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="2"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="SUBCATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6A7D76" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.Ficha}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.NombreCientifico}"
                                                                        FontSize="10"
                                                                        FontAttributes="Italic"
                                                                        TextColor="#5E6B67"
                                                                        IsVisible="{Binding JerarquiaAlbum.TieneNombreCientifico}" />
                                                                    <Label
                                                                        Text="Subcategoría existente"
                                                                        FontSize="10"
                                                                        TextColor="#527066">
                                                                        <Label.Triggers>
                                                                            <DataTrigger
                                                                                TargetType="Label"
                                                                                Binding="{Binding JerarquiaAlbum.FichaEsPropuesta}"
                                                                                Value="True">
                                                                                <Setter Property="Text" Value="Subcategoría propuesta" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </FlexLayout>

                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Motivo}"
                                                        FontSize="11"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                Padding="12"
                                                BackgroundColor="#FBFCFB"
                                                Stroke="#D9E3DF"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TienePropuestaAlbum}">
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding TieneJerarquiaAlbum}"
                                                        Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="8">
                                                    <Label
                                                        Text="Clasificación propuesta para el Álbum Botánico"
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="#31584D" />
                                                    <Label
                                                        Text="La IA propone únicamente la categoría y la subcategoría específica."
                                                        FontSize="11"
                                                        TextColor="#5E6B67" />

                                                    <FlexLayout
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Stretch"
                                                        JustifyContent="SpaceBetween">
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="360"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#F7FAFD"
                                                            Stroke="#CCDCE9"
                                                            StrokeShape="RoundRectangle 10">
                                                            <VerticalStackLayout Spacing="1">
                                                                <Label
                                                                    Text="CATEGORÍA"
                                                                    FontSize="9"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#667A8A" />
                                                                <Label
                                                                    Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=CategoriaValor}"
                                                                    FontSize="14"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#263A35" />
                                                                <Label
                                                                    Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=CategoriaEstado}"
                                                                    FontSize="10"
                                                                    TextColor="#416886" />
                                                            </VerticalStackLayout>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="360"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFF8F2"
                                                            Stroke="#E2B38E"
                                                            StrokeShape="RoundRectangle 10">
                                                            <VerticalStackLayout Spacing="1">
                                                                <Label
                                                                    Text="SUBCATEGORÍA"
                                                                    FontSize="9"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#8A5A3B" />
                                                                <Label
                                                                    Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=FichaValor}"
                                                                    FontSize="14"
                                                                    FontAttributes="Bold"
                                                                    TextColor="#263A35" />
                                                                <Label
                                                                    Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=FichaEstado}"
                                                                    FontSize="10"
                                                                    TextColor="#87451F" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </FlexLayout>

                                                    <Label
                                                        Text="{Binding ResultadoIA.MotivoAlbumPropuesta}"
                                                        FontSize="11"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="3" Spacing="8">
                                            <VerticalStackLayout
                                                Spacing="3"
                                                IsVisible="{Binding TieneAnalisisHumano}">
                                                <Label
                                                    Text="Clasificación humana"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Label
                                                    Text="{Binding UltimoAnalisisHumano.Diagnostico}"
                                                    TextColor="#5E6B67" />
                                                <Label
                                                    Text="{Binding UltimoAnalisisHumano.Observaciones}"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Spacing="3"
                                                IsVisible="{Binding TieneAprobacion}">
                                                <Label
                                                    Text="Decisión final"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Label
                                                    Text="{Binding UltimaAprobacion.Decision}"
                                                    TextColor="#5E6B67" />
                                                <Label
                                                    Text="{Binding UltimaAprobacion.DiagnosticoFinal}"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>

                                            <Label
                                                Text="{Binding MotivoDescarte}"
                                                TextColor="#B42318">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding MotivoDescarte}"
                                                        Value="">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding MotivoDescarte}"
                                                        Value="{x:Null}">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
