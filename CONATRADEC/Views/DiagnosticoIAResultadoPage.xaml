                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=CategoriaEstado}"
                                                                        FontSize="10"
                                                                        TextColor="#416886" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFDF6"
                                                            Stroke="#E7C85C"
                                                            StrokeShape="RoundRectangle 10">
