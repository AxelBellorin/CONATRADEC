<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAResultadoPage"
    x:Name="PaginaResultado"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="{Binding TituloResultado}"
                Subtitle="{Binding SubtituloResultado}"
                BackText="{Binding TextoRegresar}"
                BackCommand="{Binding RegresarResultadoCommand}"
                PrimaryText="Agregar fotografías"
                PrimaryCommand="{Binding AgregarFotografiasCommand}"
                IsPrimaryVisible="{Binding PuedeAgregarFotografias}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="12"
                    MaximumWidthRequest="1250"
                    HorizontalOptions="Center">

                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#9B552C" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding EsInspeccionAbierta}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        Text="Acciones por fotografía"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="{Binding TextoSeleccion}"
                                        TextColor="#5E6B67" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Seleccionar todo"
                                    Command="{Binding SeleccionarTodoCommand}"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B" />
                                <Button
                                    Grid.Column="2"
                                    Text="Quitar selección"
                                    Command="{Binding QuitarSeleccionCommand}"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    BackgroundColor="#EEF2F0"
                                    TextColor="#263A35" />
                            </Grid>

                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                                <Button
                                    Text="Analizar con IA"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding ProcesarSeleccionCommand}"
                                    IsVisible="{Binding PuedeProcesarSeleccion}"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Preparar revisión"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding EnviarAnalizadorCommand}"
                                    IsVisible="{Binding PuedeEnviarSeleccion}"
                                    BackgroundColor="#F2C94C"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Nueva evaluación IA"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding SolicitarRevisionCommand}"
                                    IsVisible="{Binding PuedeSolicitarRevision}"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Clasificación humana"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding AnalisisHumanoCommand}"
                                    IsVisible="{Binding PuedeAnalizarSeleccion}"
                                    BackgroundColor="#9B552C"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Registrar aprobación"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding AprobarCommand}"
                                    IsVisible="{Binding PuedeAprobarSeleccion}"
                                    BackgroundColor="#263A35"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Publicar en álbum"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding PublicarAlbumCommand}"
                                    IsVisible="{Binding PuedePublicarSeleccion}"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Descartar evidencia"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding DescartarCommand}"
                                    IsVisible="{Binding PuedeDescartarSeleccion}"
                                    BackgroundColor="#FDECEC"
                                    TextColor="#B42318"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Actualizar"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding ActualizarCommand}"
                                    BackgroundColor="#EEF2F0"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EEF2F0"
                        Stroke="#B8C7C1"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding EsInspeccionCerrada}">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Inspección cerrada · Solo lectura"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="El cierre es definitivo. La información y las fotografías pueden consultarse, pero ninguna acción modificará este expediente."
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EAF3EF"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding MostrarCierreTecnico}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="Cierre de la inspección"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#263A35" />
                                <Label
                                    Text="{Binding MotivoNoPuedeCerrar}"
                                    TextColor="#4D625C" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Cerrar inspección"
                                Command="{Binding CerrarInspeccionCommand}"
                                IsEnabled="{Binding PuedeCerrarInspeccion}"
                                WidthRequest="170"
                                HeightRequest="46"
                                CornerRadius="11"
                                BackgroundColor="#9B552C"
                                TextColor="White" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding Fotografias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFotoV2">
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        ColumnDefinitions="Auto,150,*"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="10">

                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{Binding Seleccionada}"
                                            IsEnabled="{Binding PuedeSeleccionarse}"
                                            IsVisible="{Binding Source={x:Reference PaginaResultado}, Path=BindingContext.EsInspeccionAbierta}"
                                            VerticalOptions="Start"
                                            Color="#3B655B" />

                                        <Image
                                            Grid.Column="1"
                                            Source="{Binding UrlImagen}"
                                            HeightRequest="145"
                                            WidthRequest="145"
                                            Aspect="AspectFill" />

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding Titulo}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding EstadoTexto}"
                                                    FontAttributes="Bold"
                                                    TextColor="#9B552C" />
                                            </Grid>

                                            <Label
                                                Text="{Binding FechaCampoTexto}"
                                                FontSize="13"
                                                TextColor="#5E6B67" />
                                            <Label
                                                Text="{Binding DisponibilidadTexto}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#7A5A13"
                                                IsVisible="{Binding TieneMensajeDisponibilidad}" />
                                            <Label
                                                Text="{Binding DiagnosticoTexto}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="#3B655B" />
                                            <Label
                                                Text="{Binding ResultadoIA.ResumenImagen}"
                                                TextColor="#4F5D59" />
                                            <Label
                                                Text="{Binding ErrorProcesamiento}"
                                                TextColor="#B42318"
                                                IsVisible="{Binding TieneError}" />

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="10">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label
                                                        Text="Clasificación IA"
                                                        FontAttributes="Bold"
                                                        TextColor="#263A35" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.CategoriaPrincipal}"
                                                        TextColor="#5E6B67" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.SeveridadVisual, StringFormat='Severidad: {0}'}"
                                                        TextColor="#5E6B67" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.NivelCerteza, StringFormat='Certeza: {0}'}"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label
                                                        Text="Trazabilidad"
                                                        FontAttributes="Bold"
                                                        TextColor="#263A35" />
                                                    <Label
                                                        Text="{Binding ModeloIAUtilizado, StringFormat='Modelo: {0}'}"
                                                        TextColor="#5E6B67" />
                                                    <Label
                                                        Text="{Binding IntentosIA, StringFormat='Intentos IA: {0}'}"
                                                        TextColor="#5E6B67" />
                                                    <Label
                                                        Text="{Binding UltimoAnalisisHumano.UsuarioAnalizador, StringFormat='Analizador: {0}'}"
                                                        TextColor="#5E6B67" />
                                                    <Label
                                                        Text="{Binding UltimaAprobacion.UsuarioAprobador, StringFormat='Aprobador: {0}'}"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Border
                                                Margin="0,8,0,0"
                                                Padding="12"
                                                BackgroundColor="#EEF5F2"
                                                Stroke="#AFCFC2"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TieneJerarquiaAlbum}">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label
                                                        Text="Clasificación para el Álbum Botánico"
                                                        FontAttributes="Bold"
                                                        TextColor="#31584D" />
                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Categoria, StringFormat='Categoría: {0}'}"
                                                        TextColor="#4F5D59" />
                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Subcategoria, StringFormat='Subcategoría: {0}'}"
                                                        FontAttributes="Bold"
                                                        TextColor="#3B655B" />
                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Ficha, StringFormat='Diagnóstico específico: {0}'}"
                                                        FontAttributes="Bold"
                                                        TextColor="#263A35" />
                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.NombreCientifico, StringFormat='Nombre científico: {0}'}"
                                                        FontAttributes="Italic"
                                                        TextColor="#4F5D59"
                                                        IsVisible="{Binding JerarquiaAlbum.TieneNombreCientifico}" />
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                        <Label Grid.Column="0" Text="{Binding JerarquiaAlbum.EstadoCategoria}" FontSize="10" TextColor="#6A7D76" />
                                                        <Label Grid.Column="1" Text="{Binding JerarquiaAlbum.EstadoSubcategoria}" FontSize="10" TextColor="#6A7D76" />
                                                        <Label Grid.Column="2" Text="{Binding JerarquiaAlbum.EstadoFicha}" FontSize="10" TextColor="#6A7D76" />
                                                    </Grid>
                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Motivo}"
                                                        FontSize="12"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                Margin="0,8,0,0"
                                                Padding="12"
                                                BackgroundColor="#FFF9E8"
                                                Stroke="#E2B93B"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TienePropuestaAlbum}">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label
                                                        Text="Jerarquía pendiente de revisión"
                                                        FontAttributes="Bold"
                                                        TextColor="#6B5710" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.CategoriaAlbumPropuesta, StringFormat='Categoría sugerida: {0}'}"
                                                        TextColor="#4F5D59" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.ClasificacionAlbumPropuesta, StringFormat='Diagnóstico específico sugerido: {0}'}"
                                                        FontAttributes="Bold"
                                                        TextColor="#3B655B" />
                                                    <Label
                                                        Text="La subcategoría se seleccionará o propondrá durante la clasificación humana."
                                                        FontSize="12"
                                                        TextColor="#7A6A2A" />
                                                    <Label
                                                        Text="{Binding ResultadoIA.MotivoAlbumPropuesta}"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Spacing="3">
                                            <Label
                                                Text="Clasificación humana"
                                                FontAttributes="Bold"
                                                TextColor="#263A35"
                                                IsVisible="{Binding TieneAnalisisHumano}" />
                                            <Label
                                                Text="{Binding UltimoAnalisisHumano.Diagnostico}"
                                                TextColor="#5E6B67" />
                                            <Label
                                                Text="{Binding UltimoAnalisisHumano.Observaciones}"
                                                TextColor="#5E6B67" />

                                            <Label
                                                Text="Decisión final"
                                                FontAttributes="Bold"
                                                TextColor="#263A35"
                                                Margin="0,5,0,0"
                                                IsVisible="{Binding TieneAprobacion}" />
                                            <Label
                                                Text="{Binding UltimaAprobacion.Decision}"
                                                TextColor="#5E6B67" />
                                            <Label
                                                Text="{Binding UltimaAprobacion.DiagnosticoFinal}"
                                                TextColor="#5E6B67" />
                                            <Label
                                                Text="{Binding MotivoDescarte}"
                                                TextColor="#B42318" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
