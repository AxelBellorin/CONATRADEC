<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAResultadoPage"
    x:Name="PaginaResultado"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CodigoLegibleConverter
                x:Key="CodigoLegibleConverter" />
            <converters:JerarquiaPropuestaPresentacionConverter
                x:Key="JerarquiaPropuestaPresentacionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="{Binding TituloResultado}"
                Subtitle="{Binding SubtituloResultado}"
                BackText="{Binding TextoRegresar}"
                BackCommand="{Binding RegresarResultadoCommand}"
                PrimaryText="Agregar fotografías"
                PrimaryCommand="{Binding AgregarFotografiasCommand}"
                IsPrimaryVisible="{Binding PuedeAgregarFotografias}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="12"
                    MaximumWidthRequest="1250"
                    HorizontalOptions="Center">

                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#9B552C" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding EsInspeccionAbierta}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        Text="Acciones por fotografía"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="#263A35" />
                                    <Label
                                        Text="{Binding TextoSeleccion}"
                                        TextColor="#5E6B67" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Seleccionar todo"
                                    Command="{Binding SeleccionarTodoCommand}"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B" />
                                <Button
                                    Grid.Column="2"
                                    Text="Quitar selección"
                                    Command="{Binding QuitarSeleccionCommand}"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    BackgroundColor="#EEF2F0"
                                    TextColor="#263A35" />
                            </Grid>

                            <FlexLayout
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Start">
                                <Button
                                    Text="Analizar con IA"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding ProcesarSeleccionCommand}"
                                    IsVisible="{Binding PuedeProcesarSeleccion}"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Preparar revisión"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding EnviarAnalizadorCommand}"
                                    IsVisible="{Binding PuedeEnviarSeleccion}"
                                    BackgroundColor="#F2C94C"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Nueva evaluación IA"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding SolicitarRevisionCommand}"
                                    IsVisible="{Binding PuedeSolicitarRevision}"
                                    BackgroundColor="#E3EFEA"
                                    TextColor="#3B655B"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Clasificación humana"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding AnalisisHumanoCommand}"
                                    IsVisible="{Binding PuedeAnalizarSeleccion}"
                                    BackgroundColor="#9B552C"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Registrar aprobación"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding AprobarCommand}"
                                    IsVisible="{Binding PuedeAprobarSeleccion}"
                                    BackgroundColor="#263A35"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Publicar en álbum"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding PublicarAlbumCommand}"
                                    IsVisible="{Binding PuedePublicarSeleccion}"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Descartar evidencia"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding DescartarCommand}"
                                    IsVisible="{Binding PuedeDescartarSeleccion}"
                                    BackgroundColor="#FDECEC"
                                    TextColor="#B42318"
                                    Margin="0,0,8,8" />
                                <Button
                                    Text="Actualizar"
                                    WidthRequest="170"
                                    HeightRequest="46"
                                    CornerRadius="11"
                                    Command="{Binding ActualizarCommand}"
                                    BackgroundColor="#EEF2F0"
                                    TextColor="#263A35"
                                    Margin="0,0,8,8" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EEF2F0"
                        Stroke="#B8C7C1"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding EsInspeccionCerrada}">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Inspección cerrada · Solo lectura"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="El cierre es definitivo. La información y las fotografías pueden consultarse, pero ninguna acción modificará este expediente."
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="#EAF3EF"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding MostrarCierreTecnico}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="Cierre de la inspección"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#263A35" />
                                <Label
                                    Text="{Binding MotivoNoPuedeCerrar}"
                                    TextColor="#4D625C" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Cerrar inspección"
                                Command="{Binding CerrarInspeccionCommand}"
                                IsEnabled="{Binding PuedeCerrarInspeccion}"
                                WidthRequest="170"
                                HeightRequest="46"
                                CornerRadius="11"
                                BackgroundColor="#9B552C"
                                TextColor="White" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        Spacing="12"
                        BindableLayout.ItemsSource="{Binding Fotografias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:InspeccionFotoV2">
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#D9E3DF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="12">

                                        <!-- Encabezado: identifica la evidencia sin confundir el tipo de foto con la jerarquía. -->
                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">
                                            <CheckBox
                                                Grid.Column="0"
                                                IsChecked="{Binding Seleccionada}"
                                                IsEnabled="{Binding PuedeSeleccionarse}"
                                                IsVisible="{Binding Source={x:Reference PaginaResultado}, Path=BindingContext.EsInspeccionAbierta}"
                                                VerticalOptions="Start"
                                                Color="#3B655B" />

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="5">
                                                <Label
                                                    Text="{Binding Orden, StringFormat='Fotografía {0}'}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Border
                                                    Padding="9,4"
                                                    HorizontalOptions="Start"
                                                    BackgroundColor="#EEF5F2"
                                                    Stroke="#C8DED6"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Label
                                                        Text="{Binding TipoFotografia, Converter={StaticResource CodigoLegibleConverter}, ConverterParameter='Tipo de fotografía: '}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#3B655B" />
                                                </Border>
                                                <Label
                                                    Text="{Binding FechaCampoTexto}"
                                                    FontSize="13"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding EstadoTexto}"
                                                FontAttributes="Bold"
                                                TextColor="#9B552C"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <!-- La fotografía vuelve a ser la evidencia principal de la tarjeta. -->
                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="16">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="{OnIdiom Phone=120, Tablet=190, Desktop=230}"
                                                HeightRequest="{OnIdiom Phone=120, Tablet=190, Desktop=230}"
                                                BackgroundColor="#F4F7F5"
                                                Stroke="#C8DED6"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12">
                                                <Image
                                                    Source="{Binding UrlImagen}"
                                                    Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="8">
                                                <Label
                                                    Text="{Binding DisponibilidadTexto}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="#7A5A13"
                                                    IsVisible="{Binding TieneMensajeDisponibilidad}" />
                                                <Label
                                                    Text="{Binding DiagnosticoTexto}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#3B655B" />
                                                <Label
                                                    Text="{Binding ResultadoIA.ResumenImagen}"
                                                    TextColor="#4F5D59" />
                                                <Label
                                                    Text="{Binding ErrorProcesamiento}"
                                                    TextColor="#B42318"
                                                    IsVisible="{Binding TieneError}" />

                                                <Grid
                                                    ColumnDefinitions="*,*"
                                                    ColumnSpacing="18">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                        <Label
                                                            Text="Clasificación IA"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ResultadoIA.CategoriaPrincipal}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.CategoriaPrincipal}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="Estado fitosanitario: Aparentemente sana" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="Resultado: Sin indicios visibles de plagas o enfermedades"
                                                            TextColor="#5E6B67"
                                                            IsVisible="False">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.CategoriaPrincipal}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="IsVisible"
                                                                        Value="True" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="{Binding ResultadoIA.SeveridadVisual, StringFormat='Severidad: {0}'}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.SeveridadVisual}"
                                                                    Value="NO_APLICA">
                                                                    <Setter
                                                                        Property="IsVisible"
                                                                        Value="False" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Text="{Binding ResultadoIA.NivelCerteza, StringFormat='Certeza: {0}'}"
                                                            TextColor="#5E6B67">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="ALTO">
                                                                    <Setter Property="Text" Value="Certeza: Alta" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="MEDIO">
                                                                    <Setter Property="Text" Value="Certeza: Media" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="BAJO">
                                                                    <Setter Property="Text" Value="Certeza: Baja" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    TargetType="Label"
                                                                    Binding="{Binding ResultadoIA.NivelCerteza}"
                                                                    Value="NO_APLICA">
                                                                    <Setter Property="IsVisible" Value="False" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                        <Label
                                                            Text="Trazabilidad"
                                                            FontAttributes="Bold"
                                                            TextColor="#263A35" />
                                                        <Label
                                                            Text="{Binding ModeloIAUtilizado, StringFormat='Modelo: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding IntentosIA, StringFormat='Intentos IA: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimoAnalisisHumano.UsuarioAnalizador, StringFormat='Analizador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                        <Label
                                                            Text="{Binding UltimaAprobacion.UsuarioAprobador, StringFormat='Aprobador: {0}'}"
                                                            TextColor="#5E6B67" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <VerticalStackLayout
                                            Grid.Row="2"
                                            Spacing="10">

                                            <!-- Jerarquía ya cargada: siempre conserva visible la categoría que encajó. -->
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#F7FAF8"
                                                Stroke="#C8DED6"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TieneJerarquiaAlbum}">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                            <Label
                                                                Text="Clasificación asignada al Álbum Botánico"
                                                                FontSize="15"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                            <Label
                                                                Text="Categoría, subcategoría y diagnóstico que encajaron con esta fotografía."
                                                                FontSize="11"
                                                                TextColor="#5E6B67" />
                                                        </VerticalStackLayout>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="8,4"
                                                            VerticalOptions="Center"
                                                            BackgroundColor="#E5F2ED"
                                                            Stroke="#C4DED4"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Label
                                                                Text="Jerarquía cargada"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="#31584D" />
                                                        </Border>
                                                    </Grid>

                                                    <FlexLayout
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Stretch"
                                                        JustifyContent="SpaceBetween">
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFFFF"
                                                            Stroke="#D4E5DE"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#3B655B"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="1"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="CATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6A7D76" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.Categoria}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35">
                                                                        <Label.Triggers>
                                                                            <DataTrigger
                                                                                TargetType="Label"
                                                                                Binding="{Binding JerarquiaAlbum.Categoria}"
                                                                                Value="">
                                                                                <Setter Property="Text" Value="Categoría pendiente" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.EstadoCategoria}"
                                                                        FontSize="10"
                                                                        TextColor="#527066" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFFFF"
                                                            Stroke="#D4E5DE"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    TargetType="Border"
                                                                    Binding="{Binding JerarquiaAlbum.Subcategoria}"
                                                                    Value="">
                                                                    <Setter Property="BackgroundColor" Value="#FFFDF6" />
                                                                    <Setter Property="Stroke" Value="#E7C85C" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#3B655B"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="2"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="SUBCATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6A7D76" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.Subcategoria}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#3B655B">
                                                                        <Label.Triggers>
                                                                            <DataTrigger
                                                                                TargetType="Label"
                                                                                Binding="{Binding JerarquiaAlbum.Subcategoria}"
                                                                                Value="">
                                                                                <Setter Property="Text" Value="Pendiente de definir" />
                                                                                <Setter Property="TextColor" Value="#6B5710" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.EstadoSubcategoria}"
                                                                        FontSize="10"
                                                                        TextColor="#527066" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFFFF"
                                                            Stroke="#D4E5DE"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#3B655B"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="3"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="DIAGNÓSTICO ESPECÍFICO"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6A7D76" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.Ficha}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35">
                                                                        <Label.Triggers>
                                                                            <DataTrigger
                                                                                TargetType="Label"
                                                                                Binding="{Binding JerarquiaAlbum.Ficha}"
                                                                                Value="">
                                                                                <Setter Property="Text" Value="Diagnóstico pendiente" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.NombreCientifico}"
                                                                        FontSize="10"
                                                                        FontAttributes="Italic"
                                                                        TextColor="#5E6B67"
                                                                        IsVisible="{Binding JerarquiaAlbum.TieneNombreCientifico}" />
                                                                    <Label
                                                                        Text="{Binding JerarquiaAlbum.EstadoFicha}"
                                                                        FontSize="10"
                                                                        TextColor="#527066" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </FlexLayout>

                                                    <Label
                                                        Text="{Binding JerarquiaAlbum.Motivo}"
                                                        FontSize="11"
                                                        TextColor="#5E6B67" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Propuesta: la tarjeta general es neutral y solo resalta el nivel pendiente. -->
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#FBFCFB"
                                                Stroke="#D9E3DF"
                                                StrokeShape="RoundRectangle 12"
                                                IsVisible="{Binding TienePropuestaAlbum}">
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding TieneJerarquiaAlbum}"
                                                        Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="8">
                                                    <VerticalStackLayout Spacing="1">
                                                        <Label
                                                            Text="Clasificación propuesta para el Álbum Botánico"
                                                            FontSize="15"
                                                            FontAttributes="Bold"
                                                            TextColor="#31584D" />
                                                        <Label
                                                            Text="La categoría identificada permanece visible; únicamente se destaca lo que aún requiere revisión."
                                                            FontSize="11"
                                                            TextColor="#5E6B67" />
                                                    </VerticalStackLayout>

                                                    <FlexLayout
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Stretch"
                                                        JustifyContent="SpaceBetween">
                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#F7FAFD"
                                                            Stroke="#CCDCE9"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#527A9E"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="1"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="CATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#667A8A" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=CategoriaValor}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=CategoriaEstado}"
                                                                        FontSize="10"
                                                                        TextColor="#416886" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,6,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFFDF6"
                                                            Stroke="#E7C85C"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#C99B18"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="2"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="SUBCATEGORÍA"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#806A21" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=SubcategoriaValor}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#6B5710" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=SubcategoriaEstado}"
                                                                        FontSize="10"
                                                                        TextColor="#755B08" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            FlexLayout.Basis="280"
                                                            FlexLayout.Grow="1"
                                                            BackgroundColor="#FFF8F2"
                                                            Stroke="#E2B38E"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                                                <Border
                                                                    WidthRequest="26"
                                                                    HeightRequest="26"
                                                                    BackgroundColor="#9B552C"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 13">
                                                                    <Label
                                                                        Text="3"
                                                                        HorizontalTextAlignment="Center"
                                                                        VerticalTextAlignment="Center"
                                                                        FontAttributes="Bold"
                                                                        TextColor="White" />
                                                                </Border>
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label
                                                                        Text="DIAGNÓSTICO ESPECÍFICO"
                                                                        FontSize="9"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#8A5A3B" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=FichaValor}"
                                                                        FontSize="14"
                                                                        FontAttributes="Bold"
                                                                        TextColor="#263A35" />
                                                                    <Label
                                                                        Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=FichaEstado}"
                                                                        FontSize="10"
                                                                        TextColor="#87451F" />
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </FlexLayout>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <Label
                                                            Text="⚠"
                                                            FontSize="14"
                                                            TextColor="#9A7410"
                                                            VerticalOptions="Start" />
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                            <Label
                                                                Text="{Binding ResultadoIA, Converter={StaticResource JerarquiaPropuestaPresentacionConverter}, ConverterParameter=AvisoPendiente}"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="#6B5710" />
                                                            <Label
                                                                Text="{Binding ResultadoIA.MotivoAlbumPropuesta}"
                                                                FontSize="11"
                                                                TextColor="#5E6B67" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>

                                            <VerticalStackLayout Spacing="3">
                                                <Label
                                                    Text="Clasificación humana"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35"
                                                    IsVisible="{Binding TieneAnalisisHumano}" />
                                                <Label
                                                    Text="{Binding UltimoAnalisisHumano.Diagnostico}"
                                                    TextColor="#5E6B67" />
                                                <Label
                                                    Text="{Binding UltimoAnalisisHumano.Observaciones}"
                                                    TextColor="#5E6B67" />

                                                <Label
                                                    Text="Decisión final"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35"
                                                    Margin="0,5,0,0"
                                                    IsVisible="{Binding TieneAprobacion}" />
                                                <Label
                                                    Text="{Binding UltimaAprobacion.Decision}"
                                                    TextColor="#5E6B67" />
                                                <Label
                                                    Text="{Binding UltimaAprobacion.DiagnosticoFinal}"
                                                    TextColor="#5E6B67" />
                                                <Label
                                                    Text="{Binding MotivoDescarte}"
                                                    TextColor="#B42318" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
