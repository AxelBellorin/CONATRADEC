<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.departamentoPage"
    x:Name="DepartamentoPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>

            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">

                <Border
                    MaximumWidthRequest="620"
                    Padding="28"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Image
                            Source="iconpermission.png"
                            WidthRequest="64"
                            HeightRequest="64"
                            Opacity="0.65" />

                        <Label
                            Text="Sin permiso de lectura"
                            FontSize="21"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Negro}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar el catálogo de departamentos."
                            FontSize="14"
                            TextColor="{StaticResource color_GrisOscuro}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a países"
                            Margin="0,8,0,0"
                            Padding="16,10"
                            BackgroundColor="{StaticResource color_Verde}"
                            TextColor="White"
                            CornerRadius="11"
                            Command="{Binding ReturnCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Contenido principal -->
            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnPlatform WinUI='26,22,26,28', Default='16,16,16,24'}"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="14">

                <!-- Encabezado Windows -->
                <Grid
                    Grid.Row="0"
                    IsVisible="{OnPlatform WinUI=True, Default=False}"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">

                    <Button
                        Grid.Column="0"
                        Text="← Países"
                        Padding="16,10"
                        VerticalOptions="Center"
                        BackgroundColor="#EEF2F0"
                        TextColor="{StaticResource color_Verde}"
                        CornerRadius="11"
                        Command="{Binding ReturnCommand}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3"
                        VerticalOptions="Center">

                        <HorizontalStackLayout Spacing="10">
                            <Label
                                Text="{Binding TitlePage}"
                                FontSize="30"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Border
                                IsVisible="{Binding MostrarCodigoPais}"
                                Padding="9,5"
                                VerticalOptions="Center"
                                BackgroundColor="#EEF5F2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9">

                                <Label
                                    Text="{Binding CodigoPais}"
                                    FontSize="11"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Verde}" />
                            </Border>
                        </HorizontalStackLayout>

                        <Label
                            Text="Administre los departamentos y consulte sus municipios."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="+  Nuevo departamento"
                        Padding="18,11"
                        VerticalOptions="Center"
                        Style="{StaticResource AddButton}"
                        IsVisible="{Binding CanAdd}"
                        Command="{Binding AddCommand}" />
                </Grid>

                <!-- Encabezado móvil -->
                <VerticalStackLayout
                    Grid.Row="0"
                    IsVisible="{OnPlatform WinUI=False, Default=True}"
                    Spacing="12">

                    <VerticalStackLayout Spacing="3">
                        <Label
                            Text="{Binding TitlePage}"
                            FontSize="25"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="Administre los departamentos y consulte sus municipios."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}" />
                    </VerticalStackLayout>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="← Países"
                            Padding="12,10"
                            BackgroundColor="#EEF2F0"
                            TextColor="{StaticResource color_Verde}"
                            CornerRadius="11"
                            Command="{Binding ReturnCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="+ Nuevo"
                            Padding="12,10"
                            Style="{StaticResource AddButton}"
                            IsVisible="{Binding CanAdd}"
                            Command="{Binding AddCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Búsqueda -->
                <Border
                    Grid.Row="1"
                    Padding="{OnPlatform WinUI='16,14', Default='12'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <Grid
                        RowDefinitions="Auto,Auto"
                        RowSpacing="10">

                        <SearchBar
                            Grid.Row="0"
                            Placeholder="Buscar departamento por nombre"
                            Text="{Binding TextoBusqueda}"
                            SearchCommand="{Binding BuscarCommand}"
                            BackgroundColor="#F8FAF9"
                            CancelButtonColor="{StaticResource color_Verde}" />

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10">

                            <Label
                                Text="{Binding ResumenResultados}"
                                VerticalOptions="Center"
                                FontSize="12"
                                TextColor="{StaticResource color_GrisOscuro}" />

                            <Button
                                Grid.Column="1"
                                Text="Buscar"
                                Padding="16,9"
                                Command="{Binding BuscarCommand}"
                                BackgroundColor="{StaticResource color_Verde}"
                                TextColor="White"
                                CornerRadius="10" />

                            <Button
                                Grid.Column="2"
                                Text="Limpiar"
                                Padding="16,9"
                                Command="{Binding LimpiarFiltrosCommand}"
                                BackgroundColor="#EEF2F0"
                                TextColor="{StaticResource color_Verde}"
                                CornerRadius="10" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Mensaje -->
                <Border
                    Grid.Row="2"
                    IsVisible="{Binding TieneMensaje}"
                    Padding="12"
                    BackgroundColor="#FFF7E6"
                    Stroke="#F2C94C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="13"
                        TextColor="{StaticResource color_Negro}" />
                </Border>

                <!-- Listado -->
                <RefreshView
                    Grid.Row="3"
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">

                    <CollectionView
                        x:Name="DepartamentosCollectionView"
                        ItemsSource="{Binding List}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="DepartamentosGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Grid Padding="30">

                                <VerticalStackLayout
                                    IsVisible="{Binding MostrarVacio}"
                                    Spacing="8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Image
                                        Source="iconcountry.png"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        Opacity="0.5" />

                                    <Label
                                        Text="No se encontraron departamentos"
                                        FontSize="18"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Pruebe con otro nombre o registre un nuevo departamento."
                                        FontSize="13"
                                        TextColor="{StaticResource color_GrisOscuro}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DepartamentoResponse">

                                <Border
                                    Padding="16"
                                    MinimumHeightRequest="154"
                                    BackgroundColor="White"
                                    Stroke="#DDE7E3"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16">

                                    <Grid
                                        RowDefinitions="*,Auto"
                                        RowSpacing="14">

                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">

                                            <Border
                                                WidthRequest="48"
                                                HeightRequest="48"
                                                Padding="11"
                                                BackgroundColor="#F7F1EC"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 13">

                                                <Image
                                                    Source="iconcountry.png"
                                                    Aspect="AspectFit" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding NombreDepartamento}"
                                                    FontSize="17"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding ResumenMunicipios}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource color_GrisOscuro}" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="2"
                                                Text="Activo"
                                                Padding="9,5"
                                                FontSize="11"
                                                TextColor="{StaticResource color_Verde}"
                                                BackgroundColor="#EAF7EF"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">

                                            <Button
                                                Grid.Column="0"
                                                Text="Municipios"
                                                Padding="8,9"
                                                BackgroundColor="#EEF5F2"
                                                TextColor="{StaticResource color_Verde}"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference DepartamentoPageRoot}, Path=BindingContext.ViewCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource BlueUpdate}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                IsVisible="{Binding Source={x:Reference DepartamentoPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference DepartamentoPageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource RedDelete}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                IsVisible="{Binding Source={x:Reference DepartamentoPageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference DepartamentoPageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout
                                Padding="10,16,10,24"
                                Spacing="8"
                                HorizontalOptions="Center">

                                <ActivityIndicator
                                    IsRunning="{Binding CargandoMas}"
                                    IsVisible="{Binding CargandoMas}"
                                    Color="{StaticResource color_Naranja}" />

                                <Label
                                    IsVisible="{Binding MostrarFinLista}"
                                    Text="Fin del listado"
                                    FontSize="12"
                                    TextColor="{StaticResource color_GrisOscuro}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <!-- Indicador de carga -->
                <Grid
                    Grid.RowSpan="4"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="True"
                    BackgroundColor="#40FFFFFF">

                    <Border
                        Padding="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="10">

                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource color_Naranja}" />

                            <Label
                                Text="Cargando departamentos..."
                                VerticalOptions="Center"
                                TextColor="{StaticResource color_Negro}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
