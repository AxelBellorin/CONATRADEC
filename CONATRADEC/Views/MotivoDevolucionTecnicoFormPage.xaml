<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MotivoDevolucionTecnicoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="14">
            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="{Binding Titulo}"
                Subtitle="{Binding Subtitulo}"
                BackText="Motivos de devolución"
                BackCommand="{Binding RegresarCommand}"
                IsPrimaryVisible="False" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="14"
                    MaximumWidthRequest="850"
                    HorizontalOptions="Center">
                    <Border
                        Padding="14"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#9B552C" />
                            <Label Text="{Binding MensajeEstado}" TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Padding="18"
                        BackgroundColor="White"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 15">
                        <VerticalStackLayout Spacing="13">
                            <Grid
                                ColumnDefinitions="*,180"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="14"
                                RowSpacing="10">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <Label Text="Código *" FontAttributes="Bold" TextColor="#263A35" />
                                    <Entry
                                        Text="{Binding Codigo}"
                                        Placeholder="EJ. IMAGEN_BORROSA"
                                        MaxLength="60">
                                        <Entry.Triggers>
                                            <DataTrigger
                                                TargetType="Entry"
                                                Binding="{Binding CodigoEditable}"
                                                Value="False">
                                                <Setter Property="IsReadOnly" Value="True" />
                                            </DataTrigger>
                                        </Entry.Triggers>
                                    </Entry>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Label Text="Orden *" FontAttributes="Bold" TextColor="#263A35" />
                                    <Entry Text="{Binding OrdenTexto}" Keyboard="Numeric" MaxLength="3" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                    <Label Text="Nombre *" FontAttributes="Bold" TextColor="#263A35" />
                                    <Entry Text="{Binding Nombre}" MaxLength="140" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Descripción" FontAttributes="Bold" TextColor="#263A35" />
                                <Editor
                                    Text="{Binding Descripcion}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="90"
                                    MaxLength="700" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Instrucción sugerida para el técnico *" FontAttributes="Bold" TextColor="#263A35" />
                                <Editor
                                    Text="{Binding InstruccionSugerida}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="130"
                                    MaxLength="2000" />
                            </VerticalStackLayout>

                            <Border
                                Padding="13"
                                BackgroundColor="#FAFCFB"
                                Stroke="#D9E3DF"
                                StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox
                                            IsChecked="{Binding RequiereNuevaFotografia}"
                                            Color="#9B552C" />
                                        <Label
                                            Text="Requiere una nueva fotografía"
                                            VerticalTextAlignment="Center"
                                            TextColor="#263A35" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox
                                            IsChecked="{Binding PermiteCorregirMetadatos}"
                                            Color="#3B655B">
                                            <CheckBox.Triggers>
                                                <DataTrigger
                                                    TargetType="CheckBox"
                                                    Binding="{Binding RequiereNuevaFotografia}"
                                                    Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <Label
                                            Text="Permite corregir tipo de fotografía y fecha sobre la evidencia actual"
                                            VerticalTextAlignment="Center"
                                            TextColor="#263A35" />
                                    </HorizontalStackLayout>
                                    <Label
                                        Text="{Binding AyudaCorreccion}"
                                        FontSize="12"
                                        TextColor="#5E6B67" />
                                </VerticalStackLayout>
                            </Border>

                            <Button
                                Text="Guardar motivo"
                                Command="{Binding GuardarCommand}"
                                HeightRequest="48"
                                HorizontalOptions="End"
                                WidthRequest="190"
                                BackgroundColor="#3B655B"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
