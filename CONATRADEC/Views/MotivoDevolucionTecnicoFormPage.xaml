<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MotivoDevolucionTecnicoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <ScrollView>
                <VerticalStackLayout
                    Padding="{OnIdiom Phone='12,12,12,24', Tablet='18,16,18,28', Desktop='24,20,24,32'}"
                    Spacing="14"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center">

                    <controls:ResponsiveCatalogHeader
                        Title="{Binding Titulo}"
                        Subtitle="{Binding Subtitulo}"
                        BackText="← Motivos de devolución"
                        BackCommand="{Binding RegresarCommand}"
                        IsPrimaryVisible="False" />

                    <Border
                        IsVisible="{Binding SinPermisoOperacion}"
                        Style="{StaticResource ModernWarningBanner}">
                        <Label
                            Text="{Binding MensajeSinPermiso}"
                            HorizontalTextAlignment="Center"
                            FontFamily="MontserratMedium"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </Border>

                    <Border
                        IsVisible="{Binding TieneMensajeEstado}"
                        Style="{StaticResource ModernWarningBanner}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="{StaticResource color_Cafe}"
                                WidthRequest="20"
                                HeightRequest="20" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                FontFamily="MontserratMedium"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        IsVisible="{Binding PuedeMostrarFormulario}"
                        Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="Información del motivo"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="18" />
                                <Label
                                    Text="El código identifica históricamente el motivo y no puede cambiarse después de crearlo."
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Grid
                                x:Name="IdentificacionGrid"
                                ColumnDefinitions="*,170"
                                RowDefinitions="Auto"
                                ColumnSpacing="12"
                                RowSpacing="11">
                                <VerticalStackLayout
                                    x:Name="CodigoStack"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="4">
                                    <Label Text="Código *" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Codigo}"
                                            Placeholder="EJ. IMAGEN_BORROSA"
                                            MaxLength="60"
                                            Style="{StaticResource ModernEntry}">
                                            <Entry.Triggers>
                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding CodigoEditable}"
                                                    Value="False">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                </DataTrigger>
                                            </Entry.Triggers>
                                        </Entry>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    x:Name="OrdenStack"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="4">
                                    <Label Text="Orden *" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding OrdenTexto}"
                                            Keyboard="Numeric"
                                            MaxLength="3"
                                            Style="{StaticResource ModernEntry}">
                                            <Entry.Triggers>
                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding PuedeEditarFormulario}"
                                                    Value="False">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                </DataTrigger>
                                            </Entry.Triggers>
                                        </Entry>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nombre *" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        Text="{Binding Nombre}"
                                        MaxLength="140"
                                        Style="{StaticResource ModernEntry}">
                                        <Entry.Triggers>
                                            <DataTrigger
                                                TargetType="Entry"
                                                Binding="{Binding PuedeEditarFormulario}"
                                                Value="False">
                                                <Setter Property="IsReadOnly" Value="True" />
                                            </DataTrigger>
                                        </Entry.Triggers>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Descripción" Style="{StaticResource ModernFieldLabel}" />
                                <Border
                                    Style="{StaticResource ModernInputBorder}"
                                    Padding="10,7"
                                    MinimumHeightRequest="105">
                                    <Editor
                                        Text="{Binding Descripcion}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="90"
                                        MaxLength="700"
                                        BackgroundColor="Transparent"
                                        FontFamily="MontserratMedium"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}">
                                        <Editor.Triggers>
                                            <DataTrigger
                                                TargetType="Editor"
                                                Binding="{Binding PuedeEditarFormulario}"
                                                Value="False">
                                                <Setter Property="IsReadOnly" Value="True" />
                                            </DataTrigger>
                                        </Editor.Triggers>
                                    </Editor>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Instrucción sugerida para el técnico *" Style="{StaticResource ModernFieldLabel}" />
                                <Border
                                    Style="{StaticResource ModernInputBorder}"
                                    Padding="10,7"
                                    MinimumHeightRequest="145">
                                    <Editor
                                        Text="{Binding InstruccionSugerida}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="130"
                                        MaxLength="2000"
                                        BackgroundColor="Transparent"
                                        FontFamily="MontserratMedium"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}">
                                        <Editor.Triggers>
                                            <DataTrigger
                                                TargetType="Editor"
                                                Binding="{Binding PuedeEditarFormulario}"
                                                Value="False">
                                                <Setter Property="IsReadOnly" Value="True" />
                                            </DataTrigger>
                                        </Editor.Triggers>
                                    </Editor>
                                </Border>
                            </VerticalStackLayout>

                            <Border Style="{StaticResource ModernSoftPanel}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox
                                            IsChecked="{Binding RequiereNuevaFotografia}"
                                            IsEnabled="{Binding PuedeEditarFormulario}"
                                            Color="{StaticResource color_Cafe}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Requiere una nueva fotografía"
                                            VerticalTextAlignment="Center"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            LineBreakMode="WordWrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox
                                            IsChecked="{Binding PermiteCorregirMetadatos}"
                                            IsEnabled="{Binding PuedeEditarFormulario}"
                                            Color="{StaticResource color_Verde}"
                                            VerticalOptions="Center">
                                            <CheckBox.Triggers>
                                                <DataTrigger
                                                    TargetType="CheckBox"
                                                    Binding="{Binding RequiereNuevaFotografia}"
                                                    Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <Label
                                            Grid.Column="1"
                                            Text="Permite corregir tipo de fotografía y fecha sobre la evidencia actual"
                                            VerticalTextAlignment="Center"
                                            FontFamily="MontserratMedium"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            LineBreakMode="WordWrap" />
                                    </Grid>

                                    <Label
                                        Text="{Binding AyudaCorreccion}"
                                        Style="{StaticResource ModernCaption}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Grid
                                x:Name="PieAccionesGrid"
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">
                                <Label
                                    x:Name="CamposObligatoriosLabel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Los campos marcados con * son obligatorios."
                                    Style="{StaticResource ModernCaption}"
                                    VerticalOptions="Center" />
                                <Button
                                    x:Name="GuardarButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="Guardar motivo"
                                    Command="{Binding GuardarCommand}"
                                    IsVisible="{Binding MostrarGuardar}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    MinimumWidthRequest="170" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#66000000"
                InputTransparent="False">
                <Border
                    Padding="20,16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Naranja}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="{Binding MensajeEstado}"
                            HorizontalTextAlignment="Center"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
