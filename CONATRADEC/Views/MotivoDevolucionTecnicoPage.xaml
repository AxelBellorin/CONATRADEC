<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MotivoDevolucionTecnicoPage"
    x:Name="PaginaRaiz"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">

                <CollectionView.Header>
                    <VerticalStackLayout
                        Padding="{OnIdiom Phone='12,12,12,10', Tablet='18,16,18,12', Desktop='24,20,24,14'}"
                        Spacing="12">

                        <!--
                            Encabezado estático: no cambia filas ni columnas en
                            tiempo de ejecución y evita superposición en Android.
                        -->
                        <Border
                            Style="{StaticResource ModernHeroCard}"
                            Padding="{OnIdiom Phone='12,12', Tablet='18,16', Desktop='22,20'}">
                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*,Auto"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="0"
                                    Text="← Configuración"
                                    Command="{Binding RegresarCommand}"
                                    Style="{StaticResource ModernNeutralButton}"
                                    FontSize="{OnIdiom Phone=10, Tablet=12, Desktop=12.5}"
                                    HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=44}"
                                    MinimumWidthRequest="0"
                                    Padding="{OnIdiom Phone='8,7', Tablet='12,8', Desktop='12,8'}"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.ColumnSpan="{OnIdiom Phone=3, Tablet=1, Desktop=1}"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Motivos de devolución al técnico"
                                        Style="{StaticResource ModernPageTitle}"
                                        FontSize="{OnIdiom Phone=24, Tablet=28, Desktop=30}"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Text="Administre las causas e instrucciones utilizadas por el analizador para solicitar correcciones de evidencia."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        MaxLines="{OnIdiom Phone=3, Tablet=2, Desktop=2}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="2"
                                    Text="+ Nuevo motivo"
                                    Command="{Binding NuevoCommand}"
                                    IsVisible="{Binding CanAdd}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    FontSize="{OnIdiom Phone=10, Tablet=12, Desktop=12.5}"
                                    HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=44}"
                                    MinimumWidthRequest="0"
                                    Padding="{OnIdiom Phone='10,7', Tablet='14,8', Desktop='14,8'}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Buscar}"
                                            Placeholder="Código, nombre, descripción o instrucción"
                                            ReturnType="Search"
                                            ReturnCommand="{Binding BuscarCommand}"
                                            ClearButtonVisibility="WhileEditing"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        Text="Buscar"
                                        Command="{Binding BuscarCommand}"
                                        Style="{StaticResource ModernPrimaryButton}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IncluirInactivos}"
                                        Color="{StaticResource color_Verde}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Incluir motivos inactivos"
                                        VerticalTextAlignment="Center"
                                        FontFamily="MontserratMedium"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Button
                                        Grid.Column="2"
                                        Text="Actualizar"
                                        Command="{Binding ActualizarCommand}"
                                        Style="{StaticResource ModernNeutralButton}" />
                                </Grid>

                                <Label
                                    Text="Desactivar realiza una baja lógica. El motivo deja de estar disponible para nuevas devoluciones, pero continúa visible en el historial y puede reactivarse posteriormente."
                                    Style="{StaticResource ModernCaption}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            IsVisible="{Binding TieneMensajeEstado}"
                            Style="{StaticResource ModernWarningBanner}">
                            <HorizontalStackLayout Spacing="10">
                                <ActivityIndicator
                                    IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="{StaticResource color_Cafe}"
                                    WidthRequest="20"
                                    HeightRequest="20" />
                                <Label
                                    Text="{Binding MensajeEstado}"
                                    VerticalTextAlignment="Center"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="WordWrap" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Grid Padding="{OnIdiom Phone='12,20', Tablet='18,24', Desktop='24,28'}">
                        <Border
                            IsVisible="{Binding SinItems}"
                            Style="{StaticResource ModernEmptyStateCard}">
                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">
                                <Border
                                    Style="{StaticResource ModernIconTile}"
                                    WidthRequest="56"
                                    HeightRequest="56">
                                    <Label
                                        Text="↩"
                                        FontSize="25"
                                        TextColor="{StaticResource color_Verde}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Text="No se encontraron motivos"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="17"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="Cambie la búsqueda o active la opción para incluir registros inactivos."
                                    Style="{StaticResource ModernPageSubtitle}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MotivoDevolucionTecnicoItem">
                        <Border
                            Margin="{OnIdiom Phone='12,0', Tablet='18,0', Desktop='24,0'}"
                            Style="{StaticResource ModernCatalogCard}">
                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                RowSpacing="8">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label
                                        Text="{Binding NombreMostrar}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Text="{Binding Codigo}"
                                        FontFamily="MontserratBold"
                                        FontSize="10.5"
                                        TextColor="{StaticResource color_Verde}"
                                        LineBreakMode="CharacterWrap" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="9,4"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9"
                                    VerticalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Activo}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Activo}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandCoffeeSoft}, Dark={StaticResource BrandCoffeeSoftDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="{Binding EstadoTexto}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        FontSize="10">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Activo}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource color_Verde}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Activo}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource color_Cafe}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Descripcion}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12.5"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    LineBreakMode="WordWrap" />

                                <Border
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource ModernSoftPanel}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            Text="Instrucción sugerida"
                                            Style="{StaticResource ModernFieldLabel}"
                                            TextColor="{StaticResource color_Verde}" />
                                        <Label
                                            Text="{Binding InstruccionSugerida}"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="11.5"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding TipoCorreccionTexto}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{StaticResource color_Cafe}"
                                            LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Spacing="8"
                                    HorizontalOptions="End">
                                    <Button
                                        Text="Editar"
                                        Command="{Binding Source={x:Reference PaginaRaiz}, Path=BindingContext.EditarCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Activo}"
                                        Style="{StaticResource ModernUpdateButton}" />
                                    <Button
                                        Text="Desactivar"
                                        Command="{Binding Source={x:Reference PaginaRaiz}, Path=BindingContext.EliminarCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Activo}"
                                        Style="{StaticResource ModernDangerSoftButton}" />
                                    <Button
                                        Text="Activar"
                                        Command="{Binding Source={x:Reference PaginaRaiz}, Path=BindingContext.ActivarCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ModernSecondaryButton}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Activo}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="{OnIdiom Phone=24, Tablet=28, Desktop=32}" Opacity="0" />
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#66000000"
                InputTransparent="False">
                <Border
                    Padding="20,16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Naranja}"
                            WidthRequest="24"
                            HeightRequest="24" />
                        <Label
                            Text="Actualizando motivos..."
                            VerticalOptions="Center"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
