<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietarioTerrenosPage"
    x:Name="PropietarioTerrenosPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <Grid
                x:Name="ContenidoTerrenosPropietario"
                Padding="{OnIdiom Phone='12,12,12,20', Tablet='18,16,18,24', Desktop='24,20,24,28'}">

                <!--
                    Encabezado y resumen forman parte del mismo CollectionView.
                    De esta forma se desplazan naturalmente con el contenido y
                    no quedan fijos ocupando espacio en pantallas pequeñas.
                -->
                <RefreshView
                    Command="{Binding ActualizarCommand}"
                    IsRefreshing="{Binding IsRefreshing}">

                    <CollectionView
                        ItemsSource="{Binding Terrenos}"
                        SelectionMode="None">

                        <CollectionView.Header>
                            <VerticalStackLayout
                                Spacing="14"
                                Padding="0,0,0,14">

                                <controls:ResponsiveCatalogHeader
                                    Title="{Binding Titulo}"
                                    Subtitle="Visualice los terrenos vinculados y cambie su propietario sin salir de esta pantalla."
                                    BackText="← Propietarios"
                                    BackCommand="{Binding RegresarCommand}" />

                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    Padding="16">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        HorizontalOptions="Fill">

                                        <VerticalStackLayout
                                            MinimumWidthRequest="0"
                                            Spacing="4">
                                            <Label
                                                Text="{Binding TextoPropietario}"
                                                FontSize="18"
                                                FontFamily="MontserratBold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding TextoIdentificacion}"
                                                FontSize="11.5"
                                                FontFamily="MontserratBold"
                                                TextColor="{StaticResource color_Verde}"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding TextoContacto}"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding TextoResumenTerrenos}"
                                                FontSize="11.5"
                                                FontFamily="MontserratBold"
                                                TextColor="{StaticResource color_Cafe}" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            Style="{StaticResource ModernBadgeGreen}"
                                            VerticalOptions="Start"
                                            HorizontalOptions="End">
                                            <Label
                                                Text="{Binding TextoEstadoPropietario}"
                                                FontFamily="MontserratBold"
                                                FontSize="9.5"
                                                TextColor="{StaticResource color_Verde}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.EmptyView>
                            <Border
                                Margin="0,16"
                                Style="{StaticResource ModernEmptyStateCard}">
                                <VerticalStackLayout
                                    Spacing="6"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="Sin terrenos vinculados"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="16"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Este propietario ya no tiene terrenos activos asignados."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropietarioTerrenoResumenResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    HorizontalOptions="Fill">

                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="10"
                                        HorizontalOptions="Fill">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="12"
                                            HorizontalOptions="Fill">
                                            <Label
                                                Text="{Binding TextoCodigo}"
                                                FontSize="17"
                                                FontFamily="MontserratBold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource ModernBadgeGreen}">
                                                <Label
                                                    Text="{Binding TextoEstado}"
                                                    FontSize="9.5"
                                                    FontFamily="MontserratBold"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                        </Grid>

                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Spacing="5">
                                            <Label
                                                Text="{Binding TextoDireccion}"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                            <FlexLayout
                                                Direction="Row"
                                                Wrap="Wrap"
                                                JustifyContent="Start"
                                                AlignItems="Center">
                                                <Label
                                                    Text="{Binding TextoExtension}"
                                                    Margin="0,0,14,4"
                                                    FontSize="11"
                                                    FontFamily="MontserratBold"
                                                    TextColor="{StaticResource color_Verde}" />
                                                <Label
                                                    Text="{Binding TextoProduccion}"
                                                    Margin="0,0,0,4"
                                                    FontSize="11"
                                                    FontFamily="MontserratBold"
                                                    TextColor="{StaticResource color_Cafe}" />
                                            </FlexLayout>
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Row="2"
                                            Text="Cambiar propietario"
                                            Style="{StaticResource ModernUpdateButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="8,9"
                                            Command="{Binding Source={x:Reference PropietarioTerrenosPageRoot}, Path=BindingContext.CambiarPropietarioCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={x:Reference PropietarioTerrenosPageRoot}, Path=BindingContext.CanEdit}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- Selector de propietario -->
                <Grid
                    IsVisible="{Binding MostrarSelectorPropietario}"
                    BackgroundColor="#99000000"
                    Padding="{OnIdiom Phone='10', Tablet='24', Desktop='48'}"
                    ZIndex="50">

                    <Border
                        x:Name="SelectorContainer"
                        Style="{StaticResource ModernCatalogCard}"
                        Padding="{OnIdiom Phone='14', Tablet='18', Desktop='22'}"
                        MaximumWidthRequest="760"
                        MaximumHeightRequest="760"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Grid
                            RowDefinitions="Auto,Auto,*,Auto"
                            RowSpacing="12">

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding TextoTerrenoSeleccionado}"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="18"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    Text="Seleccione el propietario activo que recibirá el terreno."
                                    Style="{StaticResource ModernPageSubtitle}" />
                                <Label
                                    Text="{Binding TextoResumenPropietarios}"
                                    FontFamily="MontserratBold"
                                    FontSize="11"
                                    TextColor="{StaticResource color_Cafe}" />
                            </VerticalStackLayout>

                            <Grid
                                x:Name="BusquedaSelectorGrid"
                                Grid.Row="1"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Border
                                    Style="{StaticResource ModernInputBorder}"
                                    Padding="4,0">
                                    <SearchBar
                                        Placeholder="Buscar propietario"
                                        Text="{Binding TextoBusquedaDestino, Mode=TwoWay}"
                                        SearchCommand="{Binding BuscarPropietariosCommand}"
                                        Style="{StaticResource ModernSearchBar}" />
                                </Border>

                                <Button
                                    x:Name="BuscarSelectorButton"
                                    Grid.Column="1"
                                    Text="Buscar"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    MinimumWidthRequest="0"
                                    Padding="12,8"
                                    Command="{Binding BuscarPropietariosCommand}" />
                            </Grid>

                            <CollectionView
                                x:Name="PropietariosDestinoCollection"
                                Grid.Row="2"
                                ItemsSource="{Binding PropietariosDestino}"
                                SelectionMode="None">

                                <CollectionView.EmptyView>
                                    <Label
                                        Text="No hay otros propietarios activos para mostrar."
                                        Padding="16"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        HorizontalTextAlignment="Center" />
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PropietarioResponse">
                                        <Border
                                            Margin="0,0,0,8"
                                            Style="{StaticResource ModernCatalogCard}"
                                            Padding="12">

                                            <Grid
                                                RowDefinitions="Auto,Auto"
                                                RowSpacing="8">

                                                <VerticalStackLayout
                                                    Spacing="3"
                                                    MinimumWidthRequest="0">
                                                    <Label
                                                        Text="{Binding TextoPrincipal}"
                                                        FontSize="14"
                                                        FontFamily="MontserratBold"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Text="{Binding TextoIdentificacion}"
                                                        FontSize="11"
                                                        FontFamily="MontserratBold"
                                                        TextColor="{StaticResource color_Verde}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Text="{Binding TextoContacto}"
                                                        FontSize="10"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>

                                                <Button
                                                    Grid.Row="1"
                                                    Text="Asignar"
                                                    Style="{StaticResource ModernUpdateButton}"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Fill"
                                                    Padding="8,8"
                                                    Command="{Binding Source={x:Reference PropietarioTerrenosPageRoot}, Path=BindingContext.SeleccionarPropietarioCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.Footer>
                                    <Border
                                        x:Name="PaginacionSelectorPropietarios"
                                        IsVisible="{Binding MostrarPaginacionPropietarios}"
                                        Margin="0,10,0,8"
                                        Padding="12"
                                        Style="{StaticResource ModernCatalogCard}"
                                        MaximumWidthRequest="520"
                                        HorizontalOptions="Center">

                                        <VerticalStackLayout Spacing="9">
                                            <VerticalStackLayout
                                                Spacing="2"
                                                HorizontalOptions="Center">
                                                <Label
                                                    Text="{Binding PaginaPropietariosTexto}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="11.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label
                                                    Text="{Binding RangoPropietariosTexto}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="9.5"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="8">
                                                <Button
                                                    Grid.Column="0"
                                                    Text="← Anterior"
                                                    Pressed="PaginacionSelector_Pressed"
                                                    Clicked="PaginacionSelector_Clicked"
                                                    Command="{Binding PaginaAnteriorPropietariosCommand}"
                                                    IsEnabled="{Binding PuedeIrAnteriorPropietarios}"
                                                    Style="{StaticResource ModernSecondaryButton}"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Fill"
                                                    Padding="6,8" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Siguiente →"
                                                    Pressed="PaginacionSelector_Pressed"
                                                    Clicked="PaginacionSelector_Clicked"
                                                    Command="{Binding PaginaSiguientePropietariosCommand}"
                                                    IsEnabled="{Binding PuedeIrSiguientePropietarios}"
                                                    Style="{StaticResource ModernSecondaryButton}"
                                                    MinimumWidthRequest="0"
                                                    HorizontalOptions="Fill"
                                                    Padding="6,8" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </CollectionView.Footer>
                            </CollectionView>

                            <Button
                                Grid.Row="3"
                                Text="Cancelar"
                                Style="{StaticResource ModernNeutralButton}"
                                MinimumWidthRequest="0"
                                HorizontalOptions="Fill"
                                Command="{Binding CancelarCambioCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#40000000"
                    ZIndex="100">
                    <Border
                        Padding="18,14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeShape="RoundRectangle 14">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource color_Naranja}" />
                            <Label
                                Text="Procesando..."
                                FontFamily="MontserratBold"
                                FontSize="12"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
