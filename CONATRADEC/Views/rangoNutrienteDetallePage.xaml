<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rangoNutrienteDetallePage"
    x:Name="DetallePageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='12,12,12,18', Tablet='18,16,18,22', Desktop='24,20,24,26'}">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">
                <CollectionView
                    ItemsSource="{Binding Aportes}"
                    SelectionMode="None"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="RangosGridLayout"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <!--
                        Encabezado, búsqueda, mensajes y estado vacío forman
                        parte del contenido desplazable. El estado vacío no
                        usa CollectionView.EmptyView para mantener operativos
                        Buscar/Limpiar en WinUI cuando la consulta devuelve 0.
                    -->
                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="12"
                            Padding="0,0,0,12">

                            <controls:ResponsiveCatalogHeader
                                Title="{Binding Titulo}"
                                Subtitle="{Binding DescripcionCategoria}"
                                BackText="← Cultivos"
                                BackCommand="{Binding BackCommand}"
                                PrimaryText="+ Nuevo rango"
                                PrimaryCommand="{Binding AddCommand}"
                                IsPrimaryVisible="{Binding CanAdd}" />

                            <controls:ResponsiveSearchPanel
                                Placeholder="Buscar por elemento, símbolo o descripción"
                                SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                                SummaryText="{Binding ResumenAportes}"
                                SearchCommand="{Binding BuscarCommand}"
                                ClearCommand="{Binding LimpiarFiltrosCommand}" />

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label Text="{Binding Mensaje}" Style="{StaticResource ModernPageSubtitle}" />
                            </Border>

                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                InputTransparent="True"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                MaximumWidthRequest="560"
                                Margin="20,18,20,6">
                                <VerticalStackLayout Spacing="9" HorizontalOptions="Center">
                                    <Border Style="{StaticResource ModernIconTile}">
                                        <Label
                                            Text="RG"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            TextColor="{StaticResource color_Verde}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Text="No se encontraron rangos"
                                        Style="{StaticResource ModernSectionTitle}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Cambie la búsqueda o configure el primer elemento."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RangoNutrienteResponse">
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                MinimumHeightRequest="198">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                        <Border
                                            Style="{StaticResource ModernIconTile}"
                                            WidthRequest="52"
                                            HeightRequest="52">
                                            <Label
                                                Text="{Binding SimboloElementoQuimico}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="17"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding NombreElementoQuimico}"
                                                Style="{StaticResource ModernSectionTitle}"
                                                FontSize="15"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Text="{Binding DescripcionMostrar}"
                                                Style="{StaticResource ModernCaption}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border Grid.Row="1" Style="{StaticResource ModernMetricSurface}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="INTERVALO" Style="{StaticResource ModernCaption}" FontSize="9.5" />
                                            <Label
                                                Text="{Binding RangoTexto}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="7">
                                        <Button
                                            Text="Ver"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.ViewCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Consultar este rango nutricional" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Editar"
                                            Style="{StaticResource ModernUpdateButton}"
                                            IsVisible="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.CanEdit}"
                                            Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Editar este rango nutricional" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Eliminar"
                                            Style="{StaticResource ModernDangerButton}"
                                            IsVisible="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.CanDelete}"
                                            Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Eliminar este rango nutricional" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="10,16,10,24" Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator
                                IsRunning="{Binding CargandoMas}"
                                IsVisible="{Binding CargandoMas}"
                                Color="{StaticResource color_Verde}"
                                SemanticProperties.Description="Cargando más rangos nutricionales" />
                            <Label
                                IsVisible="{Binding MostrarFinLista}"
                                Text="Fin del listado"
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <Grid
                ZIndex="100"
                IsVisible="{Binding IsBusy}"
                InputTransparent="False"
                BackgroundColor="#28000000">
                <Border
                    Padding="18,14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="24"
                            HeightRequest="24"
                            SemanticProperties.Description="Cargando rangos nutricionales" />
                        <Label
                            Text="Cargando rangos..."
                            VerticalOptions="Center"
                            FontFamily="MontserratBold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
