<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.noticiaDetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle de publicación"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    ControlTemplate="{StaticResource FooterTemplate}">

    <Grid>
        <Grid x:Name="ContenidoPrincipal">
            <ScrollView>
                <VerticalStackLayout
                    MaximumWidthRequest="1040"
                    HorizontalOptions="Center"
                    Padding="{OnIdiom Phone='12,12,12,28', Tablet='20,18,20,32', Desktop='28,22,28,36'}"
                    Spacing="14">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <Grid
                            RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                            ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                            RowSpacing="12"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Button
                                    Text="← Noticias"
                                    Command="{Binding RegresarCommand}"
                                    Style="{StaticResource ModernLinkButton}"
                                    HorizontalOptions="Start"
                                    Margin="-8,-5,0,0" />
                                <Label
                                    Text="Detalle de publicación"
                                    Style="{StaticResource ModernPageTitle}" />
                                <Label
                                    Text="Consulte el contenido completo y la información de vigencia."
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Row="{OnIdiom Phone=1, Default=0}"
                                Grid.Column="{OnIdiom Phone=0, Default=1}"
                                Text="Editar publicación"
                                Command="{Binding EditarCommand}"
                                IsVisible="{Binding CanEdit}"
                                Style="{StaticResource ModernCoffeeButton}"
                                HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <Border
                        IsVisible="{Binding TieneMensaje}"
                        Style="{StaticResource ModernWarningBanner}">
                        <Label
                            Text="{Binding Mensaje}"
                            Style="{StaticResource ModernPageSubtitle}" />
                    </Border>

                    <Border
                        IsVisible="{Binding TienePublicacion}"
                        Style="{StaticResource ModernCard}"
                        Padding="0">

                        <VerticalStackLayout Spacing="0">
                            <Grid
                                HeightRequest="{OnIdiom Phone=230, Tablet=320, Desktop=390}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}">
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="5">
                                    <Label
                                        Text="CONATRADEC"
                                        FontFamily="MontserratBold"
                                        FontSize="24"
                                        TextColor="{StaticResource color_Verde}" />
                                    <Label
                                        Text="Centro de noticias"
                                        Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Image
                                    Source="{Binding Publicacion.ImagenPortadaUrl}"
                                    IsVisible="{Binding Publicacion.TieneImagen}"
                                    Aspect="AspectFill" />
                            </Grid>

                            <VerticalStackLayout
                                Padding="{OnIdiom Phone=16, Tablet=22, Desktop=26}"
                                Spacing="14">

                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                    <Border
                                        Margin="0,0,7,6"
                                        Padding="10,5"
                                        BackgroundColor="{Binding Publicacion.CategoriaColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                        <Label
                                            Text="{Binding Publicacion.Categoria}"
                                            FontFamily="MontserratBold"
                                            FontSize="11"
                                            TextColor="White" />
                                    </Border>

                                    <Border
                                        Margin="0,0,7,6"
                                        IsVisible="{Binding Publicacion.Destacada}"
                                        Style="{StaticResource ModernBadgeYellow}">
                                        <Label
                                            Text="Destacada"
                                            FontFamily="MontserratBold"
                                            FontSize="10.5"
                                            TextColor="{StaticResource color_Cafe}" />
                                    </Border>
                                </FlexLayout>

                                <Label
                                    Text="{Binding Publicacion.Titulo}"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="{OnIdiom Phone=25, Tablet=29, Desktop=32}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Text="{Binding Publicacion.Resumen}"
                                    FontFamily="MontserratMedium"
                                    FontSize="{OnIdiom Phone=14, Tablet=15, Desktop=16}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    LineBreakMode="WordWrap" />

                                <BoxView
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />

                                <Grid
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                                    ColumnDefinitions="{OnIdiom Phone='*', Default='*,*'}"
                                    ColumnSpacing="12"
                                    RowSpacing="10">

                                    <Border Style="{StaticResource ModernSoftPanel}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="PUBLICACIÓN" Style="{StaticResource ModernCaption}" />
                                            <Label
                                                Text="{Binding Publicacion.FechaPublicacionTexto}"
                                                Style="{StaticResource ModernFieldLabel}" />
                                            <Label
                                                Text="{Binding Publicacion.VigenciaTexto}"
                                                Style="{StaticResource ModernCaption}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border
                                        Grid.Row="{OnIdiom Phone=1, Default=0}"
                                        Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        IsVisible="{Binding Publicacion.TieneEvento}"
                                        Style="{StaticResource ModernSoftPanel}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="EVENTO" Style="{StaticResource ModernCaption}" />
                                            <Label
                                                Text="{Binding Publicacion.FechaEventoTexto}"
                                                FontFamily="MontserratBold"
                                                FontSize="12"
                                                TextColor="{StaticResource color_Cafe}" />
                                            <Label
                                                Text="{Binding Publicacion.Ubicacion, StringFormat='Ubicación: {0}'}"
                                                IsVisible="{Binding Publicacion.TieneUbicacion}"
                                                Style="{StaticResource ModernCaption}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Label
                                    Text="{Binding Publicacion.Contenido}"
                                    FontFamily="MontserratMedium"
                                    FontSize="{OnIdiom Phone=14, Tablet=14.5, Desktop=15}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="WordWrap"
                                    LineHeight="1.35" />

                                <Button
                                    Text="{Binding Publicacion.TextoBotonEnlace}"
                                    Command="{Binding AbrirEnlaceCommand}"
                                    IsVisible="{Binding Publicacion.TieneEnlace}"
                                    HorizontalOptions="{OnIdiom Phone=Fill, Default=Start}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    MinimumWidthRequest="{OnIdiom Phone=0, Default=180}" />

                                <Label
                                    Text="Publicado por CONATRADEC"
                                    FontFamily="MontserratBold"
                                    FontSize="11"
                                    TextColor="{StaticResource color_Verde}"
                                    Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#52000000"
                InputTransparent="False">
                <Border
                    Style="{StaticResource ModernCard}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22,18">
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="28"
                            HeightRequest="28" />
                        <Label
                            Text="Cargando publicación..."
                            Style="{StaticResource ModernSectionTitle}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            Padding="24">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Sin permiso"
                        Style="{StaticResource ModernPageTitle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tiene permiso para consultar esta publicación."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
