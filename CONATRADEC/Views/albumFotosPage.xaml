<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumFotosPage"
    x:Name="AlbumPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='#F4F7F5', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <CollectionView
            x:Name="AlbumCollectionView"
            Margin="{OnPlatform WinUI='30,24,30,28', Default='14,14,14,18'}"
            ItemsSource="{Binding Registros}"
            SelectionMode="None"
            ItemSizingStrategy="MeasureFirstItem"
            RemainingItemsThreshold="2"
            RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="{OnPlatform WinUI=3, Default=1}"
                    HorizontalItemSpacing="14"
                    VerticalItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Margin="0,0,0,14">
                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='*,Auto,Auto', Default='*,*'}"
                        RowDefinitions="{OnPlatform WinUI='Auto', Default='Auto,Auto'}"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <VerticalStackLayout
                            Grid.ColumnSpan="{OnPlatform WinUI=1, Default=2}"
                            Spacing="3">
                            <Label
                                Text="Álbum botánico"
                                FontFamily="MontserratBold"
                                FontSize="{OnPlatform WinUI=31, Default=25}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />
                            <Label
                                Text="Categoría → subcategoría → ficha específica → fotografías aprobadas"
                                FontSize="{OnPlatform WinUI=13, Default=11}"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Row="{OnPlatform WinUI=0, Default=1}"
                            Grid.Column="{OnPlatform WinUI=1, Default=0}"
                            Text="Nueva categoría"
                            Command="{Binding AgregarCategoriaCommand}"
                            IsVisible="{Binding CanAdd}"
                            Style="{x:Null}"
                            BackgroundColor="#EEF5F2"
                            TextColor="#3B655B"
                            BorderColor="#C8DED6"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="15,11"
                            FontAttributes="Bold" />
                        <Button
                            Grid.Row="{OnPlatform WinUI=0, Default=1}"
                            Grid.Column="{OnPlatform WinUI=2, Default=1}"
                            Text="Nueva ficha"
                            Command="{Binding AgregarRegistroCommand}"
                            IsVisible="{Binding CanAdd}"
                            Style="{x:Null}"
                            BackgroundColor="#3B655B"
                            TextColor="White"
                            CornerRadius="12"
                            Padding="15,11"
                            FontAttributes="Bold" />
                    </Grid>

                    <Border
                        Padding="10"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 16">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="4">
                            <SearchBar
                                Text="{Binding TextoBusqueda}"
                                SearchButtonPressed="OnBuscarPresionado"
                                Placeholder="Buscar categoría, subcategoría, ficha o nombre científico"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource color_Negro}" />
                            <Button
                                Grid.Column="1"
                                Text="Limpiar"
                                Clicked="OnLimpiarBusquedaClicked"
                                Style="{x:Null}"
                                BackgroundColor="#F1F4F2"
                                TextColor="#4B5E58"
                                CornerRadius="10"
                                Padding="12,8" />
                            <HorizontalStackLayout
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding MostrarInactivos}"
                                Spacing="8">
                                <Switch
                                    IsToggled="{Binding IncluirInactivos}"
                                    Toggled="OnIncluirInactivosToggled"
                                    Style="{StaticResource SwitchStyle}" />
                                <Label
                                    Text="Mostrar elementos inactivos"
                                    VerticalOptions="Center"
                                    FontSize="11"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Categorías"
                                FontFamily="MontserratBold"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#3B655B" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="#9B552C" />
                        </Grid>
                        <CollectionView
                            ItemsSource="{Binding Categorias}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="116"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.Header>
                                <Border
                                    WidthRequest="142"
                                    HeightRequest="106"
                                    Margin="0,0,9,0"
                                    Padding="12"
                                    BackgroundColor="{Binding FondoTodas}"
                                    Stroke="{Binding BordeTodas}"
                                    StrokeShape="RoundRectangle 15">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SeleccionarTodasCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                                        <Label Text="Todas" FontSize="15" FontAttributes="Bold" TextColor="{Binding TextoTodas}" HorizontalTextAlignment="Center" />
                                        <Label Text="Galería completa" FontSize="10" TextColor="{Binding TextoTodas}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.Header>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        WidthRequest="190"
                                        HeightRequest="106"
                                        Margin="0,0,9,0"
                                        Padding="11"
                                        BackgroundColor="{Binding FondoSeleccion}"
                                        Stroke="{Binding BordeSeleccion}"
                                        StrokeShape="RoundRectangle 15">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.SeleccionarCategoriaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                            <Label Text="{Binding NombreCategoria}" FontAttributes="Bold" FontSize="13" TextColor="#263A35" MaxLines="2" />
                                            <Label Grid.Row="1" Text="{Binding TotalTexto}" FontSize="10" TextColor="#5E6B67" />
                                            <HorizontalStackLayout Grid.Row="2" Spacing="5">
                                                <Button
                                                    Text="Editar"
                                                    Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarCategoriaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                                    Style="{x:Null}"
                                                    FontSize="9"
                                                    Padding="7,3"
                                                    BackgroundColor="#EAF0FF"
                                                    TextColor="#2D5A9E" />
                                                <Button
                                                    Text="{Binding AccionEstadoTexto}"
                                                    Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoCategoriaCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                                    Style="{x:Null}"
                                                    FontSize="9"
                                                    Padding="7,3"
                                                    BackgroundColor="#FFF4E8"
                                                    TextColor="#9B552C" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding MostrarSeccionSubcategorias}"
                        Padding="12"
                        BackgroundColor="#F8FBF9"
                        Stroke="#C8DED6"
                        StrokeShape="RoundRectangle 15">
                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                                <VerticalStackLayout>
                                    <Label Text="Subcategorías" FontSize="18" FontAttributes="Bold" TextColor="#3B655B" />
                                    <Label Text="{Binding CategoriaSeleccionada.NombreCategoria, StringFormat='Dentro de {0}'}" FontSize="10" TextColor="#5E6B67" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Nueva"
                                    Command="{Binding CrearSubcategoriaCommand}"
                                    IsVisible="{Binding CanAdd}"
                                    Style="{x:Null}"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    Padding="10,6"
                                    CornerRadius="9" />
                                <Button
                                    Grid.Column="2"
                                    Text="Editar"
                                    Command="{Binding EditarSubcategoriaCommand}"
                                    IsEnabled="{Binding TieneSubcategoriaSeleccionada}"
                                    IsVisible="{Binding CanEdit}"
                                    Style="{x:Null}"
                                    BackgroundColor="#EAF0FF"
                                    TextColor="#2D5A9E"
                                    Padding="10,6"
                                    CornerRadius="9" />
                                <Button
                                    Grid.Column="3"
                                    Text="{Binding TextoCambiarEstadoSubcategoria}"
                                    Command="{Binding CambiarEstadoSubcategoriaCommand}"
                                    IsEnabled="{Binding TieneSubcategoriaSeleccionada}"
                                    IsVisible="{Binding CanDelete}"
                                    Style="{x:Null}"
                                    BackgroundColor="#FFF4E8"
                                    TextColor="#9B552C"
                                    Padding="10,6"
                                    CornerRadius="9" />
                            </Grid>
                            <CollectionView
                                ItemsSource="{Binding Subcategorias}"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                HeightRequest="84"
                                ItemSizingStrategy="MeasureFirstItem">
                                <CollectionView.Header>
                                    <Border
                                        WidthRequest="128"
                                        HeightRequest="74"
                                        Margin="0,0,8,0"
                                        Padding="10"
                                        BackgroundColor="{Binding FondoTodasSubcategorias}"
                                        Stroke="{Binding BordeTodasSubcategorias}"
                                        StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SeleccionarTodasSubcategoriasCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Todas" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{Binding TextoTodasSubcategorias}" />
                                    </Border>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            WidthRequest="210"
                                            HeightRequest="74"
                                            Margin="0,0,8,0"
                                            Padding="10"
                                            BackgroundColor="{Binding FondoSeleccion}"
                                            Stroke="{Binding BordeSeleccion}"
                                            StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.SeleccionarSubcategoriaCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding NombreSubcategoria}" FontAttributes="Bold" FontSize="12" TextColor="#263A35" MaxLines="2" />
                                                <Label Text="{Binding TotalTexto}" FontSize="9" TextColor="#5E6B67" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TituloGaleria}" FontFamily="MontserratBold" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                            <Label Text="Cada tarjeta muestra la ruta jerárquica completa de la ficha." FontSize="10" TextColor="#5E6B67" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding TotalRegistrosTexto}" VerticalOptions="Center" FontSize="11" TextColor="#5E6B67" />
                    </Grid>

                    <Border
                        IsVisible="{Binding SinRegistros}"
                        Padding="22"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 15">
                        <Label Text="No se encontraron fichas para los filtros seleccionados." HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#5E6B67" />
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="0"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 18">
                        <Grid RowDefinitions="{OnPlatform WinUI='175,Auto', Default='220,Auto'}">
                            <Grid>
                                <Image Source="{Binding FotoPortadaUrl}" Aspect="AspectFill" IsVisible="{Binding TieneFoto}" />
                                <Grid IsVisible="{Binding SinFoto}" BackgroundColor="#EEF5F2">
                                    <Label Text="Sin fotografía de portada" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#5E6B67" />
                                </Grid>
                                <Border Margin="10" Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" BackgroundColor="#E8FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                    <Label Text="{Binding TotalFotosTexto}" FontSize="10" FontAttributes="Bold" TextColor="#3B655B" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="7">
                                <Label Text="{Binding RutaJerarquica}" FontSize="11" FontAttributes="Bold" TextColor="#9B552C" />
                                <Label Text="{Binding Titulo}" FontFamily="MontserratBold" FontSize="17" FontAttributes="Bold" TextColor="#263A35" MaxLines="2" />
                                <Label Text="{Binding NombreCientifico}" IsVisible="{Binding TieneNombreCientifico}" FontAttributes="Italic" FontSize="12" TextColor="#3B655B" />
                                <Label Text="{Binding DescripcionCorta}" FontSize="11" TextColor="#5E6B67" MaxLines="3" />
                                <Button
                                    Text="Ver detalle"
                                    Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{x:Null}"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                    <Button
                                        Text="Editar"
                                        Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarRegistroCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                        Style="{x:Null}"
                                        BackgroundColor="#EAF0FF"
                                        TextColor="#2D5A9E"
                                        CornerRadius="9" />
                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding AccionEstadoTexto}"
                                        Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoRegistroCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                        Style="{x:Null}"
                                        BackgroundColor="#FFF4E8"
                                        TextColor="#9B552C"
                                        CornerRadius="9" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,12" Spacing="6">
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" Color="#9B552C" />
                    <BoxView HeightRequest="12" Color="Transparent" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </ContentView>
</ContentPage>
