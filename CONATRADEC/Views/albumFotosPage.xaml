<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumFotosPage"
    x:Name="AlbumPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentPage.Resources>
        <!--
            En Windows convierte únicamente las rutas físicas del álbum en
            StreamImageSource. Android y las URL remotas conservan su flujo.
        -->
        <converters:AlbumImageSourceConverter x:Key="AlbumImageSourceConverter" />
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid RowDefinitions="Auto,*">
            <!--
                Encabezado y búsqueda quedan fuera de la lista virtualizada.
                Los eventos originales se conservan sin cambios.
            -->
            <VerticalStackLayout
                Grid.Row="0"
                Margin="{OnIdiom Phone='12,12,12,10', Tablet='20,18,20,12', Desktop='28,22,28,14'}"
                Spacing="10">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                        RowSpacing="12"
                        ColumnSpacing="16">

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="4">
                            <Label
                                Text="Álbum botánico"
                                Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="Explore categorías, subcategorías y fotografías aprobadas para consulta técnica."
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>

                        <Grid
                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8"
                            HorizontalOptions="{OnIdiom Phone=Fill, Default=End}">
                            <Button
                                Grid.Column="0"
                                Text="Nueva categoría"
                                Command="{Binding AgregarCategoriaCommand}"
                                IsVisible="{Binding CanAdd}"
                                Style="{StaticResource ModernSecondaryButton}"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=150}" />
                            <Button
                                Grid.Column="1"
                                Text="Nueva subcategoría"
                                Command="{Binding AgregarRegistroCommand}"
                                IsVisible="{Binding CanAdd}"
                                Style="{StaticResource ModernPrimaryButton}"
                                MinimumWidthRequest="{OnIdiom Phone=0, Default=170}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernCard}" Padding="10">
                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="6"
                        ColumnSpacing="8">
                        <SearchBar
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{Binding TextoBusqueda}"
                            SearchButtonPressed="OnBuscarPresionado"
                            Placeholder="Buscar categoría, subcategoría o nombre científico"
                            Style="{StaticResource ModernSearchBar}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Limpiar"
                            Clicked="OnLimpiarBusquedaClicked"
                            Style="{StaticResource ModernNeutralButton}"
                            HeightRequest="46" />
                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            IsVisible="{Binding MostrarInactivos}"
                            Spacing="8">
                            <Switch
                                IsToggled="{Binding IncluirInactivos}"
                                Toggled="OnIncluirInactivosToggled"
                                Style="{StaticResource SwitchStyle}" />
                            <Label
                                Text="Mostrar elementos inactivos"
                                VerticalOptions="Center"
                                Style="{StaticResource ModernCaption}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <RefreshView
                Grid.Row="1"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    x:Name="AlbumCollectionView"
                    Margin="{OnIdiom Phone='12,0,12,20', Tablet='20,0,20,26', Desktop='28,0,28,30'}"
                    ItemsSource="{Binding Registros}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem"
                    RemainingItemsThreshold="2"
                    RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="14"
                            Margin="0,0,0,14">

                            <!-- Selector horizontal: se mantiene liviano y no interfiere con la virtualización vertical. -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="Categorías"
                                            Style="{StaticResource ModernSectionTitle}" />
                                        <Label
                                            Text="Deslice horizontalmente para explorar."
                                            Style="{StaticResource ModernCaption}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Categorias.Count, StringFormat='{}{0} categorías'}"
                                        VerticalOptions="Center"
                                        Style="{StaticResource ModernCaption}" />
                                </Grid>

                                <CollectionView
                                    ItemsSource="{Binding Categorias}"
                                    ItemsLayout="HorizontalList"
                                    SelectionMode="None"
                                    HeightRequest="132"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    HorizontalScrollBarVisibility="Never">
                                    <CollectionView.Header>
                                        <Border
                                            WidthRequest="142"
                                            HeightRequest="122"
                                            Margin="0,0,9,0"
                                            Padding="12"
                                            BackgroundColor="{Binding FondoTodas}"
                                            Stroke="{Binding BordeTodas}"
                                            StrokeShape="RoundRectangle 16">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SeleccionarTodasCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout
                                                VerticalOptions="Center"
                                                Spacing="5">
                                                <Label
                                                    Text="Todas"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    TextColor="{Binding TextoTodas}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="Galería completa"
                                                    FontSize="10"
                                                    TextColor="{Binding TextoTodas}"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </CollectionView.Header>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                WidthRequest="200"
                                                HeightRequest="122"
                                                Margin="0,0,9,0"
                                                Padding="11"
                                                BackgroundColor="{Binding FondoSeleccion}"
                                                Stroke="{Binding BordeSeleccion}"
                                                StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.SeleccionarCategoriaCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid
                                                    RowDefinitions="*,Auto,Auto"
                                                    RowSpacing="4">
                                                    <Label
                                                        Text="{Binding NombreCategoria}"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        TextColor="{StaticResource color_Negro}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Text="{Binding TotalRegistros, StringFormat='{}{0} subcategorías'}"
                                                        Style="{StaticResource ModernCaption}" />
                                                    <Grid
                                                        Grid.Row="2"
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="5">
                                                        <Button
                                                            Grid.Column="0"
                                                            Text="Editar"
                                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarCategoriaCommand}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                                            Style="{StaticResource ModernLinkButton}"
                                                            HeightRequest="34"
                                                            FontSize="9"
                                                            Padding="5,2" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="{Binding AccionEstadoTexto}"
                                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoCategoriaCommand}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                                            Style="{StaticResource ModernCoffeeButton}"
                                                            HeightRequest="34"
                                                            FontSize="9"
                                                            Padding="5,2" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <Border Style="{StaticResource ModernInfoBanner}">
                                <Label
                                    Text="Seleccione una categoría para concentrar la galería. Cada ficha conserva su información técnica y sus fotografías aprobadas."
                                    FontSize="11"
                                    TextColor="{StaticResource color_Verde}"
                                    LineBreakMode="WordWrap" />
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="{Binding TituloGaleria}"
                                        Style="{StaticResource ModernSectionTitle}" />
                                    <Label
                                        Text="Toque una ficha para consultar sus fotografías e información técnica."
                                        Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding TotalRegistrosTexto}"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ModernCaption}" />
                            </Grid>

                            <Border
                                IsVisible="{Binding SinRegistros}"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="560">
                                <VerticalStackLayout Spacing="8">
                                    <Image
                                        Source="iconalbum.png"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="No se encontraron subcategorías para los filtros seleccionados."
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                Padding="0">
                                <Grid RowDefinitions="{OnIdiom Phone='220,Auto', Tablet='190,Auto', Desktop='180,Auto'}">
                                    <Grid BackgroundColor="#EEF5F2">
                                        <Image
                                            Source="{Binding FotoPortadaUrl, Converter={StaticResource AlbumImageSourceConverter}}"
                                            Aspect="AspectFill"
                                            IsVisible="{Binding TieneFoto}" />
                                        <Grid
                                            IsVisible="{Binding SinFoto}"
                                            BackgroundColor="#EEF5F2">
                                            <VerticalStackLayout
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Spacing="6">
                                                <Image
                                                    Source="iconalbum.png"
                                                    WidthRequest="42"
                                                    HeightRequest="42" />
                                                <Label
                                                    Text="Sin fotografía de portada"
                                                    HorizontalTextAlignment="Center"
                                                    FontSize="11"
                                                    TextColor="{StaticResource color_GrisOscuro}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border
                                            Margin="10"
                                            Padding="8,4"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Style="{StaticResource ModernBadgeGreen}">
                                            <Label
                                                Text="{Binding TotalFotosTexto}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Verde}" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout
                                        Grid.Row="1"
                                        Padding="14"
                                        Spacing="7">
                                        <Label
                                            Text="{Binding Categoria}"
                                            FontSize="10.5"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource color_Cafe}" />
                                        <Label
                                            Text="{Binding Titulo}"
                                            FontFamily="MontserratBold"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding NombreCientifico}"
                                            IsVisible="{Binding TieneNombreCientifico}"
                                            FontAttributes="Italic"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding DescripcionCorta}"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            MaxLines="3"
                                            LineBreakMode="TailTruncation" />
                                        <Button
                                            Text="Ver detalle"
                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            HeightRequest="44" />
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="7">
                                            <Button
                                                Grid.Column="0"
                                                Text="Editar"
                                                Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarRegistroCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernUpdateButton}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="{Binding AccionEstadoTexto}"
                                                Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoRegistroCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                                Style="{StaticResource ModernCoffeeButton}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout
                            Padding="0,16"
                            Spacing="8">
                            <ActivityIndicator
                                IsRunning="{Binding IsLoadingMore}"
                                IsVisible="{Binding IsLoadingMore}"
                                Color="{StaticResource color_Verde}" />
                            <Button
                                Text="Cargar más"
                                Command="{Binding CargarMasCommand}"
                                IsVisible="{Binding TieneMas}"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalOptions="Center"
                                MinimumWidthRequest="180" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- Relay bloqueante para carga inicial, búsquedas y cambios de estado. -->
            <Grid
                Grid.RowSpan="2"
                ZIndex="100"
                BackgroundColor="#520B1511"
                IsVisible="{Binding IsBusy}"
                InputTransparent="False">
                <Border
                    Padding="22,18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="38"
                            HeightRequest="38" />
                        <Label
                            Text="Actualizando el álbum..."
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="Estamos preparando categorías y fotografías."
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource ModernCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
