<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.albumFotosPage"
    x:Name="AlbumPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentPage.Resources>
        <converters:AlbumImageSourceConverter x:Key="AlbumImageSourceConverter" />
    </ContentPage.Resources>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}"
                RefreshColor="{StaticResource color_Verde}">

                <CollectionView
                    x:Name="AlbumCollectionView"
                    ItemsSource="{Binding Registros}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="AlbumGrid"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout
                            x:Name="AlbumHeaderStack"
                            Spacing="14"
                            Margin="0,0,0,14">

                            <Border Style="{StaticResource ModernHeroCard}">
                                <Grid
                                    x:Name="HeroAlbumGrid"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="16"
                                    RowSpacing="12">
                                    <VerticalStackLayout
                                        x:Name="HeroAlbumTexto"
                                        Spacing="4">
                                        <Label
                                            Text="Álbum botánico"
                                            Style="{StaticResource ModernPageTitle}" />
                                        <Label
                                            Text="Explore categorías, subcategorías y fotografías aprobadas para consulta técnica."
                                            Style="{StaticResource ModernPageSubtitle}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        x:Name="HeroAlbumAcciones"
                                        Grid.Column="1"
                                        ColumnDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="8"
                                        RowSpacing="8">
                                        <Button
                                            x:Name="NuevaCategoriaButton"
                                            Text="Nueva categoría"
                                            Command="{Binding AgregarCategoriaCommand}"
                                            IsVisible="{Binding CanAdd}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0" />
                                        <Button
                                            x:Name="NuevaSubcategoriaButton"
                                            Grid.Column="1"
                                            Text="Nueva subcategoría"
                                            Command="{Binding AgregarRegistroCommand}"
                                            IsVisible="{Binding CanAdd}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            MinimumWidthRequest="0" />
                                        <Button
                                            x:Name="EliminadosButton"
                                            Grid.Column="2"
                                            Text="Elementos eliminados"
                                            Clicked="OnAbrirEliminadosClicked"
                                            IsVisible="{Binding MostrarEliminados}"
                                            Style="{StaticResource ModernNeutralButton}"
                                            MinimumWidthRequest="0" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ModernCard}" Padding="10">
                                <Grid
                                    x:Name="BusquedaAlbumGrid"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <SearchBar
                                        x:Name="BusquedaAlbum"
                                        Text="{Binding TextoBusqueda}"
                                        SearchButtonPressed="OnBuscarPresionado"
                                        Placeholder="Buscar categoría, subcategoría o nombre científico"
                                        Style="{StaticResource ModernSearchBar}" />
                                    <Button
                                        x:Name="LimpiarBusquedaButton"
                                        Grid.Column="1"
                                        Text="Limpiar"
                                        Clicked="OnLimpiarBusquedaClicked"
                                        Style="{StaticResource ModernNeutralButton}"
                                        HeightRequest="46"
                                        MinimumWidthRequest="0" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Categorías" Style="{StaticResource ModernSectionTitle}" />
                                        <Label Text="Deslice horizontalmente para explorar." Style="{StaticResource ModernCaption}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Categorias.Count, StringFormat='{}{0} categorías'}"
                                        VerticalOptions="Center"
                                        Style="{StaticResource ModernCaption}" />
                                </Grid>

                                <CollectionView
                                    ItemsSource="{Binding Categorias}"
                                    ItemsLayout="HorizontalList"
                                    SelectionMode="None"
                                    HeightRequest="132"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    HorizontalScrollBarVisibility="Never">
                                    <CollectionView.Header>
                                        <Border
                                            WidthRequest="142"
                                            HeightRequest="122"
                                            Margin="0,0,9,0"
                                            Padding="12"
                                            BackgroundColor="{Binding FondoTodas}"
                                            Stroke="{Binding BordeTodas}"
                                            StrokeShape="RoundRectangle 16">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SeleccionarTodasCommand}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                                                <Label
                                                    Text="Todas"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    TextColor="{Binding TextoTodas}"
                                                    HorizontalTextAlignment="Center" />
                                                <Label
                                                    Text="Galería completa"
                                                    FontSize="10"
                                                    TextColor="{Binding TextoTodas}"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </CollectionView.Header>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                WidthRequest="200"
                                                HeightRequest="122"
                                                Margin="0,0,9,0"
                                                Padding="11"
                                                BackgroundColor="{Binding FondoSeleccion}"
                                                Stroke="{Binding BordeSeleccion}"
                                                StrokeShape="RoundRectangle 16">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.SeleccionarCategoriaCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="4">
                                                    <Label
                                                        Text="{Binding NombreCategoria}"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Text="{Binding TotalRegistros, StringFormat='{}{0} subcategorías'}"
                                                        Style="{StaticResource ModernCaption}" />
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                        <Button
                                                            Text="Editar"
                                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarCategoriaCommand}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                                            Style="{StaticResource ModernLinkButton}"
                                                            HeightRequest="34"
                                                            FontSize="9"
                                                            Padding="5,2" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="Desactivar"
                                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoCategoriaCommand}"
                                                            CommandParameter="{Binding .}"
                                                            IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                                            Style="{StaticResource ModernCoffeeButton}"
                                                            HeightRequest="34"
                                                            FontSize="9"
                                                            Padding="5,2" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                IsVisible="{Binding MostrarSeccionSubcategorias}"
                                Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Subcategorías" Style="{StaticResource ModernSectionTitle}" />
                                        <Label Text="Filtre la galería dentro de la categoría seleccionada." Style="{StaticResource ModernCaption}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Subcategorias.Count, StringFormat='{}{0} disponibles'}"
                                        VerticalOptions="Center"
                                        Style="{StaticResource ModernCaption}" />
                                </Grid>

                                <CollectionView
                                    IsVisible="{Binding MostrarFiltroSubcategorias}"
                                    ItemsSource="{Binding Subcategorias}"
                                    ItemsLayout="HorizontalList"
                                    SelectionMode="None"
                                    HeightRequest="96"
                                    HorizontalScrollBarVisibility="Never">
                                    <CollectionView.Header>
                                        <Border
                                            WidthRequest="150"
                                            HeightRequest="86"
                                            Margin="0,0,9,0"
                                            Padding="10"
                                            BackgroundColor="{Binding FondoTodasSubcategorias}"
                                            Stroke="{Binding BordeTodasSubcategorias}"
                                            StrokeShape="RoundRectangle 14">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SeleccionarTodasSubcategoriasCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                Text="Todas"
                                                VerticalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{Binding TextoTodasSubcategorias}" />
                                        </Border>
                                    </CollectionView.Header>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                WidthRequest="210"
                                                HeightRequest="86"
                                                Margin="0,0,9,0"
                                                Padding="10"
                                                BackgroundColor="{Binding FondoSeleccion}"
                                                Stroke="{Binding BordeSeleccion}"
                                                StrokeShape="RoundRectangle 14">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.SeleccionarSubcategoriaCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid RowDefinitions="*,Auto">
                                                    <Label
                                                        Text="{Binding NombreSubcategoria}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Text="{Binding TotalTexto}"
                                                        Style="{StaticResource ModernCaption}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Grid
                                    IsVisible="{Binding PuedeEditarSubcategoria}"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8">
                                    <Button
                                        Text="Editar seleccionada"
                                        Command="{Binding EditarSubcategoriaCommand}"
                                        IsVisible="{Binding CanEdit}"
                                        Style="{StaticResource ModernUpdateButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Desactivar seleccionada"
                                        Command="{Binding CambiarEstadoSubcategoriaCommand}"
                                        IsVisible="{Binding CanDelete}"
                                        Style="{StaticResource ModernCoffeeButton}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Border Style="{StaticResource ModernInfoBanner}">
                                <Label
                                    Text="El listado activo se mantiene separado de los elementos eliminados. Las subcategorías desactivadas pueden reactivarse desde Elementos eliminados."
                                    FontSize="11"
                                    TextColor="{StaticResource color_Verde}"
                                    LineBreakMode="WordWrap" />
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding TituloGaleria}" Style="{StaticResource ModernSectionTitle}" />
                                    <Label Text="Toque una ficha para consultar sus fotografías e información técnica." Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding TotalRegistrosTexto}"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ModernCaption}" />
                            </Grid>

                            <Border
                                IsVisible="{Binding SinRegistros}"
                                Style="{StaticResource ModernEmptyStateCard}"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="560"
                                InputTransparent="True">
                                <VerticalStackLayout Spacing="8">
                                    <Image Source="iconalbum.png" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center" />
                                    <Label
                                        Text="No se encontraron subcategorías para los filtros seleccionados."
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCatalogCard}" Padding="0">
                                <Grid RowDefinitions="200,Auto">
                                    <Grid BackgroundColor="#EEF5F2">
                                        <Image
                                            Source="{Binding FotoPortadaUrl, Converter={StaticResource AlbumImageSourceConverter}}"
                                            Aspect="AspectFill"
                                            IsVisible="{Binding TieneFoto}" />
                                        <Grid IsVisible="{Binding SinFoto}" BackgroundColor="#EEF5F2">
                                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                                <Image Source="iconalbum.png" WidthRequest="42" HeightRequest="42" />
                                                <Label Text="Sin fotografía de portada" HorizontalTextAlignment="Center" FontSize="11" TextColor="{StaticResource color_GrisOscuro}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border
                                            Margin="10"
                                            Padding="8,4"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Style="{StaticResource ModernBadgeGreen}">
                                            <Label Text="{Binding TotalFotosTexto}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="7">
                                        <Label Text="{Binding Categoria}" FontSize="10.5" FontAttributes="Bold" TextColor="{StaticResource color_Cafe}" />
                                        <Label
                                            Text="{Binding Titulo}"
                                            FontFamily="MontserratBold"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding NombreCientifico}"
                                            IsVisible="{Binding TieneNombreCientifico}"
                                            FontAttributes="Italic"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding DescripcionCorta}"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            MaxLines="3"
                                            LineBreakMode="TailTruncation" />
                                        <Button
                                            Text="Ver detalle"
                                            Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            HeightRequest="44" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                            <Button
                                                Text="Editar"
                                                Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.EditarRegistroCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanEdit}"
                                                Style="{StaticResource ModernUpdateButton}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Desactivar"
                                                Command="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CambiarEstadoRegistroCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={x:Reference AlbumPageRoot}, Path=BindingContext.CanDelete}"
                                                Style="{StaticResource ModernCoffeeButton}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <Border
                            x:Name="PaginacionAlbum"
                            Margin="0,18,0,8"
                            Padding="12"
                            IsVisible="{Binding MostrarPaginacion}"
                            HorizontalOptions="Center"
                            Style="{StaticResource ModernCard}">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,*" RowSpacing="5" ColumnSpacing="10">
                                <Button
                                    Text="← Anterior"
                                    Clicked="OnPaginaAnteriorClicked"
                                    IsEnabled="{Binding PuedeIrAnterior}"
                                    Style="{StaticResource ModernNeutralButton}"
                                    MinimumWidthRequest="0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding PaginaTexto}" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                    <Label Text="{Binding RangoPaginaTexto}" HorizontalTextAlignment="Center" Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="2"
                                    Text="Siguiente →"
                                    Clicked="OnPaginaSiguienteClicked"
                                    IsEnabled="{Binding PuedeIrSiguiente}"
                                    Style="{StaticResource ModernNeutralButton}"
                                    MinimumWidthRequest="0" />
                            </Grid>
                        </Border>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <Grid
                ZIndex="100"
                BackgroundColor="#520B1511"
                IsVisible="{Binding IsBusy}"
                InputTransparent="False">
                <Border
                    Padding="22,18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="340"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" WidthRequest="38" HeightRequest="38" />
                        <Label
                            Text="Actualizando el álbum..."
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Estamos preparando categorías y fotografías." HorizontalTextAlignment="Center" Style="{StaticResource ModernCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
