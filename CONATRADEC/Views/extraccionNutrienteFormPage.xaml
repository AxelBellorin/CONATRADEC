<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.extraccionNutrienteFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <Grid
        Padding="{OnPlatform WinUI='28,24,28,30', Default='16,18,16,24'}">

        <ScrollView
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Spacing="18">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding Title}"
                            FontSize="{OnPlatform WinUI=30, Default=26}"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Label
                            Text="Configure la cantidad de nutriente extraída por cada quintal oro producido."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource color_Naranja}"
                        VerticalOptions="Center" />
                </Grid>

                <Border
                    Padding="{OnPlatform WinUI='22', Default='16'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="Información del parámetro"
                                FontSize="19"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Text="Cada elemento químico puede tener un único parámetro activo."
                                FontSize="12"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="CamposPrincipalesGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="14">

                            <VerticalStackLayout
                                x:Name="ElementoSection"
                                Grid.Row="0"
                                Spacing="6">

                                <Label
                                    Text="Elemento químico"
                                    FontSize="13"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}" />

                                <Border
                                    Padding="3"
                                    BackgroundColor="#FAFBFA"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorElemento}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Picker
                                        ItemsSource="{Binding Elementos}"
                                        SelectedItem="{Binding ElementoSeleccionado}"
                                        ItemDisplayBinding="{Binding Texto}"
                                        Title="Seleccione un elemento"
                                        IsEnabled="{Binding IsEditable}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource color_Negro}"
                                        TitleColor="{StaticResource color_GrisOscuro}" />
                                </Border>

                                <Label
                                    Text="{Binding ErrorElemento}"
                                    IsVisible="{Binding TieneErrorElemento}"
                                    FontSize="12"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="CantidadSection"
                                Grid.Row="1"
                                Spacing="6">

                                <Label
                                    Text="Cantidad extraída por quintal oro"
                                    FontSize="13"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}" />

                                <Border
                                    Padding="3"
                                    BackgroundColor="#FAFBFA"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorCantidad}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Text="{Binding CantidadTexto}"
                                        Placeholder="Ejemplo: 2.5"
                                        Keyboard="Numeric"
                                        MaxLength="12"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent" />
                                </Border>

                                <Label
                                    Text="Se conserva una precisión máxima de cuatro decimales porque este valor participa en el cálculo anual."
                                    FontSize="11"
                                    TextColor="{StaticResource color_GrisOscuro}" />

                                <Label
                                    Text="{Binding ErrorCantidad}"
                                    IsVisible="{Binding TieneErrorCantidad}"
                                    FontSize="12"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Descripción"
                                FontSize="13"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />

                            <Border
                                Padding="3"
                                BackgroundColor="#FAFBFA"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11">

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding TieneErrorDescripcion}"
                                        Value="True">
                                        <Setter
                                            Property="Stroke"
                                            Value="{StaticResource RedDelete}" />
                                        <Setter
                                            Property="StrokeThickness"
                                            Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Descripción del parámetro"
                                    MaxLength="150"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="120"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource color_Negro}" />
                            </Border>

                            <Label
                                Text="Máximo 150 caracteres."
                                FontSize="11"
                                TextColor="{StaticResource color_GrisOscuro}" />

                            <Label
                                Text="{Binding ErrorDescripcion}"
                                IsVisible="{Binding TieneErrorDescripcion}"
                                FontSize="12"
                                TextColor="{StaticResource RedDelete}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,2,0,16">

                    <Button
                        Grid.Column="0"
                        Text="Guardar"
                        Style="{StaticResource UpdateButton}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}" />

                    <Button
                        Grid.Column="1"
                        Text="Cancelar"
                        Style="{StaticResource CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsEditable}"
                        IsEnabled="{Binding NotIsBusy}" />

                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Regresar"
                        Style="{StaticResource CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
