<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.bitacoraDetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <ScrollView>
                <VerticalStackLayout
                    Padding="{OnIdiom Phone='12,12,12,24', Tablet='18,16,18,28', Desktop='24,20,24,32'}"
                    MaximumWidthRequest="1100"
                    HorizontalOptions="Center"
                    Spacing="14">

                    <controls:ResponsiveCatalogHeader
                        Title="Detalle de bitácora"
                        Subtitle="Información técnica, contexto de ejecución y cambios asociados a la operación seleccionada."
                        BackText="← Bitácora"
                        BackCommand="{Binding goToBack}"
                        IsPrimaryVisible="False" />

                    <VerticalStackLayout
                        Spacing="14"
                        IsVisible="{Binding TieneRegistro}">

                        <Border Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="13">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="{Binding Registro.Accion}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="{OnIdiom Phone=20, Tablet=22, Desktop=23}"
                                            TextColor="{StaticResource color_Verde}"
                                            LineBreakMode="WordWrap" />
                                        <Label
                                            Text="{Binding Registro.Modulo}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        Padding="10,5"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Start">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Registro.Exitoso}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5F5EA, Dark=#183A28}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Registro.Exitoso}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                                            Text="{Binding Registro.EstadoTexto}"
                                            FontFamily="MontserratBold"
                                            FontAttributes="Bold"
                                            FontSize="11">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Registro.Exitoso}" Value="True">
                                                    <Setter Property="TextColor" Value="#267A42" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Registro.Exitoso}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource RedDelete}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <Label
                                    Text="{Binding Registro.Descripcion}"
                                    FontFamily="MontserratMedium"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    LineBreakMode="WordWrap" />

                                <BoxView
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                    ColumnSpacing="14"
                                    RowSpacing="8">

                                    <Label Text="Fecha" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Column="1" Text="{Binding Registro.FechaHoraTexto}" Style="{StaticResource ModernCaption}" FontSize="12" />

                                    <Label Grid.Row="1" Text="Usuario" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Registro.UsuarioTexto}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="2" Text="Rol" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Registro.RolTexto}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="3" Text="Método" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Registro.MetodoHttp}" Style="{StaticResource ModernCaption}" FontSize="12" />

                                    <Label Grid.Row="4" Text="Endpoint" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Registro.Endpoint}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="5" Text="Pantalla" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Registro.PaginaOrigen}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="6" Text="Duración" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="6" Grid.Column="1" Text="{Binding Registro.DuracionTexto}" Style="{StaticResource ModernCaption}" FontSize="12" />

                                    <Label Grid.Row="7" Text="Dispositivo" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="7" Grid.Column="1" Text="{Binding Registro.Dispositivo}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="8" Text="Plataforma" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="8" Grid.Column="1" Text="{Binding Registro.Plataforma}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="9" Text="Versión app" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="9" Grid.Column="1" Text="{Binding Registro.VersionApp}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="10" Text="IP" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="10" Grid.Column="1" Text="{Binding Registro.DireccionIp}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="WordWrap" />

                                    <Label Grid.Row="11" Text="Correlación" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="11" Grid.Column="1" Text="{Binding Registro.CorrelationId}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="CharacterWrap" />

                                    <Label Grid.Row="12" Text="ID bitácora" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Grid.Row="12" Grid.Column="1" Text="{Binding Registro.BitacoraId}" Style="{StaticResource ModernCaption}" FontSize="12" LineBreakMode="CharacterWrap" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            IsVisible="{Binding Registro.TieneParametros}"
                            Style="{StaticResource ModernFormCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Parámetros de la solicitud"
                                    Style="{StaticResource ModernSectionTitle}"
                                    FontSize="17" />
                                <Border Style="{StaticResource ModernSoftPanel}">
                                    <Label
                                        Text="{Binding Registro.ParametrosFormateados}"
                                        FontFamily="MontserratMedium"
                                        FontSize="11.5"
                                        LineBreakMode="CharacterWrap"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            IsVisible="{Binding Registro.TieneError}"
                            Style="{StaticResource ModernDangerBanner}"
                            Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Error registrado"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    TextColor="{StaticResource RedDelete}" />
                                <Label
                                    Text="{Binding Registro.Error}"
                                    FontFamily="MontserratMedium"
                                    FontSize="11.5"
                                    LineBreakMode="CharacterWrap"
                                    TextColor="{AppThemeBinding Light=#7A1A15, Dark=#F2B8B5}" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="3" Margin="0,4,0,0">
                            <Label
                                Text="Cambios en base de datos"
                                Style="{StaticResource ModernSectionTitle}"
                                FontSize="20" />
                            <Label
                                Text="Valores registrados antes y después de la operación."
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>

                        <Border
                            IsVisible="{Binding Registro.SinCambios}"
                            Style="{StaticResource ModernInfoBanner}">
                            <Label
                                Text="Esta operación no modificó registros de la base de datos."
                                FontFamily="MontserratMedium"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </Border>

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Registro.Cambios}"
                            Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernCatalogCard}">
                                        <VerticalStackLayout Spacing="11">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label
                                                        Text="{Binding Entidad}"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        LineBreakMode="WordWrap" />
                                                    <Label
                                                        Text="{Binding EntidadId}"
                                                        Style="{StaticResource ModernCaption}"
                                                        LineBreakMode="CharacterWrap" />
                                                </VerticalStackLayout>

                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource ModernBadgeGreen}"
                                                    VerticalOptions="Start">
                                                    <Label
                                                        Text="{Binding Operacion}"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="10"
                                                        TextColor="{StaticResource color_Verde}" />
                                                </Border>
                                            </Grid>

                                            <Border
                                                IsVisible="{Binding TieneAnteriores}"
                                                Style="{StaticResource ModernSoftPanel}">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="Valores anteriores" Style="{StaticResource ModernFieldLabel}" />
                                                    <Label
                                                        Text="{Binding ValoresAnterioresFormateados}"
                                                        Style="{StaticResource ModernCaption}"
                                                        FontSize="11"
                                                        LineBreakMode="CharacterWrap" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                IsVisible="{Binding TieneNuevos}"
                                                Style="{StaticResource ModernSoftPanel}">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="Valores nuevos" Style="{StaticResource ModernFieldLabel}" />
                                                    <Label
                                                        Text="{Binding ValoresNuevosFormateados}"
                                                        Style="{StaticResource ModernCaption}"
                                                        FontSize="11"
                                                        LineBreakMode="CharacterWrap" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Propiedades afectadas" Style="{StaticResource ModernFieldLabel}" />
                                                <Label
                                                    Text="{Binding PropiedadesFormateadas}"
                                                    Style="{StaticResource ModernCaption}"
                                                    FontSize="11"
                                                    LineBreakMode="CharacterWrap" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsBusy}"
                BackgroundColor="#66000000"
                InputTransparent="False">
                <Border
                    Padding="20,16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Naranja}"
                            WidthRequest="24"
                            HeightRequest="24" />
                        <Label
                            Text="Cargando detalle..."
                            VerticalOptions="Center"
                            FontFamily="MontserratBold"
                            FontSize="11.5"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
