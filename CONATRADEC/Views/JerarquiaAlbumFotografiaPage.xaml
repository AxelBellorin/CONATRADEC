<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.JerarquiaAlbumFotografiaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10"
            BackgroundColor="White">
            <Button
                Text="← Cancelar"
                Command="{Binding CancelarCommand}"
                IsEnabled="{Binding NotIsBusy}"
                Style="{x:Null}"
                BackgroundColor="Transparent"
                TextColor="#3B655B"
                FontAttributes="Bold" />
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label
                    Text="Clasificación para el Álbum Botánico"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#263A35" />
                <Label
                    Text="{Binding EtapaTexto}"
                    FontSize="11"
                    TextColor="#5E6B67" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="{OnPlatform WinUI='26,22,26,34', Default='14,14,14,26'}"
                Spacing="14"
                MaximumWidthRequest="1040"
                HorizontalOptions="Center">

                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#D7E2DD"
                    StrokeShape="RoundRectangle 16">
                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='310,*', Default='*'}"
                        RowDefinitions="{OnPlatform WinUI='Auto', Default='Auto,Auto'}"
                        ColumnSpacing="16"
                        RowSpacing="12">
                        <Border
                            Grid.Column="0"
                            HeightRequest="{OnPlatform WinUI=300, Default=240}"
                            BackgroundColor="#EDF2F0"
                            Stroke="#D7E2DD"
                            StrokeShape="RoundRectangle 13">
                            <Image
                                Source="{Binding Fotografia.UrlImagen}"
                                Aspect="AspectFit" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="{OnPlatform WinUI=1, Default=0}"
                            Grid.Row="{OnPlatform WinUI=0, Default=1}"
                            Spacing="7">
                            <Label
                                Text="{Binding Fotografia.Titulo}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.DiagnosticoVisible, StringFormat='Diagnóstico IA: {0}'}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#3B655B" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.NombreCientificoSugerido, StringFormat='Nombre científico sugerido: {0}'}"
                                FontAttributes="Italic"
                                TextColor="#4F5D59" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.ResumenImagen}"
                                TextColor="#4F5D59" />
                            <Border
                                Padding="10"
                                BackgroundColor="#FFF8E5"
                                Stroke="#E4C45D"
                                StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding TieneJerarquiaActual}">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Clasificación registrada" FontAttributes="Bold" TextColor="#6B5710" />
                                    <Label Text="{Binding JerarquiaActual.Categoria, StringFormat='Categoría: {0}'}" TextColor="#6B5710" />
                                    <Label Text="{Binding JerarquiaActual.Subcategoria, StringFormat='Subcategoría: {0}'}" TextColor="#6B5710" />
                                    <Label Text="{Binding JerarquiaActual.Ficha, StringFormat='Ficha: {0}'}" TextColor="#6B5710" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#D7E2DD"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="1. Categoría fitosanitaria"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Ejemplos: Enfermedades, Plagas, Alteraciones nutricionales o Plantas sanas."
                                FontSize="11"
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding ProponerCategoria}" Color="#3B655B" />
                            <Label Text="No existe una categoría adecuada; proponer una nueva" VerticalOptions="Center" TextColor="#374A44" />
                        </HorizontalStackLayout>

                        <Border
                            Padding="11,2"
                            BackgroundColor="#F7F9F8"
                            Stroke="#D4E0DB"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding UsarCategoriaExistente}">
                            <Picker
                                ItemsSource="{Binding Categorias}"
                                SelectedItem="{Binding CategoriaSeleccionada}"
                                ItemDisplayBinding="{Binding NombreCategoria}"
                                Title="Seleccione una categoría"
                                TextColor="#263A35" />
                        </Border>

                        <Border
                            Padding="12,3"
                            BackgroundColor="#FFF9ED"
                            Stroke="#E9CF9B"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding ProponerCategoria}">
                            <Entry
                                Text="{Binding CategoriaPropuesta}"
                                MaxLength="100"
                                Placeholder="Nombre de la categoría propuesta"
                                TextColor="#263A35" />
                        </Border>

                        <BoxView HeightRequest="1" Color="#E5ECE9" />

                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="2. Subcategoría"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Describe el tipo dentro de la categoría. Ejemplos: Insectos, Enfermedades fúngicas o Deficiencias de micronutrientes."
                                FontSize="11"
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding ProponerSubcategoria}" Color="#3B655B" />
                            <Label Text="No existe una subcategoría adecuada; proponer una nueva" VerticalOptions="Center" TextColor="#374A44" />
                        </HorizontalStackLayout>

                        <Border
                            Padding="11,2"
                            BackgroundColor="#F7F9F8"
                            Stroke="#D4E0DB"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding UsarSubcategoriaExistente}">
                            <Picker
                                ItemsSource="{Binding Subcategorias}"
                                SelectedItem="{Binding SubcategoriaSeleccionada}"
                                ItemDisplayBinding="{Binding NombreSubcategoria}"
                                Title="Seleccione una subcategoría"
                                TextColor="#263A35" />
                        </Border>

                        <Border
                            Padding="12,3"
                            BackgroundColor="#FFF9ED"
                            Stroke="#E9CF9B"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding ProponerSubcategoria}">
                            <Entry
                                Text="{Binding SubcategoriaPropuesta}"
                                MaxLength="120"
                                Placeholder="Nombre de la subcategoría propuesta"
                                TextColor="#263A35" />
                        </Border>

                        <BoxView HeightRequest="1" Color="#E5ECE9" />

                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="3. Ficha o diagnóstico específico"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Es el hallazgo concreto, por ejemplo Minador de la hoja o Mancha de hierro."
                                FontSize="11"
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding ProponerFicha}" Color="#3B655B" />
                            <Label Text="No existe una ficha adecuada; proponer una nueva" VerticalOptions="Center" TextColor="#374A44" />
                        </HorizontalStackLayout>

                        <Border
                            Padding="11,2"
                            BackgroundColor="#F7F9F8"
                            Stroke="#D4E0DB"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding UsarFichaExistente}">
                            <Picker
                                ItemsSource="{Binding Fichas}"
                                SelectedItem="{Binding FichaSeleccionada}"
                                ItemDisplayBinding="{Binding Titulo}"
                                Title="Seleccione una ficha"
                                TextColor="#263A35" />
                        </Border>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding ProponerFicha}">
                            <Border Padding="12,3" BackgroundColor="#FFF9ED" Stroke="#E9CF9B" StrokeShape="RoundRectangle 11">
                                <Entry Text="{Binding FichaPropuesta}" MaxLength="200" Placeholder="Nombre común o diagnóstico específico" TextColor="#263A35" />
                            </Border>
                            <Border Padding="12,3" BackgroundColor="#F7F9F8" Stroke="#D4E0DB" StrokeShape="RoundRectangle 11">
                                <Entry Text="{Binding NombreCientifico}" MaxLength="200" Placeholder="Nombre científico (opcional)" TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding RequiereDescripcionCreacion}">
                            <Label Text="Descripción de la nueva ficha *" FontAttributes="Bold" TextColor="#263A35" />
                            <Border Padding="10" BackgroundColor="#F7F9F8" Stroke="#D4E0DB" StrokeShape="RoundRectangle 11">
                                <Editor Text="{Binding Descripcion}" MinimumHeightRequest="100" AutoSize="TextChanges" Placeholder="Descripción general para crear la ficha oficial." TextColor="#263A35" />
                            </Border>
                            <Label Text="Síntomas visibles" FontAttributes="Bold" TextColor="#263A35" />
                            <Border Padding="10" BackgroundColor="#F7F9F8" Stroke="#D4E0DB" StrokeShape="RoundRectangle 11">
                                <Editor Text="{Binding Sintomas}" MinimumHeightRequest="80" AutoSize="TextChanges" Placeholder="Síntomas que caracterizan la ficha." TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Justificación técnica *" FontAttributes="Bold" TextColor="#263A35" />
                            <Border Padding="10" BackgroundColor="#F7F9F8" Stroke="#D4E0DB" StrokeShape="RoundRectangle 11">
                                <Editor
                                    Text="{Binding Motivo}"
                                    MinimumHeightRequest="100"
                                    AutoSize="TextChanges"
                                    MaxLength="1200"
                                    Placeholder="Explique por qué esta categoría, subcategoría y ficha representan la fotografía."
                                    TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="12"
                    BackgroundColor="#EEF5F2"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        Text="{Binding AyudaEtapa}"
                        TextColor="#365A50" />
                </Border>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#9B552C" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{x:Null}"
                        HeightRequest="50"
                        CornerRadius="12"
                        BackgroundColor="#ECEFED"
                        TextColor="#374A44" />
                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoGuardar}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{x:Null}"
                        HeightRequest="50"
                        CornerRadius="12"
                        BackgroundColor="#3B655B"
                        TextColor="White"
                        FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
