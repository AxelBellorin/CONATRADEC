<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.JerarquiaAlbumFotografiaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10"
            BackgroundColor="White">
            <Button
                Text="← Cancelar"
                Command="{Binding CancelarCommand}"
                IsEnabled="{Binding NotIsBusy}"
                Style="{x:Null}"
                BackgroundColor="Transparent"
                TextColor="#3B655B"
                FontAttributes="Bold" />
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label
                    Text="Clasificación para el Álbum Botánico"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#263A35" />
                <Label
                    Text="{Binding EtapaTexto}"
                    FontSize="11"
                    TextColor="#5E6B67" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="{OnPlatform WinUI='26,22,26,34', Default='14,14,14,26'}"
                Spacing="14"
                MaximumWidthRequest="1040"
                HorizontalOptions="Center">

                <Border
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="#D7E2DD"
                    StrokeShape="RoundRectangle 16">
                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='310,*', Default='*'}"
                        RowDefinitions="{OnPlatform WinUI='Auto', Default='Auto,Auto'}"
                        ColumnSpacing="16"
                        RowSpacing="12">
                        <Border
                            Grid.Column="0"
                            HeightRequest="{OnPlatform WinUI=300, Default=240}"
                            BackgroundColor="#EDF2F0"
                            Stroke="#D7E2DD"
                            StrokeShape="RoundRectangle 13">
                            <Grid>
                                <Image
                                    Source="{Binding Fotografia.UrlImagen}"
                                    Aspect="AspectFit">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImagenTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Border
                                    Padding="8,4"
                                    Margin="8"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    BackgroundColor="#CC263A35"
                                    StrokeThickness="0"
                                    InputTransparent="True"
                                    StrokeShape="RoundRectangle 9">
                                    <Label
                                        Text="🔍 Ampliar"
                                        FontSize="11"
                                        TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="{OnPlatform WinUI=1, Default=0}"
                            Grid.Row="{OnPlatform WinUI=0, Default=1}"
                            Spacing="7">
                            <Label
                                Text="{Binding Fotografia.Titulo}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.DiagnosticoVisible, StringFormat='Diagnóstico IA: {0}'}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#3B655B" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.NombreCientificoSugerido, StringFormat='Nombre científico sugerido: {0}'}"
                                FontAttributes="Italic"
                                TextColor="#4F5D59" />
                            <Label
                                Text="{Binding Fotografia.ResultadoIA.ResumenImagen}"
                                TextColor="#4F5D59"
                                LineBreakMode="WordWrap" />

                            <Border
                                Padding="10"
                                BackgroundColor="#FFF8E5"
                                Stroke="#E4C45D"
                                StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding TieneJerarquiaActual}">
                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Clasificación registrada"
                                        FontAttributes="Bold"
                                        TextColor="#6B5710" />
                                    <Label
                                        Text="{Binding JerarquiaActual.Categoria, StringFormat='Categoría: {0}'}"
                                        TextColor="#6B5710" />
                                    <Label
                                        Text="{Binding JerarquiaActual.Ficha, StringFormat='Subcategoría: {0}'}"
                                        TextColor="#6B5710" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#D7E2DD"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="1. Categoría"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="La categoría siempre se selecciona del catálogo oficial. No se permite escribirla libremente desde una inspección."
                                FontSize="11"
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>

                        <Border
                            Padding="11,2"
                            BackgroundColor="#F7F9F8"
                            Stroke="#D4E0DB"
                            StrokeShape="RoundRectangle 11">
                            <Picker
                                ItemsSource="{Binding Categorias}"
                                SelectedItem="{Binding CategoriaSeleccionada}"
                                ItemDisplayBinding="{Binding NombreCategoria}"
                                Title="Seleccione una categoría"
                                TextColor="#263A35" />
                        </Border>

                        <Border
                            Padding="10"
                            BackgroundColor="#EEF5F2"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                Text="Si la categoría necesaria no existe, debe crearse desde la administración del Álbum Botánico antes de continuar."
                                FontSize="11"
                                TextColor="#365A50" />
                        </Border>

                        <BoxView HeightRequest="1" Color="#E5ECE9" />

                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="2. Subcategoría específica"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Label
                                Text="Busque primero en el catálogo para evitar duplicados. Solo proponga una nueva cuando realmente no exista."
                                FontSize="11"
                                TextColor="#5E6B67" />
                        </VerticalStackLayout>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            IsVisible="{Binding UsarSubcategoriaExistente}">
                            <Border
                                Grid.Column="0"
                                Padding="10,2"
                                BackgroundColor="#F7F9F8"
                                Stroke="#D4E0DB"
                                StrokeShape="RoundRectangle 11">
                                <SearchBar
                                    Text="{Binding BuscarSubcategoria}"
                                    Placeholder="Buscar por nombre común o científico"
                                    TextColor="#263A35"
                                    PlaceholderColor="#82908B"
                                    BackgroundColor="Transparent" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Text="Limpiar"
                                Command="{Binding LimpiarBusquedaCommand}"
                                HeightRequest="46"
                                CornerRadius="10"
                                BackgroundColor="#EEF2F0"
                                TextColor="#374A44" />
                        </Grid>

                        <Border
                            Padding="6"
                            BackgroundColor="#FBFCFB"
                            Stroke="#D4E0DB"
                            StrokeShape="RoundRectangle 11"
                            IsVisible="{Binding UsarSubcategoriaExistente}">
                            <CollectionView
                                ItemsSource="{Binding SubcategoriasEspecificas}"
                                SelectedItem="{Binding SubcategoriaSeleccionada}"
                                SelectionMode="Single"
                                MaximumHeightRequest="280">
                                <CollectionView.EmptyView>
                                    <Label
                                        Padding="12"
                                        Text="No se encontraron subcategorías con ese criterio."
                                        HorizontalTextAlignment="Center"
                                        TextColor="#6A7773" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AlbumRegistroJerarquiaResponse">
                                        <Border
                                            Margin="3"
                                            Padding="12,9"
                                            BackgroundColor="White"
                                            Stroke="#E0E8E5"
                                            StrokeShape="RoundRectangle 9">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding Titulo}"
                                                    FontAttributes="Bold"
                                                    TextColor="#263A35" />
                                                <Label
                                                    Text="{Binding NombreCientifico}"
                                                    FontSize="11"
                                                    FontAttributes="Italic"
                                                    TextColor="#5E6B67" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <Button
                            Text="{Binding TextoAlternarPropuesta}"
                            Command="{Binding AlternarPropuestaCommand}"
                            HeightRequest="46"
                            CornerRadius="11"
                            HorizontalOptions="Start"
                            BackgroundColor="#FFF4EA"
                            TextColor="#8A4D27" />

                        <VerticalStackLayout
                            Spacing="8"
                            IsVisible="{Binding ProponerSubcategoria}">
                            <Border
                                Padding="12"
                                BackgroundColor="#FFF8E5"
                                Stroke="#E4C45D"
                                StrokeShape="RoundRectangle 11">
                                <Label
                                    Text="La nueva subcategoría quedará como propuesta. El sistema buscará coincidencias antes de guardarla para evitar duplicados accidentales."
                                    FontSize="11"
                                    TextColor="#6B5710" />
                            </Border>
                            <Border
                                Padding="12,3"
                                BackgroundColor="#FFF9ED"
                                Stroke="#E9CF9B"
                                StrokeShape="RoundRectangle 11">
                                <Entry
                                    Text="{Binding SubcategoriaPropuesta}"
                                    MaxLength="200"
                                    Placeholder="Nombre de la nueva subcategoría"
                                    TextColor="#263A35" />
                            </Border>
                            <Border
                                Padding="12,3"
                                BackgroundColor="#F7F9F8"
                                Stroke="#D4E0DB"
                                StrokeShape="RoundRectangle 11">
                                <Entry
                                    Text="{Binding NombreCientifico}"
                                    MaxLength="200"
                                    Placeholder="Nombre científico (opcional)"
                                    TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Spacing="6"
                            IsVisible="{Binding RequiereDescripcionCreacion}">
                            <Label
                                Text="Descripción de la nueva subcategoría *"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Border
                                Padding="10"
                                BackgroundColor="#F7F9F8"
                                Stroke="#D4E0DB"
                                StrokeShape="RoundRectangle 11">
                                <Editor
                                    Text="{Binding Descripcion}"
                                    MinimumHeightRequest="100"
                                    AutoSize="TextChanges"
                                    Placeholder="Descripción general para crear la subcategoría oficial."
                                    TextColor="#263A35" />
                            </Border>
                            <Label
                                Text="Síntomas visibles"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Border
                                Padding="10"
                                BackgroundColor="#F7F9F8"
                                Stroke="#D4E0DB"
                                StrokeShape="RoundRectangle 11">
                                <Editor
                                    Text="{Binding Sintomas}"
                                    MinimumHeightRequest="80"
                                    AutoSize="TextChanges"
                                    Placeholder="Síntomas que caracterizan la subcategoría."
                                    TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Justificación técnica *"
                                FontAttributes="Bold"
                                TextColor="#263A35" />
                            <Border
                                Padding="10"
                                BackgroundColor="#F7F9F8"
                                Stroke="#D4E0DB"
                                StrokeShape="RoundRectangle 11">
                                <Editor
                                    Text="{Binding Motivo}"
                                    MinimumHeightRequest="90"
                                    AutoSize="TextChanges"
                                    MaxLength="1200"
                                    Placeholder="Explique por qué esta clasificación representa la fotografía."
                                    TextColor="#263A35" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="12"
                    BackgroundColor="#EEF5F2"
                    Stroke="#C8DED6"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        Text="{Binding AyudaEtapa}"
                        TextColor="#365A50" />
                </Border>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#9B552C" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{x:Null}"
                        HeightRequest="50"
                        CornerRadius="12"
                        BackgroundColor="#ECEFED"
                        TextColor="#374A44" />
                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoGuardar}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding NotIsBusy}"
                        Style="{x:Null}"
                        HeightRequest="50"
                        CornerRadius="12"
                        BackgroundColor="#3B655B"
                        TextColor="White"
                        FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
