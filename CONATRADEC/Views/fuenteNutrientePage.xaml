<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.fuenteNutrientePage"
    x:Name="FuenteNutrientePageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <!-- Acceso denegado -->
            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">
                <Border Style="{StaticResource ModernAccessDeniedCard}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image
                            Source="iconpermission.png"
                            WidthRequest="62"
                            HeightRequest="62"
                            Opacity="0.68" />
                        <Label
                            Text="Sin permiso de lectura"
                            Style="{StaticResource ModernSectionTitle}"
                            FontSize="20"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Su usuario no tiene permiso para consultar las fuentes de nutrientes."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="Regresar a configuración"
                            Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding RegresarConfiguracionCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid
                x:Name="ContenidoFuentes"
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='12,12,12,18', Tablet='18,16,18,22', Desktop='24,20,24,26'}">

                <RefreshView
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">
                    <CollectionView
                        x:Name="FuentesCollectionView"
                        ItemsSource="{Binding List}"
                        SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="FuentesGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <!--
                            Encabezado, búsqueda, clasificación, mensajes y estado
                            vacío forman parte del desplazamiento natural. No se usa
                            CollectionView.EmptyView para evitar que WinUI sustituya
                            los controles interactivos cuando la página queda vacía.
                        -->
                        <CollectionView.Header>
                            <VerticalStackLayout Padding="0,0,0,14" Spacing="12">

                                <controls:ResponsiveCatalogHeader
                                    Title="Fuentes de nutrientes"
                                    Subtitle="Administre fuentes para balance, fertilización mixta y enmienda calcárea."
                                    BackText="← Configuración"
                                    BackCommand="{Binding RegresarConfiguracionCommand}"
                                    PrimaryText="+ Nueva fuente"
                                    PrimaryCommand="{Binding AddCommand}"
                                    IsPrimaryVisible="{Binding CanAdd}" />

                                <Border Style="{StaticResource ModernCard}" Padding="8">
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <SearchBar
                                            Placeholder="Buscar por nombre o descripción"
                                            Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                            SearchCommand="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernSearchBar}" />
                                    </Border>
                                </Border>

                                <Border Style="{StaticResource ModernCard}" Padding="14">
                                    <VerticalStackLayout Spacing="11">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Buscar y clasificar" Style="{StaticResource ModernSectionTitle}" />
                                            <Label
                                                Text="Filtre por nombre, descripción o tipo de fuente. Los cambios se aplican al presionar Buscar."
                                                Style="{StaticResource ModernCaption}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Clasificación" Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Picker
                                                    Style="{StaticResource ModernPicker}"
                                                    Title="Seleccione una clasificación"
                                                    ItemsSource="{Binding FiltrosCategoria}"
                                                    ItemDisplayBinding="{Binding Nombre}"
                                                    SelectedItem="{Binding FiltroCategoriaSeleccionada}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <Grid
                                            x:Name="FuenteFiltroAccionesGrid"
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="10"
                                            RowSpacing="8">
                                            <Label
                                                x:Name="ResumenFuentesLabel"
                                                Text="{Binding ResumenResultados}"
                                                Style="{StaticResource ModernPageSubtitle}"
                                                VerticalOptions="Center" />
                                            <Button
                                                x:Name="BuscarFuentesButton"
                                                Grid.Column="1"
                                                Text="Buscar"
                                                Style="{StaticResource ModernPrimaryButton}"
                                                HeightRequest="44"
                                                Command="{Binding BuscarCommand}" />
                                            <Button
                                                x:Name="LimpiarFuentesButton"
                                                Grid.Column="2"
                                                Text="Limpiar"
                                                Style="{StaticResource ModernNeutralButton}"
                                                Command="{Binding LimpiarFiltrosCommand}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- La matriz se carga únicamente cuando el usuario la solicita. -->
                                <Border
                                    IsVisible="{Binding MostrarSeccionTablaComposicion}"
                                    Style="{StaticResource ModernCard}"
                                    Padding="14">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Matriz de composición" Style="{StaticResource ModernSectionTitle}" />
                                                <Label
                                                    Text="Se carga bajo demanda usando únicamente los filtros ya aplicados al listado."
                                                    Style="{StaticResource ModernCaption}" />
                                            </VerticalStackLayout>
                                            <Button
                                                Grid.Column="1"
                                                Text="{Binding TextoBotonTablaComposicion}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Command="{Binding ToggleTablaComposicionCommand}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <HorizontalStackLayout
                                            IsVisible="{Binding CargandoComposicion}"
                                            Spacing="9"
                                            HorizontalOptions="Center">
                                            <ActivityIndicator
                                                IsRunning="{Binding CargandoComposicion}"
                                                Color="{StaticResource color_Verde}"
                                                WidthRequest="22"
                                                HeightRequest="22" />
                                            <Label
                                                Text="Cargando composición..."
                                                Style="{StaticResource ModernPageSubtitle}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border
                                            IsVisible="{Binding TieneMensajeComposicion}"
                                            Style="{StaticResource ModernWarningBanner}">
                                            <Label
                                                Text="{Binding MensajeComposicion}"
                                                Style="{StaticResource ModernPageSubtitle}" />
                                        </Border>

                                        <Label
                                            Text="No hay fuentes con aportes químicos para los filtros aplicados."
                                            IsVisible="{Binding MostrarMensajeTablaVacia}"
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />

                                        <!--
                                            La matriz necesita desplazamiento propio en ambos ejes.
                                            Su altura máxima se ajusta desde code-behind según el
                                            tamaño real de la ventana para no bloquear el scroll
                                            natural del listado padre.
                                        -->
                                        <ScrollView
                                            x:Name="MatrizComposicionScrollView"
                                            Orientation="Both"
                                            IsVisible="{Binding MostrarTablaConDatos}"
                                            HorizontalScrollBarVisibility="Default"
                                            VerticalScrollBarVisibility="Default">
                                            <VerticalStackLayout Spacing="0">
                                                <HorizontalStackLayout Spacing="0">
                                                    <Border
                                                        WidthRequest="230"
                                                        Padding="9"
                                                        BackgroundColor="{StaticResource color_Verde}"
                                                        StrokeThickness="0">
                                                        <Label
                                                            Text="Fuente"
                                                            FontFamily="MontserratBold"
                                                            FontAttributes="Bold"
                                                            FontSize="12"
                                                            TextColor="White" />
                                                    </Border>
                                                    <HorizontalStackLayout
                                                        BindableLayout.ItemsSource="{Binding ElementosTabla}"
                                                        Spacing="0">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    WidthRequest="76"
                                                                    Padding="9"
                                                                    BackgroundColor="{StaticResource color_Verde}"
                                                                    Stroke="#5F8178"
                                                                    StrokeThickness="0.5">
                                                                    <Label
                                                                        Text="{Binding .}"
                                                                        FontFamily="MontserratBold"
                                                                        FontAttributes="Bold"
                                                                        FontSize="11"
                                                                        TextColor="White"
                                                                        HorizontalTextAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </HorizontalStackLayout>

                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TablaComposicion}" Spacing="0">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <HorizontalStackLayout Spacing="0">
                                                                <Border
                                                                    WidthRequest="230"
                                                                    Padding="9"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                                                                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                                                    StrokeThickness="0.5">
                                                                    <Label
                                                                        Text="{Binding Fuente}"
                                                                        FontFamily="MontserratMedium"
                                                                        FontSize="11"
                                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                                        LineBreakMode="TailTruncation" />
                                                                </Border>
                                                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Celdas}" Spacing="0">
                                                                    <BindableLayout.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                WidthRequest="76"
                                                                                Padding="9"
                                                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                                                                                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                                                                StrokeThickness="0.5">
                                                                                <Label
                                                                                    Text="{Binding Texto}"
                                                                                    FontFamily="MontserratMedium"
                                                                                    FontSize="11"
                                                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                                                    HorizontalTextAlignment="Center" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </BindableLayout.ItemTemplate>
                                                                </HorizontalStackLayout>
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </ScrollView>
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    IsVisible="{Binding TieneMensaje}"
                                    Style="{StaticResource ModernWarningBanner}">
                                    <Label Text="{Binding Mensaje}" Style="{StaticResource ModernPageSubtitle}" />
                                </Border>

                                <Border
                                    IsVisible="{Binding MostrarVacio}"
                                    Style="{StaticResource ModernEmptyStateCard}"
                                    Margin="0,6,0,0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start"
                                    MaximumWidthRequest="560">
                                    <VerticalStackLayout Spacing="9" HorizontalOptions="Center">
                                        <Border Style="{StaticResource ModernIconTile}">
                                            <Label
                                                Text="FN"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                TextColor="{StaticResource color_Verde}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            Text="No se encontraron fuentes"
                                            Style="{StaticResource ModernSectionTitle}"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Cambie los filtros o registre una nueva fuente de nutriente."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FuenteNutrienteResponse">
                                <Border
                                    Style="{StaticResource ModernCatalogCard}"
                                    MinimumHeightRequest="216">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                            <Border
                                                Style="{StaticResource ModernIconTile}"
                                                WidthRequest="52"
                                                HeightRequest="52">
                                                <Label
                                                    Text="FN"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding NombreNutriente}"
                                                    Style="{StaticResource ModernSectionTitle}"
                                                    FontSize="15"
                                                    LineBreakMode="TailTruncation" />
                                                <Label
                                                    Text="{Binding CategoriaFuenteMostrar}"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="10.5"
                                                    TextColor="{StaticResource color_Verde}" />
                                                <Label
                                                    Text="{Binding DescripcionNutriente}"
                                                    Style="{StaticResource ModernCaption}"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                VerticalOptions="Start">
                                                <Label
                                                    Text="Activo"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="10"
                                                    TextColor="{StaticResource color_Verde}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border Style="{StaticResource ModernMetricSurface}">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="PRECIO / QQ" Style="{StaticResource ModernCaption}" FontSize="9.5" />
                                                    <Label
                                                        Text="{Binding PrecioMostrar}"
                                                        FontFamily="MontserratBold"
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        TextColor="{StaticResource color_Cafe}"
                                                        HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource ModernMetricSurface}">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="APORTES" Style="{StaticResource ModernCaption}" FontSize="9.5" />
                                                    <Label
                                                        Text="{Binding AportesMostrar}"
                                                        FontFamily="MontserratMedium"
                                                        FontSize="10.5"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation"
                                                        HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="7">
                                            <Button
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Command="{Binding Source={x:Reference FuenteNutrientePageRoot}, Path=BindingContext.ViewCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                IsVisible="{Binding Source={x:Reference FuenteNutrientePageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference FuenteNutrientePageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                IsVisible="{Binding Source={x:Reference FuenteNutrientePageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference FuenteNutrientePageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Border
                                x:Name="PaginacionFuentes"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="14,13"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">
                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    ZIndex="100"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="False"
                    BackgroundColor="#28000000">
                    <Border
                        Padding="18,14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource color_Verde}"
                                WidthRequest="24"
                                HeightRequest="24" />
                            <Label
                                Text="Cargando fuentes de nutrientes..."
                                VerticalOptions="Center"
                                FontFamily="MontserratBold"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
