<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIASolicitudPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F8F7">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="{Binding TituloPagina}"
                Subtitle="{Binding SubtituloPagina}"
                BackText="← Inspección fitosanitaria"
                BackCommand="{Binding RegresarCommand}"
                IsPrimaryVisible="False" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="14"
                    MaximumWidthRequest="1150"
                    HorizontalOptions="Center">

                    <Border
                        Padding="16"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding TieneMensajeEstado}">
                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="#9B552C" />
                            <Label
                                Text="{Binding MensajeEstado}"
                                VerticalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout
                        Spacing="14"
                        IsVisible="{Binding EsModoNueva}">

                        <Border
                            Padding="18"
                            BackgroundColor="White"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 15">
                            <VerticalStackLayout Spacing="12">
                                <Label
                                    Text="Datos de campo"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#263A35" />

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">
                                    <Entry
                                        Grid.Column="0"
                                        Text="{Binding CodigoTerreno}"
                                        Placeholder="Código de terreno opcional"
                                        IsReadOnly="{Binding TieneTerrenoSeleccionado}" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Buscar terreno"
                                        Command="{Binding BuscarTerrenoCommand}"
                                        BackgroundColor="#E3EFEA"
                                        TextColor="#3B655B" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    IsVisible="{Binding TieneTerrenoSeleccionado}">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding TerrenoSeleccionadoTexto}"
                                        TextColor="#3B655B"
                                        VerticalTextAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Quitar"
                                        Command="{Binding QuitarTerrenoCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#B42318" />
                                </Grid>

                                <Editor
                                    Text="{Binding Observacion}"
                                    Placeholder="Observación general del recorrido o síntomas reportados"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="90"
                                    MaxLength="1000" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Padding="18"
                            BackgroundColor="White"
                            Stroke="#C8DED6"
                            StrokeShape="RoundRectangle 15">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label
                                            Text="Fotografías"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="#263A35" />
                                        <Label
                                            Text="{Binding ResumenFotos}"
                                            TextColor="#5E6B67" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Text="Galería"
                                        Command="{Binding AgregarFotoCommand}"
                                        BackgroundColor="#3B655B"
                                        TextColor="White" />
                                    <Button
                                        Grid.Column="2"
                                        Text="Cámara"
                                        Command="{Binding TomarFotoCommand}"
                                        BackgroundColor="#9B552C"
                                        TextColor="White" />
                                </Grid>

                                <Label
                                    Text="La fecha de identificación en campo se guarda por fotografía y no se reemplaza por la fecha de carga o análisis."
                                    TextColor="#6B5710"
                                    FontSize="13" />

                                <CollectionView
                                    ItemsSource="{Binding Fotos}"
                                    SelectionMode="None"
                                    EmptyView="Agregue fotografías para continuar.">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout
                                            Orientation="Vertical"
                                            ItemSpacing="10" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:InspeccionFotoLocal">
                                            <Border
                                                Padding="12"
                                                BackgroundColor="#FAFCFB"
                                                Stroke="#D9E3DF"
                                                StrokeShape="RoundRectangle 12">
                                                <Grid
                                                    ColumnDefinitions="100,*"
                                                    RowDefinitions="Auto,Auto,Auto"
                                                    ColumnSpacing="12"
                                                    RowSpacing="8">
                                                    <Image
                                                        Grid.RowSpan="3"
                                                        Source="{Binding Miniatura}"
                                                        HeightRequest="100"
                                                        WidthRequest="100"
                                                        Aspect="AspectFill" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding NombreArchivo}"
                                                        FontAttributes="Bold"
                                                        TextColor="#263A35"
                                                        LineBreakMode="TailTruncation" />

                                                    <Grid
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="8">
                                                        <Picker
                                                            Grid.Column="0"
                                                            Title="Tipo de foto"
                                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TiposFotografia}"
                                                            SelectedItem="{Binding TipoFotografia}" />
                                                        <DatePicker
                                                            Grid.Column="1"
                                                            Date="{Binding FechaIdentificacionCampo}" />
                                                    </Grid>

                                                    <Button
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Text="Quitar fotografía"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.QuitarFotoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        HorizontalOptions="End"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#B42318" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Button
                                    Text="Guardar inspección"
                                    Command="{Binding GuardarCommand}"
                                    BackgroundColor="#3B655B"
                                    TextColor="White"
                                    CornerRadius="11"
                                    HeightRequest="48" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="12"
                        IsVisible="{Binding EsModoListado}">
                        <Button
                            Text="Actualizar"
                            Command="{Binding ActualizarCommand}"
                            HorizontalOptions="End"
                            BackgroundColor="#E3EFEA"
                            TextColor="#3B655B" />

                        <CollectionView
                            ItemsSource="{Binding Solicitudes}"
                            SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Vertical"
                                    ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:InspeccionFitosanitariaListaItemV2">
                                    <Border
                                        Padding="14"
                                        BackgroundColor="White"
                                        Stroke="#D9E3DF"
                                        StrokeShape="RoundRectangle 14">
                                        <Grid
                                            ColumnDefinitions="82,*,Auto"
                                            RowDefinitions="Auto,Auto,Auto"
                                            ColumnSpacing="12"
                                            RowSpacing="4">
                                            <Image
                                                Grid.RowSpan="3"
                                                Source="{Binding UrlMiniatura}"
                                                HeightRequest="76"
                                                WidthRequest="76"
                                                Aspect="AspectFill" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding TerrenoTexto}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                TextColor="#263A35" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding Resumen}"
                                                TextColor="#5E6B67" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding FechaTexto}"
                                                FontSize="12"
                                                TextColor="#7A8581" />
                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Grid.RowSpan="3"
                                                Spacing="6">
                                                <Label
                                                    Text="{Binding Estado}"
                                                    TextColor="#9B552C"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center" />
                                                <Button
                                                    Text="Abrir"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirResultadoCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#3B655B"
                                                    TextColor="White" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border
                            Padding="18"
                            BackgroundColor="#FFF9E8"
                            Stroke="#E2B93B"
                            StrokeShape="RoundRectangle 14"
                            IsVisible="{Binding SinSolicitudes}">
                            <Label
                                Text="No se encontraron inspecciones para esta bandeja."
                                HorizontalTextAlignment="Center"
                                TextColor="#6B5710" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
