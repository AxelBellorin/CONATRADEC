<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.rangoNutrienteCategoriaFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <Grid
        Padding="{OnIdiom Phone='14,16,14,22', Tablet='22,20,22,26', Desktop='28,24,28,30'}">

        <ScrollView
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Spacing="18">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="{Binding Title}"
                            FontSize="{OnIdiom Phone=25, Tablet=28, Desktop=30}"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Label
                            Text="Este formulario administra el mismo catálogo de tipos de cultivo utilizado por el sistema."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource color_Naranja}"
                        VerticalOptions="Center" />
                </Grid>

                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Información del cultivo"
                                FontSize="19"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Text="El cultivo se utilizará para agrupar sus rangos nutricionales."
                                FontSize="12"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Nombre del tipo de cultivo"
                                FontSize="13"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />

                            <Border
                                Padding="3"
                                BackgroundColor="#FAFBFA"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11">

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding TieneErrorNombre}"
                                        Value="True">

                                        <Setter
                                            Property="Stroke"
                                            Value="{StaticResource RedDelete}" />

                                        <Setter
                                            Property="StrokeThickness"
                                            Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Entry
                                    Text="{Binding Nombre}"
                                    Placeholder="Ejemplo: CAFÉ"
                                    MaxLength="80"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="Transparent" />
                            </Border>

                            <Label
                                Text="{Binding ErrorNombre}"
                                IsVisible="{Binding TieneErrorNombre}"
                                FontSize="12"
                                TextColor="{StaticResource RedDelete}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Descripción"
                                FontSize="13"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Negro}" />

                            <Border
                                Padding="3"
                                BackgroundColor="#FAFBFA"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11">

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding TieneErrorDescripcion}"
                                        Value="True">

                                        <Setter
                                            Property="Stroke"
                                            Value="{StaticResource RedDelete}" />

                                        <Setter
                                            Property="StrokeThickness"
                                            Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Descripción del tipo de cultivo"
                                    MaxLength="150"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="120"
                                    IsReadOnly="{Binding IsReadOnly}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource color_Negro}" />
                            </Border>

                            <Label
                                Text="Máximo 150 caracteres."
                                FontSize="11"
                                TextColor="{StaticResource color_GrisOscuro}" />

                            <Label
                                Text="{Binding ErrorDescripcion}"
                                IsVisible="{Binding TieneErrorDescripcion}"
                                FontSize="12"
                                TextColor="{StaticResource RedDelete}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,2,0,16">

                    <Button
                        Grid.Column="0"
                        Text="Guardar"
                        Style="{StaticResource UpdateButton}"
                        Command="{Binding SaveCommand}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}" />

                    <Button
                        Grid.Column="1"
                        Text="Cancelar"
                        Style="{StaticResource CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsEditable}"
                        IsEnabled="{Binding NotIsBusy}" />

                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Regresar"
                        Style="{StaticResource CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
