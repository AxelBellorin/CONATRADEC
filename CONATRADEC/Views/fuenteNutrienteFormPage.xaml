<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.fuenteNutrienteFormPage"
    x:Name="FuenteNutrienteFormPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <ScrollView
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Padding="{OnIdiom Phone='14,14,14,24', Tablet='22,18,22,28', Desktop='28,22,28,32'}"
                Spacing="14">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                        <Border
                            Style="{StaticResource ModernIconTile}"
                            WidthRequest="52"
                            HeightRequest="52"
                            VerticalOptions="Start">
                            <Image
                                Source="iconfuentenutriente.png"
                                WidthRequest="28"
                                HeightRequest="28"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="Configure la información general, la clasificación y los aportes químicos de la fuente."
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Información general -->
                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información general" Style="{StaticResource ModernSectionTitle}" />
                            <Label Text="Nombre, precio por quintal y descripción comercial." Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="DatosBasicosGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="13">

                            <VerticalStackLayout x:Name="NombreSection" Grid.Row="0" Spacing="6">
                                <Label Text="Nombre de la fuente" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorNombre}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Style="{StaticResource ModernEntry}"
                                        Placeholder="Ejemplo: UREA 46%"
                                        Text="{Binding NombreNutriente}"
                                        MaxLength="100"
                                        IsReadOnly="{Binding IsReadOnly}" />
                                </Border>
                                <Label
                                    Text="{Binding ErrorNombre}"
                                    IsVisible="{Binding TieneErrorNombre}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="PrecioSection" Grid.Row="1" Spacing="6">
                                <Label Text="Precio por quintal" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TieneErrorPrecio}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Entry
                                        Style="{StaticResource ModernEntry}"
                                        Placeholder="Ejemplo: 1945.94"
                                        Text="{Binding PrecioNutrienteTexto}"
                                        Keyboard="Numeric"
                                        MaxLength="13"
                                        IsReadOnly="{Binding IsReadOnly}" />
                                </Border>
                                <Label Text="Ingrese el precio correspondiente a un quintal." Style="{StaticResource ModernCaption}" />
                                <Label
                                    Text="{Binding ErrorPrecio}"
                                    IsVisible="{Binding TieneErrorPrecio}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="DescripcionSection" Grid.Row="2" Spacing="6">
                                <Label Text="Descripción" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}" MinimumHeightRequest="112" Padding="10,7">
                                    <Editor
                                        Placeholder="Descripción de la fuente de nutriente"
                                        Text="{Binding DescripcionNutriente}"
                                        MaxLength="250"
                                        MinimumHeightRequest="96"
                                        AutoSize="TextChanges"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                        FontFamily="MontserratMedium"
                                        FontSize="13" />
                                </Border>
                                <Label Text="Máximo 250 caracteres." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Clasificación -->
                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Clasificación de la fuente" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Seleccione el cálculo en el que se utilizará esta fuente."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Clasificación" Style="{StaticResource ModernFieldLabel}" />
                            <Border
                                Style="{StaticResource ModernInputBorder}"
                                Padding="10,2"
                                MinimumHeightRequest="{OnIdiom Phone=52, Tablet=56, Desktop=62}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TieneErrorCategoria}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource RedDelete}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Picker
                                    Style="{StaticResource ModernPicker}"
                                    Title="Seleccione clasificación"
                                    ItemsSource="{Binding CategoriasFuente}"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    SelectedItem="{Binding CategoriaSeleccionada}"
                                    IsEnabled="{Binding IsFormEnabled}"
                                    HeightRequest="{OnIdiom Phone=50, Tablet=54, Desktop=60}"
                                    MinimumHeightRequest="{OnIdiom Phone=50, Tablet=54, Desktop=60}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Text="{Binding ErrorCategoria}"
                                IsVisible="{Binding TieneErrorCategoria}"
                                FontSize="11"
                                TextColor="{StaticResource RedDelete}" />
                        </VerticalStackLayout>

                        <Border
                            IsVisible="{Binding MostrarDatosEnmiendaCalcarea}"
                            Style="{StaticResource ModernInfoBanner}"
                            Padding="{OnIdiom Phone=13, Tablet=16, Desktop=17}">
                            <VerticalStackLayout Spacing="13">
                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="Datos para enmienda calcárea"
                                        FontFamily="MontserratBold"
                                        FontSize="15"
                                        TextColor="{StaticResource color_Verde}" />
                                    <Label
                                        Text="Ingrese el PRNT y la descripción del parámetro de la fuente encalante."
                                        Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>

                                <Grid
                                    ColumnDefinitions="{OnIdiom Phone='*', Tablet='1*,2*', Desktop='1*,2*'}"
                                    RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                                    ColumnSpacing="13"
                                    RowSpacing="12">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="PRNT" Style="{StaticResource ModernFieldLabel}" />
                                        <Border Style="{StaticResource ModernInputBorder}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}">
                                            <Entry
                                                Style="{StaticResource ModernEntry}"
                                                Placeholder="Ejemplo: 80.00"
                                                Text="{Binding PrntEnmiendaCalcareaTexto}"
                                                Keyboard="Numeric"
                                                MaxLength="7"
                                                IsReadOnly="{Binding IsReadOnly}" />
                                        </Border>
                                        <Label
                                            Text="{Binding ErrorPrntEnmiendaCalcarea}"
                                            IsVisible="{Binding TieneErrorPrntEnmiendaCalcarea}"
                                            FontSize="11"
                                            TextColor="{StaticResource RedDelete}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                        Spacing="6">
                                        <Label Text="Descripción del parámetro" Style="{StaticResource ModernFieldLabel}" />
                                        <Border
                                            Style="{StaticResource ModernInputBorder}"
                                            MinimumHeightRequest="92"
                                            Padding="10,7"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}">
                                            <Editor
                                                Placeholder="Descripción del material encalante"
                                                Text="{Binding DescripcionParametroEnmiendaCalcarea}"
                                                MaxLength="200"
                                                MinimumHeightRequest="76"
                                                AutoSize="TextChanges"
                                                IsReadOnly="{Binding IsReadOnly}"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                                FontFamily="MontserratMedium"
                                                FontSize="13" />
                                        </Border>
                                        <Label
                                            Text="{Binding ErrorDescripcionParametroEnmiendaCalcarea}"
                                            IsVisible="{Binding TieneErrorDescripcionParametroEnmiendaCalcarea}"
                                            FontSize="11"
                                            TextColor="{StaticResource RedDelete}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Aportes químicos -->
                <Border
                    IsVisible="{Binding MostrarAportesElementosQuimicos}"
                    Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding TituloSeccionAportes}" Style="{StaticResource ModernSectionTitle}" />
                                <Label Text="{Binding DescripcionSeccionAportes}" Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="+ Agregar"
                                Command="{Binding AddAporteCommand}"
                                IsVisible="{Binding MostrarBotonAgregarAporte}"
                                Style="{StaticResource ModernSecondaryButton}"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="{Binding ErrorAportes}"
                            IsVisible="{Binding TieneErrorAportes}"
                            FontSize="11"
                            TextColor="{StaticResource RedDelete}" />

                        <!--
                            La lista de elementos químicos es pequeña y forma parte
                            natural del formulario. BindableLayout evita anidar un
                            CollectionView dentro del ScrollView principal.
                        -->
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Aportes}"
                            Spacing="9">
                            <BindableLayout.EmptyView>
                                <Border Style="{StaticResource ModernSoftPanel}">
                                    <Label
                                        Text="No hay aportes agregados."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </Border>
                            </BindableLayout.EmptyView>

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernSoftPanel}" Padding="12">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto"
                                            ColumnSpacing="10"
                                            RowSpacing="10">

                                            <VerticalStackLayout Spacing="5">
                                                <Label Text="Elemento químico" Style="{StaticResource ModernFieldLabel}" />
                                                <Border
                                                    Style="{StaticResource ModernInputBorder}"
                                                    Padding="10,2"
                                                    MinimumHeightRequest="{OnIdiom Phone=52, Tablet=56, Desktop=62}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}">
                                                    <Picker
                                                        Style="{StaticResource ModernPicker}"
                                                        Title="Seleccione un elemento"
                                                        ItemsSource="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.ElementosQuimicos}"
                                                        ItemDisplayBinding="{Binding NombreElementoQuimico}"
                                                        SelectedItem="{Binding ElementoSeleccionado}"
                                                        IsEnabled="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.IsFormEnabled}"
                                                        HeightRequest="{OnIdiom Phone=50, Tablet=54, Desktop=60}"
                                                        MinimumHeightRequest="{OnIdiom Phone=50, Tablet=54, Desktop=60}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Column="1"
                                                Text="Quitar"
                                                Style="{StaticResource ModernDangerSoftButton}"
                                                VerticalOptions="End"
                                                IsVisible="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.MostrarBotonAgregarAporte}"
                                                Command="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.RemoveAporteCommand}"
                                                CommandParameter="{Binding .}" />

                                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5">
                                                <Label Text="Porcentaje de aporte" Style="{StaticResource ModernFieldLabel}" />
                                                <Border
                                                    Style="{StaticResource ModernInputBorder}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}">
                                                    <Entry
                                                        Style="{StaticResource ModernEntry}"
                                                        Placeholder="Ejemplo: 46.00"
                                                        Text="{Binding CantidadAporteTexto}"
                                                        Keyboard="Numeric"
                                                        MaxLength="6"
                                                        IsReadOnly="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.IsReadOnly}" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="9"
                    Margin="0,2,0,12">
                    <Button
                        Text="Guardar"
                        Style="{StaticResource ModernPrimaryButton}"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding SaveCommand}" />
                    <Button
                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Text="Cancelar"
                        Style="{StaticResource ModernNeutralButton}"
                        IsVisible="{Binding IsFormEnabled}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}" />
                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                        Text="Regresar"
                        Style="{StaticResource ModernNeutralButton}"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Relay de carga: solo se anima mientras IsBusy sea verdadero. -->
        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#28000000">
            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="24"
                        HeightRequest="24" />
                    <Label
                        Text="Procesando fuente de nutriente..."
                        VerticalOptions="Center"
                        FontFamily="MontserratBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
