<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.fuenteNutrienteFormPage"
    x:Name="FuenteNutrienteFormPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <Grid
        Padding="{OnIdiom Phone='14,16,14,22', Tablet='22,20,22,26', Desktop='28,24,28,30'}">

        <ScrollView
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never">

            <!--
                El ancho se calcula con el tamaño real de la ventana.
                Esto evita el formulario angosto que deja grandes
                espacios laterales en Windows.
            -->
            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1100"
                HorizontalOptions="Center"
                Spacing="18">

                <!-- Encabezado -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="{Binding Title}"
                            FontSize="{OnIdiom Phone=25, Tablet=28, Desktop=30}"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}" />

                        <Label
                            Text="Configure la información general y la clasificación de la fuente."
                            FontSize="13"
                            TextColor="{StaticResource color_GrisOscuro}"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource color_Naranja}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Datos básicos -->
                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="17">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Información general"
                                FontSize="19"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Text="Nombre, descripción y precio por quintal."
                                FontSize="12"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>

                        <Grid
                            x:Name="DatosBasicosGrid"
                            ColumnDefinitions="*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="14">

                            <!-- Nombre -->
                            <VerticalStackLayout
                                x:Name="NombreSection"
                                Grid.Row="0"
                                Spacing="6">

                                <Label
                                    Text="Nombre de la fuente"
                                    FontSize="13"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}" />

                                <Border
                                    Padding="3"
                                    BackgroundColor="#FAFBFA"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorNombre}"
                                            Value="True">

                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />

                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Placeholder="Ejemplo: UREA 46%"
                                        Text="{Binding NombreNutriente}"
                                        MaxLength="100"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent" />
                                </Border>

                                <Label
                                    Text="{Binding ErrorNombre}"
                                    IsVisible="{Binding TieneErrorNombre}"
                                    FontSize="12"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <!-- Precio -->
                            <VerticalStackLayout
                                x:Name="PrecioSection"
                                Grid.Row="1"
                                Spacing="6">

                                <Label
                                    Text="Precio por quintal"
                                    FontSize="13"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}" />

                                <Border
                                    Padding="3"
                                    BackgroundColor="#FAFBFA"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorPrecio}"
                                            Value="True">

                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />

                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Placeholder="Ejemplo: 1945.94"
                                        Text="{Binding PrecioNutrienteTexto}"
                                        Keyboard="Numeric"
                                        MaxLength="13"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent" />
                                </Border>

                                <Label
                                    Text="Ingrese el precio correspondiente a un quintal."
                                    FontSize="11"
                                    TextColor="{StaticResource color_GrisOscuro}" />

                                <Label
                                    Text="{Binding ErrorPrecio}"
                                    IsVisible="{Binding TieneErrorPrecio}"
                                    FontSize="12"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <!-- Descripción -->
                            <VerticalStackLayout
                                x:Name="DescripcionSection"
                                Grid.Row="2"
                                Spacing="6">

                                <Label
                                    Text="Descripción"
                                    FontSize="13"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}" />

                                <Border
                                    Padding="3"
                                    BackgroundColor="#FAFBFA"
                                    Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 11">

                                    <Editor
                                        Placeholder="Descripción de la fuente de nutriente"
                                        Text="{Binding DescripcionNutriente}"
                                        MaxLength="250"
                                        MinimumHeightRequest="105"
                                        AutoSize="TextChanges"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource color_Negro}" />
                                </Border>

                                <Label
                                    Text="Máximo 250 caracteres."
                                    FontSize="11"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Clasificación -->
                <Border
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Clasificación de la fuente"
                                FontSize="19"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Text="Seleccione el cálculo en el que se utilizará esta fuente."
                                FontSize="12"
                                TextColor="{StaticResource color_GrisOscuro}" />
                        </VerticalStackLayout>

                        <Border
                            Padding="3"
                            BackgroundColor="#FAFBFA"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11">

                            <Border.Triggers>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding TieneErrorCategoria}"
                                    Value="True">

                                    <Setter
                                        Property="Stroke"
                                        Value="{StaticResource RedDelete}" />

                                    <Setter
                                        Property="StrokeThickness"
                                        Value="2" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Picker
                                Title="Seleccione clasificación"
                                ItemsSource="{Binding CategoriasFuente}"
                                ItemDisplayBinding="{Binding Nombre}"
                                SelectedItem="{Binding CategoriaSeleccionada}"
                                IsEnabled="{Binding IsFormEnabled}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource color_Negro}"
                                TitleColor="{StaticResource color_GrisOscuro}" />
                        </Border>

                        <Label
                            Text="{Binding ErrorCategoria}"
                            IsVisible="{Binding TieneErrorCategoria}"
                            FontSize="12"
                            TextColor="{StaticResource RedDelete}" />

                        <!-- Datos de enmienda -->
                        <Border
                            IsVisible="{Binding MostrarDatosEnmiendaCalcarea}"
                            Padding="16"
                            BackgroundColor="#EEF5F2"
                            Stroke="{StaticResource color_Verde}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <VerticalStackLayout Spacing="13">

                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="Datos para enmienda calcárea"
                                        FontSize="16"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Verde}" />

                                    <Label
                                        Text="Ingrese el PRNT y la descripción del parámetro de la fuente encalante."
                                        FontSize="11"
                                        TextColor="{StaticResource color_GrisOscuro}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">

                                    <Label
                                        Text="PRNT"
                                        FontSize="13"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}" />

                                    <Border
                                        Padding="3"
                                        BackgroundColor="White"
                                        Stroke="#D1D5DB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 11">

                                        <Entry
                                            Placeholder="Ejemplo: 80.00"
                                            Text="{Binding PrntEnmiendaCalcareaTexto}"
                                            Keyboard="Numeric"
                                            MaxLength="7"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            BackgroundColor="Transparent" />
                                    </Border>

                                    <Label
                                        Text="{Binding ErrorPrntEnmiendaCalcarea}"
                                        IsVisible="{Binding TieneErrorPrntEnmiendaCalcarea}"
                                        FontSize="12"
                                        TextColor="{StaticResource RedDelete}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">

                                    <Label
                                        Text="Descripción del parámetro"
                                        FontSize="13"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}" />

                                    <Border
                                        Padding="3"
                                        BackgroundColor="White"
                                        Stroke="#D1D5DB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 11">

                                        <Editor
                                            Placeholder="Descripción del material encalante"
                                            Text="{Binding DescripcionParametroEnmiendaCalcarea}"
                                            MaxLength="200"
                                            MinimumHeightRequest="85"
                                            AutoSize="TextChanges"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource color_Negro}" />
                                    </Border>

                                    <Label
                                        Text="{Binding ErrorDescripcionParametroEnmiendaCalcarea}"
                                        IsVisible="{Binding TieneErrorDescripcionParametroEnmiendaCalcarea}"
                                        FontSize="12"
                                        TextColor="{StaticResource RedDelete}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Aportes -->
                <Border
                    IsVisible="{Binding MostrarAportesElementosQuimicos}"
                    Padding="{OnIdiom Phone='14', Tablet='19', Desktop='22'}"
                    BackgroundColor="White"
                    Stroke="#DDE7E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="14">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="{Binding TituloSeccionAportes}"
                                    FontSize="19"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Verde}" />

                                <Label
                                    Text="{Binding DescripcionSeccionAportes}"
                                    FontSize="12"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="+ Agregar"
                                Padding="14,9"
                                Command="{Binding AddAporteCommand}"
                                IsVisible="{Binding MostrarBotonAgregarAporte}"
                                BackgroundColor="#EEF5F2"
                                TextColor="{StaticResource color_Verde}"
                                CornerRadius="10"
                                VerticalOptions="Center" />
                        </Grid>

                        <Label
                            Text="{Binding ErrorAportes}"
                            IsVisible="{Binding TieneErrorAportes}"
                            FontSize="12"
                            TextColor="{StaticResource RedDelete}" />

                        <!--
                            La cantidad de elementos químicos es pequeña.
                            BindableLayout evita un CollectionView anidado
                            dentro del ScrollView principal.
                        -->
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Aportes}"
                            Spacing="10">

                            <BindableLayout.EmptyView>
                                <Label
                                    Text="No hay aportes agregados."
                                    Padding="10"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </BindableLayout.EmptyView>

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        Padding="12"
                                        BackgroundColor="#FAFBFA"
                                        Stroke="#DDE7E3"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12">

                                        <Grid
                                            RowDefinitions="Auto,Auto"
                                            ColumnDefinitions="*,Auto"
                                            RowSpacing="10"
                                            ColumnSpacing="10">

                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="5">

                                                <Label
                                                    Text="Elemento químico"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}" />

                                                <Picker
                                                    Title="Seleccione un elemento"
                                                    ItemsSource="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.ElementosQuimicos}"
                                                    ItemDisplayBinding="{Binding NombreElementoQuimico}"
                                                    SelectedItem="{Binding ElementoSeleccionado}"
                                                    IsEnabled="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.IsFormEnabled}"
                                                    BackgroundColor="White" />
                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="Quitar"
                                                Padding="10,8"
                                                VerticalOptions="End"
                                                IsVisible="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.MostrarBotonAgregarAporte}"
                                                Command="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.RemoveAporteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FDECEC"
                                                TextColor="{StaticResource RedDelete}"
                                                CornerRadius="9" />

                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Spacing="5">

                                                <Label
                                                    Text="Porcentaje de aporte"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}" />

                                                <Border
                                                    Padding="3"
                                                    BackgroundColor="White"
                                                    Stroke="#D1D5DB"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 10">

                                                    <Entry
                                                        Placeholder="Ejemplo: 46.00"
                                                        Text="{Binding CantidadAporteTexto}"
                                                        Keyboard="Numeric"
                                                        MaxLength="6"
                                                        IsReadOnly="{Binding Source={x:Reference FuenteNutrienteFormPageRoot}, Path=BindingContext.IsReadOnly}"
                                                        BackgroundColor="Transparent" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Acciones -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,2,0,16">

                    <Button
                        Grid.Column="0"
                        Text="Guardar"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource UpdateButton}" />

                    <Button
                        Grid.Column="1"
                        Text="Cancelar"
                        IsVisible="{Binding IsFormEnabled}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CancelButton}" />

                    <Button
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Regresar"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CancelButton}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
