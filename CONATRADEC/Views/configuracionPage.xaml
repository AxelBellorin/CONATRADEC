<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.configuracionPage"
    x:Name="ConfiguracionPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,12,14,18', Tablet='18,16,18,22', Desktop='26,22,26,30'}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{OnIdiom Phone=10, Tablet=12, Desktop=14}">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="3">

                <Label
                    Text="Configuración"
                    FontSize="{OnIdiom Phone=25, Tablet=28, Desktop=30}"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    TextColor="{StaticResource color_Verde}" />

                <Label
                    Text="Acceda a los catálogos y herramientas habilitados para su usuario."
                    FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=13}"
                    TextColor="{StaticResource color_GrisOscuro}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border
                Grid.Row="1"
                Padding="3"
                BackgroundColor="White"
                Stroke="#DDE7E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 13">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">

                    <SearchBar
                        Grid.Column="0"
                        Placeholder="Buscar una opción de configuración"
                        Text="{Binding TextoBusqueda, Mode=TwoWay}"
                        BackgroundColor="Transparent"
                        CancelButtonColor="{StaticResource color_Verde}" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ResumenOpciones}"
                        Margin="0,0,12,0"
                        VerticalOptions="Center"
                        FontSize="11"
                        TextColor="{StaticResource color_GrisOscuro}"
                        IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}" />
                </Grid>
            </Border>

            <!--
                Un único CollectionView agrupado y virtualizado.
                Se crea exactamente una tarjeta por opción.
            -->
            <CollectionView
                x:Name="OpcionesCollection"
                Grid.Row="2"
                ItemsSource="{Binding GruposVisibles}"
                IsGrouped="True"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem"
                ItemsUpdatingScrollMode="KeepScrollOffset">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        x:Name="OpcionesGridLayout"
                        Orientation="Vertical"
                        Span="1"
                        HorizontalItemSpacing="12"
                        VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Grid Padding="24">

                        <Border
                            IsVisible="{Binding MostrarSinOpciones}"
                            MaximumWidthRequest="620"
                            Padding="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Image
                                    Source="iconsettings.png"
                                    WidthRequest="54"
                                    HeightRequest="54"
                                    Opacity="0.5" />

                                <Label
                                    Text="No hay opciones disponibles"
                                    FontSize="18"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="No hay coincidencias o su usuario no tiene permisos de lectura."
                                    FontSize="12"
                                    TextColor="{StaticResource color_GrisOscuro}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:ConfiguracionGrupoVisual">

                        <Grid
                            Padding="{OnIdiom Phone='0,16,0,7', Tablet='0,18,0,8', Desktop='0,20,0,9'}"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="2">

                            <Label
                                Grid.Row="0"
                                Text="{Binding Titulo}"
                                FontSize="{OnIdiom Phone=17, Tablet=18, Desktop=19}"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Descripcion}"
                                FontSize="11"
                                TextColor="{StaticResource color_GrisOscuro}"
                                LineBreakMode="WordWrap"
                                MaxLines="2" />

                            <BoxView
                                Grid.Row="2"
                                Margin="0,7,0,0"
                                HeightRequest="1"
                                BackgroundColor="#E4ECE8" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConfiguracionOpcion">

                        <Border
                            HeightRequest="{OnIdiom Phone=92, Tablet=98, Desktop=100}"
                            Padding="{OnIdiom Phone='12', Tablet='14', Desktop='15'}"
                            BackgroundColor="White"
                            Stroke="#DDE7E3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{OnIdiom Phone=10, Tablet=11, Desktop=12}">

                                <Border
                                    WidthRequest="{OnIdiom Phone=46, Tablet=48, Desktop=50}"
                                    HeightRequest="{OnIdiom Phone=46, Tablet=48, Desktop=50}"
                                    Padding="9"
                                    BackgroundColor="{Binding ColorFondoIcono}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">

                                    <Image
                                        Source="{Binding Icono}"
                                        Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Titulo}"
                                        FontSize="{OnIdiom Phone=14, Tablet=14.5, Desktop=15}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding Descripcion}"
                                        FontSize="{OnIdiom Phone=11, Tablet=11.5, Desktop=12}"
                                        TextColor="{StaticResource color_GrisOscuro}"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    FontSize="26"
                                    TextColor="{StaticResource color_Verde}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                Grid.RowSpan="3"
                IsVisible="{Binding Navegando}"
                InputTransparent="False"
                BackgroundColor="#28FFFFFF">

                <ActivityIndicator
                    IsRunning="True"
                    Color="{StaticResource color_Naranja}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
