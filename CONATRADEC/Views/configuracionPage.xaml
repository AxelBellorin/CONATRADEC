<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.configuracionPage"
    x:Name="ConfiguracionPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,12,14,12', Tablet='18,16,18,18', Desktop='26,22,26,24'}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{OnIdiom Phone=10, Tablet=12, Desktop=14}">

            <!-- Encabezado -->
            <Border
                Grid.Row="0"
                Style="{StaticResource ModernHeroCard}">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Configuración"
                            Style="{StaticResource ModernPageTitle}" />

                        <Label
                            Text="Administre catálogos, herramientas del dispositivo y opciones de su sesión."
                            Style="{StaticResource ModernPageSubtitle}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="10,6"
                        VerticalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}">

                        <Label
                            Text="{Binding ResumenOpciones}"
                            FontFamily="MontserratBold"
                            FontSize="10.5"
                            TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Búsqueda -->
            <Border
                Grid.Row="1"
                Style="{StaticResource ModernInputBorder}"
                Padding="4,0">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <SearchBar
                        Grid.Column="0"
                        Style="{StaticResource ModernSearchBar}"
                        Placeholder="Buscar una opción de configuración"
                        Text="{Binding TextoBusqueda, Mode=TwoWay}" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ResumenOpciones}"
                        Margin="0,0,10,0"
                        VerticalOptions="Center"
                        FontFamily="MontserratMedium"
                        FontSize="10.5"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                        IsVisible="{OnIdiom Phone=False, Tablet=False, Desktop=True}" />
                </Grid>
            </Border>

            <!-- Catálogo principal -->
            <CollectionView
                x:Name="OpcionesCollection"
                Grid.Row="2"
                ItemsSource="{Binding GruposVisibles}"
                IsGrouped="True"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem"
                ItemsUpdatingScrollMode="KeepScrollOffset">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        x:Name="OpcionesGridLayout"
                        Orientation="Vertical"
                        Span="1"
                        HorizontalItemSpacing="12"
                        VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Grid Padding="12,18">
                        <Border
                            IsVisible="{Binding MostrarSinOpciones}"
                            MaximumWidthRequest="620"
                            Padding="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Style="{StaticResource ModernCard}">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Border
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    Padding="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                    <Image
                                        Source="iconsettings.png"
                                        Aspect="AspectFit" />
                                </Border>

                                <Label
                                    Text="No hay opciones disponibles"
                                    FontSize="18"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="No hay coincidencias o su usuario no tiene permisos de lectura para los catálogos administrativos."
                                    MaximumWidthRequest="480"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:ConfiguracionGrupoVisual">
                        <Grid
                            Padding="{OnIdiom Phone='2,17,2,7', Tablet='2,18,2,8', Desktop='2,20,2,9'}"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="2">

                            <Label
                                Grid.Row="0"
                                Text="{Binding Titulo}"
                                FontSize="{OnIdiom Phone=16, Tablet=17, Desktop=18}"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Descripcion}"
                                FontFamily="MontserratMedium"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap"
                                MaxLines="2" />

                            <BoxView
                                Grid.Row="2"
                                Margin="0,7,0,0"
                                HeightRequest="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConfiguracionOpcion">
                        <Border
                            HeightRequest="{OnIdiom Phone=94, Tablet=98, Desktop=100}"
                            Padding="{OnIdiom Phone='12', Tablet='14', Desktop='15'}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                            <Border.Shadow>
                                <Shadow
                                    Brush="#16211D"
                                    Offset="0,2"
                                    Radius="8"
                                    Opacity="0.045" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{OnIdiom Phone=10, Tablet=11, Desktop=12}">

                                <Border
                                    WidthRequest="{OnIdiom Phone=46, Tablet=48, Desktop=50}"
                                    HeightRequest="{OnIdiom Phone=46, Tablet=48, Desktop=50}"
                                    Padding="9"
                                    BackgroundColor="{Binding ColorFondoIcono}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">

                                    <Image
                                        Source="{Binding Icono}"
                                        Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Titulo}"
                                        FontSize="{OnIdiom Phone=14, Tablet=14.5, Desktop=15}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding Descripcion}"
                                        FontFamily="MontserratMedium"
                                        FontSize="{OnIdiom Phone=10.5, Tablet=11, Desktop=11.5}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                    <Label
                                        Text="›"
                                        FontSize="22"
                                        TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout
                        Padding="0,18,0,8"
                        Spacing="10">

                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Sistema y sesión"
                                FontFamily="MontserratBold"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                            <Label
                                Text="Herramientas del dispositivo y opciones de la cuenta actual."
                                FontFamily="MontserratMedium"
                                FontSize="10.5"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                    <Border
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
        
                        <Grid
                            x:Name="AccionesSistemaGrid"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">
        
                            <Border
                                x:Name="DatosSinConexionCard"
                                Grid.Column="0"
                                HeightRequest="62"
                                Padding="12,8"
                                IsVisible="False"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                Stroke="{AppThemeBinding Light=#D4E5DE, Dark={StaticResource BorderSoftDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13">
        
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="DatosSinConexionCard_Tapped" />
                                </Border.GestureRecognizers>
        
                                <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
                                    <Image
                                        Source="iconoffline.png"
                                        WidthRequest="27"
                                        HeightRequest="27"
                                        VerticalOptions="Center" />
        
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="Datos sin conexión"
                                            FontFamily="MontserratBold"
                                            FontSize="11.5"
                                            TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="Descargar y administrar"
                                            FontFamily="MontserratMedium"
                                            FontSize="9.5"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
        
                            <Border
                                x:Name="CerrarSesionCard"
                                Grid.Column="1"
                                HeightRequest="62"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}"
                                Stroke="{AppThemeBinding Light=#F4C7C7, Dark=#5E3030}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13">
        
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                                </Border.GestureRecognizers>
        
                                <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
                                    <Image
                                        Source="iconloginout.png"
                                        WidthRequest="27"
                                        HeightRequest="27"
                                        VerticalOptions="Center" />
        
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="Cerrar sesión"
                                            FontFamily="MontserratBold"
                                            FontSize="11.5"
                                            TextColor="{StaticResource RedDelete}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="Salir de la cuenta actual"
                                            FontFamily="MontserratMedium"
                                            FontSize="9.5"
                                            TextColor="{AppThemeBinding Light=#9B4B4B, Dark=#F0AAAA}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                Grid.RowSpan="3"
                IsVisible="{Binding Navegando}"
                InputTransparent="False"
                BackgroundColor="#28FFFFFF">

                <Border
                    Padding="18,14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">
                    <HorizontalStackLayout Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding Navegando}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="22"
                            HeightRequest="22" />
                        <Label
                            Text="Abriendo opción..."
                            VerticalOptions="Center"
                            FontFamily="MontserratBold"
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
