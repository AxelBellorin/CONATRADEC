<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.configuracionPage"
    x:Name="ConfiguracionPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,30'}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{OnIdiom Phone=12, Tablet=14, Desktop=14}">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="4">

                <Label
                    Text="Configuración"
                    FontSize="{OnIdiom Phone=26, Tablet=28, Desktop=30}"
                    FontFamily="MontserratBold"
                    FontAttributes="Bold"
                    TextColor="{StaticResource color_Verde}" />

                <Label
                    Text="Acceda a los catálogos y herramientas habilitados para su usuario."
                    FontSize="13"
                    TextColor="{StaticResource color_GrisOscuro}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border
                Grid.Row="1"
                Padding="4"
                BackgroundColor="White"
                Stroke="#DDE7E3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">

                    <SearchBar
                        Grid.Column="0"
                        Placeholder="Buscar una opción de configuración"
                        Text="{Binding TextoBusqueda, Mode=TwoWay}"
                        BackgroundColor="Transparent"
                        CancelButtonColor="{StaticResource color_Verde}" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ResumenOpciones}"
                        Margin="0,0,14,0"
                        VerticalOptions="Center"
                        FontSize="12"
                        TextColor="{StaticResource color_GrisOscuro}"
                        IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}" />
                </Grid>
            </Border>

            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding ElementosVisibles}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Grid Padding="30">

                        <Border
                            IsVisible="{Binding MostrarSinOpciones}"
                            MaximumWidthRequest="620"
                            Padding="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout
                                Spacing="9"
                                HorizontalOptions="Center">

                                <Image
                                    Source="iconsettings.png"
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    Opacity="0.55" />

                                <Label
                                    Text="No hay opciones disponibles"
                                    FontSize="18"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Negro}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="No hay coincidencias con la búsqueda o su usuario no tiene permisos de lectura sobre estas opciones."
                                    FontSize="13"
                                    TextColor="{StaticResource color_GrisOscuro}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConfiguracionElementoVisual">

                        <VerticalStackLayout>

                            <Grid
                                IsVisible="{Binding EsEncabezado}"
                                Padding="0,20,0,10"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="3">

                                <Label
                                    Grid.Row="0"
                                    Text="{Binding TituloCategoria}"
                                    FontSize="19"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource color_Verde}" />

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding DescripcionCategoria}"
                                    FontSize="12"
                                    TextColor="{StaticResource color_GrisOscuro}"
                                    LineBreakMode="WordWrap" />

                                <BoxView
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    HeightRequest="1"
                                    BackgroundColor="#E4ECE8" />
                            </Grid>

                            <Grid
                                IsVisible="{Binding EsFilaUnaColumna}"
                                Padding="0,0,0,12">

                                <controls:ConfiguracionOpcionCard
                                    Opcion="{Binding Opcion1}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />
                            </Grid>

                            <Grid
                                IsVisible="{Binding EsFilaDosColumnas}"
                                Padding="0,0,0,12"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <controls:ConfiguracionOpcionCard
                                    Grid.Column="0"
                                    Opcion="{Binding Opcion1}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />

                                <controls:ConfiguracionOpcionCard
                                    Grid.Column="1"
                                    IsVisible="{Binding MostrarOpcion2}"
                                    Opcion="{Binding Opcion2}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />
                            </Grid>

                            <Grid
                                IsVisible="{Binding EsFilaTresColumnas}"
                                Padding="0,0,0,12"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="12">

                                <controls:ConfiguracionOpcionCard
                                    Grid.Column="0"
                                    Opcion="{Binding Opcion1}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />

                                <controls:ConfiguracionOpcionCard
                                    Grid.Column="1"
                                    IsVisible="{Binding MostrarOpcion2}"
                                    Opcion="{Binding Opcion2}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />

                                <controls:ConfiguracionOpcionCard
                                    Grid.Column="2"
                                    IsVisible="{Binding MostrarOpcion3}"
                                    Opcion="{Binding Opcion3}"
                                    Command="{Binding Source={x:Reference ConfiguracionPageRoot}, Path=BindingContext.AbrirOpcionCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                Grid.RowSpan="3"
                IsVisible="{Binding Navegando}"
                InputTransparent="True"
                BackgroundColor="#30FFFFFF">

                <ActivityIndicator
                    IsRunning="True"
                    Color="{StaticResource color_Naranja}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
