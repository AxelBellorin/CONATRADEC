<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.elementoQuimicoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid
        x:Name="ContenidoFormulario"
        Padding="{OnIdiom Phone='12,12,12,20', Tablet='20,18,20,26', Desktop='28,22,28,30'}">

        <ScrollView
            HorizontalOptions="Fill"
            HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                x:Name="FormularioContainer"
                MaximumWidthRequest="1000"
                HorizontalOptions="Center"
                Spacing="14">

                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Title}"
                                Style="{StaticResource ModernPageTitle}"
                                TextColor="{StaticResource color_Verde}" />

                            <Label
                                Text="{Binding Subtitulo}"
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>

                        <ActivityIndicator
                            Grid.Column="1"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource color_Naranja}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernFormCard}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="Información general"
                                Style="{StaticResource ModernSectionTitle}" />

                            <Label
                                Text="El peso equivalente se registra y presenta con exactamente dos decimales."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>

                        <!--
                            El code-behind adapta estas columnas según el ancho
                            útil real. Así una ventana WinUI estrecha se comporta
                            como una pantalla compacta aunque Device.Idiom siga
                            siendo Desktop.
                        -->
                        <Grid
                            x:Name="CamposGrid"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="14"
                            RowSpacing="13">

                            <VerticalStackLayout
                                x:Name="CampoSimbolo"
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="6">

                                <Label
                                    Text="Símbolo del elemento"
                                    Style="{StaticResource ModernFieldLabel}" />

                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorSimbolo}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Placeholder="Ejemplo: N, P, K"
                                        Text="{Binding SimboloElementoQuimico}"
                                        MaxLength="10"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>

                                <Label
                                    Text="{Binding ErrorSimbolo}"
                                    IsVisible="{Binding TieneErrorSimbolo}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="CampoNombre"
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="Nombre del elemento"
                                    Style="{StaticResource ModernFieldLabel}" />

                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorNombre}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Placeholder="Ejemplo: Nitrógeno"
                                        Text="{Binding NombreElementoQuimico}"
                                        MaxLength="100"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>

                                <Label
                                    Text="{Binding ErrorNombre}"
                                    IsVisible="{Binding TieneErrorNombre}"
                                    FontSize="11"
                                    TextColor="{StaticResource RedDelete}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="CampoPeso"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Spacing="6">

                                <Label
                                    Text="Peso equivalente"
                                    Style="{StaticResource ModernFieldLabel}" />

                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding TieneErrorPesoEquivalente}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource RedDelete}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Entry
                                        Placeholder="Ejemplo: 14.01"
                                        Text="{Binding PesoEquivalenteTexto}"
                                        Keyboard="Numeric"
                                        MaxLength="11"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="Formato permitido: número mayor que cero con máximo dos decimales."
                                        Style="{StaticResource ModernCaption}"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ErrorPesoEquivalente}"
                                        IsVisible="{Binding TieneErrorPesoEquivalente}"
                                        FontSize="11"
                                        TextColor="{StaticResource RedDelete}"
                                        HorizontalTextAlignment="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    x:Name="AccionesGrid"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto"
                    ColumnSpacing="10"
                    RowSpacing="8"
                    Margin="0,2,0,16">

                    <Button
                        x:Name="GuardarButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Guardar"
                        MinimumWidthRequest="0"
                        IsVisible="{Binding ShowSaveButton}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ModernPrimaryButton}" />

                    <Button
                        x:Name="CancelarButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Cancelar"
                        MinimumWidthRequest="0"
                        IsVisible="{Binding MostrarBotonCancelar}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ModernNeutralButton}" />

                    <Button
                        x:Name="RegresarButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="Regresar"
                        MinimumWidthRequest="0"
                        IsVisible="{Binding IsReadOnly}"
                        IsEnabled="{Binding NotIsBusy}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ModernNeutralButton}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!--
            Capa de carga de la operación actual. Bloquea la interacción para
            impedir dobles guardados mientras existe una espera real del servidor.
        -->
        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#4A0B1511">

            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="24"
                        HeightRequest="24" />

                    <Label
                        Text="Procesando elemento químico..."
                        VerticalOptions="Center"
                        FontFamily="MontserratBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
