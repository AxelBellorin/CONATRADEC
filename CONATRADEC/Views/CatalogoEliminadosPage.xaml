<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.CatalogoEliminadosPage"
    x:Name="PaginaEliminados"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid Padding="{OnIdiom Phone='12,12,12,18', Tablet='18,16,18,22', Desktop='24,20,24,26'}">
        <Grid IsVisible="{Binding CanView}">
            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefrescarCommand}">

                <CollectionView
                    x:Name="RegistrosCollection"
                    ItemsSource="{Binding Registros}"
                    SelectionMode="None">

                    <!--
                        El encabezado y todos los estados forman parte del flujo
                        normal. No se usa EmptyView para evitar capas que puedan
                        capturar interacción en WinUI.
                    -->
                    <CollectionView.Header>
                        <VerticalStackLayout
                            Spacing="12"
                            Padding="0,0,0,12">

                            <controls:ResponsiveCatalogHeader
                                Title="{Binding Titulo}"
                                Subtitle="{Binding Descripcion}"
                                BackText="← Cerrar"
                                BackCommand="{Binding CerrarCommand}"
                                IsPrimaryVisible="False" />

                            <Border Style="{StaticResource ModernFormCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <SearchBar
                                            Placeholder="{Binding PlaceholderBusqueda}"
                                            Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                            SearchCommand="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernSearchBar}" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label
                                            Text="{Binding Resumen}"
                                            VerticalOptions="Center"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="11.5" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Buscar"
                                            Command="{Binding BuscarCommand}"
                                            Style="{StaticResource ModernPrimaryButton}" />
                                        <Button
                                            Grid.Column="2"
                                            Text="Limpiar"
                                            Command="{Binding LimpiarCommand}"
                                            Style="{StaticResource ModernNeutralButton}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding TieneMensaje}"
                                Style="{StaticResource ModernWarningBanner}">
                                <Label
                                    Text="{Binding Mensaje}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    LineBreakMode="WordWrap" />
                            </Border>

                            <Border
                                IsVisible="{Binding MostrarVacio}"
                                InputTransparent="True"
                                Style="{StaticResource ModernEmptyStateCard}"
                                Margin="0,8,0,12"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="560">
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    Spacing="8">
                                    <Border
                                        Style="{StaticResource ModernIconTile}"
                                        WidthRequest="58"
                                        HeightRequest="58">
                                        <Label
                                            Text="✓"
                                            FontSize="27"
                                            TextColor="{StaticResource color_Verde}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Text="No hay registros eliminados"
                                        Style="{StaticResource ModernSectionTitle}"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Todos los registros están activos o no coinciden con la búsqueda actual."
                                        Style="{StaticResource ModernPageSubtitle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="RegistrosGrid"
                            Orientation="Vertical"
                            Span="1"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CatalogoEliminadoItem">
                            <Border
                                Style="{StaticResource ModernCatalogCard}"
                                MinimumHeightRequest="190">
                                <Grid
                                    RowDefinitions="Auto,*,Auto"
                                    RowSpacing="12">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandCoffeeSoft}, Dark={StaticResource BrandCoffeeSoftDark}}"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="{Binding Iniciales}"
                                                FontSize="17"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Titulo}"
                                                FontSize="16"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                IsVisible="{Binding TieneSubtitulo}"
                                                Text="{Binding Subtitulo}"
                                                FontFamily="MontserratMedium"
                                                FontSize="11.5"
                                                TextColor="{StaticResource color_Cafe}"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource ModernDangerBanner}"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="Eliminado"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="9.5"
                                                TextColor="{StaticResource RedDelete}" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="1" Spacing="7">
                                        <Border
                                            IsVisible="{Binding TieneCodigo}"
                                            Style="{StaticResource ModernBadgeYellow}"
                                            Padding="9,6">
                                            <Label
                                                Text="{Binding Codigo}"
                                                FontFamily="MontserratBold"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                TextColor="{StaticResource color_Cafe}"
                                                HorizontalTextAlignment="Center"
                                                LineBreakMode="CharacterWrap" />
                                        </Border>

                                        <Label
                                            IsVisible="{Binding TieneDetalle}"
                                            Text="{Binding Detalle}"
                                            Style="{StaticResource ModernCaption}"
                                            FontSize="11.5"
                                            MaxLines="3"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Row="2"
                                        Text="Reactivar registro"
                                        IsVisible="{Binding Source={x:Reference PaginaEliminados}, Path=BindingContext.CanEdit}"
                                        Command="{Binding Source={x:Reference PaginaEliminados}, Path=BindingContext.ReactivarCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        HorizontalOptions="Fill" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Spacing="0">
                            <Border
                                x:Name="PaginacionEliminados"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="{OnIdiom Phone='12,12', Tablet='14,13', Desktop='16,14'}"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            HorizontalOptions="Fill" />
                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            HorizontalOptions="Fill" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <BoxView
                                HeightRequest="{OnIdiom Phone=18, Tablet=22, Desktop=26}"
                                Opacity="0" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Acceso denegado: el modal conserva su propio cierre. -->
        <Grid
            IsVisible="{Binding MostrarAccesoDenegado}"
            Padding="{OnIdiom Phone=12, Tablet=20, Desktop=24}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">
            <Border Style="{StaticResource ModernAccessDeniedCard}">
                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">
                    <Image
                        Source="iconpermission.png"
                        WidthRequest="62"
                        HeightRequest="62"
                        Opacity="0.68" />
                    <Label
                        Text="Sin permiso de lectura"
                        Style="{StaticResource ModernSectionTitle}"
                        FontSize="20"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Su usuario no puede consultar los registros eliminados de esta interfaz."
                        Style="{StaticResource ModernPageSubtitle}"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Cerrar"
                        Command="{Binding CerrarCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--
            Relay único para toda operación asíncrona del modal de eliminados.
            Se utiliza al cargar, buscar, paginar, reactivar y cerrar/regresar.
        -->
        <Grid
            IsVisible="{Binding MostrandoRelay}"
            InputTransparent="False"
            BackgroundColor="#66000000"
            ZIndex="100">
            <Border
                Padding="22,18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding MostrandoRelay}"
                        Color="{StaticResource color_Naranja}"
                        WidthRequest="26"
                        HeightRequest="26" />
                    <VerticalStackLayout
                        Spacing="1"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding TituloRelay}"
                            FontFamily="MontserratBold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="{Binding DetalleRelay}"
                            FontFamily="MontserratMedium"
                            FontSize="10"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
