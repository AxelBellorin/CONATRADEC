<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.RevisionAnalizadorFotografiaPage"
    x:Name="PaginaRevisionAnalizador"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid Padding="{OnIdiom Phone='12,12,12,16', Tablet='20,18,20,22', Desktop='28,22,28,26'}">
        <ScrollView HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="14" MaximumWidthRequest="1050" HorizontalOptions="Center">
                <Border Style="{StaticResource InspectionCard}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="TituloRevisionLabel" Style="{StaticResource ModernPageTitle}" LineBreakMode="WordWrap" />
                            <Label x:Name="SubtituloFotografiaLabel" Style="{StaticResource InspectionSubtitle}" />
                        </VerticalStackLayout>

                        <Border
                            HeightRequest="{OnIdiom Phone=280, Tablet=360, Desktop=440}"
                            BackgroundColor="Black"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                            StrokeShape="RoundRectangle 16">
                            <Grid Padding="8">
                                <Image x:Name="FotografiaImage" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAmpliarImagenTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Button Margin="8" Padding="14,8" Text="Ver limpia / marcada IA" Clicked="OnAmpliarImagenClicked" HorizontalOptions="End" VerticalOptions="End" BackgroundColor="#435B54" TextColor="White" CornerRadius="10" FontSize="12" />
                            </Grid>
                        </Border>
                        <Label Text="Toque la imagen para comparar la evidencia limpia con la marcada por IA." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InspectionGreenPanel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Resultado de la IA" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                        <Label x:Name="DiagnosticoIaLabel" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="WordWrap" />
                        <Label x:Name="ResumenIaLabel" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="WordWrap" />
                        <Label x:Name="DetalleIaLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}" LineBreakMode="WordWrap" />

                        <VerticalStackLayout x:Name="DiagnosticosIaStack" Spacing="9" />

                        <Button
                            x:Name="AgregarDiagnosticoButton"
                            Text="+ Agregar diagnóstico observado"
                            Clicked="OnAgregarDiagnosticoClicked"
                            HeightRequest="44"
                            Padding="12,7"
                            CornerRadius="10"
                            BackgroundColor="{AppThemeBinding Light=#EEF5F2, Dark=#2B3B36}"
                            TextColor="{StaticResource color_Verde}"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill" />

                        <Border
                            x:Name="LocalizacionIaBorder"
                            Padding="10,8"
                            BackgroundColor="{AppThemeBinding Light=#EEF5F2, Dark=#24322E}"
                            Stroke="{AppThemeBinding Light=#C8DED6, Dark=#425650}"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                x:Name="LocalizacionIaLabel"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InspectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Decisión del analizador" Style="{StaticResource InspectionTitle}" />
                        <Label Text="La fotografía continúa siendo un solo expediente. La confirmación actual conserva todas las afectaciones diferenciadas detectadas por IA; la corrección modifica su clasificación principal sin perder las secundarias." Style="{StaticResource InspectionSubtitle}" />

                        <Button Text="✓ Confirmar diagnóstico IA" Clicked="OnConfirmarClicked" Style="{StaticResource InspectionPrimaryButton}" />
                        <Button Text="✎ Corregir diagnóstico" Clicked="OnCorregirClicked" Style="{StaticResource InspectionCoffeeButton}" />
                        <Button Text="↩ Devolver al técnico" Clicked="OnDevolverTecnicoClicked" BackgroundColor="{StaticResource BrandCoffeeSoft}" TextColor="#8A4325" CornerRadius="13" HeightRequest="48" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                            <Button Grid.Column="0" Text="Omitir por ahora" Clicked="OnOmitirClicked" Style="{StaticResource InspectionNeutralButton}" />
                            <Button Grid.Column="1" Text="Cancelar revisión" Clicked="OnCancelarClicked" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" BorderColor="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" BorderWidth="1" CornerRadius="13" HeightRequest="48" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
