<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietarioFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource color_Blanco}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*">

        <!--
            Encabezado propio del formulario.
            Reemplaza por completo la flecha nativa de Shell y utiliza el
            mismo patrón visual de los demás catálogos.
        -->
        <controls:ResponsiveCatalogHeader
            Grid.Row="0"
            Title="{Binding Title}"
            Subtitle="Los datos se guardan una sola vez y se reutilizan al vincular terrenos."
            BackText="← Propietarios"
            BackCommand="{Binding CancelarCommand}"
            PrimaryText="Editar"
            PrimaryCommand="{Binding EditarCommand}"
            IsPrimaryVisible="{Binding ShowEditButton}" />

        <ScrollView Grid.Row="1">
            <Grid
                Padding="{OnPlatform WinUI='24,8,24,28', Default='14,6,14,24'}"
                ColumnDefinitions="{OnPlatform WinUI='*,7*,*', Default='0,*,0'}">

                <VerticalStackLayout
                    Grid.Column="1"
                    MaximumWidthRequest="900"
                    Spacing="14">

                    <Border
                        Padding="{OnPlatform WinUI=18, Default=14}"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="Información del propietario"
                                FontFamily="MontserratBold"
                                FontSize="17"
                                TextColor="{StaticResource color_Verde}" />

                            <Grid
                                ColumnDefinitions="{OnPlatform WinUI='*,*', Default='*'}"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="14"
                                RowSpacing="10">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Identificación"
                                        FontAttributes="Bold"
                                        FontSize="12" />

                                    <Entry
                                        Text="{Binding Identificacion, Mode=TwoWay}"
                                        Placeholder="Cédula, RUC u otra identificación"
                                        MaxLength="50"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource EntryStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnPlatform WinUI=1, Default=0}"
                                    Grid.Row="{OnPlatform WinUI=0, Default=1}"
                                    Spacing="4">

                                    <Label
                                        Text="Nombre completo"
                                        FontAttributes="Bold"
                                        FontSize="12" />

                                    <Entry
                                        Text="{Binding NombreCompleto, Mode=TwoWay}"
                                        Placeholder="Nombre del propietario"
                                        MaxLength="150"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource EntryStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Row="{OnPlatform WinUI=1, Default=2}"
                                    Spacing="4">

                                    <Label
                                        Text="Teléfono"
                                        FontAttributes="Bold"
                                        FontSize="12" />

                                    <Entry
                                        Text="{Binding Telefono, Mode=TwoWay}"
                                        Placeholder="Teléfono"
                                        Keyboard="Telephone"
                                        MaxLength="25"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource EntryStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnPlatform WinUI=1, Default=0}"
                                    Grid.Row="{OnPlatform WinUI=1, Default=3}"
                                    Spacing="4">

                                    <Label
                                        Text="Correo"
                                        FontAttributes="Bold"
                                        FontSize="12" />

                                    <Entry
                                        Text="{Binding Correo, Mode=TwoWay}"
                                        Placeholder="correo@ejemplo.com"
                                        Keyboard="Email"
                                        MaxLength="150"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Style="{StaticResource EntryStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Row="{OnPlatform WinUI=2, Default=4}"
                                    Grid.ColumnSpan="{OnPlatform WinUI=2, Default=1}"
                                    Spacing="4">

                                    <Label
                                        Text="Dirección"
                                        FontAttributes="Bold"
                                        FontSize="12" />

                                    <Editor
                                        Text="{Binding Direccion, Mode=TwoWay}"
                                        Placeholder="Dirección del propietario"
                                        MaxLength="300"
                                        MinimumHeightRequest="90"
                                        AutoSize="TextChanges"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="#F8FAF9" />
                                </VerticalStackLayout>
                            </Grid>

                            <Border
                                Padding="10"
                                BackgroundColor="#EEF5F2"
                                Stroke="#C9DDD6"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="El estado activo no se modifica desde este formulario. La eliminación es una acción independiente y requiere permiso."
                                    FontSize="11"
                                    TextColor="{StaticResource color_Verde}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='*,*', Default='*'}"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <Button
                            Text="Guardar"
                            Style="{StaticResource UpdateButton}"
                            IsVisible="{Binding ShowSaveButton}"
                            Command="{Binding GuardarCommand}" />

                        <Button
                            Grid.Column="{OnPlatform WinUI=1, Default=0}"
                            Grid.Row="{OnPlatform WinUI=0, Default=1}"
                            Text="Regresar"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding CancelarCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <ActivityIndicator
            Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource color_Verde}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
