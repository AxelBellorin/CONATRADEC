<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.propietarioFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <ScrollView HorizontalScrollBarVisibility="Never">
            <Grid
                x:Name="ContenidoFormulario"
                Padding="{OnIdiom Phone='12,12,12,22', Tablet='20,18,20,26', Desktop='28,22,28,30'}">

                <VerticalStackLayout
                    x:Name="FormularioContainer"
                    MaximumWidthRequest="960"
                    HorizontalOptions="Center"
                    Spacing="14">

                    <controls:ResponsiveCatalogHeader
                        Title="{Binding Title}"
                        Subtitle="Los datos se guardan una sola vez y se reutilizan al vincular terrenos."
                        BackText="← Propietarios"
                        BackCommand="{Binding CancelarCommand}"
                        PrimaryText="Editar"
                        PrimaryCommand="{Binding EditarCommand}"
                        IsPrimaryVisible="{Binding ShowEditButton}" />

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="15">

                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="Información del propietario"
                                    Style="{StaticResource ModernSectionTitle}" />
                                <Label
                                    Text="Mantenga estos datos actualizados para reutilizarlos en todos los terrenos asociados."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <!--
                                El Grid se reorganiza desde el code-behind según el
                                ancho REAL del formulario. Una ventana WinUI estrecha
                                pasa a una columna aunque siga siendo Desktop.
                            -->
                            <Grid
                                x:Name="CamposGrid"
                                ColumnDefinitions="*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="14"
                                RowSpacing="12">

                                <VerticalStackLayout
                                    x:Name="CampoIdentificacion"
                                    Spacing="6">
                                    <Label
                                        Text="Identificación"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Identificacion, Mode=TwoWay}"
                                            Placeholder="Cédula, RUC u otra identificación"
                                            MaxLength="50"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    x:Name="CampoNombre"
                                    Grid.Row="1"
                                    Spacing="6">
                                    <Label
                                        Text="Nombre completo"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding NombreCompleto, Mode=TwoWay}"
                                            Placeholder="Nombre del propietario"
                                            MaxLength="150"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    x:Name="CampoTelefono"
                                    Grid.Row="2"
                                    Spacing="6">
                                    <Label
                                        Text="Teléfono"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Telefono, Mode=TwoWay}"
                                            Placeholder="Teléfono"
                                            Keyboard="Telephone"
                                            MaxLength="25"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    x:Name="CampoCorreo"
                                    Grid.Row="3"
                                    Spacing="6">
                                    <Label
                                        Text="Correo"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Text="{Binding Correo, Mode=TwoWay}"
                                            Placeholder="correo@ejemplo.com"
                                            Keyboard="Email"
                                            MaxLength="150"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    x:Name="CampoDireccion"
                                    Grid.Row="4"
                                    Spacing="6">
                                    <Label
                                        Text="Dirección"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Border
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,6">
                                        <Editor
                                            Text="{Binding Direccion, Mode=TwoWay}"
                                            Placeholder="Dirección del propietario"
                                            MaxLength="300"
                                            MinimumHeightRequest="90"
                                            AutoSize="TextChanges"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                            FontFamily="MontserratMedium"
                                            FontSize="13" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Border Style="{StaticResource ModernInfoBanner}">
                                <Label
                                    Text="El estado activo no se modifica desde este formulario. La eliminación es una acción independiente y requiere permiso."
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark={StaticResource TextSecondaryDark}}"
                                    LineBreakMode="WordWrap" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        x:Name="AccionesGrid"
                        ColumnDefinitions="*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="9"
                        Margin="0,2,0,12">

                        <Button
                            x:Name="GuardarButton"
                            Text="Guardar"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinimumWidthRequest="0"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding ShowSaveButton}"
                            Command="{Binding GuardarCommand}" />

                        <Button
                            x:Name="RegresarButton"
                            Grid.Row="1"
                            Text="Regresar"
                            Style="{StaticResource ModernNeutralButton}"
                            MinimumWidthRequest="0"
                            HorizontalOptions="Fill"
                            Command="{Binding CancelarCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#28000000">

            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 14">

                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}" />
                    <Label
                        Text="Procesando..."
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
