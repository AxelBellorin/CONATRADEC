<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MultiCalculoPage"
    x:Name="MultiCalculoRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:CONATRADEC.ViewModels"
    x:DataType="viewModels:MultiCalculoViewModel"
    Title="Cálculos complementarios"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Encabezado compacto. No se replica dentro de cada pestaña. -->
        <Border
            Grid.Row="0"
            Margin="{OnIdiom Phone='14,12,14,0', Tablet='20,18,20,0', Desktop='26,20,26,0'}"
            Style="{StaticResource ModernHeroCard}"
            MaximumWidthRequest="1180"
            HorizontalOptions="Center">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="13">

                <Border
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Start">

                    <Image
                        Source="iconchemicalelement.png"
                        WidthRequest="25"
                        HeightRequest="25"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="4">

                    <Label
                        Text="Cálculos complementarios"
                        Style="{StaticResource ModernPageTitle}" />

                    <Label
                        Text="{Binding TextoEncabezado}"
                        Style="{StaticResource ModernPageSubtitle}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView
            Grid.Row="1"
            HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="{OnIdiom Phone='14,12,14,18', Tablet='20,14,20,22', Desktop='26,16,26,24'}"
                Spacing="14"
                MaximumWidthRequest="1180"
                HorizontalOptions="Center">

                <!-- Resumen del análisis. Se mantiene ligero: solo controles de texto. -->
                <Border Style="{StaticResource AnalysisPanel}">
                    <VerticalStackLayout Spacing="14">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="Datos base del análisis"
                                    Style="{StaticResource ModernSectionTitle}" />

                                <Label
                                    Text="Referencia utilizada por Balance, Enmienda y Fertilización mixta."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource ModernBadgeGreen}"
                                VerticalOptions="Start">
                                <Label
                                    Text="{Binding NombreTabActual}"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    TextColor="{StaticResource color_Verde}" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource AnalysisSoftPanel}">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="11">

                                <Border
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandCoffeeSoft}, Dark={StaticResource BrandCoffeeSoftDark}}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 11">
                                    <Image
                                        Source="icontipoanalisis.png"
                                        WidthRequest="21"
                                        HeightRequest="21"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="Nombre / identificador"
                                        Style="{StaticResource ModernFieldLabel}" />
                                    <Label
                                        Text="{Binding NombreAnalisisSuelo}"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{AppThemeBinding Light={StaticResource color_Cafe}, Dark=#E6B798}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Cultivo" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding TipoCultivo}" FontFamily="MontserratBold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tipo análisis" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding TipoAnalisisSuelo}" FontFamily="MontserratBold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="pH" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding Ph, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Verde}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Acidez total / AT" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding AcidezTotal, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Cafe}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Calcio CICE" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding CalcioCice, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Magnesio CICE" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding MagnesioCice, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Potasio CICE" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding PotasioCice, StringFormat='{0:N2}'}" FontFamily="MontserratBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource AnalysisMetric}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tamaño finca" Style="{StaticResource ModernFieldLabel}" />
                                    <Label Text="{Binding TamanoFinca, StringFormat='{0:N2} mz'}" FontFamily="MontserratBold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource AnalysisMetric}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="Plantas utilizadas en el cálculo" Style="{StaticResource ModernFieldLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding CantidadPlantasTexto}" FontFamily="MontserratBold" FontSize="14" TextColor="{StaticResource color_Verde}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--
                    El code-behind inserta únicamente la pestaña activa.
                    Se conserva esta optimización para no construir las tres
                    interfaces simultáneamente, especialmente en Android.
                -->
                <Grid x:Name="ContenidoTabActual" />

                <Border
                    IsVisible="{Binding TieneMensaje}"
                    Style="{StaticResource ModernInfoBanner}">
                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                        LineBreakMode="WordWrap" />
                </Border>

                <BoxView HeightRequest="8" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Selector fijo de cálculo y acciones. -->
        <Border
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceNavigation}, Dark={StaticResource SurfaceNavigationDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
            StrokeThickness="1"
            Padding="{OnIdiom Phone='10,8,10,10', Tablet='16,10,16,12', Desktop='20,10,20,12'}">

            <VerticalStackLayout
                Spacing="9"
                MaximumWidthRequest="1180"
                HorizontalOptions="Fill">

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="7">

                    <Button
                        Grid.Column="0"
                        Text="Balance"
                        Command="{Binding SeleccionarBalanceCommand}"
                        IsVisible="{Binding MostrarBalanceFormula}"
                        Style="{StaticResource AnalysisTabButton}"
                        MinimumWidthRequest="86"
                        HeightRequest="48"
                        FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=13}"
                        HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding EsBalanceSeleccionado}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource color_Verde}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Text="Enmienda"
                        Command="{Binding SeleccionarEnmiendaCommand}"
                        IsVisible="{Binding MostrarEnmiendaCalcarea}"
                        Style="{StaticResource AnalysisTabButton}"
                        MinimumWidthRequest="86"
                        HeightRequest="48"
                        FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=13}"
                        HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding EsEnmiendaSeleccionada}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource color_Cafe}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Text="Mixta"
                        Command="{Binding SeleccionarFertilizacionCommand}"
                        IsVisible="{Binding MostrarFertilizacionMixta}"
                        Style="{StaticResource AnalysisTabButton}"
                        MinimumWidthRequest="86"
                        HeightRequest="48"
                        FontSize="{OnIdiom Phone=12, Tablet=13, Desktop=13}"
                        HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding EsFertilizacionSeleccionada}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource color_Amarillo}" />
                                <Setter Property="TextColor" Value="{StaticResource color_Negro}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        Text="Volver"
                        Command="{Binding VolverCommand}"
                        Style="{StaticResource ModernNeutralButton}"
                        MinimumWidthRequest="132"
                        HeightRequest="48"
                        HorizontalOptions="Fill" />

                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoBotonGuardar}"
                        Command="{Binding GuardarCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        MinimumWidthRequest="132"
                        HeightRequest="48"
                        HorizontalOptions="Fill" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Relay del guardado real del análisis. -->
        <Grid
            Grid.RowSpan="3"
            BackgroundColor="#66000000"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            ZIndex="1500">

            <Border
                Padding="22,18"
                Margin="24"
                MaximumWidthRequest="390"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Style="{StaticResource ModernHeroCard}">

                <VerticalStackLayout Spacing="11">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="42"
                        HeightRequest="42"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Guardando análisis..."
                        FontFamily="MontserratBold"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Espere mientras se conservan los cálculos seleccionados."
                        Style="{StaticResource ModernCaption}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
