                                        <Label Grid.Row="2" Text="Costo comercial ajustado" Style="{StaticResource ModernCaption}" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Reference DetallePageRoot}, Path=TextoCostoComercialAjustadoVisual}" Style="{StaticResource HistoryValueLabel}" TextColor="{StaticResource color_Cafe}" />
                                        <Label Grid.Row="3" Text="Costo total final" FontFamily="MontserratBold" FontSize="12" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Source={x:Reference DetallePageRoot}, Path=TextoCostoTotalFinalVisual}" Style="{StaticResource HistoryValueLabel}" />
                                        <Label Grid.Row="4" Text="{Binding Source={x:Reference DetallePageRoot}, Path=EtiquetaDiferenciaEconomicaVisual}" FontFamily="MontserratBold" FontSize="12" TextColor="{Binding Source={x:Reference DetallePageRoot}, Path=ColorDiferenciaEconomicaVisual}" />
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Source={x:Reference DetallePageRoot}, Path=TextoDiferenciaEconomicaVisual}" FontFamily="MontserratBold" FontSize="13" TextColor="{Binding Source={x:Reference DetallePageRoot}, Path=ColorDiferenciaEconomicaVisual}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding Source={x:Reference DetallePageRoot}, Path=CargandoComplementoMixta}"
                                Style="{StaticResource HistorySoftPanel}">
                                <HorizontalStackLayout Spacing="9">
                                    <ActivityIndicator
                                        IsRunning="{Binding Source={x:Reference DetallePageRoot}, Path=CargandoComplementoMixta}"
                                        Color="{StaticResource color_Verde}"
                                        WidthRequest="22"
                                        HeightRequest="22" />
                                    <Label
                                        Text="Reconstruyendo el complemento y sus costos..."
                                        Style="{StaticResource ModernCaption}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding Source={x:Reference DetallePageRoot}, Path=TieneMensajeComplementoMixtaVisual}"
                                Style="{StaticResource HistoryWarningPanel}">
                                <Label
                                    Text="{Binding Source={x:Reference DetallePageRoot}, Path=MensajeComplementoMixtaVisual}"
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="#9A3412"
                                    LineBreakMode="WordWrap" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border
                        x:Name="SinCalculosCard"
                        IsVisible="False"
                        Style="{StaticResource HistorySoftPanel}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sin cálculos complementarios" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Este análisis conserva únicamente el requerimiento anual."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- REPORTES: dentro del scroll para no quitar altura útil. -->
                    <Border Style="{StaticResource HistoryCard}">
                        <VerticalStackLayout Spacing="11">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Reportes del análisis" Style="{StaticResource ModernSectionTitle}" />
                                <Label
                                    Text="Guarde, comparta o abra el reporte sin abandonar el detalle."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,*"
                                RowSpacing="8"
                                ColumnSpacing="8">
                                <Button Grid.Row="0" Grid.Column="0" Text="Guardar PDF" Command="{Binding GuardarPdfCommand}" Style="{StaticResource ModernPrimaryButton}" />
                                <Button Grid.Row="0" Grid.Column="1" Text="Guardar Excel" Command="{Binding GuardarExcelCommand}" Style="{StaticResource ModernCoffeeButton}" />
                                <Button Grid.Row="1" Grid.Column="0" Text="Compartir PDF" Command="{Binding CompartirPdfCommand}" Style="{StaticResource ModernUpdateButton}" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Compartir Excel" Command="{Binding CompartirExcelCommand}" Style="{StaticResource ModernSecondaryButton}" />
                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Abrir / imprimir PDF" Command="{Binding ImprimirPdfCommand}" Style="{StaticResource ModernNeutralButton}" />
                            </Grid>

                            <Button
                                Text="Volver al inicio"
                                Command="{Binding VolverCommand}"
                                Style="{StaticResource ModernSecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Relay real de la carga/operaciones del ViewModel. -->
        <Grid
            BackgroundColor="#78000000"
            IsVisible="{Binding IsBusy}">
            <Border
                Style="{StaticResource ModernCard}"
                MaximumWidthRequest="330"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="22">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="38"
                        HeightRequest="38" />
                    <Label
                        Text="Preparando análisis..."
                        FontFamily="MontserratBold"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="Cargando los datos guardados y los cálculos disponibles."
                        Style="{StaticResource ModernCaption}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
