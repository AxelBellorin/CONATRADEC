<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.AnalisisGuardadoDetallePage"
    x:Name="DetallePageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CONATRADEC.Converters"
    xmlns:viewModels="clr-namespace:CONATRADEC.ViewModels"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <ContentPage.Resources>
        <converters:QuintalesCompraConverter x:Key="QuintalesCompraConverter" />
        <converters:CostoCompraFuenteConverter x:Key="CostoCompraFuenteConverter" />
        <converters:BalanceResumenTotalConverter x:Key="BalanceResumenTotalConverter" />
        <converters:ModoBalanceConverter x:Key="ModoBalanceConverter" />
        <converters:ModoMixtaConverter x:Key="ModoMixtaConverter" />
        <converters:EnmiendaInterpretacionConverter x:Key="EnmiendaInterpretacionConverter" />
    </ContentPage.Resources>

    <Grid>
        <ScrollView HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout
                MaximumWidthRequest="1180"
                HorizontalOptions="Center"
                Padding="{OnIdiom Phone='12,12,12,34', Tablet='20,18,20,38', Desktop='28,22,28,42'}"
                Spacing="14">

                <!-- Encabezado desplazable: libera espacio útil en móvil. -->
                <Border Style="{StaticResource ModernHeroCard}">
                    <Grid
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                        ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}"
                        RowSpacing="10"
                        ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Button
                                Text="← Volver"
                                Command="{Binding VolverCommand}"
                                Style="{StaticResource ModernLinkButton}"
                                HorizontalOptions="Start"
                                Margin="-8,-5,0,0" />
                            <Label Text="Detalle del análisis" Style="{StaticResource ModernPageTitle}" />
                            <Label
                                Text="Consulte el requerimiento anual y los cálculos complementarios asociados al análisis guardado."
                                Style="{StaticResource ModernPageSubtitle}" />
                        </VerticalStackLayout>

                        <Button
                            x:Name="EditarButton"
                            Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            Text="Editar análisis"
                            IsVisible="{Binding CanEdit}"
                            Style="{StaticResource ModernUpdateButton}"
                            HorizontalOptions="{OnIdiom Phone=Fill, Default=End}"
                            VerticalOptions="End" />
                    </Grid>
                </Border>

                <Border
                    IsVisible="{Binding TieneMensaje}"
                    Style="{StaticResource HistoryWarningPanel}">
                    <Label
                        Text="{Binding Mensaje}"
                        FontFamily="MontserratMedium"
                        FontSize="12"
                        TextColor="#9A3412"
                        LineBreakMode="WordWrap" />
                </Border>

                <VerticalStackLayout
                    IsVisible="{Binding TieneDetalle}"
                    Spacing="14">

                    <!-- DATOS GENERALES -->
                    <Border Style="{StaticResource HistoryCard}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Datos generales" Style="{StaticResource ModernSectionTitle}" />
                                <Label
                                    Text="Información de identificación y condiciones principales del análisis."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Border Style="{StaticResource HistorySoftPanel}">
                                <VerticalStackLayout Spacing="3">
                                    <Label
                                        Text="{Binding ClienteMostrar}"
                                        FontFamily="MontserratBold"
                                        FontSize="{OnIdiom Phone=17, Tablet=18, Desktop=19}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        Text="{Binding TerrenoMostrar}"
                                        Style="{StaticResource ModernPageSubtitle}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Grid
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="10">
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Identificador" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding Detalle.DatosAnalisis.IdentificadorAnalisisSuelo}"
                                            Style="{StaticResource HistoryValueLabel}"
                                            TextColor="{StaticResource color_Verde}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Fecha del análisis" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.DatosAnalisis.FechaAnalisisTexto}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Laboratorio" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.DatosAnalisis.LaboratorioAnalasisSuelo}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Fecha y hora de registro" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding Detalle.DatosAnalisis.FechaRegistroTexto}"
                                            Style="{StaticResource HistoryValueLabel}"
                                            TextColor="{StaticResource color_Verde}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="pH" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.RequerimientoAnual.Ph, StringFormat='{0:N2}'}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Acidez total" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.RequerimientoAnual.AcidezTotal, StringFormat='{0:N2}'}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Materia orgánica" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.RequerimientoAnual.MateriaOrganica, StringFormat='{0:N2}'}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Producción" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding Detalle.RequerimientoAnual.CantidadQuintalesOro, StringFormat='{0:N2} qq oro'}"
                                            Style="{StaticResource HistoryValueLabel}"
                                            TextColor="{StaticResource color_Cafe}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- VALORES ORIGINALES -->
                    <Border Style="{StaticResource HistoryCard}">
                        <VerticalStackLayout Spacing="11">
                            <Label Text="Valores originales del laboratorio" Style="{StaticResource ModernSectionTitle}" />
                            <Label
                                Text="Estos son los valores reportados originalmente y sus unidades de medida."
                                Style="{StaticResource ModernCaption}" />

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Detalle.DatosAnalisis.ElementosQuimicos}"
                                Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HistoryListRow}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding ElementoMostrar}" Style="{StaticResource HistoryValueLabel}" />
                                                    <Label Text="{Binding UnidadMostrar}" Style="{StaticResource ModernCaption}" />
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding CantidadElemento, StringFormat='{0:N4}'}"
                                                    FontFamily="MontserratBold"
                                                    FontSize="13"
                                                    TextColor="{StaticResource color_Cafe}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- REQUERIMIENTO ANUAL -->
                    <Border Style="{StaticResource HistoryCard}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Requerimiento anual" Style="{StaticResource ModernSectionTitle}" />
                                <Label
                                    Text="Resultados guardados ordenados por la necesidad calculada del cultivo."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Producción" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.RequerimientoAnual.CantidadQuintalesOro, StringFormat='{0:N2} qq oro'}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tamaño de finca" Style="{StaticResource ModernCaption}" />
                                        <Label Text="{Binding Detalle.RequerimientoAnual.TamanoFinca, StringFormat='{0:N2} mz'}" Style="{StaticResource HistoryValueLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Detalle.RequerimientoAnual.Elementos}"
                                Spacing="9">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HistoryListRow}">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label
                                                            Text="{Binding ElementoMostrar}"
                                                            FontFamily="MontserratBold"
                                                            FontSize="14"
                                                            TextColor="{StaticResource color_Verde}" />
                                                        <Label
                                                            Text="{Binding Clasificacion}"
                                                            FontFamily="MontserratBold"
                                                            FontSize="10.5"
                                                            TextColor="{StaticResource color_Cafe}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            Text="Requerimiento"
                                                            Style="{StaticResource ModernCaption}"
                                                            HorizontalTextAlignment="End" />
                                                        <Label
                                                            Text="{Binding RequerimientoCalculado, StringFormat='{0:N2} lb/Mz'}"
                                                            FontFamily="MontserratBold"
                                                            FontSize="13"
                                                            TextColor="{StaticResource color_Cafe}"
                                                            HorizontalTextAlignment="End" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <VerticalStackLayout>
                                                        <Label Text="Cantidad ingresada" Style="{StaticResource ModernCaption}" />
                                                        <Label Text="{Binding CantidadIngresada, StringFormat='{0:N4}'}" Style="{StaticResource HistoryValueLabel}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Cantidad en el suelo" Style="{StaticResource ModernCaption}" />
                                                        <Label Text="{Binding CantidadConvertidaLbMz, StringFormat='{0:N2} lb/Mz'}" Style="{StaticResource HistoryValueLabel}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Label
                                                    Text="{Binding Observacion}"
                                                    Style="{StaticResource ModernCaption}"
                                                    LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border Style="{StaticResource HistorySuccessPanel}">
                                <VerticalStackLayout Spacing="5">
                                    <Label
                                        Text="Recomendación general"
                                        FontFamily="MontserratBold"
                                        FontSize="13"
                                        TextColor="{StaticResource color_Verde}" />
                                    <Label
                                        Text="{Binding Detalle.RequerimientoAnual.RecomendacionGeneral}"
                                        FontFamily="MontserratMedium"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Detalle.RequerimientoAnual.Observaciones}"
                                Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HistoryWarningPanel}">
                                            <Label
                                                Text="{Binding .}"
                                                FontFamily="MontserratMedium"
                                                FontSize="11.5"
                                                TextColor="#9A3412"
                                                LineBreakMode="WordWrap" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CÁLCULOS COMPLEMENTARIOS -->
                    <VerticalStackLayout
                        x:Name="ContenedorCalculos"
                        IsVisible="False"
                        Spacing="14">

                        <Border Style="{StaticResource HistorySectionHero}">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Cálculos complementarios"
                                    FontFamily="MontserratBold"
                                    FontSize="{OnIdiom Phone=19, Tablet=21, Desktop=22}"
                                    TextColor="White" />
                                <Label
                                    Text="Visualización de Balance, Enmienda y Fertilización mixta guardados."
                                    FontFamily="MontserratMedium"
                                    FontSize="12"
                                    TextColor="White"
                                    Opacity="0.9"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Button
                                    x:Name="BalanceTabButton"
                                    Text="Balance"
                                    Clicked="BalanceTabButton_Clicked"
                                    Style="{StaticResource AnalysisTabButton}"
                                    MinimumWidthRequest="{OnIdiom Phone=104, Default=130}" />
                                <Button
                                    x:Name="EnmiendaTabButton"
                                    Text="Enmienda"
                                    Clicked="EnmiendaTabButton_Clicked"
                                    Style="{StaticResource AnalysisTabButton}"
                                    MinimumWidthRequest="{OnIdiom Phone=104, Default=130}" />
                                <Button
                                    x:Name="MixtaTabButton"
                                    Text="Mixta"
                                    Clicked="MixtaTabButton_Clicked"
                                    Style="{StaticResource AnalysisTabButton}"
                                    MinimumWidthRequest="{OnIdiom Phone=104, Default=130}" />
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- BALANCE -->
                        <VerticalStackLayout
                            x:Name="BalancePanel"
                            IsVisible="False"
                            Spacing="12">

                            <Border Style="{StaticResource HistoryCard}">
                                <VerticalStackLayout Spacing="11">
                                    <Label Text="Balance de fórmula" Style="{StaticResource ModernSectionTitle}" />
                                    <Label
                                        Text="{Binding Detalle.BalanceNutricional.Formula.NombreFormula}"
                                        FontFamily="MontserratBold"
                                        FontSize="15"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Border Style="{StaticResource HistorySuccessPanel}">
                                        <Label
                                            Text="{Binding Detalle.BalanceNutricional.Formula.EsComplementoFertilizacionMixta, Converter={StaticResource ModoBalanceConverter}}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}"
                                            LineBreakMode="WordWrap" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Total de plantas" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.TotalPlantas, StringFormat='{0:N0}'}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Aplicaciones" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.TotalAplicaciones}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Total mezcla" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.MezclaTotalQq, StringFormat='{0:N2} qq'}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Total libras" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.TotalLibras, StringFormat='{0:N2} lb'}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Dosis anual por planta" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.DosisPlantaAnualOz, StringFormat='{0:N4} oz'}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HistoryMetric}">
                                            <VerticalStackLayout><Label Text="Dosis por aplicación" Style="{StaticResource ModernCaption}" /><Label Text="{Binding Detalle.BalanceNutricional.Formula.DosisPlantaPorAplicacionOz, StringFormat='{0:N4} oz'}" Style="{StaticResource HistoryValueLabel}" /></VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource HistoryCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Cuadro de fórmula" Style="{StaticResource ModernSectionTitle}" />
                                    <Label Text="Deslice horizontalmente para consultar todas las cantidades guardadas." Style="{StaticResource ModernCaption}" />
                                    <ScrollView Orientation="Horizontal">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="180,110,95,145,120,120,120,120" MinimumWidthRequest="1010" BackgroundColor="{StaticResource color_Verde}">
                                                <Label Grid.Column="0" Text="Fuente / elemento" Style="{StaticResource HistoryTableHeader}" />
                                                <Label Grid.Column="1" Text="Libras" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="2" Text="QQ" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="3" Text="Requerimiento" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="4" Text="Precio/QQ" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="5" Text="Subtotal" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="6" Text="Oz anuales" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="7" Text="Oz/aplicación" Style="{StaticResource HistoryTableHeaderRight}" />
                                            </Grid>
                                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Detalle.BalanceNutricional.Detalles}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="180,110,95,145,120,120,120,120" MinimumWidthRequest="1010" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}">
                                                            <VerticalStackLayout Grid.Column="0" Padding="8,6" Spacing="1">
                                                                <Label Text="{Binding FuenteMostrar}" FontFamily="MontserratBold" FontSize="11.5" />
                                                                <Label Text="{Binding ElementoMostrar}" Style="{StaticResource ModernCaption}" />
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="1" Text="{Binding Libras, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="2" Text="{Binding Qq, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="3" Text="{Binding RequerimientoLibras, StringFormat='{0:N2} lb'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="4" Text="{Binding PrecioPorQuintal, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="5" Text="{Binding SubtotalFuente, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                            <Label Grid.Column="6" Text="{Binding OnzasAnuales, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="7" Text="{Binding OnzasPorAplicacion, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource HistoryCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Resumen de costos" Style="{StaticResource ModernSectionTitle}" />
                                    <Label Text="El costo de compra utiliza quintales enteros; el subtotal exacto se conserva como referencia." Style="{StaticResource ModernCaption}" />
                                    <ScrollView Orientation="Horizontal">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="180,100,100,115,120,130,135" MinimumWidthRequest="880" BackgroundColor="#5F6663">
                                                <Label Grid.Column="0" Text="Fuente" Style="{StaticResource HistoryTableHeader}" />
                                                <Label Grid.Column="1" Text="Libras" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="2" Text="QQ exactos" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="3" Text="QQ comprar" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="4" Text="Precio/QQ" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="5" Text="Subtotal exacto" Style="{StaticResource HistoryTableHeaderRight}" />
                                                <Label Grid.Column="6" Text="Costo compra" Style="{StaticResource HistoryTableHeaderRight}" />
                                            </Grid>
                                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Detalle.BalanceNutricional.Detalles}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="180,100,100,115,120,130,135" MinimumWidthRequest="880" BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}">
                                                            <Label Grid.Column="0" Text="{Binding FuenteMostrar}" Style="{StaticResource HistoryTableCellStrong}" />
                                                            <Label Grid.Column="1" Text="{Binding Libras, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="2" Text="{Binding Qq, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="3" Text="{Binding Qq, Converter={StaticResource QuintalesCompraConverter}, StringFormat='{0:N0}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                            <Label Grid.Column="4" Text="{Binding PrecioPorQuintal, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="5" Text="{Binding SubtotalFuente, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRight}" />
                                                            <Label Grid.Column="6" Style="{StaticResource HistoryTableCellRightStrong}" TextColor="{StaticResource color_Cafe}">
                                                                <Label.Text>
                                                                    <MultiBinding Converter="{StaticResource CostoCompraFuenteConverter}" StringFormat="C$ {0:N2}">
                                                                        <Binding Path="Qq" />
                                                                        <Binding Path="PrecioPorQuintal" />
                                                                    </MultiBinding>
                                                                </Label.Text>
                                                            </Label>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Grid ColumnDefinitions="180,100,100,115,120,130,135" MinimumWidthRequest="880" BackgroundColor="{AppThemeBinding Light=#DDEBE5, Dark={StaticResource SurfaceMutedDark}}">
                                                <Label Grid.Column="0" Text="Total" Style="{StaticResource HistoryTableCellStrong}" TextColor="{StaticResource color_Verde}" />
                                                <Label Grid.Column="1" Text="{Binding Detalle.BalanceNutricional.Detalles, Converter={StaticResource BalanceResumenTotalConverter}, ConverterParameter=Libras, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                <Label Grid.Column="2" Text="{Binding Detalle.BalanceNutricional.Detalles, Converter={StaticResource BalanceResumenTotalConverter}, ConverterParameter=QqExactos, StringFormat='{0:N2}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                <Label Grid.Column="3" Text="{Binding Detalle.BalanceNutricional.Detalles, Converter={StaticResource BalanceResumenTotalConverter}, ConverterParameter=QqCompra, StringFormat='{0:N0}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                <Label Grid.Column="4" Text="—" Style="{StaticResource HistoryTableCellRight}" />
                                                <Label Grid.Column="5" Text="{Binding Detalle.BalanceNutricional.Detalles, Converter={StaticResource BalanceResumenTotalConverter}, ConverterParameter=SubtotalExacto, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRightStrong}" />
                                                <Label Grid.Column="6" Text="{Binding Detalle.BalanceNutricional.Detalles, Converter={StaticResource BalanceResumenTotalConverter}, ConverterParameter=CostoCompra, StringFormat='C$ {0:N2}'}" Style="{StaticResource HistoryTableCellRightStrong}" TextColor="{StaticResource color_Cafe}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource HistoryCard}">
