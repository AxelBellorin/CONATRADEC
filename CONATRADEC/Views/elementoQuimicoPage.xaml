<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.elementoQuimicoPage"
    x:Name="ElementoQuimicoPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{OnPlatform WinUI='Transparent', Default={StaticResource color_Blanco}}">

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>

            <Grid
                IsVisible="{Binding MostrarAccesoDenegado}"
                Padding="24">

                <Border
                    MaximumWidthRequest="620"
                    Padding="28"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Image
                            Source="iconpermission.png"
                            WidthRequest="64"
                            HeightRequest="64"
                            Opacity="0.65" />

                        <Label
                            Text="Sin permiso de lectura"
                            FontSize="21"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Negro}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Su usuario no tiene permiso para consultar los elementos químicos."
                            FontSize="14"
                            TextColor="{StaticResource color_GrisOscuro}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Regresar a configuración"
                            Padding="16,10"
                            BackgroundColor="{StaticResource color_Verde}"
                            TextColor="White"
                            CornerRadius="11"
                            Command="{Binding RegresarConfiguracionCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid
                IsVisible="{Binding CanView}"
                Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="14">

                <controls:ResponsiveCatalogHeader
                    Grid.Row="0"
                    Title="Elementos químicos"
                    Subtitle="Administre los nutrientes utilizados en análisis, rangos, fuentes y cálculos."
                    BackText="← Configuración"
                    BackCommand="{Binding RegresarConfiguracionCommand}"
                    PrimaryText="+ Nuevo elemento"
                    PrimaryCommand="{Binding AddCommand}"
                    IsPrimaryVisible="{Binding CanAdd}" />

                <!-- Búsqueda -->
                <controls:ResponsiveSearchPanel
                    Grid.Row="1"
                    Placeholder="Buscar por nombre o símbolo"
                    SearchText="{Binding TextoBusqueda, Mode=TwoWay}"
                    SummaryText="{Binding ResumenResultados}"
                    SearchCommand="{Binding BuscarCommand}"
                    ClearCommand="{Binding LimpiarFiltrosCommand}" />
                <Border
                    Grid.Row="2"
                    IsVisible="{Binding TieneMensaje}"
                    Padding="12"
                    BackgroundColor="#FFF7E6"
                    Stroke="#F2C94C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="13"
                        TextColor="{StaticResource color_Negro}" />
                </Border>

                <RefreshView
                    Grid.Row="3"
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefrescarCommand}">

                    <CollectionView
                        ItemsSource="{Binding List}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                x:Name="ElementosGridLayout"
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Grid Padding="30">
                                <VerticalStackLayout
                                    IsVisible="{Binding MostrarVacio}"
                                    Spacing="8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Image
                                        Source="iconchemicalelement.png"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        Opacity="0.5" />

                                    <Label
                                        Text="No se encontraron elementos químicos"
                                        FontSize="18"
                                        FontFamily="MontserratBold"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource color_Negro}"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Pruebe con otro nombre o símbolo, o registre un nuevo elemento."
                                        FontSize="13"
                                        TextColor="{StaticResource color_GrisOscuro}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ElementoQuimicoResponse">

                                <Border
                                    Padding="16"
                                    MinimumHeightRequest="166"
                                    BackgroundColor="White"
                                    Stroke="#DDE7E3"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16">

                                    <Grid
                                        RowDefinitions="*,Auto"
                                        RowSpacing="14">

                                        <Grid
                                            Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">

                                            <Border
                                                WidthRequest="58"
                                                HeightRequest="58"
                                                BackgroundColor="#EEF5F2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 15">

                                                <Label
                                                    Text="{Binding SimboloElementoQuimico}"
                                                    FontSize="20"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Verde}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    HorizontalTextAlignment="Center" />
                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding NombreElementoQuimico}"
                                                    FontSize="17"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource color_Negro}"
                                                    LineBreakMode="TailTruncation" />

                                                <!-- Siempre muestra exactamente dos decimales. -->
                                                <Label
                                                    Text="{Binding PesoEquivalenteFormateado}"
                                                    FontSize="13"
                                                    TextColor="{StaticResource color_GrisOscuro}" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="2"
                                                Text="Activo"
                                                Padding="9,5"
                                                FontSize="11"
                                                TextColor="{StaticResource color_Verde}"
                                                BackgroundColor="#EAF7EF"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="8">

                                            <Button
                                                Grid.Column="0"
                                                Text="Ver"
                                                Padding="8,9"
                                                BackgroundColor="#EEF5F2"
                                                TextColor="{StaticResource color_Verde}"
                                                CornerRadius="10"
                                                Command="{Binding Source={x:Reference ElementoQuimicoPageRoot}, Path=BindingContext.ViewCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource BlueUpdate}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                IsVisible="{Binding Source={x:Reference ElementoQuimicoPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference ElementoQuimicoPageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Padding="8,9"
                                                BackgroundColor="{StaticResource RedDelete}"
                                                TextColor="White"
                                                CornerRadius="10"
                                                IsVisible="{Binding Source={x:Reference ElementoQuimicoPageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference ElementoQuimicoPageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <VerticalStackLayout
                                Padding="10,16,10,24"
                                Spacing="8"
                                HorizontalOptions="Center">

                                <ActivityIndicator
                                    IsRunning="{Binding CargandoMas}"
                                    IsVisible="{Binding CargandoMas}"
                                    Color="{StaticResource color_Naranja}" />

                                <Label
                                    IsVisible="{Binding MostrarFinLista}"
                                    Text="Fin del listado"
                                    FontSize="12"
                                    TextColor="{StaticResource color_GrisOscuro}" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>

                <Grid
                    Grid.RowSpan="4"
                    IsVisible="{Binding IsBusy}"
                    InputTransparent="True"
                    BackgroundColor="#40FFFFFF">

                    <Border
                        Padding="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Stroke="#DDE7E3"
                        StrokeShape="RoundRectangle 14">

                        <HorizontalStackLayout Spacing="10">
                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource color_Naranja}" />

                            <Label
                                Text="Cargando elementos químicos..."
                                VerticalOptions="Center"
                                TextColor="{StaticResource color_Negro}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
