<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.MainPage"
    x:Name="MainPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    xmlns:models="clr-namespace:CONATRADEC.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <ContentView
            x:Name="ContenidoPrincipal"
            ControlTemplate="{StaticResource FooterTemplate}">

            <Grid RowDefinitions="Auto,*">
                <!--
                    El encabezado y la búsqueda permanecen fuera del CollectionView
                    para evitar re-mediciones del SearchBar en WinUI.
                -->
                <VerticalStackLayout
                    x:Name="EncabezadoPrincipal"
                    Grid.Row="0"
                    Margin="12,12,12,8"
                    Spacing="10">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="Análisis de suelo"
                                    Style="{StaticResource ModernPageTitle}" />

                                <Label
                                    Text="{Binding TotalMostradoTexto}"
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="+ Nuevo análisis"
                                Style="{StaticResource ModernPrimaryButton}"
                                HeightRequest="46"
                                MinimumWidthRequest="0"
                                Padding="10,9"
                                FontSize="11"
                                Command="{Binding NuevoAnalisisCommand}"
                                IsVisible="{Binding CanAdd}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border
                        IsVisible="{Binding SeHaListado}"
                        Style="{StaticResource ModernCard}"
                        Padding="8">
                        <Border Style="{StaticResource ModernInputBorder}">
                            <SearchBar
                                Text="{Binding TextoBusqueda}"
                                SearchCommand="{Binding BuscarCommand}"
                                Placeholder="Buscar cliente, laboratorio, usuario o terreno"
                                Style="{StaticResource ModernSearchBar}" />
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <RefreshView
                    Grid.Row="1"
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding ActualizarCommand}">

                    <CollectionView
                        x:Name="AnalisisCollectionView"
                        Margin="12,0,12,0"
                        ItemsSource="{Binding AnalisisGuardados}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem">

                        <!--
                            El número de columnas depende del ancho útil real de
                            las tarjetas, no del tipo de dispositivo.
                        -->
                        <CollectionView.Behaviors>
                            <controls:ResponsiveGridItemsLayoutBehavior />
                        </CollectionView.Behaviors>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="1"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.Header>
                            <VerticalStackLayout
                                Padding="0,4,0,12"
                                Spacing="12">

                                <!--
                                    Cambiar el alcance solo modifica filtros escritos.
                                    La consulta se ejecuta únicamente al presionar
                                    Aplicar filtros / Buscar.
                                -->
                                <Border
                                    IsVisible="{Binding MostrarSelectorAlcance}"
                                    Style="{StaticResource ModernCard}">

                                    <VerticalStackLayout Spacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                Text="Alcance del listado"
                                                Style="{StaticResource ModernSectionTitle}" />
                                            <Label
                                                Text="Seleccione el alcance y presione Aplicar filtros para consultar."
                                                Style="{StaticResource ModernPageSubtitle}" />
                                        </VerticalStackLayout>

                                        <Border Style="{StaticResource ModernInputBorder}">
                                            <Picker
                                                ItemsSource="{Binding OpcionesAlcanceListado}"
                                                SelectedItem="{Binding AlcanceListadoSeleccionado, Mode=TwoWay}"
                                                Style="{StaticResource ModernPicker}" />
                                        </Border>

                                        <Button
                                            Text="{Binding TextoBotonListar}"
                                            Command="{Binding ListarCommand}"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    IsVisible="{Binding CargandoListado}"
                                    Style="{StaticResource ModernSoftPanel}"
                                    HorizontalOptions="Fill">
                                    <HorizontalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="9">
                                        <ActivityIndicator
                                            IsRunning="{Binding CargandoListado}"
                                            Color="{StaticResource color_Verde}"
                                            WidthRequest="22"
                                            HeightRequest="22" />
                                        <Label
                                            Text="Actualizando análisis..."
                                            VerticalOptions="Center"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            TextColor="{StaticResource color_Verde}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border
                                    IsVisible="{Binding SeHaListado}"
                                    Style="{StaticResource ModernCard}">

                                    <VerticalStackLayout Spacing="12">
                                        <Grid
                                            x:Name="FiltrosCabeceraGrid"
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="7">
                                            <VerticalStackLayout
                                                x:Name="FiltrosTituloContenedor"
                                                Spacing="2">
                                                <Label
                                                    Text="Filtros adicionales"
                                                    Style="{StaticResource ModernSectionTitle}" />
                                                <Label
                                                    Text="Los cambios no consultan el servidor hasta presionar Buscar."
                                                    Style="{StaticResource ModernPageSubtitle}" />
                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Column="1"
                                                Text="Buscar"
                                                Command="{Binding BuscarCommand}"
                                                Style="{StaticResource ModernPrimaryButton}"
                                                HeightRequest="40"
                                                MinimumWidthRequest="0"
                                                Padding="10,7"
                                                VerticalOptions="Center" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Limpiar"
                                                Command="{Binding LimpiarFiltrosCommand}"
                                                Style="{StaticResource ModernNeutralButton}"
                                                HeightRequest="40"
                                                MinimumWidthRequest="0"
                                                Padding="10,7"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <VerticalStackLayout
                                            IsVisible="{Binding PuedeFiltrarPorUsuario}"
                                            Spacing="5">
                                            <Label
                                                Text="Usuario"
                                                Style="{StaticResource ModernFieldLabel}" />
                                            <Border Style="{StaticResource ModernInputBorder}">
                                                <Picker
                                                    ItemsSource="{Binding UsuariosFiltro}"
                                                    SelectedItem="{Binding UsuarioFiltroSeleccionado, Mode=TwoWay}"
                                                    ItemDisplayBinding="{Binding TextoMostrar}"
                                                    Style="{StaticResource ModernPicker}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                            <CheckBox
                                                IsChecked="{Binding UsarFiltroRangoFecha}"
                                                Color="{StaticResource color_Verde}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="Filtrar por fecha de guardado"
                                                VerticalOptions="Center"
                                                FontFamily="MontserratBold"
                                                FontSize="12"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Grid>

                                        <Grid
                                            x:Name="RangoFechasGrid"
                                            IsVisible="{Binding UsarFiltroRangoFecha}"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="10">

                                            <VerticalStackLayout x:Name="FechaDesdeContenedor" Spacing="5">
                                                <Label
                                                    Text="Desde"
                                                    Style="{StaticResource ModernFieldLabel}" />
                                                <Border Style="{StaticResource ModernInputBorder}">
                                                    <DatePicker
                                                        Date="{Binding FechaDesde}"
                                                        Format="dd/MM/yyyy"
                                                        Style="{StaticResource ModernDatePicker}" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                x:Name="FechaHastaContenedor"
                                                Grid.Column="1"
                                                Spacing="5">
                                                <Label
                                                    Text="Hasta"
                                                    Style="{StaticResource ModernFieldLabel}" />
                                                <Border Style="{StaticResource ModernInputBorder}">
                                                    <DatePicker
                                                        Date="{Binding FechaHasta}"
                                                        Format="dd/MM/yyyy"
                                                        Style="{StaticResource ModernDatePicker}" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label
                                            Text="{Binding ErrorRangoFecha}"
                                            IsVisible="{Binding TieneErrorRangoFecha}"
                                            TextColor="{StaticResource RedDelete}"
                                            FontFamily="MontserratBold"
                                            FontSize="11" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    IsVisible="{Binding TieneMensaje}"
                                    Padding="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}"
                                    Stroke="#F1C7C9"
                                    StrokeShape="RoundRectangle 12">
                                    <Label
                                        Text="{Binding Mensaje}"
                                        FontFamily="MontserratMedium"
                                        TextColor="{AppThemeBinding Light=#982F33, Dark=#F4B7B9}"
                                        FontSize="12" />
                                </Border>

                                <Border
                                    IsVisible="{Binding MostrarEsperaInicial}"
                                    Style="{StaticResource ModernSoftPanel}">
                                    <VerticalStackLayout
                                        Padding="10,14"
                                        Spacing="5"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding MensajeListaVacia}"
                                            FontFamily="MontserratBold"
                                            FontSize="17"
                                            TextColor="{StaticResource color_Verde}"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="{Binding SubtituloListaVacia}"
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    IsVisible="{Binding MostrarListaVacia}"
                                    Style="{StaticResource ModernSoftPanel}">
                                    <VerticalStackLayout
                                        Padding="12,16"
                                        Spacing="4"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="No hay análisis para mostrar"
                                            FontFamily="MontserratBold"
                                            FontSize="17"
                                            TextColor="{StaticResource color_Verde}"
                                            HorizontalTextAlignment="Center" />
                                        <Label
                                            Text="Pruebe ajustando los filtros o actualizando la lista."
                                            Style="{StaticResource ModernPageSubtitle}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AnalisisGuardadoResumen">
                                <Border
                                    Style="{StaticResource ModernCard}"
                                    Padding="14"
                                    Margin="0,2">

                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                        RowSpacing="10">

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding IdentificadorMostrar}"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="17"
                                                    TextColor="{StaticResource color_Verde}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding ClienteMostrar}"
                                                    FontFamily="MontserratBold"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding TerrenoMostrar}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="11"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding UsuarioMostrar, StringFormat='Usuario: {0}'}"
                                                    IsVisible="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.EsAdministrador}"
                                                    FontFamily="MontserratMedium"
                                                    FontSize="10"
                                                    TextColor="{StaticResource color_Cafe}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                Padding="8,6"
                                                VerticalOptions="Start">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label
                                                        Text="LABORATORIO"
                                                        FontFamily="MontserratBold"
                                                        FontSize="8"
                                                        CharacterSpacing="0.6"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                        HorizontalTextAlignment="Center" />
                                                    <Label
                                                        Text="{Binding FechaAnalisisTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="11"
                                                        TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">
                                            <Label
                                                Text="{Binding LaboratorioMostrar, StringFormat='Laboratorio: {0}'}"
                                                FontFamily="MontserratMedium"
                                                FontSize="10.5"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding FechaRegistroTexto, StringFormat='Guardado: {0}'}"
                                                FontFamily="MontserratBold"
                                                FontSize="10.5"
                                                TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}"
                                                HorizontalTextAlignment="End" />
                                        </Grid>

                                        <BoxView
                                            Grid.Row="2"
                                            HeightRequest="1"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}" />

                                        <Grid
                                            Grid.Row="3"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="6">

                                            <Border Style="{StaticResource ModernMetricSurface}">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                                        Text="pH"
                                                        FontFamily="MontserratMedium"
                                                        FontSize="9.5"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    <Label
                                                        Text="{Binding PhTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="15"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Style="{StaticResource ModernMetricSurface}">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                                        Text="Finca"
                                                        FontFamily="MontserratMedium"
                                                        FontSize="9.5"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    <Label
                                                        Text="{Binding TamanoFincaTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="15"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border
                                                Grid.Column="2"
                                                Style="{StaticResource ModernMetricSurface}">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label
                                                        Text="Producción"
                                                        FontFamily="MontserratMedium"
                                                        FontSize="9.5"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                                    <Label
                                                        Text="{Binding ProduccionTexto}"
                                                        FontFamily="MontserratBold"
                                                        FontSize="13"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <FlexLayout
                                            Grid.Row="4"
                                            Direction="Row"
                                            Wrap="Wrap"
                                            AlignItems="Center">

                                            <Border
                                                IsVisible="{Binding TieneFormulaNutricional}"
                                                Style="{StaticResource ModernBadgeGreen}"
                                                Margin="0,0,6,5">
                                                <Label
                                                    Text="✓ Balance"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10"
                                                    TextColor="{AppThemeBinding Light={StaticResource color_Verde}, Dark=#BFD8CF}" />
                                            </Border>

                                            <Border
                                                IsVisible="{Binding TieneEnmiendaCalcarea}"
                                                Style="{StaticResource ModernBadgeCoffee}"
                                                Margin="0,0,6,5">
                                                <Label
                                                    Text="✓ Enmienda"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10"
                                                    TextColor="{AppThemeBinding Light={StaticResource color_Cafe}, Dark=#E9B897}" />
                                            </Border>

                                            <Border
                                                IsVisible="{Binding TieneFertilizacionMixta}"
                                                Style="{StaticResource ModernBadgeYellow}"
                                                Margin="0,0,6,5">
                                                <Label
                                                    Text="✓ Mixta"
                                                    FontFamily="MontserratBold"
                                                    FontSize="10"
                                                    TextColor="{AppThemeBinding Light=#765C00, Dark=#F1D978}" />
                                            </Border>
                                        </FlexLayout>

                                        <!--
                                            MinimumWidthRequest=0 evita el ancho mínimo nativo de
                                            Button en WinUI cuando la ventana se vuelve estrecha.
                                        -->
                                        <Grid
                                            Grid.Row="5"
                                            Margin="0,1,0,0"
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="6"
                                            HorizontalOptions="Fill">

                                            <Button
                                                Text="Ver"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="5,8"
                                                IsVisible="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.CanView}"
                                                Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.VisualizarCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Editar"
                                                Style="{StaticResource ModernUpdateButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="5,8"
                                                IsVisible="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.CanEdit}"
                                                Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}" />

                                            <Button
                                                Grid.Column="2"
                                                Text="Eliminar"
                                                Style="{StaticResource ModernDangerButton}"
                                                MinimumWidthRequest="0"
                                                HorizontalOptions="Fill"
                                                Padding="5,8"
                                                IsVisible="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.CanDelete}"
                                                Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Paginación explícita: nunca se anexan páginas. -->
                        <CollectionView.Footer>
                            <Border
                                x:Name="PaginacionAnalisis"
                                IsVisible="{Binding MostrarPaginacion}"
                                Margin="0,16,0,24"
                                Padding="12"
                                Style="{StaticResource ModernCatalogCard}"
                                MaximumWidthRequest="560"
                                HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="11">
                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding PaginaTexto}"
                                            FontFamily="MontserratBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label
                                            Text="{Binding RangoPaginaTexto}"
                                            FontFamily="MontserratMedium"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="8">
                                        <Button
                                            Grid.Column="0"
                                            Text="← Anterior"
                                            Clicked="PaginacionAnalisis_Clicked"
                                            Command="{Binding PaginaAnteriorCommand}"
                                            IsEnabled="{Binding PuedeIrAnterior}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Siguiente →"
                                            Clicked="PaginacionAnalisis_Clicked"
                                            Command="{Binding PaginaSiguienteCommand}"
                                            IsEnabled="{Binding PuedeIrSiguiente}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            MinimumWidthRequest="0"
                                            HorizontalOptions="Fill"
                                            Padding="6,8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </ContentView>

        <ContentView
            x:Name="ContenidoSinPermiso"
            IsVisible="False"
            ControlTemplate="{StaticResource FooterTemplate}">
            <Grid Padding="24">
                <Border
                    MaximumWidthRequest="540"
                    Style="{StaticResource ModernCard}"
                    Padding="26"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10">
                        <Border
                            WidthRequest="54"
                            HeightRequest="54"
                            Padding="12"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 18">
                            <Image
                                Source="iconhome.png"
                                Aspect="AspectFit" />
                        </Border>

                        <Label
                            Text="Sin permisos asignados"
                            FontFamily="MontserratBold"
                            FontSize="22"
                            TextColor="{StaticResource color_Verde}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Su usuario está activo, pero su rol no tiene permiso para visualizar análisis de suelo."
                            Style="{StaticResource ModernPageSubtitle}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ContentView>

        <Grid
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#660B1511"
            InputTransparent="False">
            <Border
                Padding="24,20"
                MinimumWidthRequest="190"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceRaisedDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource color_Verde}"
                        WidthRequest="34"
                        HeightRequest="34" />
                    <Label
                        Text="Cargando datos..."
                        FontFamily="MontserratBold"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
