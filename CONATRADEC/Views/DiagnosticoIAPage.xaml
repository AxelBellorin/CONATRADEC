<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    BackgroundColor="#F7F8F7">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid
            Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <controls:ResponsiveCatalogHeader
                Grid.Row="0"
                Title="Inspección fitosanitaria"
                Subtitle="Recorridos de campo, análisis visual por fotografía y validación humana."
                BackText="← Inicio"
                BackCommand="{Binding RegresarCommand}"
                PrimaryText="Nueva inspección"
                PrimaryCommand="{Binding NuevaInspeccionCommand}"
                IsPrimaryVisible="{Binding PuedeNuevaInspeccion}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    Spacing="16"
                    MaximumWidthRequest="1100"
                    HorizontalOptions="Center">

                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='*,*', Default='*'}"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="14"
                        RowSpacing="14">

                        <Border Grid.Row="0" Grid.Column="0" Padding="18" BackgroundColor="White" Stroke="#C8DED6" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeNuevaInspeccion}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nueva inspección" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Seleccione un terreno, capture fotografías y comience el análisis individual de cada evidencia." TextColor="#5E6B67" />
                                <Button Text="Iniciar inspección" Command="{Binding NuevaInspeccionCommand}" BackgroundColor="#3B655B" TextColor="White" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnPlatform WinUI=0, Default=1}" Grid.Column="{OnPlatform WinUI=1, Default=0}" Padding="18" BackgroundColor="White" Stroke="#C8DED6" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeMisInspecciones}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Mis inspecciones" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Consulte solicitudes propias, progreso, errores y resultados en una pantalla independiente." TextColor="#5E6B67" />
                                <Button Text="Consultar mis inspecciones" Command="{Binding MisInspeccionesCommand}" BackgroundColor="#E3EFEA" TextColor="#3B655B" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnPlatform WinUI=1, Default=2}" Grid.Column="0" Padding="18" BackgroundColor="#FFF9E8" Stroke="#E2B93B" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeDecisiones}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Decisiones pendientes" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Revise la respuesta preliminar antes de enviarla al analizador, solicitar otra evaluación o cerrar la solicitud." TextColor="#5E6B67" />
                                <Button Text="Revisar decisiones" Command="{Binding DecisionesPendientesCommand}" BackgroundColor="#F2C94C" TextColor="#263A35" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnPlatform WinUI=1, Default=3}" Grid.Column="{OnPlatform WinUI=1, Default=0}" Padding="18" BackgroundColor="White" Stroke="#E3D1C6" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeAnalizador}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Bandeja del analizador" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Revise la evidencia, vincule cada fotografía con el catálogo oficial y prepare el caso para aprobación." TextColor="#5E6B67" />
                                <Button Text="Abrir bandeja" Command="{Binding AbrirAnalizadorCommand}" BackgroundColor="#9B552C" TextColor="White" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnPlatform WinUI=2, Default=4}" Grid.Column="0" Padding="18" BackgroundColor="White" Stroke="#D9E3DF" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeAprobador}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Bandeja del aprobador" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Apruebe, devuelva o rechace la evaluación humana y autorice nuevas fichas o fotografías para el álbum." TextColor="#5E6B67" />
                                <Button Text="Abrir aprobaciones" Command="{Binding AbrirAprobadorCommand}" BackgroundColor="#263A35" TextColor="White" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnPlatform WinUI=2, Default=5}" Grid.Column="{OnPlatform WinUI=1, Default=0}" Padding="18" BackgroundColor="White" Stroke="#D9E3DF" StrokeShape="RoundRectangle 15" IsVisible="{Binding PuedeHistorial}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Historial" FontSize="20" FontAttributes="Bold" TextColor="#263A35" />
                                <Label Text="Consulte inspecciones aprobadas, rechazadas, canceladas, no concluyentes o publicadas." TextColor="#5E6B67" />
                                <Button Text="Consultar historial" Command="{Binding HistorialCommand}" BackgroundColor="#EEF2F0" TextColor="#263A35" CornerRadius="11" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border
                        Padding="18"
                        BackgroundColor="#FFF9E8"
                        Stroke="#E2B93B"
                        StrokeShape="RoundRectangle 14"
                        IsVisible="{Binding SinOpciones}">
                        <Label
                            Text="Su rol no tiene opciones disponibles dentro de este módulo. Solicite los permisos correspondientes al administrador."
                            TextColor="#6B5710"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentView>
</ContentPage>
