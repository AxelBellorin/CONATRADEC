<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.DiagnosticoIAPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CONATRADEC.Controls"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentView ControlTemplate="{StaticResource FooterTemplate}">
        <Grid>
            <ScrollView>
                <VerticalStackLayout
                    Padding="{OnIdiom Phone='14,14,14,22', Tablet='20,18,20,26', Desktop='26,22,26,28'}"
                    Spacing="16"
                    MaximumWidthRequest="1160"
                    HorizontalOptions="Center">

                    <!-- El encabezado forma parte del scroll para liberar espacio en móvil. -->
                    <controls:InspectionHeader
                        Title="Inspección fitosanitaria"
                        Subtitle="Recorridos de campo, análisis visual por fotografía y validación humana."
                        BackText="← Inicio"
                        BackCommand="{Binding RegresarCommand}"
                        PrimaryText="Nueva inspección"
                        PrimaryCommand="{Binding NuevaInspeccionCommand}"
                        IsPrimaryVisible="{Binding PuedeNuevaInspeccion}" />

                    <Border Style="{StaticResource InspectionGreenPanel}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{StaticResource color_Verde}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 13">
                                <Label
                                    Text="✓"
                                    TextColor="White"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label
                                    Text="Flujo fitosanitario"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="{StaticResource color_Verde}" />
                                <Label
                                    Text="Capture evidencia en campo, dé seguimiento al diagnóstico y complete las revisiones humanas desde un mismo módulo."
                                    Style="{StaticResource InspectionSubtitle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid
                        ColumnDefinitions="{OnPlatform WinUI='*,*', Default='*'}"
                        RowDefinitions="{OnPlatform WinUI='Auto,Auto,Auto', Default='Auto,Auto,Auto,Auto,Auto'}"
                        ColumnSpacing="14"
                        RowSpacing="14">

                        <Border
                            Grid.Row="{Binding FilaNuevaInspeccion}"
                            Grid.Column="{Binding ColumnaNuevaInspeccion}"
                            Style="{StaticResource InspectionCard}"
                            IsVisible="{Binding PuedeNuevaInspeccion}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource BrandGreenSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 13">
                                        <Label Text="{Binding NumeroNuevaInspeccion}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="{StaticResource color_Verde}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Nueva inspección" Style="{StaticResource InspectionTitle}" />
                                        <Label Text="Seleccione un terreno, capture fotografías y comience el análisis individual de cada evidencia." Style="{StaticResource InspectionSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="Iniciar inspección" Command="{Binding NuevaInspeccionCommand}" Style="{StaticResource InspectionPrimaryButton}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{Binding FilaMisInspecciones}"
                            Grid.Column="{Binding ColumnaMisInspecciones}"
                            Style="{StaticResource InspectionWarningPanel}"
                            IsVisible="{Binding PuedeMisInspecciones}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource color_Amarillo}" Stroke="Transparent" StrokeShape="RoundRectangle 13">
                                        <Label Text="{Binding NumeroMisInspecciones}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Mis inspecciones" Style="{StaticResource InspectionTitle}" />
                                        <Label Text="Consulte progreso, resultados, errores, devoluciones y decisiones técnicas pendientes." Style="{StaticResource InspectionSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Button
                                    Text="Consultar mis inspecciones"
                                    Command="{Binding MisInspeccionesCommand}"
                                    HeightRequest="48"
                                    CornerRadius="13"
                                    BackgroundColor="{StaticResource color_Amarillo}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{Binding FilaAnalizador}"
                            Grid.Column="{Binding ColumnaAnalizador}"
                            Style="{StaticResource InspectionCoffeePanel}"
                            IsVisible="{Binding PuedeAnalizador}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource color_Cafe}" Stroke="Transparent" StrokeShape="RoundRectangle 13">
                                        <Label Text="{Binding NumeroAnalizador}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Bandeja del analizador" Style="{StaticResource InspectionTitle}" />
                                        <Label Text="Revise la evidencia, confirme o corrija cada clasificación y prepare las fotografías para aprobación." Style="{StaticResource InspectionSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="Abrir bandeja" Command="{Binding AbrirAnalizadorCommand}" Style="{StaticResource InspectionCoffeeButton}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{Binding FilaAprobador}"
                            Grid.Column="{Binding ColumnaAprobador}"
                            Style="{StaticResource InspectionCard}"
                            IsVisible="{Binding PuedeAprobador}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#263A35" Stroke="Transparent" StrokeShape="RoundRectangle 13">
                                        <Label Text="{Binding NumeroAprobador}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Bandeja del aprobador" Style="{StaticResource InspectionTitle}" />
                                        <Label Text="Apruebe, devuelva o rechace la evaluación humana y autorice su publicación." Style="{StaticResource InspectionSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Button
                                    Text="Abrir aprobaciones"
                                    Command="{Binding AbrirAprobadorCommand}"
                                    HeightRequest="48"
                                    CornerRadius="13"
                                    BackgroundColor="#263A35"
                                    TextColor="White"
                                    FontFamily="MontserratBold"
                                    FontAttributes="Bold"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="{Binding FilaHistorial}"
                            Grid.Column="{Binding ColumnaHistorial}"
                            Style="{StaticResource InspectionCard}"
                            IsVisible="{Binding PuedeHistorial}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource SurfaceMuted}" Stroke="{StaticResource BorderSoft}" StrokeShape="RoundRectangle 13">
                                    <Label Text="{Binding NumeroHistorial}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Historial" Style="{StaticResource InspectionTitle}" />
                                    <Label Text="Consulte inspecciones aprobadas, rechazadas, canceladas, no concluyentes o publicadas." Style="{StaticResource InspectionSubtitle}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="2"
                                    Text="Consultar"
                                    Command="{Binding HistorialCommand}"
                                    Style="{StaticResource InspectionNeutralButton}"
                                    MinimumWidthRequest="{OnIdiom Phone=104, Default=140}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        Style="{StaticResource InspectionWarningPanel}"
                        IsVisible="{Binding SinOpciones}">
                        <Label
                            Text="Su rol no tiene opciones disponibles dentro de este módulo. Solicite los permisos correspondientes al administrador."
                            TextColor="#6B5710"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Relay real: se muestra únicamente mientras el ViewModel navega. -->
            <Grid
                BackgroundColor="#66000000"
                IsVisible="{Binding IsBusy}"
                InputTransparent="False"
                ZIndex="50">
                <Border Style="{StaticResource InspectionOverlayCard}">
                    <VerticalStackLayout Spacing="12">
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{StaticResource color_Verde}"
                            WidthRequest="42"
                            HeightRequest="42" />
                        <Label
                            Text="Abriendo opción..."
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="La aplicación está preparando el flujo fitosanitario."
                            HorizontalTextAlignment="Center"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ContentView>
</ContentPage>
