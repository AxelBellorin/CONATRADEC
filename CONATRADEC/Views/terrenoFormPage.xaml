<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CONATRADEC.Views.terrenoFormPage"
    x:Name="TerrenoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Formulario de Terreno"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePage}, Dark={StaticResource SurfacePageDark}}">

    <Grid>
        <ScrollView HorizontalScrollBarVisibility="Never">
            <Grid
                Padding="{OnIdiom Phone='12,12,12,22', Tablet='20,18,20,28', Desktop='28,22,28,30'}"
                ColumnDefinitions="{OnIdiom Phone='0,*,0', Tablet='*,10*,*', Desktop='*,10*,*'}">

                <VerticalStackLayout
                    Grid.Column="1"
                    MaximumWidthRequest="1180"
                    HorizontalOptions="Fill"
                    Spacing="14">

                    <Border Style="{StaticResource ModernHeroCard}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Title}"
                                    Style="{StaticResource ModernPageTitle}"
                                    TextColor="{StaticResource color_Verde}" />
                                <Label
                                    Text="Seleccione un propietario registrado y complete la información de la finca."
                                    Style="{StaticResource ModernPageSubtitle}" />
                            </VerticalStackLayout>
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="{StaticResource color_Naranja}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModernInfoBanner}">
                        <Grid
                            ColumnDefinitions="{OnIdiom Phone='*', Tablet='Auto,*', Desktop='Auto,*'}"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="5">
                            <Border
                                Padding="10,5"
                                BackgroundColor="{StaticResource color_Verde}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9"
                                HorizontalOptions="Start">
                                <Label
                                    Text="CÓDIGO"
                                    FontFamily="MontserratBold"
                                    FontSize="10"
                                    TextColor="White" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                Spacing="2">
                                <Entry
                                    Placeholder="Se generará automáticamente al guardar"
                                    Text="{Binding CodigoTerreno, Mode=OneWay}"
                                    IsReadOnly="True"
                                    FontFamily="MontserratBold"
                                    FontSize="15"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    BackgroundColor="Transparent" />
                                <Label
                                    Text="El código lo asigna la API y no puede modificarse."
                                    Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Propietario normalizado -->
                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="13">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Propietario del terreno" Style="{StaticResource ModernSectionTitle}" />
                                    <Label
                                        Text="Los datos se administran en el módulo Propietarios y aquí solo se vincula la finca."
                                        Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Seleccionar"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Clicked="BtnSeleccionarPropietario_Clicked"
                                    IsVisible="{Binding AllowEdit}" />
                            </Grid>

                            <Border Style="{StaticResource ModernSoftPanel}">
                                <Grid
                                    ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    ColumnSpacing="14"
                                    RowSpacing="10">

                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Identificación" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PropietarioIdentificacion, TargetNullValue='No seleccionado'}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                        Spacing="3">
                                        <Label Text="Nombre completo" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PropietarioNombre, TargetNullValue='Seleccione un propietario'}"
                                            FontSize="13"
                                            FontFamily="MontserratBold"
                                            TextColor="{StaticResource color_Verde}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Row="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                                        Spacing="3">
                                        <Label Text="Teléfono" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PropietarioTelefono, TargetNullValue='Sin teléfono'}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                        Grid.Row="{OnIdiom Phone=3, Tablet=1, Desktop=1}"
                                        Spacing="3">
                                        <Label Text="Correo" Style="{StaticResource ModernCaption}" />
                                        <Label
                                            Text="{Binding PropietarioCorreo, TargetNullValue='Sin correo'}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Dirección detallada del terreno" Style="{StaticResource ModernFieldLabel}" />
                                <Border
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,6">
                                    <Editor
                                        Placeholder="Comunidad, comarca, referencias y vías de acceso"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="86"
                                        Text="{Binding DireccionTerreno, Mode=TwoWay}"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                        FontFamily="MontserratMedium"
                                        FontSize="13" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="13">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Información productiva" Style="{StaticResource ModernSectionTitle}" />
                                <Label Text="Datos utilizados para describir la capacidad productiva del terreno." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Grid
                                ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*,*', Desktop='*,*,*'}"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="11">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Extensión (manzanas)" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Placeholder="Ej: 3.50"
                                            Keyboard="Numeric"
                                            TextChanged="DecimalDosDigitos_TextChanged"
                                            Text="{Binding ExtensionManzanaTexto, Mode=TwoWay}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Spacing="6">
                                    <Label Text="Producción (quintales oro)" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Placeholder="Ej: 25.00"
                                            Keyboard="Numeric"
                                            TextChanged="DecimalDosDigitos_TextChanged"
                                            Text="{Binding CantidadQuintalesOroTexto, Mode=TwoWay}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                                    Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                                    Spacing="6">
                                    <Label Text="Cantidad de plantas" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            Placeholder="Ej: 3500"
                                            Keyboard="Numeric"
                                            TextChanged="Entero_TextChanged"
                                            Text="{Binding CantidadPlantasTerrenoTexto, Mode=TwoWay}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label
                                Text="La fecha de ingreso se registra automáticamente al crear el terreno."
                                Style="{StaticResource ModernCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="13">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Ubicación administrativa" Style="{StaticResource ModernSectionTitle}" />
                                <Label Text="País, departamento y municipio donde se encuentra la finca." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <Grid
                                ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*,*', Desktop='*,*,*'}"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="País" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            ItemsSource="{Binding Paises}"
                                            ItemDisplayBinding="{Binding NombrePais}"
                                            SelectedItem="{Binding PaisSeleccionado}"
                                            IsEnabled="{Binding IsEnabled}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Spacing="6">
                                    <Label Text="Departamento" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            ItemsSource="{Binding Departamentos}"
                                            ItemDisplayBinding="{Binding NombreDepartamento}"
                                            SelectedItem="{Binding DepartamentoSeleccionado}"
                                            IsEnabled="{Binding CanPickDepartamento}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                                    Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                                    Spacing="6">
                                    <Label Text="Municipio" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Picker
                                            ItemsSource="{Binding Municipios}"
                                            ItemDisplayBinding="{Binding NombreMunicipio}"
                                            SelectedItem="{Binding MunicipioSeleccionado}"
                                            IsEnabled="{Binding CanPickMunicipio}"
                                            Style="{StaticResource ModernPicker}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="13">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Ubicación geográfica" Style="{StaticResource ModernSectionTitle}" />
                                <Label Text="Capture las coordenadas por GPS, mapa o pegándolas directamente." Style="{StaticResource ModernCaption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Pegar coordenadas desde Google Maps" Style="{StaticResource ModernFieldLabel}" />
                                <Border Style="{StaticResource ModernInputBorder}">
                                    <Entry
                                        x:Name="CoordenadasEntry"
                                        Placeholder="12.1234, -86.1234 o formato DMS"
                                        TextChanged="CoordenadasEntry_TextChanged"
                                        Text="{Binding CoordenadasTexto, Mode=OneWay}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Style="{StaticResource ModernEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <Grid
                                ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="10"
                                RowSpacing="8">
                                <Button
                                    Text="Obtener ubicación GPS"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Command="{Binding ObtenerGpsCommand}"
                                    IsVisible="{Binding IsEnabled}" />
                                <Button
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Text="Seleccionar en mapa"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Command="{Binding SeleccionarMapaCommand}"
                                    IsVisible="{Binding IsEnabled}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Latitud" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            x:Name="LatitudEntry"
                                            IsReadOnly="True"
                                            Text="{Binding Latitud, Mode=OneWay}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Longitud" Style="{StaticResource ModernFieldLabel}" />
                                    <Border Style="{StaticResource ModernInputBorder}">
                                        <Entry
                                            x:Name="LongitudEntry"
                                            IsReadOnly="True"
                                            Text="{Binding Longitud, Mode=OneWay}"
                                            Style="{StaticResource ModernEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Se mantiene un único WebView para no aumentar consumo de memoria. -->
                            <Border
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreenSoft}, Dark={StaticResource BrandGreenSoftDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                StrokeShape="RoundRectangle 14">
                                <WebView
                                    x:Name="MiniMapaWeb"
                                    HeightRequest="{OnIdiom Phone=190, Tablet=230, Desktop=260}" />
                            </Border>

                            <Button
                                Text="Abrir ubicación en Google Maps"
                                Clicked="BtnAbrirEnMaps_Clicked"
                                Style="{StaticResource ModernSecondaryButton}"
                                HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ModernFormCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Fotos del terreno" Style="{StaticResource ModernSectionTitle}" />
                                    <Label Text="Agregue fotografías para documentar la finca." Style="{StaticResource ModernCaption}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Agregar fotos"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Command="{Binding SeleccionarFotosCommand}"
                                    IsVisible="{Binding AllowEdit}" />
                            </Grid>

                            <Label
                                Text="No hay fotos agregadas."
                                Style="{StaticResource ModernPageSubtitle}"
                                IsVisible="{Binding NoTieneFotosTerreno}" />

                            <!--
                                Carrusel horizontal con altura fija: conserva virtualización y
                                evita que el listado de fotos expanda el ScrollView principal.
                            -->
                            <CollectionView
                                ItemsSource="{Binding FotosTerreno}"
                                IsVisible="{Binding TieneFotosTerreno}"
                                HeightRequest="168"
                                ItemSizingStrategy="MeasureFirstItem">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid WidthRequest="148" HeightRequest="162">
                                            <Border
                                                WidthRequest="140"
                                                HeightRequest="140"
                                                Margin="0,8,0,0"
                                                Padding="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                                                StrokeShape="RoundRectangle 14"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start">
                                                <Image
                                                    Source="{Binding Imagen}"
                                                    Aspect="AspectFill"
                                                    WidthRequest="140"
                                                    HeightRequest="140">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.AbrirGaleriaFotosCommand, Source={x:Reference TerrenoFormPage}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                            <Button
                                                Text="×"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                CornerRadius="16"
                                                FontSize="17"
                                                Padding="0"
                                                BackgroundColor="{StaticResource RedDelete}"
                                                TextColor="White"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="0,0,5,0"
                                                IsVisible="{Binding BindingContext.AllowEdit, Source={x:Reference TerrenoFormPage}}"
                                                Command="{Binding BindingContext.QuitarFotoCommand, Source={x:Reference TerrenoFormPage}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="9"
                        Margin="0,2,0,12">
                        <Button
                            Text="Guardar"
                            Style="{StaticResource ModernPrimaryButton}"
                            IsVisible="{Binding ShowSaveButton}"
                            Clicked="BtnGuardar_Clicked" />
                        <Button
                            Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Text="Cancelar"
                            Style="{StaticResource ModernNeutralButton}"
                            Command="{Binding CancelCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid
            Grid.RowSpan="2"
            ZIndex="100"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#28000000">
            <Border
                Padding="18,14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCard}, Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource BorderSoftDark}}"
                StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource color_Verde}" />
                    <Label
                        Text="Procesando terreno..."
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
