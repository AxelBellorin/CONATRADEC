<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CONATRADEC.Controls.ResponsiveSearchPanel"
    x:Name="SearchRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        x:Name="ContainerBorder"
        Style="{StaticResource ModernCard}">

        <Grid
            RowDefinitions="Auto,Auto"
            RowSpacing="10">

            <Border
                Grid.Row="0"
                Style="{StaticResource ModernInputBorder}"
                Padding="6,0">

                <SearchBar
                    Placeholder="{Binding Placeholder, Source={x:Reference SearchRoot}}"
                    Text="{Binding SearchText, Source={x:Reference SearchRoot}, Mode=TwoWay}"
                    SearchCommand="{Binding SearchCommand, Source={x:Reference SearchRoot}}"
                    Style="{StaticResource ModernSearchBar}" />
            </Border>

            <Grid
                x:Name="ActionsGrid"
                Grid.Row="1"
                ColumnSpacing="10"
                RowSpacing="8">

                <Label
                    x:Name="SummaryLabel"
                    Text="{Binding SummaryText, Source={x:Reference SearchRoot}}"
                    VerticalOptions="Center"
                    Style="{StaticResource ModernPageSubtitle}"
                    FontSize="11.5"
                    LineBreakMode="WordWrap" />

                <Button
                    x:Name="SearchButton"
                    Text="{Binding SearchButtonText, Source={x:Reference SearchRoot}}"
                    Command="{Binding SearchCommand, Source={x:Reference SearchRoot}}"
                    Style="{StaticResource ModernPrimaryButton}"
                    HeightRequest="44" />

                <Button
                    x:Name="ClearButton"
                    Text="{Binding ClearButtonText, Source={x:Reference SearchRoot}}"
                    Command="{Binding ClearCommand, Source={x:Reference SearchRoot}}"
                    Style="{StaticResource ModernNeutralButton}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
