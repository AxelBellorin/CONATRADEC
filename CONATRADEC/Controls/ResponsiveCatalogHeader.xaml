<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CONATRADEC.Controls.ResponsiveCatalogHeader"
    x:Name="HeaderRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Style="{StaticResource ModernHeroCard}"
        Padding="{OnIdiom Phone='12,12', Tablet='18,16', Desktop='22,20'}">
        <Grid
            x:Name="HeaderGrid"
            RowSpacing="10"
            ColumnSpacing="10">

            <Button
                x:Name="BackButton"
                Text="{Binding BackText, Source={x:Reference HeaderRoot}}"
                Command="{Binding BackCommand, Source={x:Reference HeaderRoot}}"
                IsVisible="{Binding IsBackVisible, Source={x:Reference HeaderRoot}}"
                Style="{StaticResource ModernNeutralButton}"
                VerticalOptions="Center" />

            <VerticalStackLayout
                x:Name="TitleContainer"
                Spacing="4"
                VerticalOptions="Center">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label
                        x:Name="TitleLabel"
                        Text="{Binding Title, Source={x:Reference HeaderRoot}}"
                        Style="{StaticResource ModernPageTitle}"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="1"
                        IsVisible="{Binding IsContextVisible, Source={x:Reference HeaderRoot}}"
                        Style="{StaticResource ModernBadgeGreen}"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding ContextText, Source={x:Reference HeaderRoot}}"
                            FontSize="10"
                            FontFamily="MontserratBold"
                            FontAttributes="Bold"
                            TextColor="{StaticResource color_Verde}"
                            LineBreakMode="TailTruncation" />
                    </Border>
                </Grid>

                <Label
                    x:Name="SubtitleLabel"
                    Text="{Binding Subtitle, Source={x:Reference HeaderRoot}}"
                    IsVisible="{Binding HasSubtitle, Source={x:Reference HeaderRoot}}"
                    Style="{StaticResource ModernPageSubtitle}"
                    MaxLines="3" />
            </VerticalStackLayout>

            <Button
                x:Name="DeletedButton"
                Text="↺ Eliminados"
                IsVisible="False"
                Clicked="OnDeletedClicked"
                Style="{StaticResource ModernCoffeeButton}"
                VerticalOptions="Center" />

            <Button
                x:Name="PrimaryButton"
                Text="{Binding PrimaryText, Source={x:Reference HeaderRoot}}"
                Command="{Binding PrimaryCommand, Source={x:Reference HeaderRoot}}"
                IsVisible="{Binding IsPrimaryVisible, Source={x:Reference HeaderRoot}}"
                Style="{StaticResource ModernPrimaryButton}"
                BackgroundColor="{Binding PrimaryBackgroundColor, Source={x:Reference HeaderRoot}}"
                TextColor="{Binding PrimaryTextColor, Source={x:Reference HeaderRoot}}"
                VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
